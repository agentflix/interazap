# =====================================================
  # Interazap - Template de Variáveis Seguras (Vault)                                                                                                                           
  # =====================================================                                                                                                                       
  # COPIAR PARA vault.yml E PREENCHER VALORES REAIS
  # Autor: DevOps Interazap                                                                                                                                                     
  # =====================================================                                                                                                                       
  #                                                                                                                                                                             
  # Criptografar após preencher:                                                                                                                                                
  # ansible-vault encrypt vars/vault.yml                                                                                                                                        
  #
  # Editar:                                                                                                                                                                     
  # ansible-vault edit vars/vault.yml                                                                                                                                           
  #
                                                                                                                                                                                
  # =====================================================         
  # USUÁRIOS
  # =====================================================
                                                                                                                                                                                
  # Senha do usuário agentflix (hash SHA512)                                                                                                                                    
  agentflix_password: ''                                                                                                                                                        
                                                                                                                                                                                
  # =====================================================         
  # POSTGRESQL
  # =====================================================

  # Senha do superusuário postgres                                                                                                                                              
  postgres_root_password: ''
                                                                                                                                                                                
  # Senha do usuário da aplicação                                 
  postgres_app_password: ''

  # =====================================================
  # REDIS
  # =====================================================

  # Senha do Redis (obrigatória)                                                                                                                                                
  redis_password: ''
                                                                                                                                                                                
  # =====================================================         
  # LARAVEL API
  # =====================================================                                                                                                                       
   
  # APP_KEY do Laravel - PRODUÇÃO (gerar com: php artisan key:generate --show)                                                                                                  
  agentflix_secret_key_production: ''                             
                                                                                                                                                                                
  # APP_KEY do Laravel - STAGING (chave separada da produção)     
  agentflix_secret_key_staging: ''                                                                                                                                              
                                                                  
  # =====================================================                                                                                                                       
  # GATEWAY
  # =====================================================                                                                                                                       
                                                                  
  # Chave API interna - PRODUÇÃO (gerar com: uuidgen)                                                                                                                           
  gateway_internal_api_key_production: ''
                                                                                                                                                                                
  # Chave API interna - STAGING (gerar com: uuidgen)                                                                                                                            
  gateway_internal_api_key_staging: ''
                                                                                                                                                                                
  # JWT Secret - PRODUÇÃO (gerar com: openssl rand -hex 32)       
  gateway_jwt_secret_production: ''
                                                                                                                                                                                
  # JWT Secret - STAGING (gerar com: openssl rand -hex 32)
  gateway_jwt_secret_staging: ''                                                                                                                                                
                                                                  
  # =====================================================
  # REVERB (WebSockets)
  # =====================================================

  reverb_app_id_production: 'interazap-prod'                                                                                                                                    
  reverb_app_key_production: '55d3f952db28a640e9d711de115ccee0'
  reverb_app_secret_production: '303acbede345b2f51e1b950745ed01669921a0be0c9c8e847a350bf067a29094'                                                                              
                                                                                                                                                                                
  reverb_app_id_staging: 'interazap-stage'                                                                                                                                      
  reverb_app_key_staging: '6ac1c931afd6ed654852cf298f67d020'                                                                                                                    
  reverb_app_secret_staging: 'f03d4c6b885b30849cb383c99d6a299002b6d5b172aff8e75cdba6e70a802036'                                                                                 
                                                                                                                                                                                
  # =====================================================
  # AI PROVIDERS                                                                                                                                                                
  # =====================================================         

  # OpenAI (obrigatório)                                                                                                                                                        
  openai_api_key: ''
                                                                                                                                                                                
  # Google Gemini (opcional)                                      
  google_ai_api_key: ''
                                                                                                                                                                                
  # MiniMax (opcional)
  minimax_api_key: ''                                                                                                                                                           
                                                                  
  # =====================================================
  # UAZAPI (WhatsApp Provider)
  # =====================================================                                                                                                                       
   
  uazapi_base_url: 'https://free.uazapi.com'                                                                                                                                    
  uazapi_admin_token: ''                                          
                                                                                                                                                                                
  # =====================================================         
  # TENANT
  # =====================================================                                                                                                                       
   
  # UUID do tenant padrão (gerar com: uuidgen)                                                                                                                                  
  default_tenant_id: ''                                           
                                                                                                                                                                                
  # =====================================================
  # ASAAS (Billing)                                                                                                                                                             
  # =====================================================         

  asaas_api_key: ''                                                                                                                                                             
   
  # =====================================================                                                                                                                       
  # MAIL                                                          
  # =====================================================

  mail_host: 'smtp.exemplo.com'
  mail_port: '587'
  mail_username: ''                                                                                                                                                             
  mail_password: ''
  mail_from_address: 'noreply@interazap.com.br'                                                                                                                                 
                                                                                                                                                                                
  # =====================================================
  # OBSERVABILIDADE (opcionais)                                                                                                                                                 
  # =====================================================         

  sentry_dsn: ''                                                                                                                                                                
  horizon_notification_email: ''
                                                                                                                                                                                
  # =====================================================         
  # SSH
  # =====================================================

  ssh_port: 22