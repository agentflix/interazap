# =====================================================
# InteraZap - Template de Variáveis Seguras (Vault)
# =====================================================
# COPIAR PARA vault.yml E PREENCHER VALORES REAIS
# Autor: DevOps InteraZap
# =====================================================
#
# Criptografar após preencher:
# ansible-vault encrypt vars/vault.yml
#
# Editar:
# ansible-vault edit vars/vault.yml
#

# =====================================================
# USUÁRIOS
# =====================================================

# Senha do usuário interazap (hash SHA512)
interazap_password: ''

# =====================================================
# POSTGRESQL
# =====================================================

# Senha do superusuário postgres
postgres_root_password: ''

# Senha do usuário da aplicação
postgres_app_password: ''

# =====================================================
# REDIS
# =====================================================

# Senha do Redis (obrigatória)
redis_password: ''

# =====================================================
# LARAVEL API
# =====================================================

# APP_KEY do Laravel - PRODUÇÃO (gerar com: php artisan key:generate --show)
interazap_secret_key_production: ''

# APP_KEY do Laravel - STAGING (chave separada da produção)
interazap_secret_key_staging: ''

# =====================================================
# GATEWAY
# =====================================================

# Chave API interna - PRODUÇÃO (gerar com: uuidgen)
gateway_internal_api_key_production: ''

# Chave API interna - STAGING (gerar com: uuidgen)
gateway_internal_api_key_staging: ''

# Gateway Secret (Authorization Bearer) - PRODUÇÃO (gerar com: uuidgen)
# Compartilhado entre gateway/.env e api/.env (middleware gateway.secret)
gateway_secret_production: ''

# Gateway Secret (Authorization Bearer) - STAGING (gerar com: uuidgen)
gateway_secret_staging: ''

# JWT Secret - PRODUÇÃO (gerar com: openssl rand -hex 32)
gateway_jwt_secret_production: ''

# JWT Secret - STAGING (gerar com: openssl rand -hex 32)
gateway_jwt_secret_staging: ''

# WebChat JWT Secret - PRODUÇÃO (gerar com: openssl rand -hex 32)
webchat_jwt_secret_production: ''

# WebChat JWT Secret - STAGING (gerar com: openssl rand -hex 32)
webchat_jwt_secret_staging: ''

# =====================================================
# REVERB (WebSockets)
# =====================================================

reverb_app_id_production: 'interazap-prod'
reverb_app_key_production: ''
reverb_app_secret_production: ''

reverb_app_id_staging: 'interazap-stage'
reverb_app_key_staging: ''
reverb_app_secret_staging: ''

# =====================================================
# AI PROVIDERS
# =====================================================

# OpenAI (obrigatório)
openai_api_key: ''

# OpenAI Fallback (opcional - usado em caso de rate limit)
openai_api_key_fallback: ''

# Google Gemini (opcional)
google_ai_api_key: ''

# MiniMax (opcional)
minimax_api_key: ''

# =====================================================
# UAZAPI (WhatsApp Provider)
# =====================================================

uazapi_base_url: 'https://free.uazapi.com'
uazapi_admin_token: ''

# =====================================================
# TENANT
# =====================================================

# UUID do tenant padrão (gerar com: uuidgen)
default_tenant_id: ''

# =====================================================
# ASAAS (Billing)
# =====================================================

asaas_api_key: ''

# =====================================================
# GOOGLE OAUTH (Self-Signup / Login social)
# =====================================================
# Criar credenciais em: https://console.cloud.google.com/apis/credentials
# Tipo: OAuth 2.0 Client ID / Web application

google_client_id: ''
google_client_secret: ''

# =====================================================
# MAIL
# =====================================================

mail_host: 'smtp.exemplo.com'
mail_port: '587'
mail_username: ''
mail_password: ''
mail_from_address: 'noreply@interazap.com.br'

# =====================================================
# AWS / S3 (opcional - necessário se FILESYSTEM_DISK=s3)
# =====================================================

aws_access_key_id: ''
aws_secret_access_key: ''
aws_default_region: 'us-east-1'
aws_bucket: ''

# =====================================================
# OBSERVABILIDADE (opcionais)
# =====================================================

sentry_dsn: ''
horizon_notification_email: ''
horizon_slack_webhook: ''

# =====================================================
# SSH
# =====================================================

ssh_port: 22
