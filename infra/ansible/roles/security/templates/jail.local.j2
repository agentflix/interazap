# Autor: DevOps Agentflix
# =====================================================

[DEFAULT]

# Tempo de banimento em segundos (1 hora)
bantime = 3600

# Janela de busca em segundos (10 minutos)
findtime = 600

# Máximo de tentativas
maxretry = 5

# Não banir IPs especificados
# GitHub Actions runners + redes privadas
ignoreip = 127.0.0.1/8 10.0.0.0/8 192.168.0.0/16 4.148.0.0/16 4.175.0.0/16 13.64.0.0/11 20.0.0.0/8 40.0.0.0/8 52.0.0.0/8 74.234.0.0/16 140.82.112.0/20 143.55.64.0/20 185.199.108.0/22 192.30.252.0/22 198.18.0.0/15

# SSH protegido por chave pública + UFW rate-limit — fail2ban desnecessário para SSH
[sshd]
enabled = false

[nginx-http-auth]
enabled = true
port = 80,443
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 5

[nginx-noscript]
enabled = true
port = 80,443
filter = nginx-noscript
logpath = /var/log/nginx/error.log
maxretry = 3
