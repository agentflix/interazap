# =====================================================
# Nginx - Gzip Configuration
# Autor: DevOps Agentflix
# =====================================================

gzip on;
gzip_static on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 256;
gzip_buffers 16 8k;
gzip_http_version 1.1;
gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/json
    application/javascript
    application/xml
    application/xml+rss
    application/x-javascript
    application/xhtml+xml
    application/xslt+xml
    application/woff2
    image/svg+xml;
gzip_disable "msie6";
