# =====================================================
# Nginx - agentflix.com.br (Bare domain redirect)
# Redireciona para www.agentflix.com.br
# Autor: DevOps Agentflix
# =====================================================

server {
    listen 80;
    listen [::]:80;
    server_name agentflix.com.br;
    return 301 https://www.agentflix.com.br$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name agentflix.com.br;

    ssl_certificate /etc/letsencrypt/live/agentflix.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentflix.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    return 301 https://www.agentflix.com.br$request_uri;
}
