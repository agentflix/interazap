# =====================================================
# InteraZap Gateway - Environment Production
# =====================================================

NODE_ENV=production
PORT=6002
INTERNAL_API_KEY={{ gateway_internal_api_key_production }}
GATEWAY_SECRET={{ gateway_secret_production | default('') }}

API_URL=http://127.0.0.1:{{ octane_port | default(9501) }}

REDIS_URL=redis://:{{ redis_password | urlencode }}@127.0.0.1:6379/0

DATABASE_URL=postgresql://interazap_app:{{ postgres_app_password | urlencode }}@127.0.0.1:5432/interazap

# CONFIGS
DEFAULT_TENANT_ID={{ default_tenant_id }}

# LOGGER
LOG_STRUCTURED=true
LOG_LEVEL=info

# JWT
JWT_SECRET={{ gateway_jwt_secret_production }}
JWT_ALGORITHM=HS256
WEBCHAT_JWT_SECRET={{ webchat_jwt_secret_production }}

# CORS
CORS_ORIGINS=https://app.interazap.com.br

# UAZAPI
UAZAPI_BASE_URL={{ uazapi_base_url }}
UAZAPI_ADMIN_TOKEN={{ uazapi_admin_token }}
UAZAPI_WEBHOOK_URL=https://gateway.interazap.com.br
UAZAPI_WEBHOOK_EVENTS=connection,messages,messages_update
UAZAPI_WEBHOOK_EXCLUDE_MESSAGES=wasSentByApi,isGroupYes
UAZAPI_WEBHOOK_RETRIES=3

# =============================================================================
# META / WHATSAPP CLOUD API
# =============================================================================

META_VERIFY_TOKEN={{ meta_verify_token | default('') }}
META_APP_SECRET={{ meta_app_secret | default('') }}
META_WEBHOOK_CALLBACK_URL={{ meta_webhook_callback_url | default('') }}

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================

OPENAI_API_KEY={{ openai_api_key }}
# OPENAI_API_KEY_FALLBACK={{ openai_api_key_fallback | default('') }}
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# GOOGLE GEMINI CONFIGURATION
# =============================================================================

GOOGLE_AI_API_KEY={{ google_ai_api_key | default('') }}
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash
GOOGLE_TIMEOUT_MS=180000
GOOGLE_MAX_RETRIES=3

# =============================================================================
# MINIMAX CONFIGURATION
# =============================================================================

MINIMAX_API_KEY={{ minimax_api_key | default('') }}
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_DEFAULT_MODEL=MiniMax-M2.5
MINIMAX_TIMEOUT_MS=180000
MINIMAX_MAX_RETRIES=3

# =============================================================================
# AI CONSUMER CONFIGURATION
# =============================================================================

AI_CONSUMER_GROUP=gateway-ai
AI_CONSUMER_NAME=consumer-1

# ASAAS
ASAAS_API_KEY={{ asaas_api_key }}
ASAAS_BASE_URL=https://api.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET={{ asaas_webhook_secret | default('') }}

# OBSERVABILITY
SENTRY_DSN={{ sentry_dsn | default('') }}

# =============================================================================
# QUEUE & BULLMQ CONFIGURATION
# =============================================================================

BULLMQ_DEFAULT_ATTEMPTS=5
BULLMQ_DEFAULT_BACKOFF_DELAY=1000
BULLMQ_COMPLETED_JOB_AGE=3600
BULLMQ_COMPLETED_JOB_COUNT=1000

# =============================================================================
# DLQ CONFIGURATION
# =============================================================================

DLQ_MAX_RETRIES=3
DLQ_REPROCESSING_DELAY=300000
DLQ_ALERT_THRESHOLD=100

# =============================================================================
# RATE LIMITER CONFIGURATION
# =============================================================================

AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_DURATION=60000

WEBHOOK_RATE_LIMIT_MAX=50
WEBHOOK_RATE_LIMIT_DURATION=60000

NOTIFICATION_RATE_LIMIT_MAX=100
NOTIFICATION_RATE_LIMIT_DURATION=60000
