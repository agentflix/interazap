# =====================================================
# InteraZap API - Environment Production
# Autor: DevOps Agentflix
# =====================================================

APP_NAME=InteraZap
APP_ENV=production
APP_KEY={{ agentflix_secret_key_production }}
APP_DEBUG=false
APP_URL=https://api.interazap.com.br
APP_LOCALE=pt_BR

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=interazap
DB_USERNAME=agentflix_app
DB_PASSWORD={{ postgres_app_password }}

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD={{ redis_password }}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=agentflix_prod_

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_DRIVER=reverb
REVERB_APP_ID={{ reverb_app_id_production | default('interazap-prod') }}
REVERB_APP_KEY={{ reverb_app_key_production | default('interazap-prod-key') }}
REVERB_APP_SECRET={{ reverb_app_secret_production | default('interazap-prod-secret') }}
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

LOG_CHANNEL=stack
LOG_LEVEL=info

HORIZON_NAME=interazap-prod
