# =====================================================
# InteraZap API - Environment Staging
# =====================================================

APP_NAME=InteraZap
APP_ENV=staging
APP_KEY={{ interazap_secret_key_staging }}
APP_DEBUG=false
APP_URL=https://stage.api.interazap.com.br
APP_FRONTEND_URL=https://stage.app.interazap.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=https://stage.app.interazap.com.br

# LOG
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=interazap_stage
DB_USERNAME=interazap_app
DB_PASSWORD={{ postgres_app_password }}

# SESSION
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.interazap.com.br

# CACHE
CACHE_STORE=redis
CACHE_PREFIX=interazap_stage_

# REDIS
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD={{ redis_password }}
REDIS_PORT=6379
REDIS_DB=1
REDIS_PREFIX=interazap_stage_

# BROADCAST
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

# REVERB
REVERB_APP_ID={{ reverb_app_id_staging | default('interazap-stage') }}
REVERB_APP_KEY={{ reverb_app_key_staging | default('interazap-stage-key') }}
REVERB_APP_SECRET={{ reverb_app_secret_staging | default('interazap-stage-secret') }}
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_MAX_MESSAGE_SIZE=20000

# MAIL
MAIL_MAILER=smtp
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USERNAME={{ mail_username }}
MAIL_PASSWORD={{ mail_password }}
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS={{ mail_from_address }}
MAIL_FROM_NAME=InteraZap

# AWS / S3
AWS_ACCESS_KEY_ID={{ aws_access_key_id | default('') }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key | default('') }}
AWS_DEFAULT_REGION={{ aws_default_region | default('us-east-1') }}
AWS_BUCKET={{ aws_bucket | default('') }}
AWS_USE_PATH_STYLE_ENDPOINT=false

# CHAT CONFIG
CHAT_AUTO_CLOSE_MINUTES=20
CHAT_EVALUATION_PUBLIC_URL=https://stage.app.interazap.com.br

# GATEWAY
GATEWAY_URL=http://127.0.0.1:6001
GATEWAY_INTERNAL_API_KEY={{ gateway_internal_api_key_staging }}
GATEWAY_E2E=false
REALTIME_PUBSUB_ENABLED=true
REALTIME_HTTP_FALLBACK_ENABLED=true

# AI
AI_AUTOPILOT_MAX_TOKENS=800
AI_MAX_TOOL_ITERATIONS=10
AI_AUTOPILOT_QUEUE_CONNECTION=redis
AI_AUTOPILOT_QUEUE_NAME=ai
AI_EMBEDDING_DIMENSIONS=512
AI_EMBEDDING_BATCH_SIZE=100
AI_CHUNKING_CHARS_PER_TOKEN=3.5

# RAG
RAG_EF_SEARCH=100
RAG_VECTOR_WEIGHT=0.6
RAG_KEYWORD_WEIGHT=0.4
RAG_EXPAND_NEIGHBORS=true
RAG_NEIGHBOR_WINDOW=1

# ASAAS (Billing)
ASAAS_API_KEY={{ asaas_api_key }}

# CONFIGS
DEFAULT_TENANT_ID={{ default_tenant_id }}

# SANCTUM
SANCTUM_EXPIRATION=1440

# WEBCHAT
WEBCHAT_JWT_SECRET={{ webchat_jwt_secret_staging }}

# OBSERVABILITY
SENTRY_LARAVEL_DSN={{ sentry_dsn | default('') }}
SENTRY_TRACES_SAMPLE_RATE=0.5
HORIZON_NOTIFICATION_EMAIL={{ horizon_notification_email | default('') }}
HORIZON_SLACK_WEBHOOK={{ horizon_slack_webhook | default('') }}
HORIZON_SLACK_CHANNEL=#alerts-staging
HORIZON_ADMIN_EMAIL={{ horizon_notification_email | default('') }}

# QUEUE CONFIGURATION
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

QUEUE_CRITICAL_TIMEOUT=30
QUEUE_CRITICAL_TRIES=5
QUEUE_HIGH_TIMEOUT=60
QUEUE_HIGH_TRIES=3
QUEUE_DEFAULT_TIMEOUT=120
QUEUE_DEFAULT_TRIES=3
QUEUE_LOW_TIMEOUT=300
QUEUE_LOW_TRIES=2
QUEUE_AI_TIMEOUT=180
QUEUE_AI_TRIES=3
QUEUE_MEDIA_TIMEOUT=300
QUEUE_MEDIA_TRIES=3

QUEUE_HEALTH_MAX_SIZE=1000
QUEUE_HEALTH_MAX_STUCK=10
QUEUE_HEALTH_STUCK_THRESHOLD=600

# HORIZON WORKERS
HORIZON_NAME=interazap-staging
HORIZON_MAX_PROCESSES=5
HORIZON_MIN_PROCESSES=1

# CIRCUIT BREAKER
WHATSAPP_USE_REAL_PROVIDER=true
WHATSAPP_CB_FAILURE_THRESHOLD=5
WHATSAPP_CB_SUCCESS_THRESHOLD=2
WHATSAPP_CB_OPEN_TIMEOUT=60

GATEWAY_TIMEOUT=3
GATEWAY_CONNECT_TIMEOUT=5
GATEWAY_RETRY_ATTEMPTS=3
GATEWAY_RETRY_DELAY_MS=150
REALTIME_PUBSUB_ENABLED=true
REALTIME_HTTP_FALLBACK_ENABLED=true

HTTP_RETRY_DELAY_MS=1000

# REDIS BACKOFF
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# PUSH NOTIFICATIONS
APN_KEY_ID={{ apn_key_id | default('') }}
APN_TEAM_ID={{ apn_team_id | default('') }}
APN_PRIVATE_KEY={{ apn_private_key | default('') }}
APN_BUNDLE_ID={{ apn_bundle_id | default('') }}
APN_PRIVATE_SECRET={{ apn_private_secret | default('') }}
APN_PRODUCTION={{ apn_production | default('false') }}
FCM_CREDENTIALS_JSON={{ fcm_credentials_json | default('') }}
