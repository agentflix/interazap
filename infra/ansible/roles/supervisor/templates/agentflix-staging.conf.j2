# =====================================================
# Supervisor - InteraZap Staging Workers
# Autor: DevOps Agentflix
# =====================================================

[program:interazap-staging-octane]
command=php /data/stage/api/current/api/artisan octane:start --server=swoole --workers=2 --host=127.0.0.1 --port=9502
directory=/data/stage/api/current/api
user=www-data
autostart=true
autorestart=true
startretries=3
startsecs=30
stopwaitsecs=60
redirect_stderr=true
stdout_logfile=/var/log/supervisor/interazap-staging-octane.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=3
stderr_logfile=/var/log/supervisor/interazap-staging-octane-error.log
stderr_logfile_maxbytes=50MB
stderr_logfile_backups=3
environment=APP_ENV="staging",APP_DEBUG="false"

[program:interazap-staging-streams-chat]
command=php /data/stage/api/current/api/artisan streams:chat-consume
directory=/data/stage/api/current/api
user=www-data
autostart=true
autorestart=true
startretries=3
numprocs=1
process_name=%(program_name)s_%(process_num)02d
startsecs=10
stopwaitsecs=60
redirect_stderr=true
stdout_logfile=/var/log/supervisor/interazap-staging-streams-chat.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
stderr_logfile=/var/log/supervisor/interazap-staging-streams-chat-error.log
stderr_logfile_maxbytes=20MB
stderr_logfile_backups=3
environment=APP_ENV="staging",APP_DEBUG="false"

