# ATENÇÃO: Este arquivo é gerenciado pelo Ansible.
# O template canônico está em: infra/ansible/roles/nginx/templates/www-staging.conf.j2

server {
    listen 80;
    server_name stage.www.agentflix.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stage.www.agentflix.com.br;
    root /data/stage/landing/current/public;
    index index.html;
    client_max_body_size 10M;

    ssl_certificate /etc/letsencrypt/live/stage.app.agentflix.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage.app.agentflix.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        try_files $uri $uri/ =404;
    }
}
