# ATENÇÃO: Este arquivo é gerenciado pelo Ansible.
# O template canônico está em: infra/ansible/roles/nginx/templates/app-staging.conf.j2

server {
    listen 80;
    server_name stage.app.interazap.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stage.app.interazap.com.br;
    root /data/stage/app/current/dist/interazap/browser;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/stage.app.interazap.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage.app.interazap.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
