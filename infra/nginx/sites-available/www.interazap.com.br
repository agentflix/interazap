# ATENÇÃO: Este arquivo é gerenciado pelo Ansible.
# O template canônico está em: infra/ansible/roles/nginx/templates/landing-production.conf.j2

server {
    listen 80;
    server_name interazap.com.br www.interazap.com.br;
    return 301 https://www.interazap.com.br$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name interazap.com.br;

    ssl_certificate /etc/letsencrypt/live/interazap.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/interazap.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Redirect bare domain → www (canonical)
    return 301 https://www.interazap.com.br$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.interazap.com.br;
    root /data/production/landing/current;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/interazap.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/interazap.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # HTML: cache curto para facilitar atualizações
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Sitemap e robots: curto para indexação rápida de mudanças
    location ~* \.(xml|txt)$ {
        expires 1d;
        add_header Cache-Control "public, must-revalidate";
    }

    # Fontes e imagens: cache longo imutável
    location ~* \.(woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # CSS/JS compilados: cache longo imutável (hash no nome quando possível)
    location ~* \.(css|js)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
