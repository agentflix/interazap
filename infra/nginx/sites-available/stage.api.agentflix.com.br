# ATENÇÃO: Este arquivo é gerenciado pelo Ansible.
# O template canônico está em: infra/ansible/roles/nginx/templates/api-staging.conf.j2

server {
    listen 80;
    server_name stage.api.agentflix.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 8081 ssl http2;
    listen [::]:8081 ssl http2;
    server_name stage.api.agentflix.com.br;
    root /data/stage/api/current/api/public;
    index index.php;
    client_max_body_size 64M;

    ssl_certificate /etc/letsencrypt/live/stage.app.agentflix.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage.app.agentflix.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
}
