%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#4CAF50'}}}%%
graph TB
    subgraph HTTP["🌐 HTTP / Presentation Layer (api/)"]
        CTRL["Controllers (Http/Controllers)"]
        MW["Middleware (Http/Middleware)"]
        REQ["Form Requests (Http/Requests)"]
        RES["API Resources (Http/Resources)"]
    end

    subgraph APP["⚙️ Application Layer (src/Domain/*/Actions|Services|Jobs)"]
        ACT["Actions (ex: CreateChatTicketAction)"]
        SVC["Application Services"]
        JOBS["Jobs / Queue Workers"]
        EVT_H["Event Handlers / Listeners"]
    end

    subgraph DOMAIN["🏛️ Domain Layer (src/Domain/*)"]
        ENT["Models / Entities (Eloquent)"]
        VO["Enums / Value Objects"]
        REPO_I["Repository Contracts (Contracts/)"]
        DOM_SVC["Domain Services"]
        DOM_EVT["Domain Events"]
        POLICY["Policies"]
    end

    subgraph INFRA["🔧 Infrastructure (app/ + Shared/)"]
        REPO["Repository Implementations"]
        PROV["Service Providers"]
        QUEUE["Redis Queues + Horizon"]
        DB["PostgreSQL (Eloquent ORM)"]
        CIRC["Circuit Breaker (Domain/Gateway)"]
    end

    subgraph GW["🔌 Gateway Service (gateway/ — NestJS 11)"]
        SOCK["Socket.io WebSocket Gateway"]
        WH["Webhook Consumers"]
        UAZAPI["UazAPI Provider"]
        ZAPI["Z-API Provider"]
        ASAAS_GW["ASAAS Billing Consumer"]
    end

    subgraph FE["🖥️ Frontend (app/ — Angular 20 + Capacitor)"]
        PAGES["Pages (pages/)"]
        LAYOUT_FE["Layout (layout/)"]
        CORE_SVC["Core Services (core/services)"]
        SHARED_C["Shared Components (shared/)"]
    end

    CTRL --> ACT
    MW --> CTRL
    REQ --> CTRL
    CTRL --> RES
    ACT --> ENT
    ACT --> REPO_I
    ACT --> DOM_SVC
    ACT --> JOBS
    EVT_H --> DOM_EVT
    REPO -.->|implements| REPO_I
    REPO --> DB
    JOBS --> QUEUE
    CIRC --> UAZAPI
    CIRC --> ZAPI
    GW --> SOCK
    FE --> CORE_SVC
    PAGES --> SHARED_C

    style DOMAIN fill:#E8F5E9,stroke:#4CAF50,stroke-width:3px
    style APP fill:#E3F2FD,stroke:#2196F3,stroke-width:2px
    style HTTP fill:#FFF3E0,stroke:#FF9800,stroke-width:2px
    style INFRA fill:#F3E5F5,stroke:#9C27B0,stroke-width:2px
    style GW fill:#FCE4EC,stroke:#E91E63,stroke-width:2px
    style FE fill:#E0F7FA,stroke:#00BCD4,stroke-width:2px
