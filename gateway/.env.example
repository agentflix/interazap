# =============================================================================
# GATEWAY — CONFIGURAÇÕES GERAIS
# =============================================================================

PORT=3000

# [OBRIGATÓRIO] Ambiente de execução
# Valores: development | production | test
NODE_ENV=development

# [OBRIGATÓRIO] Chave interna para autenticação API→Gateway via header
# ⚠️ Gerar com: uuidgen
INTERNAL_API_KEY=generate-with-uuidgen-command

# [OBRIGATÓRIO] Segredo compartilhado para autenticação interna API→Gateway
# ⚠️ Gerar com: openssl rand -hex 32
GATEWAY_SECRET=

# LARAVEL API (for Sanctum token validation)
API_URL=http://localhost:8000

# [OPCIONAL] Timeout para chamadas de autenticação na API Laravel (ms, default: 1500)
# API_AUTH_TIMEOUT_MS=1500

# REDIS
REDIS_URL=redis://localhost:6379

# =============================================================================
# UAZAPI — PROVEDOR WHATSAPP
# =============================================================================

UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN={minha-chave}
UAZAPI_WEBHOOK_URL=https://kathe-unsacrificing-tomeka.ngrok-free.dev
UAZAPI_WEBHOOK_EVENTS=connection,messages,messages_update
UAZAPI_WEBHOOK_EXCLUDE_MESSAGES=wasSentByApi,isGroupYes
UAZAPI_WEBHOOK_RETRIES=3

# =============================================================================
# Z-API — PROVEDOR WHATSAPP (CONDICIONAL: só se usar Z-API)
# =============================================================================

# [CONDICIONAL] URL base da API Z-API (default: https://api.z-api.io)
# ZAPI_BASE_URL=https://api.z-api.io

# [CONDICIONAL] Token de cliente Z-API (obrigatório se usar Z-API)
# ZAPI_CLIENT_TOKEN=

# [CONDICIONAL] Timeout HTTP para chamadas Z-API em ms (default: 30000)
# ZAPI_HTTP_TIMEOUT=30000

# =============================================================================
# META / WHATSAPP CLOUD API — PROVEDOR WHATSAPP
# =============================================================================

# [OBRIGATÓRIO] Token de verificação do webhook Meta/WhatsApp
# ⚠️ Configurar o mesmo valor no painel Meta → Webhooks → Verify Token
META_VERIFY_TOKEN=

# [OBRIGATÓRIO] App Secret do Meta para validação HMAC dos webhooks
# Obter em: https://developers.facebook.com/ → App → Configurações → App Secret
META_APP_SECRET=

# [OBRIGATÓRIO] URL de callback para registro de webhook no Meta
# Exemplo: https://gateway.seudominio.com/webhooks/meta
META_WEBHOOK_CALLBACK_URL=

# [OPCIONAL] URL base da Graph API do Meta (default: https://graph.facebook.com/v18.0)
# META_GRAPH_API_URL=https://graph.facebook.com/v18.0

# =============================================================================
# TELEGRAM — PROVEDOR (CONDICIONAL: só se usar Telegram)
# =============================================================================

# [CONDICIONAL] Origens permitidas para conexões WebSocket do Telegram
# Deixar vazio bloqueia todas as origens (comportamento padrão seguro)
# Exemplo: https://app.interazap.com.br,https://staging.interazap.com.br
# TELEGRAM_WS_ALLOWED_ORIGINS=

# DATABASE
# ⚠️ Update with your credentials
DATABASE_URL=postgresql://user:password@host:5432/gateway

# CONFIGS
# ⚠️ Set your default tenant ID
DEFAULT_TENANT_ID=your-default-tenant-uuid

# LOGGER
# LOG_STRUCTURED=false -> logger colorido no console (dev)
# LOG_STRUCTURED=true  -> logger JSON estruturado (produção/observabilidade)
LOG_STRUCTURED=false
# Níveis: error | warn | log | info | debug | verbose
LOG_LEVEL=log

# JWT Configuration
# ⚠️ Generate a secure secret (min 32 chars): openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
JWT_ALGORITHM=HS256
# Segredo compartilhado com a API Laravel para verificar tokens do chat público
# Deve ser IGUAL ao WEBCHAT_JWT_SECRET do .env da API
WEBCHAT_JWT_SECRET=

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,https://app.interazap.com.br

# =============================================================================
# OBSERVABILIDADE
# =============================================================================

# [OBRIGATÓRIO em produção] DSN do Sentry para rastreamento de erros
# Obter em: https://sentry.io/
SENTRY_DSN=

# =============================================================================
# THROTTLE / RATE LIMITING HTTP E WEBSOCKET
# =============================================================================

# [OPCIONAL] Throttle HTTP global — janela em segundos (default: 60)
# THROTTLE_TTL=60

# [OPCIONAL] Throttle HTTP global — máximo de requisições por janela (default: 100)
# THROTTLE_LIMIT=100

# [OPCIONAL] Throttle WebSocket — janela em segundos (default: 60)
# WS_THROTTLE_TTL=60

# [OPCIONAL] Throttle WebSocket — máximo de eventos por janela (default: 60)
# WS_THROTTLE_LIMIT=60

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================

# Primary API Key (required)
OPENAI_API_KEY=sk-your-api-key

# Fallback API Key (optional) - used when primary key hits rate limits or errors
# OPENAI_API_KEY_FALLBACK=sk-your-fallback-key

# Default model for chat completions (default: gpt-4o)
OPENAI_DEFAULT_MODEL=gpt-4o

# [OPCIONAL] Alias legado para OPENAI_DEFAULT_MODEL (deprecated, prefira OPENAI_DEFAULT_MODEL)
# OPENAI_MODEL=gpt-4o-mini

# Request timeout in milliseconds (default: 180000 = 3 minutes)
OPENAI_TIMEOUT_MS=180000

# Max retries for transient errors (default: 3)
OPENAI_MAX_RETRIES=3

# Embedding model (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# GOOGLE GEMINI CONFIGURATION
# =============================================================================

# API Key (required for Google Gemini provider)
GOOGLE_AI_API_KEY=

# Default model for completions (default: gemini-2.5-flash)
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# Request timeout in milliseconds (default: 180000 = 3 minutes)
GOOGLE_TIMEOUT_MS=180000

# Max retries for transient errors (default: 3)
GOOGLE_MAX_RETRIES=3

# =============================================================================
# MINIMAX CONFIGURATION
# =============================================================================

# API Key (required for MiniMax provider)
MINIMAX_API_KEY=

# Base URL for the MiniMax API (default: https://api.minimax.io)
# MINIMAX_BASE_URL=https://api.minimax.io

# Default model for completions (default: MiniMax-M2.5)
MINIMAX_DEFAULT_MODEL=MiniMax-M2.5

# Request timeout in milliseconds (default: 180000 = 3 minutes)
MINIMAX_TIMEOUT_MS=180000

# Max retries for transient errors (default: 3)
MINIMAX_MAX_RETRIES=3

# =============================================================================
# AI — TIMEOUTS DE DELEGAÇÃO E RPC
# =============================================================================

# [OPCIONAL] Timeout de espera para delegação de IA (ms, default: 8000)
# AI_DELEGATION_WAIT_TIMEOUT_MS=8000

# [OPCIONAL] Timeout para chamadas RPC de ferramentas de IA (ms, default: 2000)
# AI_TOOL_RPC_TIMEOUT_MS=2000

# =============================================================================
# AI CONSUMER CONFIGURATION
# =============================================================================

# Consumer group name (default: gateway-ai)
AI_CONSUMER_GROUP=gateway-ai

# Consumer name - should be unique per instance (default: consumer-{pid})
# Recommended format: consumer-{hostname} for multi-instance deployments
AI_CONSUMER_NAME=consumer-1

# =============================================================================
# ASAAS BILLING CONFIGURATION
# =============================================================================

# [OBRIGATÓRIO] Asaas API Key (for payment processing)
# Obter em: https://www.asaas.com/
ASAAS_API_KEY=

# [OBRIGATÓRIO] URL base da API Asaas
# ⚠️ ATENÇÃO — O CÓDIGO TEM DEFAULT PARA SANDBOX. DEFINIR EXPLICITAMENTE EM PRODUÇÃO!
#   Sandbox:  https://sandbox.asaas.com/api/v3
#   Produção: https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# [OBRIGATÓRIO] Segredo para validação HMAC dos webhooks Asaas
# ⚠️ Configurar o mesmo valor no painel Asaas → Webhooks → Token
ASAAS_WEBHOOK_SECRET=

# =============================================================================
# QUEUE & BULLMQ CONFIGURATION (006-async-resilience)
# =============================================================================

# Default job attempts (default: 5)
BULLMQ_DEFAULT_ATTEMPTS=5

# Default backoff delay in ms (default: 1000)
BULLMQ_DEFAULT_BACKOFF_DELAY=1000

# Job retention: completed jobs age in seconds (default: 3600 = 1h)
BULLMQ_COMPLETED_JOB_AGE=3600

# Job retention: max completed jobs to keep (default: 1000)
BULLMQ_COMPLETED_JOB_COUNT=1000

# =============================================================================
# DLQ CONFIGURATION
# =============================================================================

# Max total DLQ retries before job is considered dead (default: 3)
DLQ_MAX_RETRIES=3

# Delay between DLQ reprocessing attempts in ms (default: 300000 = 5min)
DLQ_REPROCESSING_DELAY=300000

# DLQ size alert threshold (default: 100)
DLQ_ALERT_THRESHOLD=100

# =============================================================================
# RATE LIMITER CONFIGURATION
# =============================================================================

# AI batch processing: max jobs per window (default: 10)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_DURATION=60000

# Webhook retries: max jobs per window (default: 50)
WEBHOOK_RATE_LIMIT_MAX=50
WEBHOOK_RATE_LIMIT_DURATION=60000

# Notifications: max jobs per window (default: 100)
NOTIFICATION_RATE_LIMIT_MAX=100
NOTIFICATION_RATE_LIMIT_DURATION=60000