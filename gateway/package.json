{
  "name": "gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck:specs": "tsc --project tsconfig.spec.json --noEmit",
    "gate:lint": "printf '\\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\\n┃  🎨  Gate 1/3 · ESLint                             ┃\\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\\n\\n' && pnpm lint && printf '\\n✅ Gate 1/3 · ESLint OK\\n\\n'",
    "gate:test": "printf '\\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\\n┃  🧪  Gate 2/3 · Testes (Jest + @swc/jest)          ┃\\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\\n\\n' && jest && printf '\\n✅ Gate 2/3 · Testes OK\\n\\n'",
    "gate:build": "printf '\\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\\n┃  🛠   Gate 3/3 · Build (nest build)                 ┃\\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\\n\\n' && nest build && printf '\\n✅ Gate 3/3 · Build OK\\n\\n'",
    "gate:all": "printf '\\n╔═══════════════════════════════════════════════════════╗\\n║  🚀  Executando todos os gates                       ║\\n╚═══════════════════════════════════════════════════════╝\\n' && pnpm gate:lint && pnpm gate:test && pnpm gate:build && printf '\\n╔═══════════════════════════════════════════════════════╗\\n║  🎉  TODOS OS GATES PASSARAM                         ║\\n╚═══════════════════════════════════════════════════════╝\\n'"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1030.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.11",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.2",
    "bullmq": "^5.67.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.16.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "\\.real\\.e2e-spec\\.ts$"
    ],
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest"
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts",
      "!src/domains/realtime/types/**/*.ts",
      "!src/**/*.interface.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "src/main.ts",
      "src/domains/realtime/types/"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
