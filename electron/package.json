{
    "name": "interazap-desktop",
    "version": "1.0.0",
    "description": "InteraZap Desktop - Multi-OS Electron App",
    "main": "dist/main.js",
    "author": "InteraZap",
    "license": "MIT",
    "scripts": {
        "clean": "rm -rf dist app release",
        "copy:renderer": "rm -rf app && mkdir -p app && cp -R ../app/dist/app-new/browser app/browser",
        "build:angular": "cd ../app && pnpm exec ng build --configuration production",
        "build:main": "tsc -p tsconfig.electron.json",
        "prebuild": "pnpm run build:angular && pnpm run copy:renderer && pnpm run build:main",
        "electron:dev": "tsc -p tsconfig.electron.json && electron .",
        "electron:build": "pnpm run prebuild && electron-builder",
        "electron:build:win": "pnpm run prebuild && electron-builder --win",
        "electron:build:mac": "pnpm run prebuild && electron-builder --mac",
        "electron:build:linux": "pnpm run prebuild && electron-builder --linux"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "electron-store": "^10.0.0",
        "electron-updater": "^6.0.0"
    }
}
