payload);\n  }\n\n  update(\n    id: string,\n    payload: { name: string; permissions: string[] },\n  ): Observable<ApiResponse<{ role: Role }>> {\n    return this.http.put<ApiResponse<{ role: Role }>>(`${this.baseUrl}/${id}`, payload);\n  }\n\n  delete(id: string): Observable<ApiResponse<null>> {\n    return this.http.delete<ApiResponse<null>>(`${this.baseUrl}/${id}`);\n  }\n\n  /**\n   * Retorna todas as permissões disponíveis agrupadas por módulo.\n   */\n  permissions(): Observable<ApiResponse<{ permissions: GroupedPermissions }>> {\n    return this.http.get<ApiResponse<{ permissions: GroupedPermissions }>>(\n      `${this.baseUrl}/permissions`,\n    );\n  }\n\n  /**\n   * Lista simples de roles (para selects/dropdowns).\n   */\n  listAll(): Observable<PaginatedRoles> {\n    return this.list({ per_page: 100 });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/settings-users.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":77,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":77,"endColumn":23,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1776,1790],"text":"filters.search != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1776,1790],"text":"filters.search ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1776,1790],"text":"Boolean(filters.search)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/