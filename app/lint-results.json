topilotServiceStub }],\n    }).compileComponents();\n\n    autopilot = TestBed.inject(AutopilotService) as unknown as AutopilotServiceStub;\n    autopilot.listGuardrails.mockReturnValue(\n      of({ data: guardrails, meta: { current_page: 1, per_page: 10, total: 2, last_page: 1 } }),\n    );\n    autopilot.getGuardrail.mockReturnValue(of(guardrails[0]));\n    autopilot.createGuardrail.mockReturnValue(of(guardrails[0]));\n    autopilot.updateGuardrail.mockReturnValue(of(guardrails[1]));\n    autopilot.deleteGuardrail.mockReturnValue(of(void 0));\n\n    fixture = TestBed.createComponent(Guardrails);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should configure columns', () => {\n    const columns = component.columns();\n    expect(columns.some((column) => column.field === 'priority')).toBe(true);\n  });\n\n  it('should expose filter options', () => {\n    expect(component.filterStatusOptions.length).toBe(3);\n  });\n\n  it('should list guardrails with filters and sorting', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotGuardrail[] }>((resolve) => {\n      component.crudService\n        .list({ page: 1, per_page: 10, search: 'aprov', is_active: false })\n        .subscribe((res) => resolve(res));\n    });\n    expect(result.data.length).toBe(1);\n    expect(result.data[0].id).toBe('g-2');\n  });\n\n  it('should create guardrail', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotGuardrail }>((resolve) => {\n      component.crudService.create({ name: 'Nova' } as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('g-1');\n  });\n\n  it('should update guardrail', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotGuardrail }>((resolve) => {\n      component.crudService.update('guardrail-1', {} as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('g-2');\n  });\n\n  it('should delete guardrail', async (): Promise<void> => {\n    await new Promise<void>((resolve) => {\n      component.crudService.delete('guardrail-1').subscribe(() => resolve());\n    });\n    expect(autopilot.deleteGuardrail).toHaveBeenCalledWith('guardrail-1');\n  });\n\n  it('should delegate form actions to CrudPage', (): void => {\n    const crudPage = {\n      handleFormSaved: vi.fn(),\n      closeModal: vi.fn(),\n    };\n    (component as unknown as { crudPage: () => typeof crudPage }).crudPage = (): typeof crudPage =>\n      crudPage;\n\n    component.handleFormSaved(guardrails[0]);\n    component.handleFormCancelled();\n\n    expect(crudPage.handleFormSaved).toHaveBeenCalledWith(guardrails[0]);\n    expect(crudPage.closeModal).toHaveBeenCalled();\n  });\n\n  it('should update guardrail active status via crud service', async (): Promise<void> => {\n    const payload = { is_active: false };\n\n    const result = await new Promise<{ data: AutopilotGuardrail }>((resolve) => {\n      component.crudService.update(guardrails[0].id, payload).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('g-2');\n    expect(autopilot.updateGuardrail).toHaveBeenCalledWith(guardrails[0].id, payload);\n  });\n\n  it('should render empty state when no guardrails', () => {\n    autopilot.listGuardrails.mockReturnValue(\n      of({ data: [], meta: { current_page: 1, per_page: 10, total: 0, last_page: 1 } }),\n    );\n\n    fixture = TestBed.createComponent(Guardrails);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n\n    expect(component).toBeTruthy();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/guardrails/guardrails.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/autopilot.service' import is duplicated.","line":15,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":15,"endColumn":69}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TemplateRef } from '@angular/core';\nimport {\n  CUSTOM_ELEMENTS_SCHEMA,\n  ChangeDetectionStrategy,\n  Component,\n  computed,\n  inject,\n  viewChild,\n} from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport type {\n  AutopilotGuardrail,\n  AutopilotGuardrailPayload,\n} from '@core/services/autopilot.service';\nimport { AutopilotService } from '@core/services/autopilot.service';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n  CrudPageLikeRef,\n} from '../autopilot-crud.types';\nimport type { AfSelectOption } from '@shared/components';\nimport { GuardrailFormComponent } from './components';\n\n/**\n * Componente para gestão de Guardrails do IA Autopilot.\n *\n * Permite configurar regras de segurança, aprovação e limites operacionais\n * para as ações executadas pela inteligência artificial.\n *\n * @class Guardrails\n * @extends {BaseListPage<AutopilotGuardrail>}\n * @description Central de regras de segurança e conformidade da IA.\n */\n@Component({\n  selector: 'app-guardrails',\n  standalone: true,\n  imports: [GuardrailFormComponent],\n  templateUrl: './guardrails.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n})\nexport class Guardrails {\n  private readonly autopilotService = inject(AutopilotService);\n\n  readonly ruleTypeLabelMap: Record<string, string> = {\n    BLOCK: 'Bloqueio',\n    WARN: 'Alerta',\n    LOG_ONLY: 'Apenas Log',\n    REQUIRE_APPROVAL: 'Requer Aprovação',\n  };\n\n  readonly crudPage = viewChild<CrudPageLikeRef<AutopilotGuardrail>>('crudPage');\n  readonly guardrailForm = viewChild<GuardrailFormComponent>('guardrailForm');\n  readonly nameCell = viewChild<TemplateRef<{ $implicit: AutopilotGuardrail }>>('nameCell');\n  readonly ruleTypeCell = viewChild<TemplateRef<{ $implicit: AutopilotGuardrail }>>('ruleTypeCell');\n\n  readonly crudService: CrudService<AutopilotGuardrail> = {\n    list: (params) =>\n      this.autopilotService.listGuardrails({ page: 1, per_page: 1000 }).pipe(\n        map((response) => {\n          const search = params.search?.toLowerCase() ?? '';\n          const isActive = params.is_active;\n          const perPage = params.per_page ?? 10;\n          const page = params.page ?? 1;\n\n          let data = [...response.data];\n\n          if (search) {\n            data = data.filter((item) => item.name.toLowerCase().includes(search));\n          }\n\n          if (isActive !== undefined) {\n            data = data.filter((item) => item.is_active === isActive);\n          }\n\n          data.sort((a, b) => b.priority - a.priority);\n\n          const total = data.length;\n          const lastPage = Math.max(1, Math.ceil(total / perPage));\n          const start = (page - 1) * perPage;\n          const paged = data.slice(start, start + perPage);\n\n          return {\n            data: paged,\n            meta: {\n              total,\n              per_page: perPage,\n              current_page: page,\n              last_page: lastPage,\n            },\n          };\n        }),\n      ) as Observable<CrudPaginatedResponse<AutopilotGuardrail>>,\n    find: (id: string) =>\n      this.autopilotService\n        .getGuardrail(id)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotGuardrail>\n      >,\n    create: (data: Partial<AutopilotGuardrail>) =>\n      this.autopilotService\n        .createGuardrail(data as AutopilotGuardrailPayload)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotGuardrail>\n      >,\n    update: (id: string, data: Partial<AutopilotGuardrail>) =>\n      this.autopilotService\n        .updateGuardrail(id, data)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotGuardrail>\n      >,\n    delete: (id: string) => this.autopilotService.deleteGuardrail(id),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    {\n      field: 'name',\n      label: 'Nome',\n      template: this.nameCell() ?? undefined,\n    },\n    {\n      field: 'rule_type',\n      label: 'Tipo',\n      template: this.ruleTypeCell() ?? undefined,\n    },\n    { field: 'priority', label: 'Prioridade', type: 'text' },\n    { field: 'is_active', label: 'Status', type: 'status' },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Guardrail',\n      plural: 'Segurança (Guardrails)',\n      createButton: 'Nova regra',\n      modalCreate: 'Novo Guardrail',\n      modalEdit: 'Editar Guardrail',\n    },\n    subtitle: 'Autopilot',\n    searchPlaceholder: 'Buscar guardrails...',\n    emptyState: {\n      icon: 'lucideShield',\n      title: 'Nenhum guardrail encontrado',\n      description: 'Adicione regras de segurança para seu autopilot.',\n    },\n    enableSelection: false,\n    enableSearch: true,\n    enableFilters: true,\n    enableBulkDelete: false,\n    enablePagination: false,\n  };\n\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  handleFormSaved(item: AutopilotGuardrail): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.handleFormSaved(item);\n    }\n  }\n\n  handleFormCancelled(): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.closeModal();\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/help/help.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/help/help.ts","messages":[{"ruleId":"@typescript-eslint/no-extraneous-class","severity":2,"message":"Unexpected empty class.","line":23,"column":14,"nodeType":"Identifier","messageId":"empty","endLine":23,"endColumn":27}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, CUSTOM_ELEMENTS_SCHEMA, ChangeDetectionStrategy } from '@angular/core';\nimport { RouterLink } from '@angular/router';\nimport { AfPageTitleComponent } from '@shared/components';\n\n/**\n * Componente de tutorial e documentação do IA Autopilot.\n *\n * Centraliza informações detalhadas sobre como configurar playbooks,\n * ferramentas, segurança, simulador e histórico de execuções.\n * Voltado para usuários leigos com linguagem simples e analogias práticas.\n *\n * @class AutopilotHelp\n * @description Central de ajuda, tutorial passo a passo e FAQ do Autopilot.\n */\n@Component({\n  selector: 'app-autopilot-help',\n  standalone: true,\n  imports: [AfPageTitleComponent, RouterLink],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n  templateUrl: './help.html',\n})\nexport class AutopilotHelp {}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/history/history.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/history/history.spec.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/autopilot.service' import is duplicated.","line":7,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":7,"endColumn":76},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (132). Maximum allowed is 80.","line":15,"column":21,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":146,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { type ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideRouter } from '@angular/router';\nimport { of, throwError } from 'rxjs';\nimport { History } from './history';\nimport type { AutopilotAction, AutopilotRun } from 'src/app/core/services/autopilot.service';\nimport { AutopilotService } from 'src/app/core/services/autopilot.service';\n\nclass AutopilotServiceStub {\n  listRuns = vi.fn();\n  getRun = vi.fn();\n  cancelRun = vi.fn();\n}\n\ndescribe('History', () => {\n  let component: History;\n  let fixture: ComponentFixture<History>;\n  let autopilot: AutopilotServiceStub;\n\n  const actions: AutopilotAction[] = [\n    {\n      id: 'a-1',\n      run_id: 'r-1',\n      action_type: 'send_message',\n      tool_name: 'chat.send',\n      order: 1,\n    },\n  ];\n\n  const run: AutopilotRun = {\n    id: 'r-1',\n    playbook_id: 'p-1',\n    status: 'RUNNING',\n    playbook_version: 1,\n    started_at: '2026-01-30T10:00:00Z',\n    completed_at: '2026-01-30T10:00:10Z',\n    actions,\n  };\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [History],\n      providers: [provideRouter([]), { provide: AutopilotService, useClass: AutopilotServiceStub }],\n    }).compileComponents();\n\n    autopilot = TestBed.inject(AutopilotService) as unknown as AutopilotServiceStub;\n    autopilot.listRuns.mockReturnValue(\n      of({ data: [run], meta: { current_page: 1, per_page: 10, total: 1, last_page: 1 } }),\n    );\n    autopilot.getRun.mockReturnValue(of({ data: run }));\n    autopilot.cancelRun.mockReturnValue(of({ data: run }));\n\n    fixture = TestBed.createComponent(History);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should configure columns', () => {\n    const columns = component.columns();\n    expect(columns.some((column) => column.field === 'status')).toBe(true);\n  });\n\n  it('should list autopilot runs', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotRun[] }>((resolve) => {\n      component.crudService.list({ page: 1, per_page: 10 }).subscribe((res) => resolve(res));\n    });\n    expect(result.data.length).toBe(1);\n  });\n\n  it('should get autopilot run details', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotRun }>((resolve) => {\n      component.crudService.find('r-1').subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('r-1');\n  });\n\n  it('opens details and loads actions', async (): Promise<void> => {\n    component.viewDetails(run);\n\n    await new Promise((resolve) => setTimeout(resolve, 10));\n\n    expect(component.selectedRun()?.id).toBe('r-1');\n    expect(component.selectedRunActions().length).toBe(1);\n    expect(component.isDetailOpen()).toBe(true);\n  });\n\n  it('closes details and clears state', (): void => {\n    component.selectedRun.set(run);\n    component.selectedRunActions.set(actions);\n    component.isDetailOpen.set(true);\n\n    component.closeDetails();\n\n    expect(component.selectedRun()).toBeNull();\n    expect(component.selectedRunActions()).toEqual([]);\n    expect(component.isDetailOpen()).toBe(false);\n  });\n\n  it('cancels running execution and reloads list', (): void => {\n    const crudPage = {\n      showSuccess: vi.fn(),\n      showError: vi.fn(),\n      reloadList: vi.fn(),\n    };\n    (component as unknown as { crudPage: () => typeof crudPage }).crudPage = (): typeof crudPage =>\n      crudPage;\n    component.cancelRun(run);\n    component.confirmCancel();\n\n    expect(autopilot.cancelRun).toHaveBeenCalledWith('r-1');\n    expect(crudPage.reloadList).toHaveBeenCalled();\n    expect(crudPage.showSuccess).toHaveBeenCalled();\n  });\n\n  it('does not cancel when status is final', (): void => {\n    component.cancelRun({ ...run, status: 'COMPLETED' });\n    expect(autopilot.cancelRun).not.toHaveBeenCalled();\n  });\n\n  it('formats dates and duration', (): void => {\n    expect(component.formatDate(undefined)).toBe('-');\n    expect(component.calculateDuration({ ...run, completed_at: undefined })).toBe('-');\n    expect(component.calculateDuration(run)).toBe('10s');\n  });\n\n  it('shows error when detail fetch fails', async (): Promise<void> => {\n    const crudPage = {\n      showSuccess: vi.fn(),\n      showError: vi.fn(),\n      reloadList: vi.fn(),\n    };\n    (component as unknown as { crudPage: () => typeof crudPage }).crudPage = (): typeof crudPage =>\n      crudPage;\n    autopilot.getRun.mockReturnValue(throwError(() => new Error('fail')));\n\n    component.viewDetails(run);\n\n    await new Promise((resolve) => setTimeout(resolve, 10));\n\n    expect(crudPage.showError).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/history/history.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' im