null);\n  private readonly _runThinking = signal<AiRunEvent | null>(null);\n  private readonly _runToolCall = signal<AiRunToolCallEvent | null>(null);\n  private readonly _runToolResult = signal<AiRunToolResultEvent | null>(null);\n  private readonly _runCompleted = signal<AiRunCompletedEvent | null>(null);\n  private readonly _runFailed = signal<AiRunEvent | null>(null);\n  private readonly _runBlocked = signal<AiRunEvent | null>(null);\n  private readonly _lastEventType = signal<string | null>(null);\n  private readonly _eventCount = signal(0);\n  private listenersBound = false;\n\n  readonly connected = this.realtime.connected;\n  readonly lastEvent = computed(() => ({\n    started: this._runStarted(),\n    thinking: this._runThinking(),\n    toolCall: this._runToolCall(),\n    toolResult: this._runToolResult(),\n    completed: this._runCompleted(),\n    failed: this._runFailed(),\n    blocked: this._runBlocked(),\n    type: this._lastEventType(),\n    version: this._eventCount(),\n  }));\n\n  connect(): void {\n    this.realtime.connect();\n    this.bindEvents();\n  }\n\n  private bindEvents(): void {\n    if (this.listenersBound) {\n      return;\n    }\n\n    const events = [\n      'ai.run.started',\n      'ai.run.thinking',\n      'ai.run.tool_call',\n      'ai.run.tool_result',\n      'ai.run.completed',\n      'ai.run.failed',\n      'ai.run.blocked',\n    ];\n\n    for (const eventName of events) {\n      this.realtime\n        .on(eventName)\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe((payload) => this.handleEvent(eventName, payload));\n    }\n\n    this.listenersBound = true;\n  }\n\n  private handleEvent(eventName: string, payload: unknown): void {\n    const eventPayload = this.normalizePayload(payload);\n    if (!eventPayload) {\n      return;\n    }\n\n    switch (eventName) {\n      case 'ai.run.started':\n        this._runStarted.set(eventPayload);\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.thinking':\n        this._runThinking.set(eventPayload);\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.tool_call':\n        this._runToolCall.set(this.toToolCallEvent(eventPayload));\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.tool_result':\n        this._runToolResult.set(this.toToolResultEvent(eventPayload));\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.completed':\n        this._runCompleted.set(this.toCompletedEvent(eventPayload));\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.failed':\n        this._runFailed.set(eventPayload);\n        this._lastEventType.set(eventName);\n        break;\n      case 'ai.run.blocked':\n        this._runBlocked.set(eventPayload);\n        this._lastEventType.set(eventName);\n        break;\n      default:\n        return;\n    }\n\n    this._eventCount.update((value) => value + 1);\n  }\n\n  private normalizePayload(payload: unknown): (AiRunEvent & Record<string, unknown>) | null {\n    if (!this.isRecord(payload)) {\n      return null;\n    }\n\n    const runId = this.getString(payload, 'run_id');\n    const tenantId = this.getString(payload, 'tenant_id');\n    const status = this.getString(payload, 'status');\n\n    if (!runId || !tenantId || !status) {\n      return null;\n    }\n\n    const normalizedPayload: AiRunEvent & Record<string, unknown> = {\n      ...payload,\n      run_id: runId,\n      tenant_id: tenantId,\n      status,\n    };\n\n    return normalizedPayload;\n  }\n\n  private isRecord(value: unknown): value is Record<string, unknown> {\n    return typeof value === 'object' && value !== null;\n  }\n\n  private toToolCallEvent(\n    payload: AiRunEvent & Record<string, unknown>,\n  ): AiRunToolCallEvent | null {\n    const toolName = this.getString(payload, 'tool_name');\n    if (!toolName) {\n      return null;\n    }\n\n    return {\n      ...payload,\n      tool_name: toolName,\n      tool_args: this.getRecord(payload, 'tool_args') ?? {},\n      iteration: this.getNumber(payload, 'iteration') ?? 0,\n    };\n  }\n\n  private toToolResultEvent(\n    payload: AiRunEvent & Record<string, unknown>,\n  ): AiRunToolResultEvent | null {\n    const toolName = this.getString(payload, 'tool_name');\n    if (!toolName) {\n      return null;\n    }\n\n    return {\n      ...payload,\n      tool_name: toolName,\n      result: this.getRecord(payload, 'result') ?? {},\n      success: this.getBoolean(payload, 'success') ?? false,\n      iteration: this.getNumber(payload, 'iteration') ?? 0,\n    };\n  }\n\n  private toCompletedEvent(\n    payload: AiRunEvent & Record<string, unknown>,\n  ): AiRunCompletedEvent | null {\n    const output = this.getRecord(payload, 'output') ?? {};\n    const normalizedOutput: AiRunCompletedEvent['output'] = {};\n\n    const response = this.getString(output, 'response');\n    if (response) {\n      normalizedOutput.response = response;\n    }\n\n    if (Object.prototype.hasOwnProperty.call(output, 'error')) {\n      const error = output['error'];\n      if (typeof error === 'string' || error === null) {\n        normalizedOutput.error = error as string | null;\n      }\n    }\n\n    if (Object.prototype.hasOwnProperty.call(output, 'blocked')) {\n      const blocked = output['blocked'];\n      if (typeof blocked === 'boolean') {\n        normalizedOutput.blocked = blocked;\n      }\n    }\n\n    if (Object.prototype.hasOwnProperty.call(output, 'raw')) {\n      const raw = output['raw'];\n      if (this.isRecord(raw)) {\n        normalizedOutput.raw = raw as AiRunCompletedEvent['output']['raw'];\n      }\n    }\n\n    return {\n      ...payload,\n      output: normalizedOutput,\n    };\n  }\n\n  private getString(value: Record<string, unknown>, key: string): string | null {\n    const candidate = value[key];\n    return typeof candidate === 'string' && candidate.trim() !== '' ? candidate : null;\n  }\n\n  private getNumber(value: Record<string, unknown>, key: string): number | null {\n    const candidate = value[key];\n    return typeof candidate === 'number' && Number.isFinite(candidate) ? candidate : null;\n  }\n\n  private getBoolean(value: Record<string, unknown>, key: string): boolean | null {\n    const candidate = value[key];\n    return typeof candidate === 'boolean' ? candidate : null;\n  }\n\n  private getRecord(value: Record<string, unknown>, key: string): Record<string, unknown> | null {\n    const candidate = value[key];\n    return this.isRecord(candidate) ? candidate : null;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/ai-usage.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/autopilot-playbook.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":34,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":34,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1422,1433],"text":"params.page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1422,1433],"text":"params.page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1422,1433],"text":"Boolean(params.page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":35,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":35,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1501,1516],"text":"params.per_page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1501,1516],"text":"params.per_page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1501,1516],"text":"Boolean(params.per_page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":80,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":80,"endColumn":33}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Paginated } from '@shared/types/pagination';\nimport type { AutopilotPlaybook, AutopilotPlaybookPayload } from '../models/ai.models';\n\n// Re-export for backwards compatibility\nexport type { AutopilotPlaybook, AutopilotPlaybookPayload } from '../models/ai.models';\n\n/**\n * Serviço para gestão de roteiros (Playbooks) do IA Autopilot.\n *\n * Responsável por realizar operações de CRUD e listagem de playbooks,\n * permitindo a configuração e versionamento de fluxos de inteligência artificial.\n *\n * @class AutopilotPlaybookService\n * @description Service para persistência e recuperação de roteiros de IA.\n */\n@Injectable({ providedIn: 'root' })\nexport class AutopilotPlaybookService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai/playbooks`;\n\n  /**\n   * Obtém uma lista paginada de todos os playbooks cadastrados.\n   * @param params Parâmetros de paginação (página e itens por página).\n   * @returns {Observable<Paginated<AutopilotPlaybook>>} Stream finito com a lista de playbooks.\n   */\n  list(\n    params: { page?: number; per_page?: number } = {},\n  ): Observable<Paginated<AutopilotPlaybook>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n\n    return this.http.get<Paginated<AutopilotPlaybook>>(this.baseUrl, { params: httpParams });\n  }\n\n  /**\n   * Recupera os detalhes completos de um playbook específico via ID.\n   * @param id Identificador único do playbook.\n   * @returns {Observable<AutopilotPlaybook>} Stream finito com os dados do playbook.\n   */\n  get(id: string): Observable<AutopilotPlaybook> {\n    return this.http\n      .get<{ data: AutopilotPlaybook }>(`${this.baseUrl}/${id}`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Cria um novo playbook no sistema.\n   * @param payload Dados iniciais do playbook.\n   * @returns {Observable<AutopilotPlaybook>} Stream finito com o playbook criado.\n   */\n  create(payload: AutopilotPlaybookPayload): Observable<AutopilotPlaybook> {\n    return this.http\n      .post<{ data: AutopilotPlaybook }>(this.baseUrl, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Atualiza os dados ou o fluxo de um playbook existente.\n   * @param id Identificador do playbook a ser atualizado.\n   * @param payload Alterações a serem aplicadas.\n   * @returns {Observable<AutopilotPlaybook>} Stream finito com o playbook atualizado.\n   */\n  update(id: string, payload: AutopilotPlaybookPayload): Observable<AutopilotPlaybook> {\n    return this.http\n      .put<{ data: AutopilotPlaybook }>(`${this.baseUrl}/${id}`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Remove permanentemente um playbook do sistema.\n   * @param id Identificador do playbook.\n   * @returns {Observable<void>} Stream finito indicando sucesso da operação.\n   */\n  delete(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/autopilot-run.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":32,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":32,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1284,1295],"text":"params.page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1284,1295],"text":"params.page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1284,1295],"text":"Boolean(params.page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":33,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":33,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1363,1378],"text":"params.per_page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1363,1378],"text":"params.per_page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1363,1378],"text":"Boolean(params.per_page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Paginated } from '@shared/types/pagination';\nimport type { AutopilotRun, AutopilotRunPayload } from '../models/ai.models';\n\n// Re-export for backwards compatibility\nexport type { AutopilotRun, AutopilotRunPayload } from '../models/ai.models';\n\n/**\n * Serviço para gestão de execuções (Runs) do IA Autopilot.\n *\n * Permite listar históricos de execuções das roteiros e disparar\n * novas simulações ou execuções reais de playbooks.\n *\n * @class AutopilotRunService\n * @description Service para controle e auditoria de corridas do Autopilot.\n */\n@Injectable({ providedIn: 'root' })\nexport class AutopilotRunService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai`;\n\n  /**\n   * Obtém uma lista paginada do histórico de execuções.\n   * @param params Parâmetros de paginação.\n   * @returns {Observable<Paginated<AutopilotRun>>} Stream finito com a lista de runs.\n   */\n  list(params: { page?: number; per_page?: number } = {}): Observable<Paginated<AutopilotRun>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n\n    return this.http.get<Paginated<AutopilotRun>>(`${this.baseUrl}/runs`, { params: httpParams });\n  }\n\n  /**\n   * Recupera os detalhes e resultados de uma execução específica.\n   * @param id Identificador da run.\n   * @returns {Observable<AutopilotRun>} Stream finito com os dados da execução.\n   */\n  get(id: string): Observable<AutopilotRun> {\n    return this.http\n      .get<{ data: AutopilotRun }>(`${this.baseUrl}/runs/${id}`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Dispara a execução de um playbook específico.\n   * @param playbookId Identificador do playbook a ser executado.\n   * @param payload Contexto e dados de entrada para a execução.\n   * @returns {Observable<AutopilotRun>} Stream finito com a run iniciada.\n   */\n  run(playbookId: string, payload: AutopilotRunPayload): Observable<AutopilotRun> {\n    return this.http\n      .post<{ data: AutopilotRun }>(`${this.baseUrl}/playbooks/${playbookId}/runs`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Cancela uma execução em andamento.\n   * @param id Identificador da run.\n   * @returns {Observable<AutopilotRun>} Stream finito com o estado atualizado da run.\n   */\n  cancel(id: string): Observable<AutopilotRun> {\n    return this.http\n      .patch<{ data: AutopilotRun }>(`${this.baseUrl}/runs/${id}/cancel`, {})\n      .pipe(map((resp) => resp.data));\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/simulator/simulator.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":313,"column":12,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":313,"endColumn":22,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[11787,11798],"text":"(event.type == null)"},"