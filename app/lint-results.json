Count":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  output,\n  signal,\n  HostListener,\n} from '@angular/core';\nimport { FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/** Command palette item */\nexport interface AfCommandItem {\n  id: string;\n  label: string;\n  description?: string;\n  icon?: string;\n  group?: string;\n}\n\n/**\n * AfCommandPaletteComponent — Searchable command palette (⌘K / Ctrl+K).\n *\n * @example\n * ```html\n * <af-command-palette [items]=\"commands\" [open]=\"paletteOpen()\" (itemSelected)=\"run($event)\" (closed)=\"close()\" />\n * ```\n */\n@Component({\n  selector: 'af-command-palette',\n  standalone: true,\n  imports: [ReactiveFormsModule, LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    @if (open()) {\n      <div class=\"fixed inset-0 z-50 flex items-start justify-center pt-[15vh]\">\n        <div class=\"fixed inset-0 bg-black/40 backdrop-blur-sm\" (click)=\"closed.emit()\"></div>\n        <div\n          class=\"relative z-10 w-full max-w-lg bg-white dark:bg-neutral-900 rounded-xl\n          border border-neutral-200 dark:border-neutral-700 shadow-2xl overflow-hidden\"\n        >\n          <!-- Search -->\n          <div\n            class=\"flex items-center gap-3 px-4 py-3 border-b border-neutral-200 dark:border-neutral-700\"\n          >\n            <lucide-icon name=\"search\" [size]=\"18\" class=\"text-neutral-400\" />\n            <input\n              type=\"text\"\n              [formControl]=\"searchCtrl\"\n              placeholder=\"Buscar comandos...\"\n              class=\"flex-1 bg-transparent border-0 text-sm text-neutral-900 dark:text-neutral-50\n                placeholder:text-neutral-400 focus:outline-none focus:ring-0\"\n            />\n          </div>\n          <!-- Results -->\n          <div class=\"max-h-72 overflow-y-auto py-1\">\n            @for (item of filteredItems(); track item.id) {\n              <button\n                type=\"button\"\n                class=\"w-full flex items-center gap-3 px-4 py-2.5 text-left\n                  hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors\"\n                (click)=\"selectItem(item)\"\n              >\n                @if (item.icon) {\n                  <lucide-icon [name]=\"item.icon\" [size]=\"16\" class=\"text-neutral-500\" />\n                }\n                <div>\n                  <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-50\">\n                    {{ item.label }}\n                  </p>\n                  @if (item.description) {\n                    <p class=\"text-xs text-neutral-400\">{{ item.description }}</p>\n                  }\n                </div>\n              </button>\n            }\n            @if (filteredItems().length === 0) {\n              <p class=\"px-4 py-6 text-center text-sm text-neutral-400\">Nenhum resultado.</p>\n            }\n          </div>\n        </div>\n      </div>\n    }\n  `,\n})\nexport class AfCommandPaletteComponent {\n  /** Whether palette is open */\n  readonly open = input(false);\n\n  /** Available commands */\n  readonly items = input<AfCommandItem[]>([]);\n\n  /** Emitted when an item is selected */\n  readonly itemSelected = output<string>();\n\n  /** Emitted when palette should close */\n  readonly closed = output<void>();\n\n  protected readonly searchCtrl = new FormControl('', { nonNullable: true });\n\n  protected filteredItems(): AfCommandItem[] {\n    const term = this.searchCtrl.value.toLowerCase();\n    if (!term) return this.items();\n    return this.items().filter(\n      (i) => i.label.toLowerCase().includes(term) || i.description?.toLowerCase().includes(term),\n    );\n  }\n\n  protected selectItem(item: AfCommandItem): void {\n    this.itemSelected.emit(item.id);\n    this.closed.emit();\n    this.searchCtrl.reset();\n  }\n\n  @HostListener('document:keydown', ['$event'])\n  protected onKeydown(event: KeyboardEvent): void {\n    if (event.key === 'Escape' && this.open()) {\n      this.closed.emit();\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/confirm-modal/confirm-modal.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":89,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":89,"endColumn":35},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":92,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":92,"endColumn":35}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output } from '@angular/core';\nimport { AfModalComponent } from '../modal/modal';\nimport { AfButtonComponent } from '../button/button';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * Confirm modal component for AgentFlix UI Kit.\n *\n * @description Pre-built confirmation dialog with icon, message, and action buttons.\n * Supports danger and warning variants for destructive actions.\n *\n * @example\n * ```html\n * <af-confirm-modal\n *   [open]=\"showConfirm\"\n *   title=\"Excluir Contato\"\n *   message=\"Tem certeza que deseja excluir este contato? Esta ação não pode ser desfeita.\"\n *   confirmLabel=\"Excluir\"\n *   variant=\"danger\"\n *   (confirmed)=\"onDelete()\"\n *   (cancelled)=\"showConfirm = false\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-confirm-modal',\n  standalone: true,\n  imports: [AfModalComponent, AfButtonComponent, LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-modal [open]=\"open()\" [title]=\"title()\" size=\"sm\" [showClose]=\"false\" (closed)=\"onCancel()\">\n      <div>\n        <!-- Icon -->\n        <div\n          class=\"mx-auto flex items-center justify-center size-12 rounded-full mb-4\"\n          [class]=\"iconBgClass\"\n        >\n          <lucide-icon [name]=\"iconName()\" [size]=\"24\" class=\"block\" [class]=\"iconColorClass\" />\n        </div>\n\n        <!-- Message -->\n        <p class=\"text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed\">\n          {{ message() }}\n        </p>\n      </div>\n\n      <!-- Footer -->\n      <div\n        footer\n        class=\"flex justify-end gap-3 px-6 py-4 border-t border-neutral-200 dark:border-neutral-700\"\n      >\n        <af-button variant=\"ghost\" size=\"sm\" (click)=\"onCancel()\">\n          {{ cancelLabel() }}\n        </af-button>\n        <af-button\n          [variant]=\"variant() === 'danger' ? 'danger' : 'primary'\"\n          size=\"sm\"\n          (click)=\"onConfirm()\"\n        >\n          {{ confirmLabel() }}\n        </af-button>\n      </div>\n    </af-modal>\n  `,\n})\nexport class AfConfirmModalComponent {\n  /** Whether the confirm modal is open */\n  readonly open = input(false);\n\n  /** Title for the modal header */\n  readonly title = input('Confirmar');\n\n  /** Message body explaining the action */\n  readonly message = input('Tem certeza que deseja realizar esta ação?');\n\n  /** Confirm button label */\n  readonly confirmLabel = input('Confirmar');\n\n  /** Cancel button label */\n  readonly cancelLabel = input('Cancelar');\n\n  /** Visual variant: danger shows red, warning shows yellow */\n  readonly variant = input<'danger' | 'warning' | 'default'>('default');\n\n  /** Lucide icon name */\n  readonly iconName = input<string>('triangle-alert');\n\n  /** Emitted when user confirms */\n  readonly confirmed = output<void>();\n\n  /** Emitted when user cancels */\n  readonly cancelled = output<void>();\n\n  /** Icon background class based on variant */\n  protected get iconBgClass(): string {\n    const map: Record<string, string> = {\n      danger: 'bg-red-100 dark:bg-red-900/30',\n      warning: 'bg-amber-100 dark:bg-amber-900/30',\n      default: 'bg-accent-100 dark:bg-accent-900/30',\n    };\n    return map[this.variant()];\n  }\n\n  /** Icon color class based on variant */\n  protected get iconColorClass(): string {\n    const map: Record<string, string> = {\n      danger: 'text-red-600 dark:text-red-400',\n      warning: 'text-amber-600 dark:text-amber-400',\n      default: 'text-accent-600 dark:text-accent-400',\n    };\n    return map[this.variant()];\n  }\n\n  /** Emit confirm event */\n  protected onConfirm(): void {\n    this.confirmed.emit();\n  }\n\n  /** Emit cancel event */\n  protected onCancel(): void {\n    this.cancelled.emit();\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/container/container.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/copy-input/copy-input.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/countdown/countdown.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":91},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":47,"column":30,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":47,"endColumn":34},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":59,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":59,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1825,1840],"text":"this.intervalId != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1825,1840],"text":"this.intervalId ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1825,1840],"text":"Boolean(this.intervalId)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":69,"column":11,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":69,"endColumn":26,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2095,2110],"text":"this.intervalId != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[2095,2110],"text":"this.intervalId ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2095,2110],"text":"Boolean(this.intervalId)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit, OnDestroy } from '@angular/core';\nimport { Component, ChangeDetectionStrategy, input, output, signal } from '@angular/core';\nimport { DecimalPipe } from '@angular/common';\n\n/**\n * AfCountdownComponent — Countdown timer displaying remaining time.\n *\n * @example\n * ```html\n * <af-countdown [targetDate]=\"promoEnd\" (finished)=\"onExpire()\" />\n * ```\n */\n@Component({\n  selector: 'af-countdown',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"inline-flex items-center gap-1.5\">\n      @for (unit of displayUnits(); track unit.label) {\n        <div class=\"flex flex-col items-center\">\n          <span\n            class=\"text-2xl font-bold tabular-nums text-neutral-900 dark:text-neutral-50\n            bg-neutral-100 dark:bg-neutral-800 rounded-lg px-3 py-2 min-w-[3rem] text-center\"\n          >\n            {{ unit.value | number: '2.0-0' }}\n          </span>\n          <span class=\"text-[10px] uppercase tracking-wider text-neutral-400 mt-1\">{{\n            unit.label\n          }}</span>\n        </div>\n        @if (!$last) {\n          <span class=\"text-xl font-bold text-neutral-400 mt-[-1rem]\">:</span>\n        }\n      }\n    </div>\n  `,\n  imports: [DecimalPipe],\n})\nexport class AfCountdownComponent implements OnInit, OnDestroy {\n  /** Target date string (ISO) */\n  readonly targetDate = input('');\n\n  /** Show days/hours/minutes/seconds */\n  readonly showDays = input(true);\n\n  /** Emitted when countdown reaches zero */\n  readonly finished = output<void>();\n\n  protected readonly displayUnits = signal<{ label: string; value: number }[]>([]);\n\n  private intervalId: ReturnType<typeof setInterval> | null = null;\n\n  ngOnInit(): void {\n    this.tick();\n    this.intervalId = setInterval(() => this.tick(), 1000);\n  }\n\n  ngOnDestroy(): void {\n    if (this.intervalId) clearInterval(this.intervalId);\n  }\n\n  private tick(): void {\n    const target = new Date(this.targetDate()).getTime();\n    const now = Date.now();\n    const diff = Math.max(0, target - now);\n\n    if (diff === 0) {\n      this.finished.emit();\n      if (this.intervalId) clearInterval(this.intervalId);\n    }\n\n    const totalSeconds = Math.floor(diff / 1000);\n    const days = Math.floor(totalSeconds / 86400);\n    const hours = Math.floor((totalSeconds % 86400) / 3600);\n    const minutes = Math.floor((totalSeconds % 3600) / 60);\n    const seconds = totalSeconds % 60;\n\n    const units: { label: string; value: number }[] = [];\n    if (this.showDays()) units.push({ label: 'Dias', value: days });\n    units.push({ label: 'Horas', value: hours });\n    units.push({ label: 'Min', value: minutes });\n    units.push({ label: 'Seg', value: seconds });\n\n    this.displayUnits.set(units);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/crud-page/crud-page.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":163,"column":28,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":163,"endColumn":32},{"ruleId":"@angular-eslint/no-output-native","severity":2,"message":"Output bindings, including aliases, should not be named as standard DOM events","line":166,"column":12,"nodeType":"Identifier","messageId":"noOutputNative","endLine":166,"endColumn":18}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  output,\n  DestroyRef,\n  inject,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { AfPageTitleComponent } from '../page-title/page-title';\nimport { AfSearchInputComponent } from '../search-input/search-input';\nimport { AfEmptyStateComponent } from '../empty-state/empty-state';\nimport { AfPaginationComponent } from '../pagination/pagination';\nimport { AfSkeletonTableRowComponent } from '../skeleton-table-row/skeleton-table-row';\nimport { AfButtonComponent } from '../button/button';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * AfCrudPageComponent — Standard CRUD listing layout that orchestrates\n * a page title, search bar, content slot, pagination, and empty state.\n *\n * @example\n * ```html\n * <af-crud-page\n *   title=\"Contatos\"\n *   subtitle=\"Gerencie seus contatos\"\n *   createLabel=\"Novo Contato\"\n *   [loading]=\"isLoading()\"\n *   [empty]=\"contacts().length === 0\"\n *   [currentPage]=\"meta.current_page\"\n *   [lastPage]=\"meta.last_page\"\n *   [perPage]=\"meta.per_page\"\n *   [total]=\"meta.total\"\n *   (create)=\"openCreateModal()\"\n *   (search)=\"onSearch($event)\"\n *   (pageChange)=\"loadPage($event)\"\n * >\n *   <table class=\"w-full\">...</table>\n * </af-crud-page>\n * ```\n */\n@Component({\n  selector: 'af-crud-page, app-crud-page',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfPageTitleComponent,\n    AfSearchInputComponent,\n    AfEmptyStateComponent,\n    AfPaginationComponent,\n    AfSkeletonTableRowComponent,\n    AfButtonComponent,\n    LucideAngularModule,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"space-y-6\">\n      <!-- Header: Title + Create button -->\n      <af-page-title [title]=\"title()\" [subtitle]=\"subtitle()\">\n        @if (createLabel()) {\n          <af-button variant=\"primary\" size=\"sm\" (click)=\"create.emit()\">\n            <lucide-icon name=\"plus\" [size]=\"16\" class=\"block\" />\n            {{ createLabel() }}\n          </af-button>\n        }\n      </af-page-title>\n\n      <!-- Search bar + optional filter slot -->\n      <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-3\">\n        <div class=\"w-full sm:max-w-xs\">\n          <af-search-input\n            [control]=\"searchControl\"\n            [placeholder]=\"searchPlaceholder()\"\n            size=\"sm\"\n          />\n        </div>\n        <ng-content select=\"[filters]\" />\n      </div>\n\n      <!-- Content area -->\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden\"\n      >\n        @if (loading()) {\n          <af-skeleton-table-row [columns]=\"skeletonColumns()\" [rows]=\"skeletonRows()\" />\n        } @else if (empty()) {\n          <af-empty-state [title]=\"emptyTitle()\" [description]=\"emptyDescription()\" />\n        } @else {\n          <ng-content />\n        }\n      </div>\n\n      <!-- Pagination -->\n      @if (!loading() && !empty() && lastPage() > 1) {\n        <af-pagination\n          [currentPage]=\"currentPage()\"\n          [lastPage]=\"lastPage()\"\n          [perPage]=\"perPage()\"\n          [total]=\"total()\"\n          (pageChange)=\"pageChange.emit($event)\"\n        />\n      }\n    </div>\n  `,\n})\nexport class AfCrudPageComponent {\n  /** Page heading */\n  readonly title = input.required<string>();\n\n  /** Optional subtitle */\n  readonly subtitle = input<string>();\n\n  /** Label for the create button (omit to hide) */\n  readonly createLabel = input<string>();\n\n  /** Search placeholder text */\n  readonly searchPlaceholder = input('Buscar...');\n\n  /** Whether data is currently loading */\n  readonly loading = input(false);\n\n  /** Whether the data set is empty (after loading) */\n  readonly empty = input(false);\n\n  /** Empty-state heading */\n  readonly emptyTitle = input('Nenhum registro encontrado');\n\n  /** Empty-state description */\n  readonly emptyDescription = input('Crie seu primeiro registro para começar.');\n\n  /** Number of skeleton columns */\n  readonly skeletonColumns = input(4);\n\n  /** Number of skeleton rows */\n  readonly skeletonRows = input(5);\n\n  /** Current page (1-indexed) */\n  readonly currentPage = input(1);\n\n  /** Last available page */\n  readonly lastPage = input(1);\n\n  /** Items per page */\n  readonly perPage = input(15);\n\n  /** Total number of records */\n  readonly total = input(0);\n\n  /** Legacy CRUD service input */\n  readonly service = input<unknown>();\n\n  /** Legacy CRUD config input */\n  readonly config = input<unknown>();\n\n  /** Legacy columns input */\n  readonly columns = input<unknown>();\n\n  /** Legacy actions input */\n  readonly actions = input<unknown>();\n\n  /** Emitted when the create button is clicked */\n  readonly create = output<void>();\n\n  /** Emitted when a search term changes */\n  readonly search = output<string>();\n\n  /** Emitted when user navigates to a different page */\n  readonly pageChange = output<number>();\n\n  /** Legacy custom action output */\n  readonly customAction = output<{ action: string; item: unknown }>();\n\n  /** Internal search control */\n  protected readonly searchControl = new FormControl('', { nonNullable: true });\n\n  /** Legacy temporary status control */\n  readonly tempStatusControl = new FormControl<string>('');\n\n  private readonly destroyRef = inject(DestroyRef);\n\n  constructor() {\n    this.searchControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((value) => this.search.emit(value));\n  }\n}\n\nexport const CrudPageComponent = AfCrudPageComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/currency-input/currency-input.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/forms' import is duplicated.","line":11,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":11,"endColumn":86},{"ruleId":"@typescript-eslint/no-empty-functi