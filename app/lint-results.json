<div class=\"size-8 rounded-lg bg-primary-600 flex items-center justify-center\">\n              <span class=\"text-white font-bold text-sm\">A</span>\n            </div>\n            <span class=\"text-neutral-900 dark:text-white font-bold text-lg tracking-tight\"\n              >AgentFlix</span\n            >\n          </div>\n        } @else {\n          <div class=\"size-8 rounded-lg bg-primary-600 flex items-center justify-center mx-auto\">\n            <span class=\"text-white font-bold text-sm\">A</span>\n          </div>\n        }\n      </div>\n\n      <!-- Navigation -->\n      <nav class=\"flex-1 overflow-y-auto py-4 px-3 scrollbar-thin\">\n        @for (item of menuItems; track item.label + item.type) {\n          @if (item.type === 'title') {\n            @if (!theme.sidebarCollapsed()) {\n              <div\n                class=\"px-3 pt-5 pb-2 text-[11px] font-semibold uppercase tracking-widest text-neutral-400 dark:text-white/40\"\n              >\n                {{ item.label }}\n              </div>\n            } @else {\n              <div class=\"my-3 mx-2 h-px bg-neutral-200 dark:bg-white/10\"></div>\n            }\n          }\n\n          @if (item.type === 'item') {\n            <a\n              [routerLink]=\"item.link\"\n              routerLinkActive=\"bg-neutral-200/50 text-primary-700 dark:bg-white/10 dark:text-white font-medium\"\n              [routerLinkActiveOptions]=\"{ exact: item.link === '/dashboard' }\"\n              [class]=\"menuItemClasses()\"\n              [title]=\"theme.sidebarCollapsed() ? item.label : ''\"\n            >\n              @if (item.iconName) {\n                <lucide-icon [name]=\"item.iconName\" [size]=\"16\" class=\"shrink-0\" />\n              }\n              @if (!theme.sidebarCollapsed()) {\n                <span class=\"truncate\">{{ item.label }}</span>\n              }\n            </a>\n          }\n\n          @if (item.type === 'accordion') {\n            <div>\n              <button\n                (click)=\"toggleAccordion(item.label)\"\n                [class]=\"menuItemClasses()\"\n                class=\"w-full\"\n                type=\"button\"\n              >\n                @if (item.iconName) {\n                  <lucide-icon [name]=\"item.iconName\" [size]=\"16\" class=\"shrink-0\" />\n                }\n                @if (!theme.sidebarCollapsed()) {\n                  <span class=\"flex-1 text-left truncate\">{{ item.label }}</span>\n                  <lucide-icon\n                    [name]=\"isAccordionOpen(item.label) ? 'chevron-down' : 'chevron-right'\"\n                    [size]=\"12\"\n                    class=\"shrink-0 text-neutral-400 dark:text-white/40\"\n                  />\n                }\n              </button>\n\n              @if (isAccordionOpen(item.label) && !theme.sidebarCollapsed() && item.children) {\n                <div\n                  class=\"ml-5 pl-3 border-l border-neutral-200 dark:border-white/10 mt-1 space-y-0.5\"\n                >\n                  @for (child of item.children; track child.label) {\n                    <a\n                      [routerLink]=\"child.link\"\n                      routerLinkActive=\"text-primary-700 dark:text-accent-400 font-medium\"\n                      class=\"flex items-center gap-2.5 px-3 py-1.5 text-[13px] text-neutral-500 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white rounded-md transition-colors duration-150\"\n                    >\n                      <span class=\"truncate\">{{ child.label }}</span>\n                    </a>\n                  }\n                </div>\n              }\n            </div>\n          }\n        }\n      </nav>\n    </aside>\n\n    <!-- Mobile Overlay -->\n    @if (theme.mobileSidebarOpen()) {\n      <div class=\"fixed inset-0 z-50 lg:hidden\">\n        <div\n          class=\"absolute inset-0 bg-black/50 backdrop-blur-sm\"\n          (click)=\"theme.closeMobileSidebar()\"\n        ></div>\n        <aside\n          class=\"absolute left-0 top-0 h-full w-72 bg-white dark:bg-neutral-900 border-r border-neutral-200 dark:border-white/10 flex flex-col shadow-xl animate-in slide-in-from-left duration-200\"\n        >\n          <!-- Same content as desktop but always expanded -->\n          <div\n            class=\"flex items-center justify-between h-16 px-4 border-b border-neutral-200 dark:border-white/10\"\n          >\n            <div class=\"flex items-center gap-2.5\">\n              <div class=\"size-8 rounded-lg bg-primary-600 flex items-center justify-center\">\n                <span class=\"text-white font-bold text-sm\">A</span>\n              </div>\n              <span class=\"text-neutral-900 dark:text-white font-bold text-lg tracking-tight\"\n                >AgentFlix</span\n              >\n            </div>\n            <button\n              (click)=\"theme.closeMobileSidebar()\"\n              class=\"text-neutral-500 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white p-1 rounded cursor-pointer\"\n              type=\"button\"\n            >\n              <lucide-icon name=\"x\" [size]=\"20\" />\n            </button>\n          </div>\n\n          <nav class=\"flex-1 overflow-y-auto py-4 px-3\">\n            @for (item of menuItems; track item.label + item.type) {\n              @if (item.type === 'title') {\n                <div\n                  class=\"px-3 pt-5 pb-2 text-[11px] font-semibold uppercase tracking-widest text-neutral-400 dark:text-white/40\"\n                >\n                  {{ item.label }}\n                </div>\n              }\n\n              @if (item.type === 'item') {\n                <a\n                  [routerLink]=\"item.link\"\n                  routerLinkActive=\"bg-neutral-200/50 text-primary-700 dark:bg-white/10 dark:text-white font-medium\"\n                  (click)=\"theme.closeMobileSidebar()\"\n                  class=\"flex items-center gap-3 px-3 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 dark:text-white/70 dark:hover:text-white dark:hover:bg-white/10 rounded-md transition-colors duration-150\"\n                >\n                  @if (item.iconName) {\n                    <lucide-icon [name]=\"item.iconName\" [size]=\"16\" class=\"shrink-0\" />\n                  }\n                  <span class=\"truncate\">{{ item.label }}</span>\n                </a>\n              }\n\n              @if (item.type === 'accordion' && item.children) {\n                <button\n                  (click)=\"toggleAccordion(item.label)\"\n                  class=\"w-full flex items-center gap-3 px-3 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 dark:text-white/70 dark:hover:text-white dark:hover:bg-white/10 rounded-md transition-colors duration-150 cursor-pointer\"\n                  type=\"button\"\n                >\n                  @if (item.iconName) {\n                    <lucide-icon [name]=\"item.iconName\" [size]=\"16\" class=\"shrink-0\" />\n                  }\n                  <span class=\"flex-1 text-left truncate\">{{ item.label }}</span>\n                  <lucide-icon\n                    [name]=\"isAccordionOpen(item.label) ? 'chevron-down' : 'chevron-right'\"\n                    [size]=\"12\"\n                    class=\"shrink-0 text-neutral-400 dark:text-white/40\"\n                  />\n                </button>\n\n                @if (isAccordionOpen(item.label)) {\n                  <div\n                    class=\"ml-5 pl-3 border-l border-neutral-200 dark:border-white/10 mt-1 space-y-0.5\"\n                  >\n                    @for (child of item.children; track child.label) {\n                      <a\n                        [routerLink]=\"child.link\"\n                        routerLinkActive=\"text-primary-700 dark:text-accent-400 font-medium\"\n                        (click)=\"theme.closeMobileSidebar()\"\n                        class=\"flex items-center gap-2.5 px-3 py-1.5 text-[13px] text-neutral-500 hover:text-neutral-900 dark:text-white/60 dark:hover:text-white rounded-md transition-colors duration-150\"\n                      >\n                        <span class=\"truncate\">{{ child.label }}</span>\n                      </a>\n                    }\n                  </div>\n                }\n              }\n            }\n          </nav>\n        </aside>\n      </div>\n    }\n  `,\n})\nexport class SidenavComponent {\n  protected readonly theme = inject(ThemeService);\n  protected readonly menuItems = SIDEBAR_MENU;\n\n  private openAccordions = signal<Set<string>>(new Set());\n\n  protected sidebarClasses(): string {\n    return this.theme.sidebarCollapsed()\n      ? 'w-[68px] bg-white dark:bg-neutral-900 border-r border-neutral-200 dark:border-white/10'\n      : 'w-64 bg-white dark:bg-neutral-900 border-r border-neutral-200 dark:border-white/10';\n  }\n\n  protected menuItemClasses(): string {\n    return [\n      'flex items-center gap-3 px-3 py-2 text-sm',\n      'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 hover:bg-neutral-200/50 dark:hover:text-white dark:hover:bg-white/10',\n      'rounded-md transition-colors duration-150 cursor-pointer',\n    ].join(' ');\n  }\n\n  protected toggleAccordion(label: string): void {\n    this.openAccordions.update((set) => {\n      const next = new Set(set);\n      if (next.has(label)) {\n        next.delete(label);\n      } else {\n        next.add(label);\n      }\n      return next;\n    });\n  }\n\n  protected isAccordionOpen(label: string): boolean {\n    return this.openAccordions().has(label);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/components/topbar/notification-dropdown.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/components/topbar/theme-toggler.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/components/topbar/topbar.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/components/topbar/user-profile.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/main-layout/main-layout.ts","messages":[{"ruleId":"@typescript-eslint/no-extraneous-class","severity":2,"message":"Unexpected empty class.","line":41,"column":14,"nodeType":"Identifier","messageId":"empty","endLine":41,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy } from '@angular/core';\nimport { RouterOutlet } from '@angular/router';\nimport { SidenavComponent } from '../components/sidenav/sidenav';\nimport { TopbarComponent } from '../components/topbar/topbar';\nimport { FooterComponent } from '../components/footer/footer';\n\n/**\n * Main application shell layout.\n * Orchestrates the sidebar, topbar, content area, and footer.\n * All authenticated pages render inside the `<router-outlet>`.\n *\n * @example\n * ```ts\n * // In app.routes.ts:\n * { path: '', component: MainLayoutComponent, children: [...] }\n * ```\n */\n@Component({\n  selector: 'af-main-layout',\n  standalone: true,\n  imports: [RouterOutlet, SidenavComponent, TopbarComponent, FooterComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"flex h-screen overflow-hidden bg-surface-50 dark:bg-neutral-950\">\n      <!-- Sidebar -->\n      <af-sidenav />\n\n      <!-- Main Content Area -->\n      <div class=\"flex-1 flex flex-col min-w-0 overflow-y-auto\">\n        <af-topbar />\n\n        <main class=\"flex-1 px-4 sm:px-6 lg:px-8 py-6\">\n          <router-outlet />\n        </main>\n\n        <af-footer />\n      </div>\n    </div>\n  `,\n})\nexport class MainLayoutComponent {}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/admin/circuit-breaker-status/circuit-breaker-status.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../core/services/queue.service' import is duplicated.","line":28,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":28,"endColumn":69}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n} from '@angular/core';\nimport { DatePipe } from '@angular/common';\nimport { RouterLink } from '@angular/router';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfBadgeComponent,\n  AfButtonComponent,\n  AfCardComponent,\n  AfEmptyStateComponent,\n  AfIconButtonComponent,\n  AfPageTitleComponent,\n} from '@shared/components';\nimport type {\n  CircuitBreakerOverview,\n  CircuitBreakerStatus,\n  CircuitState,\n  CircuitStateChange,\n} from '../../../core/services/queue.service';\nimport { QueueService } from '../../../core/services/queue.service';\n\nconst STATE_LABELS: Record<CircuitState, string> = {\n  CLOSED: 'Fechado',\n  HALF_OPEN: 'Semi-Aberto',\n  OPEN: 'Aberto',\n};\n\n@Component({\n  selector: 'app-circuit-breaker-status',\n  standalone: true,\n  imports: [\n    DatePipe,\n    RouterLink,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfIconButtonComponent,\n    AfCardComponent,\n    AfBadgeComponent,\n    AfButtonComponent,\n    AfEmptyStateComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"space-y-6\">\n      <af-page-title\n        title=\"Circuit Breakers\"\n        subtitle=\"Monitoramento e controle de circuit breakers\"\n      >\n        <a routerLink=\"/admin/queues\" class=\"inline-flex\">\n          <af-icon-button label=\"Voltar\" variant=\"ghost\" size=\"sm\">\n            <lucide-icon name=\"arrow-left\" [size]=\"15\" />\n          </af-icon-button>\n        </a>\n\n        <af-icon-button label=\"Atualizar\" variant=\"outline\" size=\"sm\" (click)=\"refresh()\">\n          <lucide-icon name=\"refresh-cw\" [size]=\"14\" [class.animate-spin]=\"loading()\" />\n        </af-icon-button>\n      </af-page-title>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        <af-card>\n          <div class=\"flex items-center gap-3\">\n            <span\n              class=\"size-10 rounded-lg bg-success/15 text-success flex items-center justify-center\"\n            >\n              <lucide-icon name=\"check-circle\" [size]=\"20\" />\n            </span>\n            <div>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">Fechados</p>\n              <p class=\"text-xl font-semibold text-success\">\n                {{ circuitData()?.totalClosed ?? 0 }}\n              </p>\n            </div>\n          </div>\n        </af-card>\n\n        <af-card>\n          <div class=\"flex items-center gap-3\">\n            <span\n              class=\"size-10 rounded-lg bg-warning/15 text-warning flex items-center justify-center\"\n            >\n              <lucide-icon name=\"alert-triangle\" [size]=\"20\" />\n            </span>\n            <div>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">Semi-Abertos</p>\n              <p class=\"text-xl font-semibold text-warning\">\n                {{ circuitData()?.totalHalfOpen ?? 0 }}\n              </p>\n            </div>\n          </div>\n        </af-card>\n\n        <af-card>\n          <div class=\"flex items-center gap-3\">\n            <span\n              class=\"size-10 rounded-lg bg-danger/15 text-danger flex items-center justify-center\"\n            >\n              <lucide-icon name=\"x-circle\" [size]=\"20\" />\n            </span>\n            <div>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">Abertos</p>\n              <p class=\"text-xl font-semibold text-danger\">{{ circuitData()?.totalOpen ?? 0 }}</p>\n            </div>\n          </div>\n        </af-card>\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n        @if (!loading() && circuits().length === 0) {\n          <div class=\"lg:col-span-2\">\n            <af-empty-state\n              title=\"Nenhum circuit breaker configurado\"\n              description=\"Os circuit breakers aparecerão aqui quando forem configurados\"\n            >\n              <div icon>\n                <lucide-icon name=\"zap\" [size]=\"26\" class=\"text-neutral-400\" />\n              </div>\n            </af-empty-state>\n          </div>\n        } @else {\n          @for (circuit of circuits(); track circuit.name) {\n            <af-card>\n              <div class=\"space-y-4\">\n                <div class=\"flex items-start justify-between gap-3\">\n                  <div class=\"flex items-center gap-3\">\n                    <span\n                      class=\"size-10 rounded-lg flex items-center justify-center\"\n                      [class]=\"stateIconWrapper(circuit.state)\"\n                    >\n                      @switch (circuit.state) {\n                        @case ('CLOSED') {\n                          <lucide-icon name=\"check-circle\" [size]=\"20\" class=\"text-success\" />\n                        }\n                        @case ('HALF_OPEN') {\n                          <lucide-icon name=\"alert-triangle\" [size]=\"20\" class=\"text-warning\" />\n                        }\n                        @case ('OPEN') {\n                          <lucide-icon name=\"x-circle\" [size]=\"20\" class=\"text-danger\" />\n                        }\n                      }\n                    </span>\n                    <div>\n                      <h3 class=\"font-medium text-neutral-900 dark:text-neutral-100\">\n                        {{ circuit.name }}\n                      </h3>\n                      <af-badge [variant]=\"stateVariant(circuit.state)\">{{\n                        getStateLabel(circuit.state)\n                      }}</af-badge>\n                    </div>\n                  </div>\n\n                  <div class=\"flex items-center gap-2\">\n                    @if (circuit.state !== 'CLOSED') {\n                      <af-button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        [disabled]=\"actionLoading() === circuit.name\"\n                        (click)=\"resetCircuit(circuit.name)\"\n                      >\n                        @if (actionLoading() === circuit.name) {\n                          <lucide-icon name=\"loader-2\" [size]=\"14\" class=\"animate-spin\" />\n                        } @else {\n                          <lucide-icon name=\"rotate-ccw\" [size]=\"14\" class=\"block\" />\n                        }\n                        Reset\n                      </af-button>\n                    }\n\n                    @if (circuit.state === 'CLOSED') {\n                      <af-button\n                        variant=\"danger\"\n                        size=\"sm\"\n                        [disabled]=\"actionLoading() === circuit.name\"\n                        (click)=\"openCircuit(circuit.name)\"\n                      >\n                        <lucide-icon name=\"power\" [size]=\"14\" class=\"block\" />\n                        Abrir\n                      </af-button>\n                    }\n                  </div>\n                </div>\n\n                <div class=\"grid grid-cols-2 gap-4\">\n                  <div>\n                    <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">Falhas</p>\n                    <p class=\"text-lg font-semibold text-danger\">{{ circuit.failures }}</p>\n                  </div>\n                  <div>\n                    <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">Sucessos</p>\n                    <p class=\"text-lg font-semibold text-success\">{{ circuit.successes }}</p>\n                  </div>\n                  @if (circuit.lastFailure) {\n                    <div>\n                      <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">Última Falha</p>\n                      <p class=\"text-sm text-neutral-700 dark:text-neutral-300\">\n                        {{ circuit.lastFailure | date: 'dd/MM HH:mm' }}\n                      </p>\n                    </div>\n                  }\n                  @if (circuit.nextRetryAt) {\n                    <div>\n                      <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                        Próxima Tentativa\n                      </p>\n                      <p class=\"text-sm text-neutral-700 dark:text-neutral-300\">\n                        {{ circuit.nextRetryAt | date: 'dd/MM HH:mm' }}\n                      </p>\n                    </div>\n                  }\n                </div>\n\n                @if (circuit.history?.length) {\n                  <div>\n                    <af-button variant=\"ghost\" size=\"sm\" (click)=\"toggleHistory(circuit.name)\">\n                      {{ expandedCircuits().has(circuit.name) ? 'Ocultar' : 'Ver' }} histórico ({{\n                        circuit.history.length\n                      }})\n                    </af-button>\n\n                    @if (expandedCircuits().has(circuit.name)) {\n                      <div class=\"mt-3 space-y-2\">\n                        @for (event of circuit.history.slice(0, 5); track $index) {\n                          <div class=\"flex items-center gap-2 text-sm\">\n                            <span class=\"text-neutral-400\">{{\n                              event.timestamp | date: 'dd/MM HH:mm:ss'\n                            }}</span>\n                            <span class=\"text-neutral-400\">→</span>\n                            <af-badge [variant]=\"stateVariant(event.to)\">{{\n                              getStateLabel(event.to)\n                            }}</af-badge>\n                            @if (event.reason) {\n                              <span\n                                class=\"text-neutral-500 text-xs truncate max-w-80\"\n                                [title]=\"event.reason\"\n                              >\n                                ({{ event.reason }})\n                              </span>\n                            }\n                          </div>\n                        }\n\n                        @if (circuit.history.length > 5) {\n                          <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                            + {{ circuit.history.length - 5 }} eventos anteriores\n                          </p>\n                        }\n                      </div>\n                    }\n                  </div>\n                }\n              </div>\n            </af-card>\n          }\n        }\n      </div>\n    </div>\n  `,\n})\nexport class CircuitBreakerStatusComponent implements OnInit {\n  private readonly queueService = inject(QueueService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly loading = signal(false);\n  readonly actionLoading = signal<string | null>(null);\n  readonly circuitData = signal<CircuitBreakerOverview | null>(null);\n  readonly expandedCircuits = signal(new Set<string>());\n\n  readonly circuits = computed<CircuitBreakerStatus[]>(() => this.circuitData()?.circuits ?? []);\n\n  ngOnInit(): void {\n    this.loadCircuits();\n    this.subscribeToUpdates();\n  }\n\n  refresh(): void {\n    this.loadCircuits();\n  }\n\n  getStateLabel(state: CircuitState): string {\n    return STATE_LABELS[state];\n  }\n\n  stateVariant(state: CircuitState): 'success' | 'warning' | 'danger' {\n    if (state === 'CLOSED') return 'success';\n    if (state === 'HALF_OPEN') return 'warning';\n    return 'danger';\n  }\n\n  stateIconWrapper(state: CircuitState): string {\n    if (state === 'CLOSED') return 'bg-success/15';\n    if (state === 'HALF_OPEN') return 'bg-warning/15';\n    return 'bg-danger/15';\n  }\n\n  resetCircuit(name: string): void {\n    this.actionLoading.set(name);\n    this.queueService\n      .resetCircuitBreaker(name)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.actionLoading.set(null);\n          this.loadCircuits();\n        },\n        error: () => this.actionLoading.set(null),\n      });\n  }\n\n  openCircuit(name: string): void {\n    this.actionLoading.set(name);\n    this.queueService\n      .openCircuitBreaker(name)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.actionLoading.set(null);\n          this.loadCircuits();\n        },\n        error: () => this.actionLoading.set(null),\n      });\n  }\n\n  toggleHistory(name: string): void {\n    this.expandedCircuits.update((set) => {\n      const newSet = new Set(set);\n      if (newSet.has(name)) {\n        newSet.delete(name);\n      } else {\n        newSet.add(name);\n      }\n      return newSet;\n    });\n  }\n\n  private loadCircuits(): void {\n    this.loading.set(true);\n    this.queueService\n      .getCircuitBreakers()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (data) => {\n          this.circuitData.set(data);\n          this.loading.set(false);\n        },\n        error: () => this.loading.set(false),\n      });\n  }\n\n  private subscribeToUpdates(): void {\n    this.queueService\n      .subscribeToCircuitEvents()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((event: CircuitStateChange & { name: string }) => {\n        this.circuitData.update((data) => {\n          if (!data) return data;\n\n          const circuits = data.circuits.map((c) => {\n            if (c.name === event.name) {\n              return {\n                ...c,\n                state: event.to,\n                history: [\n                  {\n                    from: event.from,\n                    to: event.to,\n                    timestamp: event.timestamp,\n                    reason: event.reason,\n                  },\n                  ...c.history,\n                ],\n              };\n            }\n            return c;\n          });\n\n          return {\n            ...data,\n            circuits,\n            totalClosed: circuits.filter((c) => c.state === 'CLOSED').length,\n            totalHalfOpen: circuits.filter((c) => c.state === 'HALF_OPEN').length,\n            totalOpen: circuits.filter((c) => c.state === 'OPEN').length,\n          };\n        });\n      });\n  }\n}\n\nexport default CircuitBreakerStatusComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/admin/dead-letter-queue/dead-letter-queue.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import