Funnel>>,\n    find: (id: string | number) =>\n      this.funnelService.get(id).pipe(\n        map((response) => ({\n          data: response.data.funnel,\n        })),\n      ) as Observable<CrudItemResponse<Funnel>>,\n    create: (data: Partial<Funnel>) =>\n      this.funnelService.create(data as FunnelPayload).pipe(\n        map((response) => ({\n          data: response.data.funnel,\n        })),\n      ) as Observable<CrudItemResponse<Funnel>>,\n    update: (id: string | number, data: Partial<Funnel>) =>\n      this.funnelService.update(id, data as FunnelPayload).pipe(\n        map((response) => ({\n          data: response.data.funnel,\n        })),\n      ) as Observable<CrudItemResponse<Funnel>>,\n    delete: (id: string | number) => this.funnelService.delete(id),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    {\n      field: 'name',\n      label: 'Nome',\n      type: 'text',\n      subField: 'description',\n    },\n    {\n      field: 'steps_count',\n      label: 'Etapas',\n      template: this.stepsCountCell() ?? undefined,\n    },\n    {\n      field: 'is_active',\n      label: 'Status',\n      type: 'status',\n    },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Funil',\n      plural: 'Funis',\n      createButton: 'Novo funil',\n      modalCreate: 'Novo funil',\n      modalEdit: 'Editar funil',\n    },\n    subtitle: 'CRM',\n    searchPlaceholder: 'Buscar funis...',\n    emptyState: {\n      icon: 'lucideGitBranchPlus',\n      title: 'Nenhum funil encontrado',\n      description: 'Comece adicionando seu primeiro funil de vendas.',\n    },\n    enableSelection: true,\n    enableSearch: true,\n    enableFilters: true,\n    e