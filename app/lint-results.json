ex;\n  }\n\n  protected onDragOver(event: DragEvent, index: number): void {\n    event.preventDefault();\n  }\n\n  protected onDrop(index: number): void {\n    if (this.dragIndex === index) return;\n    const copy = [...this.items()];\n    const [moved] = copy.splice(this.dragIndex, 1);\n    copy.splice(index, 0, moved);\n    this.reordered.emit(copy);\n    this.dragIndex = -1;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/spinner/spinner.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/split-pane/split-pane.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/stack/stack.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/stat-card/stat-card.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/status-badge/status-badge.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/stepper/stepper.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'computed' is defined but never 