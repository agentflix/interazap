tions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[25786,25795],"text":"calledId == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[25787,25795],"text":"(calledId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[25786,25795],"text":"!Boolean(calledId)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":23,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { AfterViewInit, OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  ElementRef,\n  ViewChild,\n  computed,\n  inject,\n  signal,\n  Output,\n  EventEmitter,\n  effect,\n} from '@angular/core';\nimport { ActivatedRoute } from '@angular/router';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormControl } from '@angular/forms';\nimport { fromEvent } from 'rxjs';\nimport { SimplebarAngularModule } from 'simplebar-angular';\nimport { NgIcon, provideIcons } from '@ng-icons/core';\nimport {\n  lucideMessagesSquare,\n  lucideCheck,\n  lucideCheckCheck,\n  lucideAlertCircle,\n  lucideClock,\n  lucideSmile,\n  lucidePencil,\n  lucideTrash2,\n  lucideReply,\n  lucideMoreVertical,\n  lucideX,\n  lucideChevronDown,\n  lucideUser,\n  lucideMapPin,\n} from '@ng-icons/lucide';\nimport { CalledService } from 'src/app/core/services/called.service';\nimport type { CalledMessage, PaginationMeta } from 'src/app/core/services/called-message.service';\nimport { CalledMessageService } from 'src/app/core/services/called-message.service';\nimport { AuthStoreService } from 'src/app/core/services/auth-store.service';\nimport { ChatStartService } from 'src/app/core/services/chat-start.service';\nimport type {\n  ChatTypingEvent,\n  ChatMessageStatusEvent,\n  ChatMessageDeleteEvent,\n} from 'src/app/core/services/chat-realtime.service';\nimport { ChatRealtimeService } from 'src/app/core/services/chat-realtime.service';\nimport { ButtonComponent } from 'src/app/shared/components/buttons';\nimport { TextareaInputComponent } from 'src/app/shared/components/inputs';\n\nimport { ChatMessageMediaComponent } from '../chat-message-media/chat-message-media.component';\nimport { ChatQuotedMessageComponent } from '../chat-quoted-message/chat-quoted-message.component';\n\n/**\n * Componente principal da visualização de mensagens do chat.\n *\n * Responsável por renderizar o histórico de mensagens, gerenciar a paginação (scroll infinito),\n * exibir indicadores de digitação e disparar notificações em tempo real através de WebSockets.\n *\n * @class UserChat\n * @description Área central de troca de mensagens entre atendente e contato.\n */\n@Component({\n  selector: 'app-user-chat',\n  standalone: true,\n  imports: [\n    SimplebarAngularModule,\n    NgIcon,\n    ChatMessageMediaComponent,\n    ChatQuotedMessageComponent,\n    ButtonComponent,\n    TextareaInputComponent,\n  ],\n  templateUrl: './user-chat.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  host: {\n    class: 'block h-full',\n  },\n  viewProviders: [\n    provideIcons({\n      lucideMessagesSquare,\n      lucideCheck,\n      lucideCheckCheck,\n      lucideAlertCircle,\n      lucideClock,\n      lucideSmile,\n      lucidePencil,\n      lucideTrash2,\n      lucideReply,\n      lucideMoreVertical,\n      lucideX,\n      lucideChevronDown,\n      lucideUser,\n      lucideMapPin,\n    }),\n  ],\n  styles: [\n    `\n      :host ::ng-deep .simplebar-content {\n        height: 100%;\n      }\n    `,\n  ],\n})\nexport class UserChat implements AfterViewInit, OnInit {\n  private readonly messageService = inject(CalledMessageService);\n  private readonly calledService = inject(CalledService);\n  private readonly route = inject(ActivatedRoute);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly authStore = inject(AuthStoreService);\n  private readonly chatStart = inject(ChatStartService);\n  private readonly realtime = inject(ChatRealtimeService);\n\n  /**\n   * Referência ao elemento de container de mensagens para controle de scroll.\n   * @private\n   */\n  @ViewChild('scrollContainer', { read: ElementRef })\n  private readonly scrollContainer?: ElementRef<HTMLElement>;\n\n  /**\n   * Identificador do atendimento (chamado) atual.\n   * @type {WritableSignal<string | null>}\n   */\n  readonly calledId = signal<string | null>(null);\n\n  /**\n   * Lista de mensagens carregadas para o atendimento atual.\n   * @type {WritableSignal<CalledMessage[]>}\n   */\n  readonly messages = signal<CalledMessage[]>([]);\n\n  /**\n   * Indica se o carregamento inicial das mensagens está em curso.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly isLoading = signal(false);\n\n  /**\n   * Indica se o carregamento de mais páginas de histórico está em curso.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly isLoadingMore = signal(false);\n\n  /**\n   * Limite de mensagens por página no carregamento inicial.\n   * @type {WritableSignal<number>}\n   */\n  readonly limit = signal(30);\n\n  /**\n   * Página atual do histórico de mensagens sendo visualizada.\n   * @type {WritableSignal<number>}\n   */\n  readonly page = signal(1);\n\n  /**\n   * Indica se existem mais mensagens disponíveis no histórico para carregar.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly hasMore = signal(true);\n\n  /**\n   * Metadados da paginação retornados pelo servidor.\n   * @type {WritableSignal<PaginationMeta | null>}\n   */\n  readonly pagination = signal<PaginationMeta | null>(null);\n\n  /**\n   * Dados do usuário autenticado no sistema.\n   * @type {Signal<User | null>}\n   */\n  readonly currentUser = this.authStore.user;\n\n  /**\n   * Indica se o contato está digitando no momento.\n   * @type {WritableSignal<ChatTypingEvent | null>}\n   */\n  readonly contactTyping = signal<ChatTypingEvent | null>(null);\n\n  /**\n   * Evento disparado ao clicar em responder.\n   */\n  @Output() reply = new EventEmitter<CalledMessage>();\n\n  /**\n   * Disparar evento de resposta.\n   * @param message Mensagem a ser respondida.\n   */\n  onReply(message: CalledMessage): void {\n    this.openMenuId.set(null);\n    this.reply.emit(message);\n  }\n\n  /**\n   * Verifica se existem mensagens na conversa atual.\n   * @type {Signal<boolean>}\n   */\n  readonly hasMessages = computed(() => this.messages().length > 0);\n\n  /**\n   * Flag para habilitar visualização de conteúdo excluído (supervisor).\n   */\n  readonly isSupervisor = computed(() => this.authStore.user()?.is_supervisor ?? false);\n\n  /**\n   * Elemento HTML responsável pelo scroll (pode ser o host ou um wrapper do Simplebar).\n   * @private\n   */\n  private scrollElement: HTMLElement | null = null;\n\n  /**\n   * Indica que o scroll deve ser movido para o final após o próximo carregamento ou alteração de view.\n   * @private\n   */\n  private pendingScrollToBottom = false;\n\n  /**\n   * Construtor do componente.\n   * Monitora a alteração de parâmetros da rota para carregar o histórico\n   * de atendimentos e gerenciar salas de WebSocket.\n   * Configura os effects para eventos realtime.\n   */\n  constructor() {\n    this.route.paramMap.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((params) => {\n      const prevId = this.calledId();\n      const id = params.get('calledId');\n\n      // Leave previous ticket room\n      if (prevId) {\n        this.realtime.leaveTicket(prevId);\n      }\n\n      this.calledId.set(id);\n      this.resetState();\n\n      if (id) {\n        this.loadMessages(true);\n        this.realtime.joinTicket(id);\n        // Mark as read immediately when opening/changing to a ticket\n        this.calledService.markAsRead(id).subscribe({ error: () => {} });\n      }\n    });\n\n    // Effect para atualização de status de mensagens\n    effect(() => {\n      const { event, version } = this.realtime.messageStatus();\n      if (event && version > 0) {\n        this.updateMessageStatus(event);\n      }\n    });\n\n    // Effect para novas mensagens\n    effect(() => {\n      const { event, version } = this.realtime.newMessage();\n      if (event && version > 0) {\n        const currentId = this.calledId();\n        if (currentId && event.ticket_id === currentId) {\n          const exists = this.messages().some((m) => m.id === event.message.id);\n          if (!exists) {\n            this.appendMessage(event.message as CalledMessage);\n          }\n        }\n      }\n    });\n\n    // Effect para indicadores de digitação\n    effect(() => {\n      const { event, version } = this.realtime.typing();\n      if (event && version > 0) {\n        const currentId = this.calledId();\n        if (currentId && event.ticket_id === currentId && event.contact_id) {\n          this.contactTyping.set(event.is_typing ? event : null);\n        }\n      }\n    });\n\n    // Effect para eventos de exclusão\n    effect(() => {\n      const { event, version } = this.realtime.delete();\n      if (event && version > 0) {\n        const currentId = this.calledId();\n        if (currentId && event.ticket_id === currentId) {\n          this.markMessageDeleted(event);\n        }\n      }\n    });\n  }\n\n  /**\n   * Inicializar as conexões de tempo real.\n   */\n  ngOnInit(): void {\n    // Connect realtime with tenant\n    const user = this.authStore.user();\n    if (user?.tenant_id) {\n      this.realtime.connect(String(user.tenant_id));\n    }\n  }\n\n  /**\n   * Configurar a detecção de scroll no container de mensagens para disparar o carregamento infinito.\n   */\n  ngAfterViewInit(): void {\n    queueMicrotask(() => {\n      this.scrollElement = this.findScrollElement();\n      if (!this.scrollElement) return;\n      fromEvent(this.scrollElement, 'scroll')\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe(() => this.handleScroll());\n      if (this.pendingScrollToBottom && this.hasMessages()) {\n        this.scrollToBottom();\n        this.pendingScrollToBottom = false;\n      }\n    });\n  }\n\n  /**\n   * Resetar o estado da conversa ao carregar um novo atendimento.\n   * @private\n   */\n  private resetState(): void {\n    this.messages.set([]);\n    this.page.set(1);\n    this.hasMore.set(true);\n    this.pagination.set(null);\n    this.isLoading.set(false);\n    this.isLoadingMore.set(false);\n    this.pendingScrollToBottom = true;\n  }\n\n  /**\n   * Lidar com o evento de scroll do container.\n   * Dispara o carregamento de páginas anteriores quando o usuário atinge o topo.\n   * @private\n   */\n  private handleScroll(): void {\n    if (!this.scrollElement || this.isLoading() || this.isLoadingMore() || !this.hasMore()) {\n      return;\n    }\n    if (this.scrollElement.scrollTop <= 40) {\n      this.loadMore();\n    }\n  }\n\n  /**\n   * Buscar mensagens do histórico através da API.\n   * Implementa lógica para manter a posição do scroll quando carregando páginas anteriores.\n   *\n   * @param scrollToBottom Define se o scroll deve ser forçado para o final após o carregamento.\n   * @param previousHeight Altura do container antes do novo carregamento.\n   * @param previousScrollTop Posição do scroll antes do novo carregamento.\n   * @private\n   */\n  private loadMessages(\n    scrollToBottom = false,\n    previousHeight?: number,\n    previousScrollTop?: number,\n  ): void {\n    const calledId = this.calledId();\n    if (!calledId) return;\n\n    if (!this.isLoadingMore()) {\n      this.isLoading.set(true);\n    }\n\n    this.messageService\n      .list(calledId, this.page())\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const payload = response?.data;\n          const incomingMessages = payload?.messages ?? [];\n          const currentMessages = this.messages();\n          const merged = this.mergeAndSort(currentMessages, incomingMessages);\n\n          this.messages.set(merged);\n\n          if (this.page() === 1) {\n            if (scrollToBottom || this.pendingScrollToBottom) {\n              if (this.scrollElement) {\n                this.scrollToBottom();\n                this.pendingScrollToBottom = false;\n              } else {\n                this.pendingScrollToBottom = true;\n              }\n            }\n          } else {\n            // Restore scroll position when loading previous pages\n            if (previousHeight !== undefined && previousScrollTop !== undefined) {\n              this.restoreScrollPosition(previousHeight, previousScrollTop);\n            }\n          }\n\n          const meta = payload?.meta ?? null;\n          this.pagination.set(meta);\n          this.hasMore.set(meta ? Boolean(meta.has_more) : incomingMessages.length >= this.limit());\n          this.isLoading.set(false);\n          this.isLoadingMore.set(false);\n        },\n        error: () => {\n          if (this.isLoadingMore()) {\n            this.page.update((p) => Math.max(1, p - 1));\n          }\n          this.isLoading.set(false);\n          this.isLoadingMore.set(false);\n        },\n      });\n  }\n\n  /**\n   * Processar o carregamento da próxima página (mais antiga) do histórico de mensagens.\n   * @private\n   */\n  private loadMore(): void {\n    if (!this.scrollElement || !this.hasMore() || this.isLoadingMore()) return;\n    const previousHeight = this.scrollElement.scrollHeight;\n    const previousScrollTop = this.scrollElement.scrollTop;\n    this.isLoadingMore.set(true);\n    this.page.update((p) => p + 1);\n    this.loadMessages(false, previousHeight, previousScrollTop);\n  }\n\n  /**\n   * Rolar visualmente o container de mensagens para o final.\n   * @private\n   */\n  private scrollToBottom(): void {\n    if (!this.scrollElement) {\n      this.pendingScrollToBottom = true;\n      return;\n    }\n    requestAnimationFrame(() => {\n      requestAnimationFrame(() => {\n        // Must re-check because element might be gone or detached\n        if (this.scrollElement) {\n          this.scrollElement.scrollTop = this.scrollElement.scrollHeight;\n        }\n      });\n    });\n  }\n\n  /**\n   * Forçar o scroll para o final, ignorando o estado atual de rolagem.\n   */\n  scrollToBottomForce(): void {\n    queueMicrotask(() => this.scrollToBottom());\n  }\n\n  /**\n   * Restaurar a posição do scroll após a adição de novas mensagens ao topo do container.\n   *\n   * @param previousHeight Altura original do container.\n   * @param previousScrollTop Posição original do scroll.\n   * @private\n   */\n  private restoreScrollPosition(previousHeight: number, previousScrollTop: number): void {\n    if (!this.scrollElement) return;\n    requestAnimationFrame(() => {\n      if (!this.scrollElement) return;\n      const newHeight = this.scrollElement.scrollHeight;\n      const diff = newHeight - previousHeight;\n      // If content was added to the top, diff should be positive.\n      // We want to stay at the \"same\" visual relative point.\n      this.scrollElement.scrollTop = previousScrollTop + diff;\n    });\n  }\n\n  /**\n   * Mesclar dois conjuntos de mensagens, eliminando duplicatas e ordenando cronologicamente.\n   *\n   * @param current Lista atual de mensagens em memória.\n   * @param incoming Novas mensagens recebidas do servidor.\n   * @returns Lista mesclada e ordenada.\n   * @private\n   */\n  private mergeAndSort(current: CalledMessage[], incoming: CalledMessage[]): CalledMessage[] {\n    const map = new Map<string | number, CalledMessage>();\n\n    // Add current messages to map\n    current.forEach((msg) => map.set(msg.id, msg));\n\n    // Add incoming messages (overwriting or ignoring duplicates?\n    // overwrite usually safer for updates, but for pagination ignore is fine.\n    // Let's overwrite to be sure we have latest data)\n    incoming.forEach((msg) => map.set(msg.id, msg));\n\n    const uniqueMessages = Array.from(map.values());\n\n    return uniqueMessages.sort((a, b) => this.toTimestamp(a) - this.toTimestamp(b));\n  }\n\n  /**\n   * Converter as propriedades de data da mensagem para um timestamp numérico comparável.\n   *\n   * @param message Objeto da mensagem.\n   * @returns Timestamp da mensagem.\n   * @private\n   */\n  private toTimestamp(message: CalledMessage): number {\n    const rawValue =\n      message.created_at ?? message.sent_at ?? message.delivered_at ?? message.read_at;\n    if (!rawValue) return 0;\n    const timestamp = new Date(rawValue).getTime();\n    return Number.isNaN(timestamp) ? 0 : timestamp;\n  }\n\n  /**\n   * Localizar o elemento DOM correto para gerenciar o scroll (compatível com Simplebar).\n   * @returns O elementoHTMLElement responsável pelo scroll.\n   * @private\n   */\n  private findScrollElement(): HTMLElement | null {\n    const host = this.scrollContainer?.nativeElement;\n    if (!host) return null;\n    return (host.querySelector('.simplebar-content-wrapper') as HTMLElement) ?? host;\n  }\n\n  /**\n   * Verificar se a mensagem é do tipo entrada (recebida do contato).\n   * @param message Objeto da mensagem.\n   * @returns {boolean}\n   */\n  isIncoming(message: CalledMessage): boolean {\n    return message.direction === 'incoming';\n  }\n\n  /**\n   * Adicionar uma nova mensagem ao conjunto atual e rolar para o final se apropriado.\n   * @param message Mensagem a ser adicionada.\n   */\n  appendMessage(message: CalledMessage): void {\n    // Determine if we should scroll to bottom (user is already at bottom)\n    const isAtBottom = this.isUserAtBottom();\n\n    // Merge and sort\n    const current = this.messages();\n    const merged = this.mergeAndSort(current, [message]);\n    this.messages.set(merged);\n\n    if (isAtBottom || !this.hasMessages()) {\n      this.scrollToBottom();\n    }\n  }\n\n  /**\n   * Substituir uma mensagem temporária (otimista) pelo objeto real retornado pelo servidor.\n   *\n   * @param tempId Identificador temporário da mensagem.\n   * @param message Objeto completo da mensagem final.\n   */\n  replaceMessage(tempId: string | number, message: CalledMessage): void {\n    const current = this.messages();\n    // Check if we are just replacing an ID or full object\n    // Filter out the tempId one if it's different from message.id\n    let filtered = current;\n    if (String(tempId) !== String(message.id)) {\n      filtered = current.filter((m) => String(m.id) !== String(tempId));\n    }\n\n    const merged = this.mergeAndSort(filtered, [message]);\n    this.messages.set(merged);\n\n    // Usually replacing a temp message with real one happens at the bottom\n    this.scrollToBottom();\n  }\n\n  /**\n   * Verificar se o usuário está visualizando o final da conversa.\n   * @returns {boolean} True se o scroll estiver próximo ao final.\n   * @private\n   */\n  private isUserAtBottom(): boolean {\n    if (!this.scrollElement) return true;\n    const threshold = 100; // pixels from bottom\n    const position = this.scrollElement.scrollTop + this.scrollElement.clientHeight;\n    const height = this.scrollElement.scrollHeight;\n    return height - position <= threshold;\n  }\n\n  /**\n   * Atualiza o status de uma mensagem existente na lista local.\n   * Procura a mensagem por ID interno ou ID externo e aplica os novos timestamps de status.\n   * @param event Dados do evento de alteração de status da mensagem.\n   * @private\n   */\n  private updateMessageStatus(event: ChatMessageStatusEvent): void {\n    const updated = this.messages().map((msg) => {\n      // Verifica por message_id (eventos do Laravel) ou external_id (eventos do Gateway)\n      const matchById = event.message_id && String(msg.id) === event.message_id;\n      const matchByExternalId =\n        event.external_id && msg.external_id && String(msg.external_id) === event.external_id;\n\n      if (matchById || matchByExternalId) {\n        return {\n          ...msg,\n          status: event.status,\n          sent_at: event.sent_at ?? msg.sent_at,\n          delivered_at: event.delivered_at ?? msg.delivered_at,\n          read_at: event.read_at ?? msg.read_at,\n        };\n      }\n      return msg;\n    });\n    this.messages.set(updated);\n  }\n\n  /**\n   * Marca uma mensagem como excluída mantendo o conteúdo original.\n   * @param event Evento de exclusão em tempo real.\n   */\n  private markMessageDeleted(event: ChatMessageDeleteEvent): void {\n    const updated = this.messages().map((msg) => {\n      if (String(msg.id) === String(event.message_id)) {\n        return {\n          ...msg,\n          status: 'deleted',\n          is_deleted: true,\n          deleted_at: event.deleted_at ?? msg.deleted_at ?? new Date().toISOString(),\n          deleted_by: event.deleted_by ?? msg.deleted_by ?? 'remote',\n        };\n      }\n      return msg;\n    });\n    this.messages.set(updated);\n  }\n\n  /**\n   * Obter o nome do ícone correspondente ao status de entrega da mensagem.\n   *\n   * @param message Mensagem para verificação.\n   * @returns Nome do ícone Lucide.\n   */\n  getStatusIcon(message: CalledMessage): string {\n    if (message.direction === 'incoming') return '';\n    switch (message.status) {\n      case 'pending':\n        return 'lucideClock';\n      case 'sent':\n        return 'lucideCheck';\n      case 'delivered':\n        return 'lucideCheckCheck';\n      case 'read':\n        return 'lucideCheckCheck';\n      case 'deleted':\n        return 'lucideAlertCircle';\n      case 'failed':\n        return 'lucideAlertCircle';\n      default:\n        return 'lucideClock';\n    }\n  }\n\n  /**\n   * Obter as classes CSS de cor para o ícone de status da mensagem.\n   *\n   * @param message Mensagem para verificação.\n   * @returns String de classes CSS (Tailwind).\n   */\n  getStatusClass(message: CalledMessage): string {\n    if (message.direction === 'incoming') return '';\n    switch (message.status) {\n      case 'pending':\n        return 'text-default-400';\n      case 'sent':\n        return 'text-default-500';\n      case 'delivered':\n        return 'text-primary';\n      case 'read':\n        return 'text-success';\n      case 'deleted':\n        return 'text-default-400';\n      case 'failed':\n        return 'text-danger';\n      default:\n        return 'text-default-400';\n    }\n  }\n\n  /**\n   * Extrair iniciais do nome do usuário atual para exibição no avatar.\n   * @returns {string} Iniciais formatadas em maiúsculas.\n   */\n  getUserInitials(): string {\n    const name = this.currentUser()?.name ?? '';\n    const parts = name.trim().split(' ').filter(Boolean);\n    if (parts.length === 0) return 'EU';\n    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n    return `${parts[0][0]}${parts[1][0]}`.toUpperCase();\n  }\n\n  /**\n   * Formatar uma string de data para exibição de hora local (hh:mm).\n   * @param value String de data ISO or legível.\n   * @returns Hora formatada em pt-BR.\n   */\n  formatTime(value?: string | null): string {\n    if (!value) return '';\n    const date = new Date(value);\n    if (Number.isNaN(date.getTime())) return '';\n    return date.toLocaleTimeString('pt-BR', {\n      hour: '2-digit',\n      minute: '2-digit',\n    });\n  }\n\n  /**\n   * Estado de edição de mensagem.\n   * @type {WritableSignal<string | null>}\n   */\n  readonly editingMessageId = signal<string | null>(null);\n\n  /** Controle do conteúdo de edição de mensagem */\n  readonly editMessageControl = new FormControl<string>('', { nonNullable: true });\n\n  /**\n   * ID da mensagem que está com o popover de reações aberto.\n   * @type {WritableSignal<string | null>}\n   */\n  readonly openReactionsId = signal<string | null>(null);\n\n  /**\n   * ID da mensagem que está com o menu de ações aberto.\n   * @type {WritableSignal<string | null>}\n   */\n  readonly openMenuId = signal<string | null>(null);\n\n  /**\n   * Lista de emojis comuns para reação rápida.\n   */\n  readonly reactionEmojis = ['👍', '❤️', '😂', '😮', '😢', '😡', '🙏', '✅'];\n\n  /**\n   * Solicitar a abertura do diálogo de criação de novo chat.\n   */\n  openStartChat(): void {\n    this.chatStart.open();\n  }\n\n  callPhone(phone?: string | null): void {\n    if (!phone) return;\n    window.location.href = `tel:${phone}`;\n  }\n\n  /**\n   * Alternar visualização do seletor de emojis para uma mensagem.\n   * @param messageId ID da mensagem.\n   */\n  toggleReactions(messageId: string | number): void {\n    const current = this.openReactionsId();\n    this.openReactionsId.set(current === String(messageId) ? null : String(messageId));\n    this.openMenuId.set(null); // Close menu when opening reactions\n  }\n\n  /**\n   * Alternar visualização do menu de ações de uma mensagem.\n   * @param messageId ID da mensagem.\n   */\n  toggleMessageMenu(messageId: string | number): void {\n    const current = this.openMenuId();\n    this.openMenuId.set(current === String(messageId) ? null : String(messageId));\n    this.openReactionsId.set(null); // Close reactions when opening menu\n  }\n\n  /**\n   * Fechar o menu de ações aberto.\n   */\n  closeMessageMenu(): void {\n    this.openMenuId.set(null);\n  }\n\n  /**\n   * Enviar uma reação para a mensagem.\n   * @param messageId ID da mensagem.\n   * @param emoji Emoji selecionado.\n   */\n  reactToMessage(messageId: string | number, emoji: string): void {\n    const calledId = this.calledId();\n    if (!calledId) return;\n\n    this.openReactionsId.set(null); // Fechar popover\n\n    // Otimistic update (opcional, mas recomendado)\n    // Vamos deixar o realtime atualizar por enquanto para simplificar o estado\n\n    this.messageService.react(calledId, String(messageId), emoji).subscribe({\n      error: () => {\n        // Reverter se falhar (implementar se fizer update otimista)\n      },\n    });\n  }\n\n  /**\n   * Iniciar edição de uma mensagem.\n   * @param message Mensagem a ser editada.\n   */\n  startEditing(message: CalledMessage): void {\n    if (message.type !== 'text') return; // Apenas texto por enquanto\n    this.openMenuId.set(null);\n    this.editingMessageId.set(String(message.id));\n    this.editMessageControl.setValue(message.content ?? '', { emitEvent: false });\n  }\n\n  /**\n   * Cancelar edição.\n   */\n  cancelEditing(): void {\n    this.editingMessageId.set(null);\n    this.editMessageControl.setValue('', { emitEvent: false });\n  }\n\n  /**\n   * Salvar edição da mensagem.\n   * @param messageId ID da mensagem.\n   * @param newContent Novo conteúdo.\n   */\n  saveEdit(messageId: string | number): void {\n    const calledId = this.calledId();\n    const newContent = this.editMessageControl.value;\n    if (!calledId || !newContent.trim()) return;\n\n    this.messageService.edit(calledId, String(messageId), newContent).subscribe({\n      next: () => {\n        this.editingMessageId.set(null);\n        this.editMessageControl.setValue('', { emitEvent: false });\n      },\n      error: () => {\n        // Tratamento de erro\n      },\n    });\n  }\n\n  /**\n   * Excluir uma mensagem.\n   * @param messageId ID da mensagem.\n   */\n  deleteMessage(messageId: string | number): void {\n    const calledId = this.calledId();\n    if (!calledId) return;\n\n    this.openMenuId.set(null);\n\n    if (!confirm('Tem certeza que deseja excluir esta mensagem para todos?')) return;\n\n    this.messageService.delete(calledId, String(messageId)).subscribe({\n      error: () => {\n        alert('Erro ao excluir mensagem');\n      },\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/integration/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/integration/comp