\n@Injectable({ providedIn: 'root' })\nexport class AutopilotService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai`;\n\n  // Playbooks\n  listPlaybooks(\n    params: { page?: number; per_page?: number } = {},\n  ): Observable<Paginated<AutopilotPlaybook>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    return this.http.get<Paginated<AutopilotPlaybook>>(`${this.baseUrl}/playbooks`, {\n      params: httpParams,\n    });\n  }\n\n  getPlaybook(id: string): Observable<AutopilotPlaybook> {\n    return this.http\n      .get<{ data: AutopilotPlaybook }>(`${this.baseUrl}/playbooks/${id}`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  createPlaybook(payload: AutopilotPlaybookPayload): Observable<AutopilotPlaybook> {\n    return this.http\n      .post<{ data: AutopilotPlaybook }>(`${this.baseUrl}/playbooks`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  updatePlaybook(\n    id: string,\n    payload: Partial<AutopilotPlaybookPayload>,\n  ): Observable<AutopilotPlaybook> {\n    return this.http\n      .put<{ data: AutopilotPlaybook }>(`${this.baseUrl}/playbooks/${id}`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  deletePlaybook(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/playbooks/${id}`);\n  }\n\n  publishPlaybook(id: string): Observable<{ data: AutopilotPlaybook }> {\n    return this.http.post<{ data: AutopilotPlaybook }>(\n      `${this.baseUrl}/playbooks/${id}/publish`,\n      {},\n    );\n  }\n\n  getPlaybookVersions(id: string): Observable<{ data: AutopilotPlaybook[] }> {\n    return this.http.get<{ data: AutopilotPlaybook[] }>(`${this.baseUrl}/playbooks/${id}/versions`);\n  }\n\n  // Tools\n  listTools(\n    params: { page?: number; per_page?: number } = {},\n  ): Observable<Paginated<AutopilotTool>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    return this.http.get<Paginated<AutopilotTool>>(`${this.baseUrl}/tools`, { params: httpParams });\n  }\n\n  getTool(id: string): Observable<AutopilotTool> {\n    return this.http\n      .get<{ data: AutopilotTool }>(`${this.baseUrl}/tools/${id}`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  createTool(payload: AutopilotToolPayload): Observable<AutopilotTool> {\n    return this.http\n      .post<{ data: AutopilotTool }>(`${this.baseUrl}/tools`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  updateTool(id: string, payload: Partial<AutopilotToolPayload>): Observable<AutopilotTool> {\n    return this.http\n      .put<{ data: AutopilotTool }>(`${this.baseUrl}/tools/${id}`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  deleteTool(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/tools/${id}`);\n  }\n\n  // Guardrails\n  listGuardrails(\n    params: { page?: number; per_page?: number } = {},\n  ): Observable<Paginated<AutopilotGuardrail>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    return this.http.get<Paginated<AutopilotGuardrail>>(`${this.baseUrl}/guardrails`, {\n      params: httpParams,\n    });\n  }\n\n  getGuardrail(id: string): Observable<AutopilotGuardrail> {\n    return this.http\n      .get<{ data: AutopilotGuardrail }>(`${this.baseUrl}/guardrails/${id}`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  createGuardrail(payload: AutopilotGuardrailPayload): Observable<AutopilotGuardrail> {\n    return this.http\n      .post<{ data: AutopilotGuardrail }>(`${this.baseUrl}/guardrails`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  updateGuardrail(\n    id: string,\n    payload: Partial<AutopilotGuardrailPayload>,\n  ): Observable<AutopilotGuardrail> {\n    return this.http\n      .put<{ data: AutopilotGuardrail }>(`${this.baseUrl}/guardrails/${id}`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  deleteGuardrail(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/guardrails/${id}`);\n  }\n\n  // Runs / Histórico\n  listRuns(params: { page?: number; per_page?: number } = {}): Observable<Paginated<AutopilotRun>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    return this.http.get<Paginated<AutopilotRun>>(`${this.baseUrl}/runs`, { params: httpParams });\n  }\n\n  getRun(id: string): Observable<{ data: AutopilotRun }> {\n    return this.http.get<{ data: AutopilotRun }>(`${this.baseUrl}/runs/${id}`);\n  }\n\n  cancelRun(id: string): Observable<{ data: AutopilotRun }> {\n    return this.http.patch<{ data: AutopilotRun }>(`${this.baseUrl}/runs/${id}/cancel`, {});\n  }\n\n  runSimulation(payload: SimulationPayload): Observable<{ data: SimulatorRunResponse }> {\n    const body = { context: payload.input ?? {} };\n    return this.http\n      .post<{ data: AutopilotRun }>(`${this.baseUrl}/playbooks/${payload.playbook_id}/runs`, body)\n      .pipe(\n        map((resp) => ({\n          data: {\n            run: resp.data,\n            actions: resp.data.actions ?? [],\n            logs: (resp.data.actions ?? []).map((action) => {\n              const tool = action.input?.['tool'];\n              const detail = typeof tool === 'string' ? tool : action.action_type;\n              return `${action.action_type}: ${detail}`;\n            }),\n          },\n        })),\n      );\n  }\n\n  listTriggerLogs(\n    params: { page?: number; per_page?: number; trigger_type?: string; status?: string } = {},\n  ): Observable<Paginated<AutopilotTriggerLog>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    if (params.trigger_type) httpParams = httpParams.set('trigger_type', params.trigger_type);\n    if (params.status) httpParams = httpParams.set('status', params.status);\n\n    return this.http.get<Paginated<AutopilotTriggerLog>>(`${this.baseUrl}/trigger-logs`, {\n      params: httpParams,\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/billing-invoice.service.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Method 'list' has a complexity of 11. Maximum allowed is 10.","line":99,"column":3,"nodeType":"FunctionExpression","messageId":"complex","endLine":99,"endColumn":7},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":102,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":102,"endColumn":23,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2259,2273],"text":"filters.search != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2259,2273],"text":"filters.search ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2259,2273],"text":"Boolean(filters.search)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nul