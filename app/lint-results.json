7947,17947],"text":"await "},"desc":"Add await operator."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { forkJoin } from 'rxjs';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfCheckboxInputComponent,\n  AfCrudPageComponent,\n  AfConfirmModalComponent,\n  AfDataTableComponent,\n  AfLoadingButtonComponent,\n  AfModalComponent,\n  AfSelectInputComponent,\n  AfStatusBadgeComponent,\n  AfTableActionsComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { ToastService } from '../../../core/services/toast.service';\nimport { type Contact, ContactService } from '../../../core/services/crm-contact.service';\nimport { ContactFormComponent } from './components/contact-form/crm-contact-form';\nimport { ContactExportComponent } from './components/contact-export/crm-contact-export';\nimport { ContactImportComponent } from './components/contact-import/crm-contact-import';\n\n/**\n * Contacts CRM page — CRUD for contacts with import/export.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-contacts',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfModalComponent,\n    AfConfirmModalComponent,\n    AfButtonComponent,\n    AfCheckboxInputComponent,\n    AfLoadingButtonComponent,\n    AfSelectInputComponent,\n    AfDataTableComponent,\n    AfStatusBadgeComponent,\n    AfTableActionsComponent,\n    AfAlertComponent,\n    ContactFormComponent,\n    ContactExportComponent,\n    ContactImportComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Contatos\"\n      subtitle=\"CRM\"\n      createLabel=\"Novo contato\"\n      searchPlaceholder=\"Buscar contatos...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum contato encontrado\"\n      emptyDescription=\"Comece adicionando seu primeiro contato ao sistema.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"6\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (create)=\"openCreate()\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <!-- Filter + header actions slot -->\n      <div filters class=\"flex items-center gap-2\">\n        <div class=\"min-w-40\">\n          <af-select-input\n            [control]=\"filterStatusControl\"\n            [options]=\"filterStatusOptions\"\n            size=\"sm\"\n            classContainer=\"\"\n            dataTest=\"contact-filter-status\"\n          />\n        </div>\n        @if (hasSelection()) {\n          <af-button variant=\"danger\" size=\"sm\" (click)=\"openBulkDelete()\">\n            Excluir selecionados ({{ selectedCount() }})\n          </af-button>\n        }\n        <div class=\"ml-auto flex items-center gap-2\">\n          <af-button\n            variant=\"outline\"\n            size=\"sm\"\n            dataTest=\"contact-import-btn\"\n            (click)=\"openImport()\"\n          >\n            <lucide-icon name=\"upload\" [size]=\"14\" class=\"block\" />\n            Importar\n          </af-button>\n          <app-contact-export\n            [searchTerm]=\"searchTerm()\"\n            [statusFilter]=\"filterStatusControl.value\"\n          />\n        </div>\n      </div>\n\n      <!-- Table -->\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar contatos\"\n            message=\"Não foi possível carregar os contatos. Verifique sua conexão e tente novamente.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th class=\"w-10\">\n                <af-checkbox-input\n                  [control]=\"selectAllControl\"\n                  ariaLabel=\"Selecionar todos os contatos\"\n                  dataTest=\"contacts-select-all\"\n                />\n              </th>\n              <th>Nome</th>\n              <th>Empresa</th>\n              <th>Telefone</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (contact of contacts(); track contact.id) {\n              <tr>\n                <td>\n                  <af-checkbox-input\n                    [control]=\"getRowSelectionControl(contact.id)\"\n                    [ariaLabel]=\"'Selecionar contato ' + contact.name\"\n                    [dataTest]=\"'contact-select-' + contact.id\"\n                  />\n                </td>\n                <td>\n                  <div class=\"flex items-center gap-3\">\n                    <div\n                      class=\"shrink-0 w-8 h-8 rounded-full overflow-hidden\n                        bg-accent-100 dark:bg-accent-900\n                        flex items-center justify-center\n                        text-xs font-semibold text-accent-700 dark:text-accent-300\"\n                    >\n                      @if (contact.avatar) {\n                        <img\n                          [src]=\"contact.avatar\"\n                          [alt]=\"contact.name\"\n                          class=\"w-full h-full object-cover\"\n                        />\n                      } @else {\n                        {{ getInitials(contact.name) }}\n                      }\n                    </div>\n                    <div class=\"flex flex-col\">\n                      <span class=\"font-medium\">{{ contact.name }}</span>\n                      @if (contact.document) {\n                        <span class=\"text-xs text-neutral-500\">{{\n                          formatDocument(contact.document)\n                        }}</span>\n                      }\n                    </div>\n                  </div>\n                </td>\n                <td>\n                  <div class=\"flex flex-col\">\n                    <span class=\"font-medium text-neutral-800 dark:text-neutral-200\">{{\n                      contact.company?.name || '—'\n                    }}</span>\n                    @if (contact.company?.document) {\n                      <span class=\"text-xs text-neutral-500\">{{\n                        formatDocument(contact.company!.document)\n                      }}</span>\n                    }\n                  </div>\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ formatPhone(contact.phone) }}\n                </td>\n                <td>\n                  <af-status-badge [status]=\"contact.is_active ? 'online' : 'offline'\">\n                    {{ contact.is_active ? 'Ativo' : 'Inativo' }}\n                  </af-status-badge>\n                </td>\n                <td>\n                  <div class=\"flex justify-end\">\n                    <af-table-actions (edit)=\"openEdit(contact)\" (delete)=\"openDelete(contact)\" />\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <!-- Create / Edit modal -->\n    <af-modal\n      [open]=\"showFormModal()\"\n      [title]=\"formModalTitle()\"\n      size=\"lg\"\n      (closed)=\"handleFormCancelled()\"\n    >\n      <app-contact-form\n        #contactForm\n        [contact]=\"selectedContact()\"\n        (saved)=\"handleFormSaved($event)\"\n        (cancelled)=\"handleFormCancelled()\"\n      />\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button\n          variant=\"ghost\"\n          size=\"sm\"\n          dataTest=\"contact-form-cancel-btn\"\n          (click)=\"contactFormRef()?.cancel()\"\n        >\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"primary\"\n          size=\"sm\"\n          [loading]=\"isFormSaving()\"\n          dataTest=\"contact-form-save-btn\"\n          (click)=\"contactFormRef()?.submit()\"\n        >\n          Salvar\n        </af-loading-button>\n      </div>\n    </af-modal>\n\n    <!-- Delete confirmation modal -->\n    <af-confirm-modal\n      [open]=\"showDeleteModal()\"\n      [title]=\"deleteModalTitle()\"\n      [message]=\"deleteMessage()\"\n      [confirmLabel]=\"deleteConfirmLabel()\"\n      cancelLabel=\"Cancelar\"\n      variant=\"danger\"\n      iconName=\"trash-2\"\n      (confirmed)=\"handleDeleteConfirmed()\"\n      (cancelled)=\"showDeleteModal.set(false)\"\n    />\n\n    <!-- Import modal -->\n    <af-modal [open]=\"isImportOpen()\" title=\"Importar contatos\" size=\"lg\" (closed)=\"closeImport()\">\n      <app-contact-import\n        #contactImportComponent\n        (imported)=\"handleImported()\"\n        (errorOccurred)=\"handleImportError($event)\"\n      />\n    </af-modal>\n  `,\n})\nexport class Contacts implements OnInit {\n  private readonly contactService = inject(ContactService);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly route = inject(ActivatedRoute);\n  private readonly router = inject(Router);\n  private routeHandled = false;\n\n  readonly contactFormRef = viewChild<ContactFormComponent>('contactForm');\n  readonly contactImportRef = viewChild<ContactImportComponent>('contactImportComponent');\n\n  readonly isFormSaving = computed(() => this.contactFormRef()?.isSaving() ?? false);\n\n  // ─── List state ────────────────────────────────────────────────────────────\n  readonly contacts = signal<Contact[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n\n  readonly searchTerm = signal('');\n  private readonly pageNumber = signal(1);\n\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.contacts().length === 0,\n  );\n\n  // ─── Status filter ─────────────────────────────────────────────────────────\n  readonly filterStatusControl = new FormControl<string>('all', { nonNullable: true });\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  // ─── Modal state ───────────────────────────────────────────────────────────\n  readonly showFormModal = signal(false);\n  readonly selectedContact = signal<Contact | null>(null);\n  readonly formModalTitle = computed(() =>\n    this.selectedContact() ? 'Editar contato' : 'Novo contato',\n  );\n\n  readonly showDeleteModal = signal(false);\n  readonly contactToDelete = signal<Contact | null>(null);\n  readonly isDeleting = signal(false);\n\n  readonly selectAllControl = new FormControl<boolean>(false, { nonNullable: true });\n  private readonly rowSelectionControls = new Map<string, FormControl<boolean>>();\n  readonly selectedContactIds = signal<string[]>([]);\n  readonly selectedCount = computed(() => this.selectedContactIds().length);\n  readonly hasSelection = computed(() => this.selectedCount() > 0);\n\n  readonly deleteModalTitle = computed(() =>\n    this.contactToDelete() ? 'Excluir contato' : 'Excluir contatos',\n  );\n  readonly deleteConfirmLabel = computed(() =>\n    this.contactToDelete() ? 'Excluir' : 'Excluir selecionados',\n  );\n  readonly deleteMessage = computed(() => {\n    const c = this.contactToDelete();\n    if (!c && this.selectedCount() > 0) {\n      return `Tem certeza que deseja excluir ${this.selectedCount()} contatos selecionados? Esta ação não pode ser desfeita.`;\n    }\n    return c\n      ? `Tem certeza que deseja excluir o contato \"${c.name}\"? Esta ação não pode ser desfeita.`\n      : 'Tem certeza que deseja excluir este contato?';\n  });\n\n  // ─── Import state ──────────────────────────────────────────────────────────\n  readonly isImportOpen = signal(false);\n\n  constructor() {\n    this.filterStatusControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => {\n        this.pageNumber.set(1);\n        this.loadContacts();\n      });\n\n    this.selectAllControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((checked) => {\n        const next = checked ? this.contacts().map((c) => String(c.id)) : [];\n        this.selectedContactIds.set(next);\n        for (const c of this.contacts()) {\n          this.getRowSelectionControl(String(c.id)).setValue(checked);\n        }\n      });\n  }\n\n  ngOnInit(): void {\n    this.loadContacts();\n    this.handleRouteContact();\n  }\n\n  // ─── Actions ───────────────────────────────────────────────────────────────\n  openCreate(): void {\n    this.selectedContact.set(null);\n    this.showFormModal.set(true);\n  }\n\n  openEdit(contact: Contact): void {\n    this.selectedContact.set(contact);\n    this.showFormModal.set(true);\n  }\n\n  openDelete(contact: Contact): void {\n    this.contactToDelete.set(contact);\n    this.showDeleteModal.set(true);\n  }\n\n  openBulkDelete(): void {\n    if (!this.hasSelection()) return;\n    this.contactToDelete.set(null);\n    this.showDeleteModal.set(true);\n  }\n\n  handleFormSaved(_contact: Contact): void {\n    this.showFormModal.set(false);\n    this.selectedContact.set(null);\n    this.toast.success('Contato salvo com sucesso.');\n    this.loadContacts();\n  }\n\n  handleFormCancelled(): void {\n    this.showFormModal.set(false);\n    this.selectedContact.set(null);\n  }\n\n  handleDeleteConfirmed(): void {\n    if (this.isDeleting()) return;\n    const single = this.contactToDelete();\n    const ids = single ? [String(single.id)] : this.selectedContactIds();\n    if (ids.length === 0) return;\n\n    this.isDeleting.set(true);\n    forkJoin(ids.map((id) => this.contactService.delete(id))).subscribe({\n      next: () => {\n        this.isDeleting.set(false);\n        this.showDeleteModal.set(false);\n        this.contactToDelete.set(null);\n        this.clearSelection();\n        this.toast.success(\n          ids.length > 1 ? 'Contatos excluídos com sucesso.' : 'Contato excluído com sucesso.',\n        );\n        this.loadContacts();\n      },\n      error: () => {\n        this.isDeleting.set(false);\n        this.showDeleteModal.set(false);\n      },\n    });\n  }\n\n  onSearch(term: string): void {\n    this.searchTerm.set(term);\n    this.pageNumber.set(1);\n    this.loadContacts();\n  }\n\n  loadPage(page: number): void {\n    this.pageNumber.set(page);\n    this.loadContacts();\n  }\n\n  retry(): void {\n    this.loadContacts();\n  }\n\n  // ─── Import ────────────────────────────────────────────────────────────────\n  openImport(): void {\n    this.contactImportRef()?.reset();\n    this.isImportOpen.set(true);\n  }\n\n  closeImport(): void {\n    this.isImportOpen.set(false);\n  }\n\n  handleImported(): void {\n    this.loadContacts();\n  }\n\n  handleImportError(_message: string): void {\n    // Error is shown inline in the import component\n  }\n\n  formatDocument(value: string | undefined): string {\n    if (!value) return '—';\n    const digits = value.replace(/\\D/g, '');\n\n    if (digits.length === 11) {\n      return digits.replace(/(\\d{3})(\\d{3})(\\d{3})(\\d{2})/, '$1.$2.$3-$4');\n    }\n\n    if (digits.length === 14) {\n      return digits.replace(/(\\d{2})(\\d{3})(\\d{3})(\\d{4})(\\d{2})/, '$1.$2.$3/$4-$5');\n    }\n\n    return value;\n  }\n\n  /** Returns up to 2 uppercase initials from a contact name */\n  getInitials(name: string): string {\n    return name\n      .split(' ')\n      .filter((n) => n.length > 0)\n      .slice(0, 2)\n      .map((n) => n.charAt(0).toUpperCase())\n      .join('');\n  }\n\n  formatPhone(value: string | undefined): string {\n    if (!value) return '—';\n    const digits = value.replace(/\\D/g, '');\n\n    if (digits.startsWith('55')) {\n      const localNumber = digits.slice(2);\n\n      if (localNumber.length === 11) {\n        const formatted = localNumber.replace(/(\\d{2})(\\d{5})(\\d{4})/, '($1) $2-$3');\n        return `+55 ${formatted}`;\n      }\n\n      if (localNumber.length === 10) {\n        const formatted = localNumber.replace(/(\\d{2})(\\d{4})(\\d{4})/, '($1) $2-$3');\n        return `+55 ${formatted}`;\n      }\n    }\n\n    if (digits.length === 11) {\n      return digits.replace(/(\\d{2})(\\d{5})(\\d{4})/, '($1) $2-$3');\n    }\n\n    if (digits.length === 10) {\n      return digits.replace(/(\\d{2})(\\d{4})(\\d{4})/, '($1) $2-$3');\n    }\n\n    return value;\n  }\n\n  // ─── Data loading ──────────────────────────────────────────────────────────\n  private loadContacts(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    const statusValue = this.filterStatusControl.value;\n    const is_active =\n      statusValue === 'active' ? true : statusValue === 'inactive' ? false : undefined;\n\n    this.contactService\n      .list({\n        search: this.searchTerm() || undefined,\n        page: this.pageNumber(),\n        per_page: 15,\n        sort_by: 'name',\n        sort_dir: 'asc',\n        is_active,\n      })\n      .subscribe({\n        next: (response) => {\n          this.contacts.set(response.data);\n          this.meta.set(response.meta);\n          this.syncSelectionControls(response.data);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.isLoading.set(false);\n          this.hasError.set(true);\n        },\n      });\n  }\n\n  private handleRouteContact(): void {\n    this.route.queryParamMap.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((params) => {\n      const contactId = params.get('contact_id');\n      if (!contactId || this.routeHandled) return;\n      this.routeHandled = true;\n      this.contactService\n        .find(contactId)\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe({\n          next: (response) => {\n            this.openEdit(response.data.contact);\n            this.router.navigate([], {\n              queryParams: { contact_id: null },\n              queryParamsHandling: 'merge',\n              replaceUrl: true,\n            });\n          },\n        });\n    });\n  }\n\n  getRowSelectionControl(id: string): FormControl<boolean> {\n    const existing = this.rowSelectionControls.get(id);\n    if (existing) return existing;\n\n    const control = new FormControl<boolean>(false, { nonNullable: true });\n    control.valueChanges.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((checked) => {\n      const selected = new Set(this.selectedContactIds());\n      if (checked) selected.add(id);\n      else selected.delete(id);\n      this.selectedContactIds.set([...selected]);\n\n      const allSelected =\n        this.contacts().length > 0 && this.contacts().every((c) => selected.has(String(c.id)));\n      this.selectAllControl.setValue(allSelected, { emitEvent: false });\n    });\n\n    this.rowSelectionControls.set(id, control);\n    return control;\n  }\n\n  private syncSelectionControls(contacts: Contact[]): void {\n    const activeIds = new Set(contacts.map((c) => String(c.id)));\n    for (const key of this.rowSelectionControls.keys()) {\n      if (!activeIds.has(key)) this.rowSelectionControls.delete(key);\n    }\n    const selected = this.selectedContactIds().filter((id) => activeIds.has(id));\n    this.selectedContactIds.set(selected);\n    for (const c of contacts) {\n      this.getRowSelectionControl(String(c.id)).setValue(selected.includes(String(c.id)));\n    }\n    this.selectAllControl.setValue(contacts.length > 0 && selected.length === contacts.length, {\n      emitEvent: false,\n    });\n  }\n\n  private clearSelection(): void {\n    this.selectedContactIds.set([]);\n    this.selectAllControl.setValue(false, { emitEvent: false });\n    for (const control of this.rowSelectionControls.values()) {\n      control.setValue(false, { emitEvent: false });\n    }\n  }\n}\n\nexport default Contacts;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/departments/components/department-form/department-form.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":84,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":84,"endColumn":35}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport {\n  AfAlertComponent,\n  AfSwitchInputComponent,\n  AfTextInputComponent,\n  AfTextareaInputComponent,\n} from '@shared/components';\nimport {\n  type Department,\n  DepartmentService,\n} from '../../../../../core/services/department.service';\n\n/**\n * Department form component for creating and editing CRM departments.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-department-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfTextInputComponent,\n    AfTextareaInputComponent,\n    AfSwitchInputComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <form [formGroup]=\"form\" (ngSubmit)=\"submit()\">\n      @if (errorMessage()) {\n        <div class=\"mb-4\">\n          <af-alert variant=\"danger\" [message]=\"errorMessage() ?? ''\" />\n        </div>\n      }\n\n      <af-text-input\n        label=\"Nome\"\n        [control]=\"form.controls.name\"\n        placeholder=\"Ex: Vendas\"\n        [required]=\"true\"\n        dataTest=\"department-form-name\"\n      />\n\n      <af-textarea-input\n        label=\"Descrição\"\n        [control]=\"form.controls.description\"\n        placeholder=\"Descrição do departamento...\"\n        [rows]=\"3\"\n        dataTest=\"department-form-description\"\n      />\n\n      <af-switch-input\n        label=\"Ativo\"\n        [control]=\"form.controls.is_active\"\n        dataTest=\"department-form-active\"\n      />\n    </form>\n  `,\n})\nexport class DepartmentFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly departmentService = inject(DepartmentService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  /** Department to edit — null for create mode */\n  readonly department = input<Department | null>(null);\n\n  /** Emitted after a successful save */\n  readonly saved = output<Department>();\n\n  /** Emitted when user cancels */\n  readonly cancelled = output<void>();\n\n  /** Save loading state — accessed by parent via viewChild */\n  readonly isSaving = signal(false);\n\n  /** Inline error message */\n  readonly errorMessage = signal<string | null>(null);\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', { nonNullable: true, validators: [Validators.required] }),\n    description: this.fb.control('', { nonNullable: true }),\n    is_active: this.fb.control(true, { nonNullable: true }),\n  });\n\n  constructor() {\n    effect(() => {\n      const item = this.department();\n      if (item) {\n        if (this.lastLoadedId() === item.id) return;\n        this.lastLoadedId.set(item.id);\n        this.form.reset({\n          name: item.name,\n          description: item.description ?? '',\n          is_active: item.is_active,\n        });\n      } else {\n        this.lastLoadedId.set(null);\n        this.resetForm();\n      }\n    });\n  }\n\n  /** Submit the form — validates, builds payload, calls API */\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n    const payload = {\n      name: formValue.name,\n      description: formValue.description || undefined,\n      is_active: formValue.is_active,\n    };\n\n    const editing = this.department();\n    const request = editing\n      ? this.departmentService.update(editing.id, payload)\n      : this.departmentService.create(payload);\n\n    this.isSaving.set(true);\n    this.errorMessage.set(null);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response.data);\n      },\n      error: () => {\n        this.isSaving.set(false);\n        this.errorMessage.set('Não foi possível salvar o departamento. Tente novamente.');\n      },\n    });\n  }\n\n  /** Cancel — emit cancelled event */\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      description: '',\n      is_active: true,\n    });\n    this.errorMessage.set(null);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/departments/departments.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { forkJoin } from 'rxjs';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfCheckboxInputComponent,\n  AfCrudPageComponent,\n  AfConfirmModalComponent,\n  AfDataTableComponent,\n  AfLoadingButtonComponent,\n  AfModalComponent,\n  AfSelectInputComponent,\n  AfStatusBadgeComponent,\n  AfTableActionsComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { ToastService } from '../../../core/services/toast.service';\nimport { type Department, DepartmentService } from '../../../core/services/department.service';\nimport { DepartmentFormComponent } from './components/department-form/department-form';\n\n/**\n * Departments settings page — CRUD for CRM departments.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-departments',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfModalComponent,\n    AfConfirmModalComponent,\n    AfButtonComponent,\n    AfCheckboxInputComponent,\n    AfLoadingButtonComponent,\n    AfSelectInputComponent,\n    AfDataTableComponent,\n    AfStatusBadgeComponent,\n    AfTableActionsComponent,\n    AfAlertComponent,\n    DepartmentFormComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <!-- CRUD Page wrapper: title + search + filter slot + content + pagination -->\n    <af-crud-page\n      title=\"Departamentos\"\n      subtitle=\"Configurações\"\n      createLabel=\"Novo departamento\"\n      searchPlaceholder=\"Buscar departamentos...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum departamento encontrado\"\n      emptyDescription=\"Comece adicionando seu primeiro departamento ao sistema.\"\n      [skeletonColumns]=\"4\"\n      [skeletonRows]=\"6\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (create)=\"openCreate()\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <!-- Filter slot -->\n      <div filters class=\"flex items-center gap-2\">\n        <div class=\"min-w-40\">\n          <af-select-input\n            [control]=\"filterStatusControl\"\n            [options]=\"filterStatusOptions\"\n            size=\"sm\"\n            classContainer=\"\"\n            dataTest=\"department-filter-status\"\n          />\n        </div>\n        @if (hasSelection()) {\n          <af-button variant=\"danger\" size=\"sm\" (click)=\"openBulkDelete()\">\n            Excluir selecionados ({{ selectedCount() }})\n          </af-button>\n        }\n      </div>\n\n      <!-- Table (shown when not loading / not empty / no error) -->\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar departamentos\"\n            message=\"Não foi possível carregar os departamentos. Verifique sua conexão e tente novamente.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th class=\"w-10\">\n                <af-checkbox-input\n                  [control]=\"selectAllControl\"\n                  ariaLabel=\"Selecionar todos os departamentos\"\n                  dataTest=\"departments-select-all\"\n                />\n              </th>\n              <th>Nome</th>\n              <th>Descrição</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (dept of departments(); track dept.id) {\n              <tr>\n                <td>\n                  <af-checkbox-input\n                    [control]=\"getRowSelectionControl(dept.id)\"\n                    [ariaLabel]=\"'Selecionar departamento ' + dept.name\"\n                    [dataTest]=\"'department-select-' + dept.id\"\n                  />\n                </td>\n                <td class=\"font-medium\">\n                  {{ dept.name }}\n                </td>\n                <td class=\"max-w-xs truncate\">\n                  {{ dept.description || '—' }}\n                </td>\n                <td>\n                  <af-status-badge [status]=\"dept.is_active ? 'online' : 'offline'\">\n                    {{ dept.is_active ? 'Ativo' : 'Inativo' }}\n                  </af-status-badge>\n                </td>\n                <td>\n                  <div class=\"flex justify-end\">\n                    <af-table-actions (edit)=\"openEdit(dept)\" (delete)=\"openDelete(dept)\" />\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <!-- Create / Edit modal -->\n    <af-modal\n      [open]=\"showFormModal()\"\n      [title]=\"formModalTitle()\"\n      size=\"md\"\n      (closed)=\"handleFormCancelled()\"\n    >\n      <app-department-form\n        #departmentForm\n        [department]=\"selectedDepartment()\"\n        (saved)=\"handleFormSaved($event)\"\n        (cancelled)=\"handleFormCancelled()\"\n      />\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button\n          variant=\"ghost\"\n          size=\"sm\"\n          dataTest=\"department-form-cancel-btn\"\n          (click)=\"departmentFormRef()?.cancel()\"\n        >\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"primary\"\n          size=\"sm\"\n          [loading]=\"isFormSaving()\"\n          dataTest=\"department-form-save-btn\"\n          (click)=\"departmentFormRef()?.submit()\"\n        >\n          Salvar\n        </af-loading-button>\n      </div>\n    </af-modal>\n\n    <!-- Delete confirmation modal -->\n    <af-confirm-modal\n      [open]=\"showDeleteModal()\"\n      [title]=\"deleteModalTitle()\"\n      [message]=\"deleteMessage()\"\n      [confirmLabel]=\"deleteConfirmLabel()\"\n      cancelLabel=\"Cancelar\"\n      variant=\"danger\"\n      iconName=\"trash-2\"\n      (confirmed)=\"handleDeleteConfirmed()\"\n      (cancelled)=\"showDeleteModal.set(false)\"\n    />\n  `,\n})\nexport class Departments implements OnInit {\n  private readonly departmentService = inject(DepartmentService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly toast = inject(ToastService);\n\n  /** Form component reference — only defined while modal is open */\n  readonly departmentFormRef = viewChild<DepartmentFormComponent>('departmentForm');\n\n  /** Proxy for form isSaving state — safe when modal is closed */\n  readonly isFormSaving = computed(() => this.departmentFormRef()?.isSaving() ?? false);\n\n  // ─── List state ────────────────────────────────────────────────────────────\n  readonly departments = signal<Department[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n\n  private readonly searchTerm = signal('');\n  private readonly pageNumber = signal(1);\n\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.departments().length === 0,\n  );\n\n  // ─── Filter ────────────────────────────────────────────────────────────────\n  readonly filterStatusControl = new FormControl<string>('all', { nonNullable: true });\n\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  // ─── Modal state ───────────────────────────────────────────────────────────\n  readonly showFormModal = signal(false);\n  readonly selectedDepartment = signal<Department | null>(null);\n\n  readonly formModalTitle = computed(() =>\n    this.selectedDepartment() ? 'Editar departamento' : 'Novo departamento',\n  );\n\n  readonly showDeleteModal = signal(false);\n  readonly departmentToDelete = signal<Department | null>(null);\n\n  readonly selectAllControl = new FormControl<boolean>(false, { nonNullable: true });\n  private readonly rowSelectionControls = new Map<string, FormControl<boolean>>();\n  readonly selectedDepartmentIds = signal<string[]>([]);\n  readonly selectedCount = computed(() => this.selectedDepartmentIds().length);\n  readonly hasSelection = computed(() => this.selectedCount() > 0);\n\n  readonly deleteModalTitle = computed(() =>\n    this.departmentToDelete() ? 'Excluir departamento' : 'Excluir departamentos',\n  );\n\n  readonly deleteConfirmLabel = computed(() =>\n    this.departmentToDelete() ? 'Excluir' : 'Excluir selecionados',\n  );\n\n  readonly deleteMessage = computed(() => {\n    const dept = this.departmentToDelete();\n    if (!dept && this.selectedCount() > 0) {\n      return `Tem certeza que deseja excluir ${this.selectedCount()} departamentos selecionados? Esta ação não pode ser desfeita.`;\n    }\n    return dept\n      ? `Tem certeza que deseja excluir o departamento \"${dept.name}\"? Esta ação não pode ser desfeita.`\n      : 'Tem certeza que deseja excluir este departamento?';\n  });\n\n  readonly isDeleting = signal(false);\n\n  constructor() {\n    // Reload list whenever status filter changes\n    this.filterStatusControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => {\n        this.pageNumber.set(1);\n        this.loadDepartments();\n      });\n\n    this.selectAllControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((checked) => {\n        const nextSelected = checked ? this.departments().map((dept) => dept.id) : [];\n        this.selectedDepartmentIds.set(nextSelected);\n\n        for (const dept of this.departments()) {\n          this.getRowSelectionControl(dept.id).setValue(checked, { emitEvent: false });\n        }\n      });\n  }\n\n  ngOnInit(): void {\n    this.loadDepartments();\n  }\n\n  // ─── Actions ───────────────────────────────────────────────────────────────\n\n  openCreate(): void {\n    this.selectedDepartment.set(null);\n    this.showFormModal.set(true);\n  }\n\n  openEdit(dept: Department): void {\n    this.selectedDepartment.set(dept);\n    this.showFormModal.set(true);\n  }\n\n  openDelete(dept: Department): void {\n    this.departmentToDelete.set(dept);\n    this.showDeleteModal.set(true);\n  }\n\n  openBulkDelete(): void {\n    if (!this.hasSelection()) return;\n    this.departmentToDelete.set(null);\n    this.showDeleteModal.set(true);\n  }\n\n  handleFormSaved(dept: Department): void {\n    this.showFormModal.set(false);\n    this.selectedDepartment.set(null);\n    this.toast.success('Departamento salvo com sucesso.');\n    this.departments.update((list) => list.map((d) => (d.id === dept.id ? dept : d)));\n    this.loadDepartments();\n  }\n\n  handleFormCancelled(): void {\n    this.showFormModal.set(false);\n    this.selectedDepartment.set(null);\n  }\n\n  handleDeleteConfirmed(): void {\n    if (this.isDeleting()) return;\n\n    const singleDepartment = this.departmentToDelete();\n    const idsToDelete = singleDepartment ? [singleDepartment.id] : this.selectedDepartmentIds();\n\n    if (idsToDelete.length === 0) return;\n\n    this.isDeleting.set(true);\n\n    forkJoin(idsToDelete.map((id) => this.departmentService.delete(id))).subscribe({\n      next: () => {\n        this.isDeleting.set(false);\n        this.showDeleteModal.set(false);\n        this.departmentToDelete.set(null);\n        this.clearSelection();\n        this.toast.success(\n          idsToDelete.length > 1\n            ? 'Departamentos excluídos com sucesso.'\n            : 'Departamento excluído com sucesso.',\n        );\n        this.loadDepartments();\n      },\n      error: () => {\n        this.isDeleting.set(false);\n        this.showDeleteModal.set(false);\n      },\n    });\n  }\n\n  onSearch(term: string): void {\n    this.searchTerm.set(term);\n    this.pageNumber.set(1);\n    this.loadDepartments();\n  }\n\n  loadPage(page: number): void {\n    this.pageNumber.set(page);\n    this.loadDepartments();\n  }\n\n  retry(): void {\n    this.loadDepartments();\n  }\n\n  // ─── Data loading ──────────────────────────────────────────────────────────\n\n  private loadDepartments(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    const statusValue = this.filterStatusControl.value;\n    const is_active =\n      statusValue === 'active' ? true : statusValue === 'inactive' ? false : undefined;\n\n    this.departmentService\n      .list({\n        search: this.searchTerm() || undefined,\n        page: this.pageNumber(),\n        per_page: 15,\n        sort_by: 'name',\n        sort_dir: 'asc',\n        is_active,\n      })\n      .subscribe({\n        next: (response) => {\n          this.departments.set(response.data);\n          this.meta.set(response.meta);\n          this.syncSelectionControls(response.data);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.isLoading.set(false);\n          this.hasError.set(true);\n        },\n      });\n  }\n\n  getRowSelectionControl(id: string): FormControl<boolean> {\n    const existing = this.rowSelectionControls.get(id);\n    if (existing) return existing;\n\n    const control = new FormControl<boolean>(false, { nonNullable: true });\n    control.valueChanges.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((checked) => {\n      const selected = new Set(this.selectedDepartmentIds());\n      if (checked) {\n        selected.add(id);\n      } else {\n        selected.delete(id);\n      }\n\n      this.selectedDepartmentIds.set([...selected]);\n\n      const allSelected =\n        this.departments().length > 0 && this.departments().every((dept) => selected.has(dept.id));\n      this.selectAllControl.setValue(allSelected, { emitEvent: false });\n    });\n\n    this.rowSelectionControls.set(id, control);\n    return control;\n  }\n\n  private syncSelectionControls(departments: Department[]): void {\n    const activeIds = new Set(departments.map((dept) => dept.id));\n\n    for (const key of this.rowSelectionControls.keys()) {\n      if (!activeIds.has(key)) {\n        this.rowSelectionControls.delete(key);\n      }\n    }\n\n    const selected = this.selectedDepartmentIds().filter((id) => activeIds.has(id));\n    this.selectedDepartmentIds.set(selected);\n\n    for (const dept of departments) {\n      this.getRowSelectionControl(dept.id).setValue(selected.includes(dept.id), {\n        emitEvent: false,\n      });\n    }\n\n    this.selectAllControl.setValue(\n      departments.length > 0 && selected.length === departments.length,\n      {\n        emitEvent: false,\n      },\n    );\n  }\n\n  private clearSelection(): void {\n    this.selectedDepartmentIds.set([]);\n    this.selectAllControl.setValue(false, { emitEvent: false });\n    for (const control of this.rowSelectionControls.values()) {\n      control.setValue(false, { emitEvent: false });\n    }\n  }\n}\n\nexport default Departments;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/funnels/components/funnel-form/crm-funnel-form.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../../../core/services/crm-funnel.service' import is duplicated.","line":32,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":32,"endColumn":81},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":232,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":232,"endColumn":35},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":355,"column":14,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":355,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[11339,11349],"text":"(step.color != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[11339,11349],"text":"(step.color ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[11339,11349],"text":"(Boolean(step.color))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":386,"column":22,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine"