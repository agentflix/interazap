omponent,\n  DestroyRef,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { FormControl } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { debounceTime, distinctUntilChanged, map, startWith } from 'rxjs/operators';\nimport type { Observable } from 'rxjs';\nimport { merge } from 'rxjs';\nimport { NgIcon, provideIcons } from '@ng-icons/core';\nimport {\n  lucideCalendar,\n  lucideList,\n  lucidePlus,\n  lucideTrash2,\n  lucidePencil,\n  lucideSlidersHorizontal,\n} from '@ng-icons/lucide';\nimport type { FullCalendarComponent } from '@fullcalendar/angular';\nimport { FullCalendarModule } from '@fullcalendar/angular';\nimport type { CalendarOptions, EventApi, EventClickArg, EventInput } from '@fullcalendar/core';\nimport dayGridPlugin from '@fullcalendar/daygrid';\nimport timeGridPlugin from '@fullcalendar/timegrid';\nimport listPlugin from '@fullcalendar/list';\nimport type { DateClickArg } from '@fullcalendar/interaction';\nimport interactionPlugin, { Draggable } from '@fullcalendar/interaction';\nimport ptBrLocale from '@fullcalendar/core/locales/pt-br';\nimport { CrudPageComponent } from '@shared/components/crud-page';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n} from '@shared/components/crud-page/models';\nimport { ModalComponent } from '@shared/components/modal/modal';\nimport { ButtonComponent, LoadingButtonComponent } from '@shared/components/buttons';\nimport { PageTitle } from '@shared/components/page-title/page-title';\nimport { SearchInputComponent } from '@shared/components/search-input/search-input';\nimport type { SelectOption } from '@shared/components/inputs';\nimport {\n  SelectInputComponent,\n  CheckboxInputComponent,\n  TextInputComponent,\n} from '@shared/components/inputs';\nimport type {\n  Event as CRMEvent,\n  EventFilters,\n  EventRecurrence,\n  EventStatus,\n  EventType,\n} from 'src/app/core/services/event.service';\nimport { EventService } from 'src/app/core/services/event.service';\nimport type { Contact } from 'src/app/core/models/contact.model';\nimport { ContactService } from 'src/app/core/services/contact.service';\nimport type { CRMCompany } from 'src/app/core/services/crm-company.service';\nimport { CRMCompanyService } from 'src/app/core/services/crm-company.service';\nimport type { Negotiation } from 'src/app/core/services/negotiation.service';\nimport { NegotiationService } from 'src/app/core/services/negotiation.service';\nimport type { User } from 'src/app/core/services/user.service';\nimport { UserService } from 'src/app/core/services/user.service';\nimport { AgendaFormComponent } from './components';\n\ntype ViewMode = 'list' | 'calendar';\ntype ToggleFilterValue = 'all' | 'yes' | 'no';\ntype LinkableTypeValue = 'all' | 'deal' | 'contact' | 'company';\n\ninterface CalendarFilterSnapshot {\n  type: EventType | 'all';\n  status: EventStatus | 'all';\n  userId: string;\n  startDate: string;\n  endDate: string;\n  participantId: string;\n  linkableType: LinkableTypeValue;\n  linkableId: string;\n  isAllDay: ToggleFilterValue;\n  recurrence: EventRecurrence | 'all';\n  hasReminders: ToggleFilterValue;\n  location: string;\n}\n\n@Component({\n  selector: 'app-agenda',\n  standalone: true,\n  imports: [\n    CommonModule,\n    NgIcon,\n    DatePipe,\n    FullCalendarModule,\n    CrudPageComponent,\n    AgendaFormComponent,\n    ModalComponent,\n    ButtonComponent,\n    LoadingButtonComponent,\n    PageTitle,\n    SearchInputComponent,\n    CheckboxInputComponent,\n    SelectInputComponent,\n    TextInputComponent,\n  ],\n  templateUrl: './agenda.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  viewProviders: [\n    provideIcons({\n      lucideCalendar,\n      lucideList,\n      lucidePlus,\n      lucideTrash2,\n      lucidePencil,\n      lucideSlidersHorizontal,\n    }),\n  ],\n})\nexport class Agenda implements AfterViewInit {\n  private readonly eventService = inject(EventService);\n  private readonly userService = inject(UserService);\n  private readonly contactService = inject(ContactService);\n  private readonly crmCompanyService = inject(CRMCompanyService);\n  private readonly negotiationService = inject(NegotiationService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly viewMode = signal<ViewMode>('calendar');\n  readonly isCalendarModalOpen = signal(false);\n  readonly isCalendarFiltersModalOpen = signal(false);\n  private calendarFiltersSnapshot: CalendarFilterSnapshot | null = null;\n  readonly calendarEditingItem = signal<CRMEvent | null>(null);\n  readonly calendarInitialData = signal<Partial<CRMEvent> | null>(null);\n\n  readonly users = signal<User[]>([]);\n  readonly contacts = signal<Contact[]>([]);\n  readonly companies = signal<CRMCompany[]>([]);\n  readonly negotiations = signal<Negotiation[]>([]);\n\n  readonly calendarSearchControl = new FormControl('', { nonNullable: true });\n  readonly typeFilterControl = new FormControl<EventType | 'all'>('all', { nonNullable: true });\n  readonly statusFilterControl = new FormControl<EventStatus | 'all'>('all', { nonNullable: true });\n  readonly userIdFilterControl = new FormControl('', { nonNullable: true });\n  readonly startDateFilterControl = new FormControl('', { nonNullable: true });\n  readonly endDateFilterControl = new FormControl('', { nonNullable: true });\n  readonly participantIdFilterControl = new FormControl('', { nonNullable: true });\n  readonly linkableTypeFilterControl = new FormControl<LinkableTypeValue>('all', {\n    nonNullable: true,\n  });\n  readonly linkableIdFilterControl = new FormControl('', { nonNullable: true });\n  readonly isAllDayFilterControl = new FormControl<ToggleFilterValue>('all', { nonNullable: true });\n  readonly recurrenceFilterControl = new FormControl<EventRecurrence | 'all'>('all', {\n    nonNullable: true,\n  });\n  readonly hasRemindersFilterControl = new FormControl<ToggleFilterValue>('all', {\n    nonNullable: true,\n  });\n  readonly locationFilterControl = new FormControl('', { nonNullable: true });\n\n  readonly dropRemoveControl = new FormControl(false, { nonNullable: true });\n\n  readonly crudPage = viewChild<CrudPageComponent<CRMEvent>>('crudPage');\n  readonly agendaForm = viewChild<AgendaFormComponent>('agendaForm');\n  readonly typeCell = viewChild<TemplateRef<{ $implicit: CRMEvent }>>('typeCell');\n  readonly startsAtCell = viewChild<TemplateRef<{ $implicit: CRMEvent }>>('startsAtCell');\n  readonly endsAtCell = viewChild<TemplateRef<{ $implicit: CRMEvent }>>('endsAtCell');\n  readonly statusCell = viewChild<TemplateRef<{ $implicit: CRMEvent }>>('statusCell');\n\n  readonly statusOptions: { id: EventStatus; label: string }[] = [\n    { id: 'scheduled', label: 'Agendado' },\n    { id: 'completed', label: 'Concluído' },\n    { id: 'cancelled', label: 'Cancelado' },\n  ];\n\n  readonly typeOptions: { id: EventType; label: string }[] = [\n    { id: 'meeting', label: 'Reunião' },\n    { id: 'call', label: 'Ligação' },\n    { id: 'task', label: 'Tarefa' },\n    { id: 'deadline', label: 'Prazo' },\n    { id: 'reminder', label: 'Lembrete' },\n    { id: 'other', label: 'Outro' },\n  ];\n\n  readonly filterTypeOptions: SelectOption[] = [\n    { label: 'Todos os tipos', value: 'all' },\n    ...this.typeOptions.map((option) => ({ label: option.label, value: option.id })),\n  ];\n\n  readonly filterStatusOptions: SelectOption[] = [\n    { label: 'Todos os status', value: 'all' },\n    ...this.statusOptions.map((option) => ({ label: option.label, value: option.id })),\n  ];\n\n  readonly responsibleOptions = (): SelectOption[] => [\n    { label: 'Todos os responsáveis', value: '' },\n    ...this.users().map((user) => ({ label: user.name, value: user.id })),\n  ];\n\n  readonly participantOptions = (): SelectOption[] => [\n    { label: 'Todos os participantes', value: '' },\n    ...this.users().map((user) => ({ label: user.name, value: user.id })),\n  ];\n\n  readonly linkableTypeOptions: SelectOption[] = [\n    { label: 'Todos os vínculos', value: 'all' },\n    { label: 'Negociação', value: 'deal' },\n    { label: 'Contato', value: 'contact' },\n    { label: 'Empresa', value: 'company' },\n  ];\n\n  readonly linkableEntityOptions = (): SelectOption[] => {\n    const linkableType = this.linkableTypeFilterControl.value;\n\n    if (linkableType === 'deal') {\n      return [\n        { label: 'Todas as negociações', value: '' },\n        ...this.negotiations().map((negotiation) => ({\n          label: negotiation.title,\n          value: String(negotiation.id),\n        })),\n      ];\n    }\n\n    if (linkableType === 'contact') {\n      return [\n        { label: 'Todos os contatos', value: '' },\n        ...this.contacts().map((contact) => ({ label: contact.name, value: String(contact.id) })),\n      ];\n    }\n\n    if (linkableType === 'company') {\n      return [\n        { label: 'Todas as empresas', value: '' },\n        ...this.companies().map((company) => ({ label: company.name, value: String(company.id) })),\n      ];\n    }\n\n    return [{ label: 'Selecione o vínculo', value: '' }];\n  };\n\n  readonly isAllDayOptions: SelectOption[] = [\n    { label: 'Dia inteiro: todos', value: 'all' },\n    { label: 'Somente dia inteiro', value: 'yes' },\n    { label: 'Sem dia inteiro', value: 'no' },\n  ];\n\n  readonly recurrenceOptions: SelectOption[] = [\n    { label: 'Recorrência: todas', value: 'all' },\n    { label: 'Sem recorrência', value: 'none' },\n    { label: 'Diária', value: 'daily' },\n    { label: 'Semanal', value: 'weekly' },\n    { label: 'Mensal', value: 'monthly' },\n    { label: 'Anual', value: 'yearly' },\n  ];\n\n  readonly hasRemindersOptions: SelectOption[] = [\n    { label: 'Lembretes: todos', value: 'all' },\n    { label: 'Com lembretes', value: 'yes' },\n    { label: 'Sem lembretes', value: 'no' },\n  ];\n\n  readonly crudService: CrudService<CRMEvent> = {\n    list: (params) => {\n      return this.eventService\n        .list(\n          this.buildFilters({ page: params.page, perPage: params.per_page, search: params.search }),\n        )\n        .pipe(\n          map((response) => ({\n            data: response.data,\n            meta: response.meta,\n          })),\n        ) as Observable<CrudPaginatedResponse<CRMEvent>>;\n    },\n    find: (id: string) =>\n      this.eventService.list({ per_page: 200 }).pipe(\n        map((response) => ({\n          data: response.data.find((item) => item.id === id) as CRMEvent,\n        })),\n      ) as Observable<CrudItemResponse<CRMEvent>>,\n    create: (data: Partial<CRMEvent>) =>\n      this.eventService.create(data).pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<CRMEvent>\n      >,\n    update: (id: string, data: Partial<CRMEvent>) =>\n      this.eventService\n        .update(id, data)\n        .pipe(map((response) => ({ data: response }))) as Observable<CrudItemResponse<CRMEvent>>,\n    delete: (id: string) => this.eventService.delete(id),\n  };\n\n  readonly columns: CrudColumnDef[] = [\n    {\n      field: 'title',\n      label: 'Evento',\n      type: 'text',\n    },\n    {\n      field: 'type',\n      label: 'Tipo',\n      template: this.typeCell() ?? undefined,\n    },\n    {\n      field: 'starts_at',\n      label: 'Início',\n      template: this.startsAtCell() ?? undefined,\n    },\n    {\n      field: 'ends_at',\n      label: 'Término',\n      template: this.endsAtCell() ?? undefined,\n    },\n    {\n      field: 'status',\n      label: 'Status',\n      template: this.statusCell() ?? undefined,\n    },\n  ];\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Evento',\n      plural: 'Agenda',\n      createButton: 'Novo evento',\n      modalCreate: 'Novo evento',\n      modalEdit: 'Editar evento',\n    },\n    subtitle: 'CRM',\n    searchPlaceholder: 'Buscar eventos...',\n    emptyState: {\n      icon: 'lucideCalendar',\n      title: 'Nenhum evento encontrado',\n      description: 'Comece adicionando seu primeiro evento.',\n    },\n    enableSelection: true,\n    enableSearch: true,\n    enableFilters: true,\n    enableBulkDelete: true,\n  };\n\n  readonly calendarComponent = viewChild<FullCalendarComponent>('calendar');\n\n  calendarOptions: CalendarOptions = {\n    plugins: [dayGridPlugin, timeGridPlugin, interactionPlugin, listPlugin],\n    initialView: 'dayGridMonth',\n    locale: 'pt-br',\n    locales: [ptBrLocale],\n    themeSystem: 'standard',\n    headerToolbar: {\n      left: 'prev,next today',\n      center: 'title',\n      right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth',\n    },\n    editable: true,\n    droppable: true,\n    selectable: true,\n    events: [],\n    dateClick: this.handleDateClick.bind(this),\n    eventClick: this.handleEventClick.bind(this),\n    eventDrop: this.handleEventDrop.bind(this),\n    drop: (info) => {\n      if (this.dropRemoveControl.value && info.draggedEl?.parentNode) {\n        info.draggedEl.parentNode.removeChild(info.draggedEl);\n      }\n\n      const type = info.draggedEl.getAttribute('data-type') as EventType | null;\n      this.openCalendarCreate(info.date, type || undefined);\n    },\n    eventClassNames: (arg) => {\n      const event = arg.event;\n      return event.extendedProps?.['classNames'] || [];\n    },\n  };\n\n  constructor() {\n    this.loadFilterDependencies();\n    this.watchFilterChanges();\n    this.watchCalendarSearch();\n\n    this.linkableTypeFilterControl.valueChanges\n      .pipe(startWith(this.linkableTypeFilterControl.value), takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => {\n        this.linkableIdFilterControl.setValue('');\n      });\n  }\n\n  ngAfterViewInit(): void {\n    this.initDraggables();\n  }\n\n  initDraggables(): void {\n    const externalEl = document.getElementById('external-events');\n    if (externalEl) {\n      new Draggable(externalEl, {\n        itemSelector: '.external-event',\n        eventData: (eventEl: HTMLElement): { title: string } => ({\n          title: eventEl.innerText.trim(),\n        }),\n      });\n    }\n  }\n\n  setView(view: ViewMode): void {\n    this.viewMode.set(view);\n\n    if (view === 'calendar') {\n      const api = this.calendarComponent()?.getApi();\n      if (api) api.changeView('dayGridMonth');\n      this.loadCalendarEvents();\n      return;\n    }\n\n    const crud = this.crudPage();\n    if (crud) {\n      crud.goToPage(1);\n      crud.reloadList();\n    }\n  }\n\n  loadCalendarEvents(): void {\n    this.eventService\n      .list(\n        this.buildFilters({\n          perPage: 200,\n          search: this.calendarSearchControl.value,\n        }),\n      )\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.updateCalendarEvents(response.data ?? []);\n        },\n        error: () => {\n          const crud = this.crudPage();\n          if (crud) {\n            crud.showError('Não foi possível carregar os eventos.');\n          }\n        },\n      });\n  }\n\n  updateCalendarEvents(items: CRMEvent[]): void {\n    const calendarEvents: EventInput[] = items.map((item) => {\n      const className = this.getTypeClass(item.type);\n\n      return {\n        id: item.id,\n        title: item.title,\n        start: item.starts_at,\n        end: item.ends_at ?? undefined,\n        allDay: item.is_all_day,\n        classNames: [className],\n        extendedProps: { ...item },\n      };\n    });\n\n    this.calendarOptions = {\n      ...this.calendarOptions,\n      events: calendarEvents,\n    };\n\n    const api = this.calendarComponent()?.getApi();\n    if (api) {\n      api.removeAllEvents();\n      api.addEventSource(calendarEvents);\n    }\n  }\n\n  getTypeClass(type: EventType): string {\n    switch (type) {\n      case 'meeting':\n        return '!bg-info !border-info !text-white';\n      case 'call':\n        return '!bg-primary !border-primary !text-white';\n      case 'task':\n        return '!bg-success !border-success !text-white';\n      case 'deadline':\n        return '!bg-danger !border-danger !text-white';\n      case 'reminder':\n        return '!bg-warning !border-warning !text-white';\n      default:\n        return '!bg-default-400 !border-default-400 !text-white';\n    }\n  }\n\n  handleDateClick(arg: DateClickArg): void {\n    this.openCalendarCreate(new Date(arg.date));\n  }\n\n  handleEventClick(arg: EventClickArg): void {\n    const eventId = arg.event.id;\n    const found = arg.event.extendedProps as CRMEvent | undefined;\n    if (found) {\n      this.openCalendarEdit(found);\n      return;\n    }\n\n    this.eventService\n      .list(this.buildFilters({ perPage: 200 }))\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const item = response.data.find((entry) => entry.id === eventId);\n          if (item) {\n            this.openCalendarEdit(item);\n          }\n        },\n      });\n  }\n\n  handleEventDrop(arg: { event: EventApi; revert: () => void }): void {\n    const event = arg.event;\n    const payload: Partial<CRMEvent> = {\n      starts_at: event.start?.toISOString() ?? '',\n      ends_at: event.end ? event.end.toISOString() : undefined,\n      is_all_day: event.allDay,\n    };\n\n    this.eventService\n      .update(event.id, payload)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.loadCalendarEvents();\n          const crud = this.crudPage();\n          if (crud) {\n            crud.reloadList();\n          }\n        },\n        error: () => {\n          const crud = this.crudPage();\n          if (crud) {\n            crud.showError('Não foi possível mover o evento.');\n          }\n          arg.revert();\n        },\n      });\n  }\n\n  onCreateEvent(): void {\n    if (this.viewMode() === 'calendar') {\n      this.openCalendarCreate();\n      return;\n    }\n\n    const crud = this.crudPage();\n    if (crud) {\n      crud.openCreate();\n    }\n  }\n\n  openCalendarFiltersModal(): void {\n    this.calendarFiltersSnapshot = this.captureCalendarFilters();\n    this.isCalendarFiltersModalOpen.set(true);\n  }\n\n  cancelCalendarFiltersModal(): void {\n    if (this.calendarFiltersSnapshot) {\n      this.restoreCalendarFilters(this.calendarFiltersSnapshot);\n    }\n    this.calendarFiltersSnapshot = null;\n    this.isCalendarFiltersModalOpen.set(false);\n  }\n\n  applyCalendarFiltersModal(): void {\n    this.calendarFiltersSnapshot = null;\n    this.isCalendarFiltersModalOpen.set(false);\n  }\n\n  clearFilters(): void {\n    this.typeFilterControl.setValue('all');\n    this.statusFilterControl.setValue('all');\n    this.userIdFilterControl.setValue('');\n    this.startDateFilterControl.setValue('');\n    this.endDateFilterControl.setValue('');\n    this.participantIdFilterControl.setValue('');\n    this.linkableTypeFilterControl.setValue('all');\n    this.linkableIdFilterControl.setValue('');\n    this.isAllDayFilterControl.setValue('all');\n    this.recurrenceFilterControl.setValue('all');\n    this.hasRemindersFilterControl.setValue('all');\n    this.locationFilterControl.setValue('');\n  }\n\n  openCalendarCreate(date?: Date, type: EventType = 'meeting'): void {\n    this.calendarEditingItem.set(null);\n    this.calendarInitialData.set({\n      type,\n      starts_at: date ? this.toInputDateTime(date) : this.toInputDateTime(new Date()),\n    });\n    this.isCalendarModalOpen.set(true);\n  }\n\n  openCalendarEdit(item: CRMEvent): void {\n    this.calendarInitialData.set(null);\n    this.calendarEditingItem.set(item);\n    this.isCalendarModalOpen.set(true);\n  }\n\n  closeCalendarModal(): void {\n    this.isCalendarModalOpen.set(false);\n    this.calendarEditingItem.set(null);\n    this.calendarInitialData.set(null);\n  }\n\n  handleCalendarSaved(_item: CRMEvent): void {\n    this.closeCalendarModal();\n    this.loadCalendarEvents();\n    const crud = this.crudPage();\n    if (crud) {\n      crud.reloadList();\n    }\n  }\n\n  handleFormSaved(item: CRMEvent): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.handleFormSaved(item);\n    }\n    this.loadCalendarEvents();\n  }\n\n  handleFormCancelled(): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.closeModal();\n    }\n  }\n\n  statusClass(status: EventStatus): string {\n    switch (status) {\n      case 'scheduled':\n        return 'bg-info/10 text-info border-info/30';\n      case 'completed':\n        return 'bg-success/10 text-success border-success/30';\n      case 'cancelled':\n        return 'bg-danger/10 text-danger border-danger/30';\n      default:\n        return 'bg-default-100 text-default-600 border-default-200';\n    }\n  }\n\n  statusLabel(status: EventStatus): string {\n    return this.statusOptions.find((option) => option.id === status)?.label ?? status;\n  }\n\n  typeLabel(type: EventType): string {\n    return this.typeOptions.find((option) => option.id === type)?.label ?? type;\n  }\n\n  private watchFilterChanges(): void {\n    merge(\n      this.typeFilterControl.valueChanges,\n      this.statusFilterControl.valueChanges,\n      this.userIdFilterControl.valueChanges,\n      this.startDateFilterControl.valueChanges,\n      this.endDateFilterControl.valueChanges,\n      this.participantIdFilterControl.valueChanges,\n      this.linkableTypeFilterControl.valueChanges,\n      this.linkableIdFilterControl.valueChanges,\n      this.isAllDayFilterControl.valueChanges,\n      this.recurrenceFilterControl.valueChanges,\n      this.hasRemindersFilterControl.valueChanges,\n      this.locationFilterControl.valueChanges.pipe(debounceTime(300), distinctUntilChanged()),\n    )\n      .pipe(startWith(null), takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => {\n        if (this.viewMode() === 'calendar') {\n          this.loadCalendarEvents();\n        }\n\n        const crud = this.crudPage();\n        if (crud) {\n          crud.goToPage(1);\n          crud.reloadList();\n        }\n      });\n  }\n\n  private watchCalendarSearch(): void {\n    this.calendarSearchControl.valueChanges\n      .pipe(debounceTime(300), distinctUntilChanged(), takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => {\n        if (this.viewMode() === 'calendar') {\n          this.loadCalendarEvents();\n        }\n      });\n  }\n\n  private loadFilterDependencies(): void {\n    this.userService\n      .list({ per_page: 200, is_active: true })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.users.set(response.data ?? []);\n        },\n        error: () => {\n          this.users.set([]);\n        },\n      });\n\n    this.contactService\n      .list({ per_page: 200, is_active: true })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.contacts.set(response.data ?? []);\n        },\n        error: () => {\n          this.contacts.set([]);\n        },\n      });\n\n    this.crmCompanyService\n      .all()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (companies) => {\n          this.companies.set(companies ?? []);\n        },\n        error: () => {\n          this.companies.set([]);\n        },\n      });\n\n    this.negotiationService\n      .list({ per_page: 200 })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.negotiations.set(response.data ?? []);\n        },\n        error: () => {\n          this.negotiations.set([]);\n        },\n      });\n  }\n\n  private buildFilters(params?: {\n    page?: number;\n    perPage?: number;\n    search?: string;\n  }): EventFilters {\n    const filters: EventFilters = {\n      search: params?.search?.trim() || undefined,\n      type: this.typeFilterControl.value === 'all' ? undefined : this.typeFilterControl.value,\n      status: this.statusFilterControl.value === 'all' ? undefined : this.statusFilterControl.value,\n      user_id: this.userIdFilterControl.value || undefined,\n      start_date: this.startDateFilterControl.value || undefined,\n      end_date: this.endDateFilterControl.value || undefined,\n      participant_id: this.participantIdFilterControl.value || undefined,\n      linkable_type:\n        this.linkableTypeFilterControl.value === 'all'\n          ? undefined\n          : this.linkableTypeFilterControl.value,\n      linkable_id: this.linkableIdFilterControl.value || undefined,\n      recurrence:\n        this.recurrenceFilterControl.value === 'all'\n          ? undefined\n          : this.recurrenceFilterControl.value,\n      location: this.locationFilterControl.value.trim() || undefined,\n      page: params?.page,\n      per_page: params?.perPage,\n      sort_by: 'starts_at',\n      sort_dir: 'asc',\n    };\n\n    if (this.isAllDayFilterControl.value === 'yes') {\n      filters.is_all_day = true;\n    }\n\n    if (this.isAllDayFilterControl.value === 'no') {\n      filters.is_all_day = false;\n    }\n\n    if (this.hasRemindersFilterControl.value === 'yes') {\n      filters.has_reminders = true;\n    }\n\n    if (this.hasRemindersFilterControl.value === 'no') {\n      filters.has_reminders = false;\n    }\n\n    return filters;\n  }\n\n  private toInputDateTime(value: string | Date | undefined): string {\n    if (!value) return '';\n    const date = typeof value === 'string' ? new Date(value) : value;\n    if (Number.isNaN(date.getTime())) return '';\n    const pad = (num: number): string => String(num).padStart(2, '0');\n    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;\n  }\n\n  private captureCalendarFilters(): CalendarFilterSnapshot {\n    return {\n      type: this.typeFilterControl.value,\n      status: this.statusFilterControl.value,\n      userId: this.userIdFilterControl.value,\n      startDate: this.startDateFilterControl.value,\n      endDate: this.endDateFilterControl.value,\n      participantId: this.participantIdFilterControl.value,\n      linkableType: this.linkableTypeFilterControl.value,\n      linkableId: this.linkableIdFilterControl.value,\n      isAllDay: this.isAllDayFilterControl.value,\n      recurrence: this.recurrenceFilterControl.value,\n      hasReminders: this.hasRemindersFilterControl.value,\n      location: this.locationFilterControl.value,\n    };\n  }\n\n  private restoreCalendarFilters(snapshot: CalendarFilterSnapshot): void {\n    this.typeFilterControl.setValue(snapshot.type);\n    this.statusFilterControl.setValue(snapshot.status);\n    this.userIdFilterControl.setValue(snapshot.userId);\n    this.startDateFilterControl.setValue(snapshot.startDate);\n    this.endDateFilterControl.setValue(snapshot.endDate);\n    this.participantIdFilterControl.setValue(snapshot.participantId);\n    this.linkableTypeFilterControl.setValue(snapshot.linkableType);\n    this.linkableIdFilterControl.setValue(snapshot.linkableId);\n    this.isAllDayFilterControl.setValue(snapshot.isAllDay);\n    this.recurrenceFilterControl.setValue(snapshot.recurrence);\n    this.hasRemindersFilterControl.setValue(snapshot.hasReminders);\n    this.locationFilterControl.setValue(snapshot.location);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/agenda/components/agenda-filter-bar/agenda-filter-bar.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarning