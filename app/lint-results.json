onent,\n    AfTextareaInputComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Quarentena\"\n      subtitle=\"Governança IA\"\n      searchPlaceholder=\"Buscar prompts em quarentena...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum prompt aguardando revisão\"\n      emptyDescription=\"Não há prompts em quarentena no momento.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"5\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar quarentena\"\n            message=\"Não foi possível carregar prompts em quarentena. Verifique sua conexão e tente novamente.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th>Tenant</th>\n              <th>Content</th>\n              <th>Motivo</th>\n              <th>Data</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (item of quarantineItems(); track item.id) {\n              <tr>\n                <td>\n                  <span class=\"font-medium\">{{ item.tenant?.name || '—' }}</span>\n                </td>\n                <td>\n                  <span class=\"text-xs text-neutral-600 dark:text-neutral-400\">\n                    {{ (item.content || '').slice(0, 120) }}...\n                  </span>\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ item.validation_status_label || item.validation_status }}\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ item.created_at }}\n                </td>\n                <td>\n                  <div class=\"flex justify-end items-center gap-1\">\n                    <af-icon-button\n                      label=\"Aprovar prompt\"\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      (click)=\"openApprove(item)\"\n                    >\n                      <lucide-icon name=\"check\" [size]=\"14\" class=\"text-success\" />\n                    </af-icon-button>\n                    <af-icon-button\n                      label=\"Rejeitar prompt\"\n                      variant=\"danger\"\n                      size=\"sm\"\n                      (click)=\"openReject(item)\"\n                    >\n                      <lucide-icon name=\"x\" [size]=\"14\" />\n                    </af-icon-button>\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <!-- Approve Confirmation -->\n    <af-confirm-modal\n      [open]=\"approveModalOpen()\"\n      title=\"Aprovar prompt\"\n      message=\"Tem certeza que deseja aprovar este prompt em quarentena?\"\n      confirmLabel=\"Aprovar\"\n      cancelLabel=\"Cancelar\"\n      variant=\"default\"\n      iconName=\"check\"\n      (confirmed)=\"confirmApprove()\"\n      (cancelled)=\"closeApprove()\"\n    />\n\n    <!-- Reject Modal -->\n    <af-modal [open]=\"rejectModalOpen()\" title=\"Rejeitar prompt\" size=\"md\" (closed)=\"closeReject()\">\n      <af-textarea-input\n        label=\"Motivo\"\n        [control]=\"rejectForm.controls.reason\"\n        [rows]=\"5\"\n        [required]=\"true\"\n        errorMessage=\"Informe o motivo da rejeição\"\n      />\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button variant=\"ghost\" size=\"sm\" (click)=\"closeReject()\">Cancelar</af-button>\n        <af-loading-button\n          variant=\"danger\"\n          size=\"sm\"\n          [loading]=\"isSaving()\"\n          [disabled]=\"rejectForm.invalid\"\n          (click)=\"confirmReject()\"\n        >\n          Rejeitar\n        </af-loading-button>\n      </div>\n    </af-modal>\n  `,\n})\nexport class PromptQuarantine implements OnInit {\n  private readonly governanceService = inject(AiGovernanceService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly fb = inject(FormBuilder);\n\n  readonly quarantineItems = signal<QuarantinedPrompt[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.quarantineItems().length === 0,\n  );\n\n  readonly approveModalOpen = signal(false);\n  readonly rejectModalOpen = signal(false);\n  readonly selectedItem = signal<QuarantinedPrompt | null>(null);\n  readonly isSaving = signal(false);\n\n  readonly rejectForm = this.fb.nonNullable.group({\n    reason: ['', [Validators.required, Validators.minLength(3)]],\n  });\n\n  private searchTerm = signal('');\n  private pageNumber = signal(1);\n\n  ngOnInit(): void {\n    this.loadQuarantine();\n  }\n\n  openApprove(item: QuarantinedPrompt): void {\n    this.selectedItem.set(item);\n    this.approveModalOpen.set(true);\n  }\n\n  closeApprove(): void {\n    this.approveModalOpen.set(false);\n    this.selectedItem.set(null);\n  }\n\n  confirmApprove(): void {\n    const current = this.selectedItem();\n    if (!current) return;\n\n    this.isSaving.set(true);\n    this.governanceService\n      .approvePrompt(current.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isSaving.set(false);\n          this.closeApprove();\n          this.loadQuarantine();\n        },\n        error: () => {\n          this.isSaving.set(false);\n        },\n      });\n  }\n\n  openReject(item: QuarantinedPrompt): void {\n    this.selectedItem.set(item);\n    this.rejectForm.reset({ reason: '' });\n    this.rejectModalOpen.set(true);\n  }\n\n  closeReject(): void {\n    this.rejectModalOpen.set(false);\n    this.selectedItem.set(null);\n  }\n\n  confirmReject(): void {\n    if (this.rejectForm.invalid || !this.selectedItem()) {\n      this.rejectForm.markAllAsTouched();\n      return;\n    }\n\n    this.isSaving.set(true);\n\n    this.governanceService\n      .rejectPrompt(this.selectedItem()!.id, this.rejectForm.controls.reason.value)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isSaving.set(false);\n          this.closeReject();\n          this.loadQuarantine();\n        },\n        error: () => {\n          this.isSaving.set(false);\n        },\n      });\n  }\n\n  onSearch(term: string): void {\n    this.searchTerm.set(term);\n    this.pageNumber.set(1);\n    this.loadQuarantine();\n  }\n\n  loadPage(page: number): void {\n    this.pageNumber.set(page);\n    this.loadQuarantine();\n  }\n\n  retry(): void {\n    this.loadQuarantine();\n  }\n\n  private loadQuarantine(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    this.governanceService\n      .listQuarantine()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.quarantineItems.set(response.data);\n          this.meta.set(response.meta);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.isLoading.set(false);\n          this.hasError.set(true);\n        },\n      });\n  }\n}\n\nexport default PromptQuarantine;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/platform/ai-governance/prompt-segments/components/prompt-segment-form/prompt-segment-form.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":98,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":98,"endColumn":35},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 15. Maximum allowed is 10.","line":112,"column":15,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":112,"endColumn":17},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":152,"column":36,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":152,"endColumn":51,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[4161,4162],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport {\n  AfSelectInputComponent,\n  AfSwitchInputComponent,\n  AfTextInputComponent,\n  AfTextareaInputComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport type { SegmentPrompt } from '../../../../../../pages/ai/models/ai.models';\nimport { AiGovernanceService } from '../../../../../../core/services/ai-governance.service';\n\n/**\n * Modal form for creating/editing segment prompts.\n */\n@Component({\n  selector: 'app-prompt-segment-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfTextInputComponent,\n    AfTextareaInputComponent,\n    AfSelectInputComponent,\n    AfSwitchInputComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <form class=\"space-y-4\" (ngSubmit)=\"submit()\">\n      <af-select-input\n        label=\"Master\"\n        [control]=\"form.controls.master_id\"\n        [options]=\"masterOptions()\"\n        [required]=\"true\"\n        dataTest=\"segment-master-id\"\n      />\n\n      <af-text-input\n        label=\"Código\"\n        [control]=\"form.controls.code\"\n        [required]=\"true\"\n        [maxLength]=\"100\"\n        errorMessage=\"Código é obrigatório.\"\n        dataTest=\"segment-code\"\n      />\n\n      <af-text-input\n        label=\"Nome\"\n        [control]=\"form.controls.name\"\n        [required]=\"true\"\n        [maxLength]=\"255\"\n        errorMessage=\"Nome é obrigatório.\"\n        dataTest=\"segment-name\"\n      />\n\n      <af-textarea-input\n        label=\"Descrição\"\n        [control]=\"form.controls.description\"\n        [rows]=\"3\"\n        dataTest=\"segment-description\"\n      />\n\n      <af-textarea-input\n        label=\"Conteúdo\"\n        [control]=\"form.controls.content\"\n        [required]=\"true\"\n        [rows]=\"10\"\n        errorMessage=\"Conteúdo é obrigatório.\"\n        dataTest=\"segment-content\"\n      />\n\n      <af-switch-input\n        [control]=\"form.controls.is_active\"\n        label=\"Ativo\"\n        dataTest=\"segment-active\"\n      />\n    </form>\n  `,\n})\nexport class PromptSegmentFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly service = inject(AiGovernanceService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly segment = input<SegmentPrompt | null>(null);\n  readonly masterOptions = input<AfSelectOption[]>([]);\n\n  readonly saved = output<SegmentPrompt>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n\n  readonly form = this.fb.nonNullable.group({\n    code: ['', [Validators.required, Validators.maxLength(100)]],\n    name: ['', [Validators.required, Validators.maxLength(255)]],\n    description: [''],\n    content: ['', [Validators.required, Validators.minLength(10)]],\n    master_id: ['', [Validators.required]],\n    is_active: [true],\n  });\n\n  constructor() {\n    effect(() => {\n      const current = this.segment();\n      this.form.reset({\n        code: current?.code ?? '',\n        name: current?.name ?? '',\n        description: current?.description ?? '',\n        content: current?.content ?? '',\n        master_id: current?.master_id ?? '',\n        is_active: current?.is_active ?? true,\n      });\n\n      if (current?.code === 'GENERAL') {\n        this.form.controls.code.disable({ emitEvent: false });\n        this.form.controls.is_active.disable({ emitEvent: false });\n      } else {\n        this.form.controls.code.enable({ emitEvent: false });\n        this.form.controls.is_active.enable({ emitEvent: false });\n      }\n    });\n  }\n\n  submit(): void {\n    if (this.form.invalid) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    this.isSaving.set(true);\n\n    const raw = this.form.getRawValue();\n    const payload = {\n      code: raw.code,\n      name: raw.name,\n      description: raw.description || undefined,\n      content: raw.content,\n      master_id: raw.master_id,\n      is_active: raw.is_active,\n    };\n\n    const request$ = this.segment()\n      ? this.service.updateSegment(this.segment()!.id, payload)\n      : this.service.createSegment(payload);\n\n    request$.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response);\n      },\n      error: () => {\n        this.isSaving.set(false);\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  hasValidData(): boolean {\n    return this.form.valid;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/platform/ai-governance/prompt-segments/prompt-segments.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfConfirmModalComponent,\n  AfCrudPageComponent,\n  AfDataTableComponent,\n  AfIconButtonComponent,\n  AfLoadingButtonComponent,\n  AfModalComponent,\n  AfStatusBadgeComponent,\n  AfTableActionsComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport type { SegmentPrompt } from '../../../ai/models/ai.models';\nimport { AiGovernanceService } from '../../../../core/services/ai-governance.service';\nimport { PromptSegmentFormComponent } from './components/prompt-segment-form/prompt-segment-form';\n\n/**\n * List and CRUD page for segment prompts.\n */\n@Component({\n  selector: 'app-prompt-segments',\n  standalone: true,\n  imports: [\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfDataTableComponent,\n    AfModalComponent,\n    AfConfirmModalComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfLoadingButtonComponent,\n    AfStatusBadgeComponent,\n    AfTableActionsComponent,\n    AfAlertComponent,\n    PromptSegmentFormComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Segmentos\"\n      subtitle=\"Governança IA\"\n      createLabel=\"Novo segmento\"\n      searchPlaceholder=\"Buscar segmentos...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum segmento encontrado\"\n      emptyDescription=\"Crie segmentos por vertical para personalizar o comportamento da IA.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"5\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (create)=\"openCreate()\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar segmentos\"\n            message=\"Não foi possível carregar os segmentos. Verifique sua conexão e tente novamente.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th>Código</th>\n              <th>Nome</th>\n              <th>Master</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (segment of segments(); track segment.id) {\n              <tr>\n                <td>\n                  <span class=\"font-medium text-sm\">{{ segment.code }}</span>\n                </td>\n                <td>\n                  <div class=\"flex flex-col\">\n                    <span class=\"font-medium\">{{ segment.name }}</span>\n                    @if (segment.description) {\n                      <span class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                        {{ segment.description }}\n                      </span>\n                    }\n                  </div>\n                </td>\n                <td>\n                  <span\n                    class=\"inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium bg-accent-500/10 text-accent-600 dark:text-accent-400\"\n                  >\n                    {{ segment.master?.name || 'Sem master' }}\n                  </span>\n                </td>\n                <td>\n                  <af-status-badge [status]=\"segment.is_active ? 'online' : 'offline'\">\n                    {{ segment.is_active ? 'Ativo' : 'Inativo' }}\n                  </af-status-badge>\n                </td>\n                <td>\n                  <div class=\"flex justify-end items-center gap-1\">\n                    @if (!segment.is_general) {\n                      <af-table-actions (edit)=\"openEdit(segment)\" (delete)=\"openDelete(segment)\" />\n                    } @else {\n                      <af-icon-button\n                        label=\"Editar segmento\"\n                        variant=\"ghost\"\n                        size=\"sm\"\n                        (click)=\"openEdit(segment)\"\n                      >\n                        <lucide-icon name=\"pencil\" [size]=\"14\" />\n                      </af-icon-button>\n                    }\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <!-- Create / Edit Modal -->\n    <af-modal\n      [open]=\"showFormModal()\"\n      [title]=\"formModalTitle()\"\n      size=\"lg\"\n      (closed)=\"handleFormCancelled()\"\n    >\n      <app-prompt-segment-form\n        #segmentForm\n        [segment]=\"selectedSegment()\"\n        [masterOptions]=\"masterOptions()\"\n        (saved)=\"handleFormSaved($event)\"\n        (cancelled)=\"handleFormCancelled()\"\n      />\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button variant=\"ghost\" size=\"sm\" (click)=\"segmentFormRef()?.cancel()\">\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"primary\"\n          size=\"sm\"\n          [loading]=\"segmentFormRef()?.isSaving() ?? false\"\n          [disabled]=\"(segmentFormRef()?.hasValidData() ?? false) === false\"\n          (click)=\"segmentFormRef()?.submit()\"\n        >\n          Salvar\n        </af-loading-button>\n      </div>\n    </af-modal>\n\n    <!-- Delete Confirmation -->\n    <af-confirm-modal\n      [open]=\"showDeleteModal()\"\n      title=\"Desativar segmento\"\n      [message]=\"deleteMessage()\"\n      confirmLabel=\"Desativar\"\n      cancelLabel=\"Cancelar\"\n      variant=\"danger\"\n      iconName=\"trash-2\"\n      (confirmed)=\"handleDeleteConfirmed()\"\n      (cancelled)=\"showDeleteModal.set(false)\"\n    />\n  `,\n})\nexport class PromptSegments implements OnInit {\n  private readonly governanceService = inject(AiGovernanceService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly segmentFormRef = viewChild<PromptSegmentFormComponent>('segmentForm');\n\n  readonly segments = signal<SegmentPrompt[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.segments().length === 0,\n  );\n\n  readonly masterOptions = signal<AfSelectOption[]>([]);\n\n  readonly showFormModal = signal(false);\n  readonly selectedSegment = signal<SegmentPrompt | null>(null);\n  readonly formModalTitle = computed(() =>\n    this.selectedSegment() ? 'Editar segmento' : 'Novo segmento',\n  );\n\n  readonly showDeleteModal = signal(false);\n  readonly segmentToDelete = signal<SegmentPrompt | null>(null);\n  readonly isDeleting = signal(false);\n  readonly deleteMessage = computed(() => {\n    const item = this.segmentToDelete();\n    return item\n      ? `Tem certeza que deseja desativar o segmento \"${item.name}\"?`\n      : 'Tem certeza que deseja desativar este segmento?';\n  });\n\n  private searchTerm = signal('');\n  private pageNumber = signal(1);\n\n  ngOnInit(): void {\n    this.loadSegments();\n    this.loadMasterOptions();\n  }\n\n  openCreate(): void {\n    this.selectedSegment.set(null);\n    this.showFormModal.set(true);\n  }\n\n  openEdit(segment: SegmentPrompt): void {\n    this.selectedSegment.set(segment);\n    this.showFormModal.set(true);\n  }\n\n  openDelete(segment: SegmentPrompt): void {\n    this.segmentToDelete.set(segment);\n    this.showDeleteModal.set(true);\n  }\n\n  handleFormSaved(_item: SegmentPrompt): void {\n    this.showFormModal.set(false);\n    this.selectedSegment.set(null);\n    this.loadSegments();\n  }\n\n  handleFormCancelled(): void {\n    this.showFormModal.set(false);\n    this.selectedSegment.set(null);\n  }\n\n  handleDeleteConfirmed(): void {\n    const target = this.segmentToDelete();\n    if (!target || this.isDeleting()) return;\n\n    this.isDeleting.set(true);\n    this.governanceService\n      .deleteSegment(target.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isDeleting.set(false);\n          this.showDeleteModal.set(false);\n          this.segmentToDelete.set(null);\n          this.loadSegments();\n        },\n        error: () => {\n          this.isDeleting.set(false);\n          this.showDeleteModal.set(false);\n        },\n      });\n  }\n\n  onSearch(term: string): void {\n    this.searchTerm.set(term);\n    this.pageNumber.set(1);\n    this.loadSegments();\n  }\n\n  loadPage(page: number): void {\n    this.pageNumber.set(page);\n    this.loadSegments();\n  }\n\n  retry(): void {\n    this.loadSegments();\n  }\n\n  private loadSegments(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    this.governanceService\n      .listSegments()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.segments.set(response.data);\n          this.meta.set(response.meta);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.isLoading.set(false);\n          this.hasError.set(true);\n        },\n      });\n  }\n\n  private loadMasterOptions(): void {\n    this.governanceService\n      .listMasters()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.masterOptions.set(\n            response.data.map((master) => ({ value: master.id, label: master.name })),\n          );\n        },\n        error: () => {\n          this.masterOptions.set([]);\n        },\n      });\n  }\n}\n\nexport default PromptSegments;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/platform/models/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/platform/models/platform-plan.model.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/platform/plans/plan-list/components/plan-crud-form/plan-crud-form.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":143,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":143,"e