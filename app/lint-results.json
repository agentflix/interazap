tpClient, HttpParams } from '@angular/common/http';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\n\n/** CRM Company model */\nexport interface CRMCompany {\n  id: string;\n  name: string;\n  document?: string;\n  email?: string;\n  phone?: string;\n  address?: string;\n  city?: string;\n  state?: string;\n  zip_code?: string;\n  is_active: boolean;\n  created_at?: string;\n  updated_at?: string;\n}\n\nexport interface CRMCompanyFilters {\n  search?: string;\n  is_active?: boolean;\n  per_page?: number;\n  page?: number;\n  sort_by?: string;\n  sort_dir?: string;\n}\n\nexport interface CRMCompanyPayload {\n  name: string;\n  document?: string;\n  email?: string;\n  phone?: string;\n  address?: string;\n  city?: string;\n  state?: string;\n  zip_code?: string;\n  is_active?: boolean;\n}\n\nexport interface CRMCompanyListResponse {\n  success: boolean;\n  data: CRMCompany[];\n  meta: {\n    current_page: number;\n    from: number;\n    last_page: number;\n    per_page: number;\n    to: number;\n    total: number;\n  };\n}\n\nexport interface CRMCompanyResponse {\n  success: boolean;\n  data: CRMCompany;\n}\n\n/**\n * Service for managing CRM companies.\n * Preserved verbatim from source — no business logic changes.\n */\n@Injectable({ providedIn: 'root' })\nexport class CRMCompanyService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/crm/companies`;\n\n  /** List companies with filters and pagination. */\n  list(params: CRMCompanyFilters = {}): Observable<CRMCompanyListResponse> {\n    let httpParams = new HttpParams();\n    if (params.search) httpParams = httpParams.set('search', params.search);\n    if (params.is_active !== undefined)\n      httpParams = httpParams.set('is_active', String(params.is_active));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.sort_by) httpParams = httpParams.set('sort_by', params.sort_by);\n    if (params.sort_dir) httpParams = httpParams.set('sort_dir', params.sort_dir);\n    return this.http.get<CRMCompanyListResponse>(this.baseUrl, { params: httpParams });\n  }\n\n  /** List all companies without pagination. */\n  all(): Observable<CRMCompany[]> {\n    return this.http\n      .get<{ data: CRMCompany[] } | CRMCompany[]>(`${this.baseUrl}/all`)\n      .pipe(map((resp) => ('data' in resp ? resp.data : resp)));\n  }\n\n  /** Get a single company by ID. */\n  get(id: string): Observable<CRMCompanyResponse> {\n    return this.http.get<CRMCompanyResponse>(`${this.baseUrl}/${id}`);\n  }\n\n  /** Create a new company. */\n  create(payload: CRMCompanyPayload): Observable<CRMCompanyResponse> {\n    return this.http.post<CRMCompanyResponse>(this.baseUrl, payload);\n  }\n\n  /** Update an existing company. */\n  update(id: string, payload: CRMCompanyPayload): Observable<CRMCompanyResponse> {\n    return this.http.put<CRMCompanyResponse>(`${this.baseUrl}/${id}`, payload);\n  }\n\n  /** Delete a company. */\n  delete(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/crm-contact.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":98,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":98,"endColumn":23,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2188,2202],"text":"filters.search != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2188,2202],"text":"filters.search ?? \"\""},"desc":"Explicitly tr