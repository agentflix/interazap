plicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":215,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":215,"endColumn":28,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[6233,6252],"text":"Boolean(errors['minlength'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":216,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":216,"endColumn":28,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[6328,6347],"text":"Boolean(errors['maxlength'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":217,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":217,"endColumn":22,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[6423,6436],"text":"Boolean(errors['min'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  inject,\n  input,\n  output,\n  signal,\n  computed,\n} from '@angular/core';\nimport { provideIcons } from '@ng-icons/core';\nimport { lucideX } from '@ng-icons/lucide';\nimport { type FormGroup, FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { FunnelService } from 'src/app/core/services/funnel.service';\nimport { NegotiationService } from 'src/app/core/services/negotiation.service';\nimport { UserService } from 'src/app/core/services/user.service';\nimport type { CRMNegotiation } from '../crm-section';\nimport { TextInputComponent } from 'src/app/shared/components/text-input/text-input';\nimport { CurrencyInputComponent } from 'src/app/shared/components/currency-input/currency-input';\nimport type { SelectOption } from 'src/app/shared/components/select-input/select-input';\nimport { SelectInputComponent } from 'src/app/shared/components/select-input/select-input';\nimport { TextareaInputComponent } from 'src/app/shared/components/textarea-input/textarea-input';\nimport {\n  ButtonComponent,\n  IconButtonComponent,\n  LoadingButtonComponent,\n} from 'src/app/shared/components/buttons';\n\n/**\n * Modal para criar ou editar negociação.\n * Formulário reativo com validação client-side.\n */\n@Component({\n  selector: 'app-deal-edit-modal',\n  templateUrl: './deal-edit-modal.component.html',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [\n    ReactiveFormsModule,\n    TextInputComponent,\n    CurrencyInputComponent,\n    SelectInputComponent,\n    TextareaInputComponent,\n    ButtonComponent,\n    IconButtonComponent,\n    LoadingButtonComponent,\n  ],\n  host: { class: 'block' },\n  viewProviders: [provideIcons({ lucideX })],\n})\nexport class DealEditModalComponent implements OnInit {\n  private readonly fb = inject(FormBuilder);\n  private readonly negotiationService = inject(NegotiationService);\n  private readonly funnelService = inject(FunnelService);\n  private readonly userService = inject(UserService);\n\n  readonly isOpen = input.required<boolean>();\n  readonly deal = input<CRMNegotiation | null>(null);\n  readonly contactId = input.required<string>();\n  readonly closeModal = output<void>();\n  readonly dealSaved = output<CRMNegotiation>();\n\n  readonly form: FormGroup;\n  readonly isSaving = signal(false);\n  readonly funnels = signal<\n    {\n      id: string | number;\n      name: string;\n      steps?: { id: string | number; name: string }[];\n    }[]\n  >([]);\n  readonly users = signal<{ id: string; name: string }[]>([]);\n\n  constructor() {\n    this.form = this.fb.group({\n      title: ['', [Validators.required, Validators.minLength(3), Validators.maxLength(255)]],\n      value: [0, [Validators.required, Validators.min(0)]],\n      funnel_id: ['', Validators.required],\n      step_id: ['', Validators.required],\n      responsible_id: [''],\n      expected_close: [''],\n      notes: ['', Validators.maxLength(1000)],\n    });\n  }\n\n  ngOnInit(): void {\n    this.loadFunnels();\n    this.loadUsers();\n\n    // Preencher formulário se edição\n    if (this.deal()) {\n      const d = this.deal()!;\n      this.form.patchValue({\n        title: d.title,\n        value: d.value ?? d.amount ?? 0,\n        funnel_id: d.funnel_id ?? d.funnel?.id ?? '',\n        step_id: d.step?.id ?? '',\n        responsible_id: d.user?.id ?? '',\n        expected_close: d.expected_close ?? d.expected_close_date ?? '',\n      });\n    }\n  }\n\n  /**\n   * Carregar funis disponíveis.\n   */\n  loadFunnels(): void {\n    this.funnelService.list().subscribe({\n      next: (response) => {\n        const items = response.data ?? [];\n        this.funnels.set(items);\n        if (items.length > 0 && !this.deal()) {\n          this.form.patchValue({ funnel_id: items[0].id, step_id: items[0].steps?.[0]?.id });\n        }\n      },\n    });\n  }\n\n  /**\n   * Carregar usuários para responsável.\n   */\n  loadUsers(): void {\n    this.userService.list().subscribe({\n      next: (response) => {\n        this.users.set(response.data ?? []);\n      },\n    });\n  }\n\n  /**\n   * Obter etapas do funil selecionado.\n   */\n  get selectedFunnelSteps(): { id: string | number; name: string }[] {\n    const funnelId = this.form.get('funnel_id')?.value;\n    const funnel = this.funnels().find((f) => f.id === funnelId);\n    return funnel?.steps || [];\n  }\n\n  /**\n   * Opções de funis formatadas para SelectInputComponent.\n   */\n  readonly funnelOptions = computed<SelectOption[]>(() =>\n    this.funnels().map((f) => ({ value: f.id.toString(), label: f.name })),\n  );\n\n  /**\n   * Opções de etapas formatadas para SelectInputComponent.\n   */\n  readonly stepOptions = computed<SelectOption[]>(() =>\n    this.selectedFunnelSteps.map((s) => ({ value: s.id.toString(), label: s.name })),\n  );\n\n  /**\n   * Opções de usuários formatadas para SelectInputComponent.\n   */\n  readonly userOptions = computed<SelectOption[]>(() =>\n    this.users().map((u) => ({ value: u.id, label: u.name })),\n  );\n\n  /**\n   * Salvar negociação (criar ou atualizar).\n   */\n  onSubmit(): void {\n    if (this.form.invalid) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    this.isSaving.set(true);\n    const payload = {\n      ...this.form.value,\n      crm_contact_id: this.contactId(),\n    };\n\n    const save$ = this.deal()\n      ? this.negotiationService.update(this.deal()!.id, payload)\n      : this.negotiationService.create(payload);\n\n    save$.subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.dealSaved.emit(response.data.negotiation as CRMNegotiation);\n      },\n      error: () => {\n        this.isSaving.set(false);\n      },\n    });\n  }\n\n  /**\n   * Fechar modal.\n   */\n  onClose(): void {\n    this.form.reset();\n    this.closeModal.emit();\n  }\n\n  /**\n   * Verificar se campo tem erro.\n   */\n  hasError(field: string): boolean {\n    const control = this.form.get(field);\n    return !!(control && control.invalid && control.touched);\n  }\n\n  /**\n   * Mensagem de erro do campo.\n   */\n  getErrorMessage(field: string): string {\n    const control = this.form.get(field);\n    if (!control || !control.errors) return '';\n\n    const errors = control.errors;\n    if (errors['required']) return 'Campo obrigatório';\n    if (errors['minlength']) return `Mínimo ${errors['minlength'].requiredLength} caracteres`;\n    if (errors['maxlength']) return `Máximo ${errors['maxlength'].requiredLength} caracteres`;\n    if (errors['min']) return `Valor mínimo: ${errors['min'].min}`;\n\n    return 'Campo inválido';\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chat-sidebar/crm-section/deal-loss-modal/deal-loss-modal.component.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chat-sidebar/crm-section/deal-loss-modal/deal-loss-modal.component.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/forms' import is duplicated.","line":14,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":14,"endColumn":79},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":56,"column":32,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":56,"endColumn":36},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":57,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":57,"endColumn":35}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  computed,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { provideIcons } from '@ng-icons/core';\nimport { lucideX } from '@ng-icons/lucide';\nimport type { FormControl, FormGroup } from '@angular/forms';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { NegotiationService } from 'src/app/core/services/negotiation.service';\nimport { ReasonLossService } from 'src/app/core/services/reason-loss.service';\nimport type { CRMNegotiation } from '../crm-section';\nimport {\n  ButtonComponent,\n  IconButtonComponent,\n  LoadingButtonComponent,\n} from 'src/app/shared/components/buttons';\nimport {\n  SelectInputComponent,\n  TextareaInputComponent,\n  type SelectOption,\n} from 'src/app/shared/components/inputs';\n\n/**\n * Modal para marcar negociação como perdida.\n * Motivo obrigatório, observações opcionais.\n */\n@Component({\n  selector: 'app-deal-loss-modal',\n  templateUrl: './deal-loss-modal.component.html',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [\n    ReactiveFormsModule,\n    ButtonComponent,\n    IconButtonComponent,\n    LoadingButtonComponent,\n    SelectInputComponent,\n    TextareaInputComponent,\n  ],\n  host: { class: 'block' },\n  viewProviders: [provideIcons({ lucideX })],\n})\nexport class DealLossModalComponent implements OnInit {\n  private readonly fb = inject(FormBuilder);\n  private readonly negotiationService = inject(NegotiationService);\n  private readonly reasonLossService = inject(ReasonLossService);\n\n  readonly isOpen = input.required<boolean>();\n  readonly deal = input.required<CRMNegotiation>();\n  readonly closeModal = output<void>();\n  readonly confirmed = output<void>();\n\n  readonly form: FormGroup<{\n    reason_id: FormControl<string | number | null>;\n    notes: FormControl<string | null>;\n  }>;\n  readonly isConfirming = signal(false);\n  readonly reasons = signal<{ id: string | number; name: string }[]>([]);\n  readonly reasonOptions = computed<readonly SelectOption[]>(() =>\n    this.reasons().map((reason) => ({\n      value: reason.id,\n      label: reason.name,\n    })),\n  );\n\n  constructor() {\n    this.form = this.fb.group({\n      reason_id: this.fb.control<string | number | null>('', Validators.required),\n      notes: this.fb.control<string | null>('', Validators.maxLength(500)),\n    });\n  }\n\n  ngOnInit(): void {\n    this.loadReasons();\n  }\n\n  /**\n   * Carregar motivos de perda.\n   */\n  loadReasons(): void {\n    this.reasonLossService.list({ active: true }).subscribe({\n      next: (response) => {\n        this.reasons.set(response.data);\n      },\n    });\n  }\n\n  /**\n   * Confirmar perda da negociação.\n   */\n  onConfirm(): void {\n    if (this.form.invalid) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    this.isConfirming.set(true);\n    const { reason_id, notes } = this.form.value;\n\n    this.negotiationService.markAsLost(this.deal().id, reason_id, notes).subscribe({\n      next: () => {\n        this.isConfirming.set(false);\n        this.confirmed.emit();\n      },\n      error: () => {\n        this.isConfirming.set(false);\n      },\n    });\n  }\n\n  /**\n   * Fechar modal.\n   */\n  onClose(): void {\n    this.form.reset();\n    this.closeModal.emit();\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chat-sidebar/crm-section/deal-win-modal/deal-win-modal.component.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chat-sidebar/crm-section/deal-win-modal/deal-win-modal.component.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":31,"co