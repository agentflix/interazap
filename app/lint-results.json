pdated_at?: string;\n}\n\nexport interface Funnel {\n  id: string | number;\n  name: string;\n  description?: string;\n  is_active: boolean;\n  is_default?: boolean;\n  steps?: FunnelStep[];\n  steps_count?: number;\n  created_at?: string;\n  updated_at?: string;\n}\n\nexport interface FunnelFilters {\n  search?: string;\n  is_active?: boolean | string;\n  per_page?: number;\n  page?: number;\n}\n\nexport interface PaginatedResponse<T> {\n  data: T[];\n  meta: {\n    current_page: number;\n    last_page: number;\n    per_page: number;\n    total: number;\n  };\n}\n\nexport interface FunnelPayload {\n  name: string;\n  description?: string;\n  is_active?: boolean;\n  steps?: FunnelStepPayload[];\n}\n\nexport interface FunnelStepPayload {\n  name: string;\n  order?: number;\n  color?: string;\n  is_active?: boolean;\n}\n\n@Injectable({ providedIn: 'root' })\nexport class FunnelService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/crm/funnels`;\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Funnels CRUD\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  list(filters: FunnelFilters = {}): Observable<PaginatedResponse<Funnel>> {\n    let params = new HttpParams();\n\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.is_active !== undefined && filters.is_active !== 'all') {\n      params = params.set(\n        'is_active',\n        String(filters.is_active === true || filters.is_active === 'active'),\n      );\n    }\n    if (filters.per_page) params = params.set('per_page', String(filters.per_page));\n    if (filters.page) params = params.set('page', String(filters.page));\n\n    return this.http.get<PaginatedResponse<Funnel>>(this.baseUrl, { params });\n  }\n\n  all(): Observable<{ data: { funnels: Funnel[] } }> {\n    return this.http.get<{ data: Funnel[] | { funnels?: Funnel[] } }>(`${this.baseUrl}/all`).pipe(\n      map((response) => {\n        const data = response.data;\n        const funnels = Array.isArray(data) ? data : (data?.funnels ?? []);\n\n        return { data: { funnels } };\n      }),\n    );\n  }\n\n  get(id: string | number): Observable<{ data: { funnel: Funnel } }> {\n    return this.http.get<{ data: { funnel: Funnel } }>(`${this.baseUrl}/${id}`);\n  }\n\n  create(payload: FunnelPayload): Observable<{ data: { funnel: Funnel } }> {\n    return this.http.post<{ data: { funnel: Funnel } }>(this.baseUrl, payload);\n  }\n\n  update(id: string | number, payload: FunnelPayload): Observable<{ data: { funnel: Funnel } }> {\n    return this.http.put<{ data: { funnel: Funnel } }>(`${this.baseUrl}/${id}`, payload);\n  }\n\n  delete(id: string | number): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Funnel Steps CRUD\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  listSteps(funnelId: string | number): Observable<{ data: { steps: FunnelStep[] } }> {\n    return this.http.get<{ data: { steps: FunnelStep[] } }>(`${this.baseUrl}/${funnelId}/steps`);\n  }\n\n  createStep(\n    funnelId: string | number,\n    payload: FunnelStepPayload,\n  ): Observable<{ data: { step: FunnelStep } }> {\n    return this.http.post<{ data: { step: FunnelStep } }>(\n      `${this.baseUrl}/${funnelId}/steps`,\n      payload,\n    );\n  }\n\n  updateStep(\n    funnelId: string | number,\n    stepId: string | number,\n    payload: FunnelStepPayload,\n  ): Observable<{ data: { step: FunnelStep } }> {\n    return this.http.put<{ data: { step: FunnelStep } }>(\n      `${this.baseUrl}/${funnelId}/steps/${stepId}`,\n      payload,\n    );\n  }\n\n  deleteStep(funnelId: string | number, stepId: string | number): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${funnelId}/steps/${stepId}`);\n  }\n\n  reorderSteps(funnelId: string | number, stepIds: (string | number)[]): Observable<void> {\n    const steps = stepIds.map((id, index) => ({ id, order: index + 1 }));\n    return this.http.post<void>(`${this.baseUrl}/${funnelId}/steps/reorder`, { steps });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/instance.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":71,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":71,"endColumn":23,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1991,2005],"text":"filters.search != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1991,2005],"text":"filters.search ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1991,2005],"text":"Boolean(filters.search)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected value in conditional. A boolean expression is required.","line":72,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorOther","endLine":72,"endColumn":31},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":78,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":78,"endColumn":25,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2365,2381],"text":"filters.per_page != null"},"desc":"Change condition to check for n