e\n * ```html\n * <af-accordion-item title=\"FAQ #1\" [open]=\"true\">\n *   <p>Answer content here.</p>\n * </af-accordion-item>\n * ```\n */\n@Component({\n  selector: 'af-accordion-item',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"border-b border-neutral-200 dark:border-neutral-700\">\n      <button\n        type=\"button\"\n        class=\"flex items-center justify-between w-full px-4 py-3 text-left\n          text-sm font-medium text-neutral-900 dark:text-neutral-50\n          hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors cursor-pointer\"\n        [attr.aria-expanded]=\"isOpen()\"\n        (click)=\"toggle()\"\n      >\n        <span>{{ title() }}</span>\n        <lucide-icon\n          [name]=\"isOpen() ? 'chevron-up' : 'chevron-down'\"\n          [size]=\"16\"\n          class=\"text-neutral-400 transition-transform\"\n        />\n      </button>\n      @if (isOpen()) {\n        <div class=\"px-4 pb-4 text-sm text-neutral-600 dark:text-neutral-400\">\n          <ng-content />\n        </div>\n      }\n    </div>\n  `,\n})\nexport class AfAccordionItemComponent {\n  /** Panel title */\n  readonly title = input.required<string>();\n\n  /** Initial open state */\n  readonly open = input(false);\n\n  protected readonly isOpen = signal(false);\n\n  constructor() {\n    // defer reading input to init\n    queueMicrotask(() => this.isOpen.set(this.open()));\n  }\n\n  protected toggle(): void {\n    this.isOpen.update((v) => !v);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/addon-input/addon-input.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":99,"column":32,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":99,"endColumn":36}],"s