pression","messageId":"noNonNull","endLine":245,"endColumn":45},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected value in conditional. A boolean expression is required.","line":251,"column":15,"nodeType":"Identifier","messageId":"conditionErrorOther","endLine":251,"endColumn":29},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected value in conditional. A boolean expression is required.","line":276,"column":9,"nodeType":"Identifier","messageId":"conditionErrorOther","endLine":276,"endColumn":24}],"suppressedMessages":[],"errorCount":23,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport type { SelectOption } from '@shared/components/inputs';\nimport {\n  CurrencyInputComponent,\n  SelectInputComponent,\n  TextInputComponent,\n  TextareaInputComponent,\n} from '@shared/components/inputs';\nimport type {\n  Negotiation,\n  NegotiationPayload,\n  NegotiationStatus,\n} from 'src/app/core/services/negotiation.service';\nimport { NegotiationService } from 'src/app/core/services/negotiation.service';\nimport type { Funnel, FunnelStep } from 'src/app/core/services/funnel.service';\nimport { FunnelService } from 'src/app/core/services/funnel.service';\nimport type { Contact } from 'src/app/core/models/contact.model';\nimport type { CRMCompany } from 'src/app/core/services/crm-company.service';\n\nimport type { User } from 'src/app/core/services/user.service';\n\n@Component({\n  selector: 'app-negotiation-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    CurrencyInputComponent,\n    SelectInputComponent,\n    TextInputComponent,\n    TextareaInputComponent,\n  ],\n  templateUrl: './negotiation-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class NegotiationFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly negotiationService = inject(NegotiationService);\n  private readonly funnelService = inject(FunnelService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | number | null>(null);\n\n  readonly negotiation = input<Negotiation | null>(null);\n  readonly funnels = input<Funnel[]>([]);\n  readonly contacts = input<Contact[]>([]);\n  readonly companies = input<CRMCompany[]>([]);\n  readonly users = input<User[]>([]);\n  readonly initialFunnelId = input<string | number | null>(null);\n\n  readonly saved = output<Negotiation>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n  readonly steps = signal<FunnelStep[]>([]);\n  readonly selectedCompanyId = signal<string | number | null>(null);\n\n  readonly filteredContacts = computed(() => {\n    const companyId = this.selectedCompanyId();\n    const allContacts = this.contacts();\n    if (!companyId) return allContacts;\n    return allContacts.filter((contact) => String(contact.crm_company_id) === String(companyId));\n  });\n\n  readonly contactOptions = computed<SelectOption[]>(() =>\n    this.filteredContacts().map((contact) => ({ value: contact.id, label: contact.name })),\n  );\n\n  readonly companyOptions = computed<SelectOption[]>(() =>\n    this.companies().map((company) => ({ value: company.id, label: company.name })),\n  );\n\n  readonly userOptions = computed<SelectOption[]>(() =>\n    this.users().map((user) => ({ value: user.id, label: user.name })),\n  );\n\n  readonly funnelOptions = computed<SelectOption[]>(() =>\n    this.funnels().map((funnel) => ({ value: funnel.id, label: funnel.name })),\n  );\n\n  readonly stepOptions = computed<SelectOption[]>(() =>\n    this.steps().map((step) => ({ value: step.id, label: step.name })),\n  );\n\n  readonly formStatusOptions: SelectOption[] = [\n    { label: 'Aberta', value: 'open' },\n    { label: 'Ganha', value: 'won' },\n    { label: 'Perdida', value: 'lost' },\n  ];\n\n  readonly form = this.fb.group({\n    title: this.fb.control('', Validators.required),\n    contact_id: this.fb.control<string | number | null>(null, Validators.required),\n    value: this.fb.control<number | null>(null),\n    user_id: this.fb.control<string | number | null>(null, Validators.required),\n    crm_company_id: this.fb.control<string | number | null>(null, Validators.required),\n    funnel_id: this.fb.control<string | number | null>(null, Validators.required),\n    step_id: this.fb.control<string | number | null>(null, Validators.required),\n    expected_close_date: this.fb.control(''),\n    status: this.fb.control<NegotiationStatus>('open'),\n    notes: this.fb.control(''),\n  });\n\n  constructor() {\n    effect(() => {\n      const item = this.negotiation();\n      if (item) {\n        if (this.lastLoadedId() === item.id) {\n          return;\n        }\n        this.lastLoadedId.set(item.id);\n        this.form.reset({\n          title: item.title,\n          contact_id: item.contact_id ?? null,\n          value: item.value ?? null,\n          user_id: item['user_id'] ?? null,\n          crm_company_id: item.crm_company_id ?? null,\n          funnel_id: item.funnel_id ?? null,\n          step_id: item.step_id ?? null,\n          expected_close_date: item.expected_close_date ?? '',\n          status: item.status ?? 'open',\n          notes: item.notes ?? '',\n        });\n        this.selectedCompanyId.set(item.crm_company_id ?? null);\n\n        if (item.funnel_id) {\n          this.loadStepsForFunnel(item.funnel_id, item.step_id ?? null);\n        }\n        return;\n      }\n\n      this.lastLoadedId.set(null);\n      this.resetForm();\n    });\n\n    this.form.controls.funnel_id.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((funnelId) => {\n        if (funnelId) {\n          this.loadStepsForFunnel(this.normalizeId(funnelId)!, null);\n        } else {\n          this.steps.set([]);\n          this.form.controls.step_id.setValue(null);\n        }\n      });\n\n    this.form.controls.crm_company_id.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((companyId) => {\n        const normalizedCompanyId = this.normalizeId(companyId ?? null);\n        this.selectedCompanyId.set(normalizedCompanyId);\n\n        if (!normalizedCompanyId) {\n          return;\n        }\n\n        const contacts = this.filteredContacts();\n        if (contacts.length === 1) {\n          this.form.controls.contact_id.setValue(contacts[0].id);\n          return;\n        }\n\n        const currentContactId = this.normalizeId(this.form.controls.contact_id.value);\n        if (\n          currentContactId &&\n          !contacts.some((contact) => String(contact.id) === String(currentContactId))\n        ) {\n          this.form.controls.contact_id.setValue(null);\n        }\n      });\n\n    this.form.controls.contact_id.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((contactId) => {\n        const normalizedContactId = this.normalizeId(contactId ?? null);\n        if (!normalizedContactId) return;\n\n        const contact = this.contacts().find(\n          (item) => String(item.id) === String(normalizedContactId),\n        );\n        if (contact?.crm_company_id) {\n          this.selectedCompanyId.set(contact.crm_company_id);\n          this.form.controls.crm_company_id.setValue(contact.crm_company_id, { emitEvent: false });\n        }\n      });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n    const payload: NegotiationPayload = {\n      title: formValue.title,\n      contact_id: formValue.contact_id!,\n      value: formValue.value || undefined,\n      user_id: formValue.user_id!,\n      crm_company_id: formValue.crm_company_id!,\n      funnel_id: formValue.funnel_id!,\n      step_id: formValue.step_id!,\n      expected_close_date: formValue.expected_close_date || undefined,\n      status: formValue.status || 'open',\n      notes: formValue.notes || undefined,\n    };\n\n    const editing = this.negotiation();\n    this.isSaving.set(true);\n\n    const request = editing\n      ? this.negotiationService.update(editing.id, payload)\n      : this.negotiationService.create(payload);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response.data.negotiation);\n      },\n      error: () => {\n        this.isSaving.set(false);\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private loadStepsForFunnel(\n    funnelId: string | number,\n    selectedStepId: string | number | null = null,\n  ): void {\n    this.funnelService\n      .listSteps(this.normalizeId(funnelId)!)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const steps = response.data?.steps ?? [];\n          this.steps.set(steps);\n          if (selectedStepId) {\n            this.form.controls.step_id.setValue(selectedStepId);\n          } else if (steps.length) {\n            this.form.controls.step_id.setValue(steps[0].id);\n          }\n        },\n      });\n  }\n\n  private resetForm(): void {\n    const initialFunnelId = this.normalizeId(this.initialFunnelId());\n    this.form.reset({\n      title: '',\n      contact_id: null,\n      value: null,\n      user_id: null,\n      crm_company_id: null,\n      funnel_id: initialFunnelId,\n      step_id: null,\n      expected_close_date: '',\n      status: 'open',\n      notes: '',\n    });\n    this.selectedCompanyId.set(null);\n\n    if (initialFunnelId) {\n      this.loadStepsForFunnel(initialFunnelId);\n    } else {\n      this.steps.set([]);\n    }\n  }\n\n  private normalizeId(value: string | number | null): string | number | null {\n    if (value === null || value === '') return null;\n    if (typeof value === 'string') {\n      const numeric = Number(value);\n      return Number.isNaN(numeric) ? value : numeric;\n    }\n    return value;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/negotiations/negotiations.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/negotiations/negotiations.spec.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core/testing' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":49},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (158). Maximum allowed is 80.","line":8,"column":26,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":165,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ComponentFixture } from '@angular/core/testing';\nimport { TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\nimport { provideRouter } from '@angular/router';\nimport { Negotiations } from './negotiations';\n\ndescribe('Negotiations', () => {\n  let component: Negotiations;\n  let fixture: ComponentFixture<Negotiations>;\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [Negotiations],\n      providers: [provideHttpClient(), provideHttpClientTesting(), provideRouter([])],\n    }).compileComponents();\n\n    fixture = TestBed.createComponent(Negotiations);\n    component = fixture.componentInstance;\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should default to kanban view mode', () => {\n    expect(component.viewMode()).toBe('kanban');\n  });\n\n  it('should format currency', () => {\n    expect(\n      component.getStepTotal({\n        id: 1,\n        name: 'Step',\n        order: 1,\n        is_active: true,\n        negotiations: [{ id: 1, title: 'A', status: 'open', value: 1000 }],\n      }),\n    ).toBe(1000);\n  });\n\n  it('should map status labels', () => {\n    expect(component.getStatusLabel('open')).toBe('Aberta');\n    expect(component.getStatusLabel('won')).toBe('Ganha');\n    expect(component.getStatusLabel('lost')).toBe('Perdida');\n  });\n\n  it('should return drop list id', () => {\n    expect(\n      component.getDropListId({\n        id: 12,\n        funnel_id: 1,\n        name: 'Step',\n        order: 1,\n        is_active: true,\n        negotiations: [],\n      }),\n    ).toBe('step-12');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Currency Formatting\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should format zero currency', () => {\n    expect(\n      component.getStepTotal({ id: 1, name: 'Step', order: 1, is_active: true, negotiations: [] }),\n    ).toBe(0);\n  });\n\n  it('should format large currency values', () => {\n    expect(component.formatDate('2026-01-01')).not.toBe('-');\n  });\n\n  it('should format decimal currency values', () => {\n    expect(component.formatDate('invalid-date')).toBe('-');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Status Labels\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should return default status for unknown values', () => {\n    // Component uses default case which returns 'Aberta' for any unrecognized status\n\n    expect(\n      component.getStatusLabel('unknown' as Parameters<typeof component.getStatusLabel>[0]),\n    ).toBe('Aberta');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Drop List ID\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should generate drop list id with string id', () => {\n    expect(\n      component.getDropListId({\n        id: 'step-abc',\n        funnel_id: 1,\n        name: 'Step',\n        order: 1,\n        is_active: true,\n        negotiations: [],\n      }),\n    ).toBe('step-step-abc');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // CRUD Service\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure crud service with required methods', () => {\n    expect(component.crudService.list).toBeDefined();\n    expect(component.crudService.find).toBeDefined();\n    expect(component.crudService.create).toBeDefined();\n    expect(component.crudService.update).toBeDefined();\n    expect(component.crudService.delete).toBeDefined();\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // CRUD Config\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure crudConfig with correct labels', () => {\n    expect(component.crudConfig.labels?.singular).toBeDefined();\n    expect(component.crudConfig.labels?.plural).toBeDefined();\n  });\n\n  it('should have search enabled', () => {\n    expect(component.crudConfig.enableSearch).toBe(false);\n  });\n\n  it('should have filters disabled by default', () => {\n    // Component uses custom filter dialog, not crud built-in filters\n    expect(component.crudConfig.enableFilters).toBe(false);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Columns Configuration\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure title column', () => {\n    expect(component.columns.some((column) => column.field === 'title')).toBe(true);\n  });\n\n  it('should configure value column', () => {\n    expect(component.columns.some((column) => column.field === 'value')).toBe(true);\n  });\n\n  it('should configure status column', () => {\n    expect(component.columns.some((column) => column.field === 'status')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Actions Configuration\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure actions with edit', () => {\n    expect(component.actions.some((action) => action.type === 'edit')).toBe(true);\n  });\n\n  it('should configure actions with delete', () => {\n    expect(component.actions.some((action) => action.type === 'delete')).toBe(true);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/negotiations/negotiations.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":11,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/cdk/drag-drop' import is duplicated.","line":31,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":31,"endColumn":93},{"ruleId":"no-duplicate-imports","severity":2,"message":"'rxjs' import is duplicated.","line":33,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":33,"endColumn":30},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@shared/components/in