onent,\n  AfPageTitleComponent,\n  AfSelectInputComponent,\n  AfSwitchInputComponent,\n  AfTextInputComponent,\n  AfTextareaInputComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { ToastService } from '../../../../../core/services/toast.service';\nimport type { AiAgent, AiAgentPayload } from '../../../models/ai.models';\nimport { AiAgentService } from '../../../services/ai-agent.service';\n\n/**\n * Create or edit an AI agent.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-agent-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfTextInputComponent,\n    AfSelectInputComponent,\n    AfTextareaInputComponent,\n    AfSwitchInputComponent,\n    AfButtonComponent,\n    AfLoadingButtonComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title [title]=\"pageTitle()\" subtitle=\"Inteligência Artificial\" />\n\n    <div class=\"grid grid-cols-1 gap-5 mb-5\">\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n      >\n        @if (isLoading()) {\n          <div class=\"flex items-center justify-center py-10\">\n            <lucide-icon name=\"loader\" [size]=\"32\" class=\"text-accent-500 animate-spin\" />\n          </div>\n        } @else {\n          <form [formGroup]=\"form\" (ngSubmit)=\"submit()\" class=\"space-y-6\">\n            <!-- Basic Info -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <af-text-input\n                [control]=\"form.controls.name\"\n                label=\"Nome do Agente\"\n                placeholder=\"Ex: Vendedor Principal\"\n                [required]=\"true\"\n                dataTest=\"agent-name\"\n              />\n              <af-select-input\n                [control]=\"form.controls.type\"\n                label=\"Tipo\"\n                [options]=\"agentTypes\"\n                [required]=\"true\"\n                dataTest=\"agent-type\"\n              />\n            </div>\n\n            <!-- Model Settings -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              <af-select-input\n                [control]=\"form.controls.model_id\"\n                label=\"Modelo\"\n                [options]=\"modelOptions\"\n                dataTest=\"agent-model\"\n              />\n              <div>\n                <af-text-input\n                  [control]=\"form.controls.temperature\"\n                  label=\"Temperatura\"\n                  type=\"number\"\n                  dataTest=\"agent-temperature\"\n                />\n                <p class=\"text-xs text-neutral-500 mt-1\">0 = preciso, 2 = criativo</p>\n              </div>\n              <af-text-input\n                [control]=\"form.controls.max_tokens\"\n                label=\"Max Tokens\"\n                type=\"number\"\n                dataTest=\"agent-max-tokens\"\n              />\n            </div>\n\n            <!-- System Prompt -->\n            <af-textarea-input\n              [control]=\"form.controls.system_prompt\"\n              label=\"System Prompt\"\n              placeholder=\"Instruções gerais para o agente...\"\n              [rows]=\"6\"\n              dataTest=\"agent-system-prompt\"\n            />\n            <p class=\"text-xs text-neutral-500 -mt-4\">\n              Defina o comportamento padrão do agente. Deixe em branco para usar o prompt global.\n            </p>\n\n            <!-- Active Toggle -->\n            <af-switch-input [control]=\"form.controls.is_active\" label=\"Agente ativo\" />\n\n            <!-- Actions -->\n            <div\n              class=\"flex items-center justify-between pt-4 border-t border-neutral-200 dark:border-neutral-700\"\n            >\n              <af-button variant=\"ghost\" size=\"sm\" type=\"button\" (click)=\"goBack()\">\n                <lucide-icon name=\"arrow-left\" [size]=\"16\" class=\"block\" />\n                Voltar\n              </af-button>\n\n              <af-loading-button\n                variant=\"primary\"\n                size=\"sm\"\n                type=\"submit\"\n                [loading]=\"isSaving()\"\n                [disabled]=\"form.invalid\"\n              >\n                <lucide-icon name=\"save\" [size]=\"16\" class=\"block\" />\n                {{ isEditMode() ? 'Atualizar' : 'Criar' }}\n              </af-loading-button>\n            </div>\n          </form>\n        }\n      </div>\n    </div>\n  `,\n})\nexport class AgentFormComponent implements OnInit {\n  private readonly fb = inject(FormBuilder);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly agentService = inject(AiAgentService);\n  private readonly toast = inject(ToastService);\n\n  readonly isLoading = signal(false);\n  readonly isSaving = signal(false);\n  readonly agentId = signal<string | null>(null);\n\n  readonly isEditMode = computed(() => this.agentId() !== null);\n  readonly pageTitle = computed(() => (this.isEditMode() ? 'Editar Agente' : 'Novo Agente'));\n\n  readonly form = this.fb.group({\n    name: ['', [Validators.required, Validators.minLength(3), Validators.maxLength(100)]],\n    type: ['sales' as AiAgent['type'], [Validators.required]],\n    model_id: ['gpt-4o-mini'],\n    system_prompt: [''],\n    max_tokens: [2048, [Validators.required, Validators.min(100), Validators.max(8192)]],\n    temperature: [0.7, [Validators.required, Validators.min(0), Validators.max(2)]],\n    top_p: [1.0, [Validators.required, Validators.min(0), Validators.max(1)]],\n    is_active: [true],\n  });\n\n  readonly agentTypes: AfSelectOption[] = [\n    { value: 'sales', label: 'Vendas' },\n    { value: 'support', label: 'Suporte' },\n    { value: 'qualifier', label: 'Qualificador' },\n  ];\n\n  readonly modelOptions: AfSelectOption[] = [\n    { value: 'gpt-4o', label: 'GPT-4o (Avançado)' },\n    { value: 'gpt-4o-mini', label: 'GPT-4o Mini (Rápido)' },\n  ];\n\n  ngOnInit(): void {\n    const id = this.route.snapshot.paramMap.get('id');\n    if (id) {\n      this.agentId.set(id);\n      this.loadAgent(id);\n    }\n  }\n\n  /**\n   * Load agent data for editing.\n   */\n  private loadAgent(id: string): void {\n    this.isLoading.set(true);\n    this.agentService.get(id).subscribe({\n      next: (agent) => {\n        this.form.patchValue({\n          name: agent.name,\n          type: agent.type,\n          model_id: agent.model_id ?? 'gpt-4o-mini',\n          system_prompt: agent.system_prompt ?? '',\n          max_tokens: agent.max_tokens,\n          temperature: agent.temperature,\n          top_p: agent.top_p,\n          is_active: agent.is_active,\n        });\n        this.isLoading.set(false);\n      },\n      error: () => {\n        this.toast.error('Erro ao carregar agente.');\n        this.isLoading.set(false);\n        void this.router.navigate(['/ai/agents']);\n      },\n    });\n  }\n\n  /**\n   * Submit form to create or update agent.\n   */\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) return;\n\n    this.isSaving.set(true);\n    const payload = this.form.value as AiAgentPayload;\n\n    const request$ = this.isEditMode()\n      ? this.agentService.update(this.agentId()!, payload)\n      : this.agentService.create(payload);\n\n    request$.subscribe({\n      next: () => {\n        this.isSaving.set(false);\n        this.toast.success(this.isEditMode() ? 'Agente atualizado.' : 'Agente criado.');\n        void this.router.navigate(['/ai/agents']);\n      },\n      error: () => {\n        this.isSaving.set(false);\n        this.toast.error('Erro ao salvar agente.');\n      },\n    });\n  }\n\n  /**\n   * Navigate back to list.\n   */\n  goBack(): void {\n    void this.router.navigate(['/ai/agents']);\n  }\n}\n\nexport default AgentFormComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/agents/agent-list/agent-list.ts","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":1,"message":"Missing return type on function.","line":164,"column":3,"nodeType":"ArrowFunctionExpression","messageId":"missingReturnType","endLine":164,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ChangeDetectionStrategy, Component, DestroyRef, inject, signal } from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { Router } from '@angular/router';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfCrudPageComponent,\n  AfDataTableComponent,\n  AfIconButtonComponent,\n  AfLoadingButtonComponent,\n} from '@shared/components';\nimport { ToastService } from '../../../../../core/services/toast.service';\nimport type { AiAgent } from '../../../models/ai.models';\nimport { AiAgentService } from '../../../services/ai-agent.service';\n\n/**\n * List and manage AI agents.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-agent-list',\n  standalone: true,\n  imports: [\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfDataTableComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfLoadingButtonComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Agentes IA\"\n      subtitle=\"Inteligência Artificial\"\n      searchPlaceholder=\"Buscar por nome...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum agente encontrado\"\n      emptyDescription=\"Crie o primeiro agente para automatizar atendimentos.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"5\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <!-- Header actions slot -->\n      <div filters class=\"flex items-center justify-end w-full\">\n        <af-button variant=\"primary\" size=\"sm\" (click)=\"openCreate()\">\n          <lucide-icon name=\"plus\" [size]=\"16\" class=\"block\" />\n          Novo agente\n        </af-button>\n      </div>\n\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar agentes\"\n            message=\"Não foi possível carregar a listagem de agentes.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th>Nome</th>\n              <th>Tipo</th>\n              <th>Modelo</th>\n              <th>Temperatura</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (agent of agents(); track agent.id) {\n              <tr>\n                <td class=\"font-medium text-neutral-800 dark:text-neutral-100\">\n                  {{ agent.name }}\n                </td>\n                <td>\n                  <span\n                    class=\"inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border\"\n                    [class]=\"typeBadgeClass(agent.type)\"\n                  >\n                    {{ formatType(agent.type) }}\n                  </span>\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ agent.model_id ?? 'gpt-4o-mini' }}\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ agent.temperature }}\n                </td>\n                <td>\n                  <span\n                    class=\"inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border\"\n                    [class]=\"\n                      agent.is_active\n                        ? 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-400 dark:border-emerald-800'\n                        : 'bg-neutral-100 text-neutral-600 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700'\n                    \"\n                  >\n                    {{ agent.is_active ? 'Ativo' : 'Inativo' }}\n                  </span>\n                </td>\n                <td>\n                  <div class=\"flex items-center justify-end gap-1\">\n                    <af-icon-button\n                      label=\"Editar\"\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      (click)=\"openEdit(agent)\"\n                    >\n                      <lucide-icon name=\"pencil\" [size]=\"15\" class=\"block\" />\n                    </af-icon-button>\n                    <af-loading-button\n                      variant=\"secondary\"\n                      size=\"sm\"\n                      [loading]=\"togglingId() === agent.id\"\n                      (click)=\"toggle(agent)\"\n                    >\n                      <lucide-icon name=\"power\" [size]=\"14\" class=\"block\" />\n                    </af-loading-button>\n                    <af-icon-button\n                      label=\"Excluir\"\n                      variant=\"danger\"\n                      size=\"sm\"\n                      (click)=\"openDelete(agent)\"\n                    >\n                      <lucide-icon name=\"trash-2\" [size]=\"15\" class=\"block\" />\n                    </af-icon-button>\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n  `,\n})\nexport class AgentListComponent {\n  private readonly agentService = inject(AiAgentService);\n  private readonly router = inject(Router);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly agents = signal<AiAgent[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly togglingId = signal<string | null>(null);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 10, total: 0 });\n\n  readonly isEmpty = () => !this.isLoading() && !this.hasError() && this.agents().length === 0;\n\n  private currentPage = 1;\n  private currentSearch = '';\n\n  constructor() {\n    this.fetchAgents(1);\n  }\n\n  onSearch(term: string): void {\n    this.currentSearch = term.trim();\n    this.fetchAgents(1);\n  }\n\n  loadPage(page: number): void {\n    this.fetchAgents(page);\n  }\n\n  retry(): void {\n    this.fetchAgents(this.currentPage);\n  }\n\n  openCreate(): void {\n    void this.router.navigate(['/ai/agents/new']);\n  }\n\n  openEdit(agent: AiAgent): void {\n    void this.router.navigate(['/ai/agents', agent.id, 'edit']);\n  }\n\n  openDelete(agent: AiAgent): void {\n    if (!confirm(`Deseja excluir o agente \"${agent.name}\"?`)) return;\n    this.agentService\n      .delete(agent.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.toast.success('Agente excluído.');\n          this.fetchAgents(this.currentPage);\n        },\n        error: () => this.toast.error('Erro ao excluir agente.'),\n      });\n  }\n\n  toggle(agent: AiAgent): void {\n    this.togglingId.set(agent.id);\n    this.agentService\n      .toggleActive(agent.id, !agent.is_active)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.toast.success('Status atualizado.');\n          this.togglingId.set(null);\n          this.fetchAgents(this.currentPage);\n        },\n        error: () => {\n          this.toast.error('Erro ao atualizar status.');\n          this.togglingId.set(null);\n        },\n      });\n  }\n\n  /**\n   * Format agent type label.\n   */\n  formatType(type: AiAgent['type']): string {\n    const labels: Record<AiAgent['type'], string> = {\n      sales: 'Vendas',\n      support: 'Suporte',\n      qualifier: 'Qualificador',\n    };\n    return labels[type] ?? type;\n  }\n\n  /**\n   * Get badge class for agent type.\n   */\n  typeBadgeClass(type: AiAgent['type']): string {\n    const classes: Record<AiAgent['type'], string> = {\n      sales:\n        'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-400 dark:border-emerald-800',\n      support:\n        'bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-900/20 dark:text-sky-400 dark:border-sky-800',\n      qualifier:\n        'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/20 dark:text-amber-400 dark:border-amber-800',\n    };\n    return classes[type] ?? 'bg-neutral-100 text-neutral-600 border-neutral-200';\n  }\n\n  private fetchAgents(page: number): void {\n    this.currentPage = page;\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    this.agentService\n      .list({ page: 1, per_page: 1000 })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const search = this.currentSearch.toLowerCase();\n          const perPage = this.meta().per_page;\n\n          let data = [...(response.data ?? [])];\n          if (search) {\n            data = data.filter((item) => item.name.toLowerCase().includes(search));\n          }\n\n          const total = data.length;\n          const lastPage = Math.max(1, Math.ceil(total / perPage));\n          const start = (page - 1) * perPage;\n          const paged = data.slice(start, start + perPage);\n\n          this.agents.set(paged);\n          this.meta.set({ total, per_page: perPage, current_page: page, last_page: lastPage });\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.hasError.set(true);\n          this.isLoading.set(false);\n        },\n      });\n  }\n}\n\nexport default AgentListComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/dashboard/usage-dashboard/usage-dashboard.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":94}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';\nimport { DecimalPipe } from '@angular/common';\nimport { forkJoin } from 'rxjs';\nimport { LucideAngularModule } from 'lucide-angular';\nimport { AfAlertComponent, AfButtonComponent, AfPageTitleComponent } from '@shared/components';\nimport { AiUsageService } from '../../../services/ai-usage.service';\nimport type { UsageAgent, UsageDaily, UsageSummary } from '../../../models/ai.models';\n\n/**\n * Dashboard showing AI usage metrics and costs.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-usage-dashboard',\n  standalone: true,\n  imports: [\n    DecimalPipe,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfButtonComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title title=\"Dashboard de Custos\" subtitle=\"Inteligência Artificial\" />\n\n    @if (isLoading()) {\n      <!-- Loading State -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-5\">\n        @for (skeleton of [0, 1, 2, 3]; track skeleton) {\n          <div\n            class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 animate-pulse\"\n          >\n            <div class=\"h-4 w-24 bg-neutral-200 dark:bg-neutral-700 rounded mb-3\"></div>\n            <div class=\"h-8 w-32 bg-neutral-200 dark:bg-neutral-700 rounded\"></div>\n          </div>\n        }\n      </div>\n      <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n        <div\n          class=\"lg:col-span-2 bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 animate-pulse\"\n        >\n          <div class=\"h-5 w-32 bg-neutral-200 dark:bg-neutral-700 rounded mb-4\"></div>\n          <div class=\"h-40 bg-neutral-200 dark:bg-neutral-700 rounded\"></div>\n        </div>\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 animate-pulse\"\n        >\n          <div class=\"h-5 w-32 bg-neutral-200 dark:bg-neutral-700 rounded mb-4\"></div>\n          @for (row of [0, 1, 2, 3, 4]; track row) {\n            <div class=\"h-10 bg-neutral-200 dark:bg-neutral-700 rounded mb-2\"></div>\n          }\n        </div>\n      </div>\n    } @else if (hasError()) {\n      <!-- Error State -->\n      <div class=\"p-4\">\n        <af-alert\n          variant=\"danger\"\n          title=\"Erro ao carregar dados\"\n          message=\"Não foi possível carregar as métricas de uso.\"\n        />\n        <div class=\"mt-2\">\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      </div>\n    } @else {\n      <!-- Summary Cards -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-5\">\n        <!-- Total Cost -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-sm text-neutral-500\">Custo do Mês</span>\n            <span\n              class=\"size-8 p-1.5 rounded-lg bg-accent-50 dark:bg-accent-900/20 text-accent-600 dark:text-accent-400\"\n            >\n              <lucide-icon name=\"dollar-sign\" [size]=\"18\" />\n            </span>\n          </div>\n          <div class=\"flex items-baseline gap-2\">\n            <span class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n              {{ summary()?.formatted_cost ?? '$0.00' }}\n            </span>\n            @if (summary()?.cost_change_percent) {\n              <span class=\"text-xs flex items-center gap-1\" [class]=\"trendClass()\">\n                <lucide-icon [name]=\"trendIcon()\" [size]=\"12\" />\n                {{ summary()?.cost_change_percent | number: '1.1-1' }}%\n              </span>\n            }\n          </div>\n        </div>\n\n        <!-- Total Tokens -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-sm text-neutral-500\">Tokens Usados</span>\n            <span\n              class=\"size-8 p-1.5 rounded-lg bg-sky-50 dark:bg-sky-900/20 text-sky-600 dark:text-sky-400\"\n            >\n              <lucide-icon name=\"coins\" [size]=\"18\" />\n            </span>\n          </div>\n          <span class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ formatNumber(summary()?.total_tokens ?? 0) }}\n          </span>\n        </div>\n\n        <!-- Total Requests -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-sm text-neutral-500\">Requisições</span>\n            <span\n              class=\"size-8 p-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400\"\n            >\n              <lucide-icon name=\"activity\" [size]=\"18\" />\n            </span>\n          </div>\n          <span class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ formatNumber(summary()?.total_requests ?? 0) }}\n          </span>\n        </div>\n\n        <!-- Avg Latency -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-sm text-neutral-500\">Latência Média</span>\n            <span\n              class=\"size-8 p-1.5 rounded-lg bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400\"\n            >\n              <lucide-icon name=\"bot\" [size]=\"18\" />\n            </span>\n          </div>\n          <span class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ summary()?.avg_latency_ms | number: '1.0-0' }}ms\n          </span>\n        </div>\n      </div>\n\n      <!-- Charts Row -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n        <!-- Daily Usage Chart -->\n        <div\n          class=\"lg:col-span-2 bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <h3 class=\"text-base font-medium text-neutral-900 dark:text-neutral-100 mb-4\">\n            Uso Diário (30 dias)\n          </h3>\n          @if (chartData().length > 0) {\n            <div class=\"flex items-end justify-between gap-1 h-32\">\n              @for (bar of chartData(); track bar.date) {\n                <div\n                  class=\"flex-1 bg-accent-200 dark:bg-accent-800/40 hover:bg-accent-400 dark:hover:bg-accent-600/60 rounded-t transition-colors cursor-pointer group relative\"\n                  [style.height.px]=\"bar.height\"\n                >\n                  <div\n                    class=\"hidden group-hover:block absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-xs rounded whitespace-nowrap z-10\"\n                  >\n                    {{ bar.date }}<br />\n                    {{ bar.cost }} | {{ bar.tokens }} tokens\n                  </div>\n                </div>\n              }\n            </div>\n            <div class=\"flex justify-between mt-2 text-xs text-neutral-400\">\n              <span>{{ chartData()[0]?.date }}</span>\n              <span>{{ chartData()[chartData().length - 1]?.date }}</span>\n            </div>\n          } @else {\n            <div class=\"flex items-center justify-center h-32 text-neutral-400 text-sm\">\n              Sem dados no período\n            </div>\n          }\n        </div>\n\n        <!-- Top Agents -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          <h3 class=\"text-base font-medium text-neutral-900 dark:text-neutral-100 mb-4\">\n            Top Agentes\n          </h3>\n          @if (topAgents().length > 0) {\n            <div class=\"space-y-3\">\n              @for (agent of topAgents(); track agent.agent_name; let i = $index) {\n                <div class=\"flex items-center justify-between\">\n                  <div class=\"flex items-center gap-2\">\n                    <span\n                      class=\"size-6 flex items-center justify-center rounded-full text-xs font-medium\"\n                      [class]=\"\n                        i === 0\n                          ? 'bg-accent-500 text-white'\n                          : 'bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-400'\n                      \"\n                    >\n                      {{ i + 1 }}\n                    </span>\n                    <span class=\"text-sm text-neutral-700 dark:text-neutral-300\">\n                      {{ agent.agent_name }}\n                    </span>\n                  </div>\n                  <span class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100\">\n                    {{ agent.formatted_cost }}\n                  </span>\n                </div>\n              }\n            </div>\n          } @else {\n            <div class=\"flex items-center justify-center h-32 text-neutral-400 text-sm\">\n              Nenhum agente com uso\n            </div>\n          }\n        </div>\n      </div>\n    }\n  `,\n})\nexport class UsageDashboardComponent implements OnInit {\n  private readonly usageService = inject(AiUsageService);\n\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n\n  readonly summary = signal<UsageSummary | null>(null);\n  readonly dailyUsage = signal<UsageDaily[]>([]);\n  readonly topAgents = signal<UsageAgent[]>([]);\n\n  readonly trendIcon = computed(() =>\n    (this.summary()?.cost_change_percent ?? 0) >= 0 ? 'trending-up' : 'trending-down',\n  );\n\n  readonly trendClass = computed(() =>\n    (this.summary()?.cost_change_percent ?? 0) >= 0\n      ? 'text-red-600 dark:text-red-400'\n      : 'text-emerald-600 dark:text-emerald-400',\n  );\n\n  readonly chartData = computed(() => {\n    const data = this.dailyUsage();\n    if (data.length === 0) return [];\n\n    // Normalize for chart display (max height 100px)\n    const maxCost = Math.max(...data.map((d) => d.cost), 0.01);\n    return data.map((d) => ({\n      date: d.date,\n      height: Math.max(4, (d.cost / maxCost) * 100),\n      cost: d.formatted_cost,\n      tokens: d.tokens,\n    }));\n  });\n\n  ngOnInit(): void {\n    this.loadData();\n  }\n\n  /**\n   * Load all dashboard data.\n   */\n  private loadData(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    forkJoin({\n      summary: this.usageService.getSummary(),\n      daily: this.usageService.getDaily(30),\n      topAgents: this.usageService.getTopAgents(5),\n    }).subscribe({\n      next: (result) => {\n        this.summary.set(result.summary);\n        this.dailyUsage.set(result.daily);\n        this.topAgents.set(result.topAgents);\n        this.isLoading.set(false);\n      },\n      error: () => {\n        this.isLoading.set(false);\n        this.hasError.set(true);\n      },\n    });\n  }\n\n  /**\n   * Retry loading data.\n   */\n  retry(): void {\n    this.loadData();\n  }\n\n  /**\n   * Format large numbers.\n   */\n  formatNumber(num: number): string {\n    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';\n    if (num >= 1000) return (num / 1000).toFixed(1) + 'K';\n    return String(num);\n  }\n}\n\nexport default UsageDashboardComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/knowledge/knowledge-dashboard/knowledge-dashboard.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":96}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport { ChangeDetectionStrategy, Component, DestroyRef, inject, signal } from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { LucideAngularModule } from 'lucide-angular';\nimport { AfAlertComponent, AfButtonComponent, AfPageTitleComponent } from '@shared/components';\nimport { AiKnowledgeService } from '../../../services/ai-knowledge.service';\nimport type { KnowledgeStats } from '../../../models/ai.models';\n\n/**\n * Knowledge base usage dashboard with storage and document stats.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-knowledge-dashboard',\n  standalone: true,\n  imports: [LucideAngularModule, AfPageTitleComponent, AfButtonComponent, AfAlertComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title title=\"Dashboard de uso\" subtitle=\"Base de Conhecimento\" />\n\n    @if (statsLoading()) {\n      <div class=\"grid grid-cols-1 gap-3 mb-4 md:grid-cols-2 xl:grid-cols-4\">\n        @for (item of [1, 2, 3, 4]; track item) {\n          <div\n            class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4 animate-pulse\"\n          >\n            <div class=\"h-4 w-24 bg-neutral-200 dark:bg-neutral-700 rounded mb-2\"></div>\n            <div class=\"h-7 w-20 bg-neutral-200 dark:bg-neutral-700 rounded\"></div>\n          </div>\n        }\n      </div>\n    }\n\n    @if (stats(); as kbStats) {\n      <div class=\"grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4\">\n        <!-- Documents -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4\"\n        >\n          <p class=\"text-xs text-neutral-500 mb-1\">Total de documentos</p>\n          <p class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ kbStats.document_count }}\n          </p>\n          <p class=\"text-xs text-neutral-500 mt-1\">\n            Prontos: {{ kbStats.documents_ready }} · Processando: {{ kbStats.documents_processing }}\n          </p>\n        </div>\n\n        <!-- Chunks -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4\"\n        >\n          <p class=\"text-xs text-neutral-500 mb-1\">Total de chunks</p>\n          <p class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ kbStats.total_chunks }}\n          </p>\n          <p class=\"text-xs text-neutral-500 mt-1\">Pendentes: {{ kbStats.documents_pending }}</p>\n        </div>\n\n        <!-- Storage -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4\"\n        >\n          <p class=\"text-xs text-neutral-500 mb-1\">Storage usado</p>\n          <p class=\"text-2xl font-semibold text-neutral-900 dark:text-neutral-100\">\n            {{ kbStats.storage_formatted }}\n          </p>\n          <p class=\"text-xs text-neutral-500 mt-1\">de {{ kbStats.storage_limit_formatted }}</p>\n          <div\n            class=\"w-full h-1.5 mt-2 bg-neutral-100 dark:bg-neutral-700 rounded-full overflow-hidden\"\n          >\n            <div\n              class=\"h-1.5 bg-accent-500 rounded-full\"\n              [style.width.%]=\"\n                kbStats.storage_used_percent > 100 ? 100 : kbStats.storage_used_percent\n              \"\n            ></div>\n          </div>\n        </div>\n\n        <!-- Failed -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4\"\n        >\n          <p class=\"text-xs text-neutral-500 mb-1\">Documentos com falha</p>\n          <p\n            class=\"text-2xl font-semibold\"\n            [class.text-red-600]=\"kbStats.documents_failed > 0\"\n            [class.dark:text-red-400]=\"kbStats.documents_failed > 0\"\n            [class.text-neutral-900]=\"kbStats.documents_failed === 0\"\n            [class.dark:text-neutral-100]=\"kbStats.documents_failed === 0\"\n          >\n            {{ kbStats.documents_failed }}\n          </p>\n          <p class=\"text-xs text-neutral-500 mt-1\">Reindexe para tentar novamente</p>\n        </div>\n      </div>\n    }\n\n    @if (statsError()) {\n      <div class=\"mt-4\">\n        <af-alert\n          variant=\"danger\"\n          title=\"Erro ao carregar estatísticas\"\n          message=\"Não foi possível carregar estatísticas da base de conhecimento.\"\n        />\n        <div class=\"mt-2\">\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"reload()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      </div>\n    }\n  `,\n})\nexport class KnowledgeDashboardComponent implements OnInit {\n  private readonly knowledgeService = inject(AiKnowledgeService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly stats = signal<KnowledgeStats | null>(null);\n  readonly statsLoading = signal(true);\n  readonly statsError = signal(false);\n\n  ngOnInit(): void {\n    this.loadStats();\n  }\n\n  reload(): void {\n    this.loadStats();\n  }\n\n  private loadStats(): void {\n    this.statsLoading.set(true);\n    this.statsError.set(false);\n\n    this.knowledgeService\n      .getStats()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (stats) => {\n          this.stats.set(stats);\n          this.statsLoading.set(false);\n        },\n        error: () => {\n          this.statsError.set(true);\n          this.statsLoading.set(false);\n        },\n      });\n  }\n}\n\nexport default KnowledgeDashboardComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/knowledge/knowledge-detail/knowledge-detail.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":204,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":204,"endColumn":12,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[7740,7743],"text":"id == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[7741,7743],"text":"(id ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[7740,7743],"text":"!Boolean(id)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { LucideAngularModule } from 'lucide-angular';\nimport { AfAlertComponent, AfButtonComponent, AfPageTitleComponent } from '@shared/components';\nimport type { AiKnowledge, KnowledgeChunk } from '../../../models/ai.models';\nimport { AiKnowledgeService } from '../../../services/ai-knowledge.service';\n\n/**\n * Knowledge document detail with chunk listing.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-knowledge-detail',\n  standalone: true,\n  imports: [LucideAngularModule, AfPageTitleComponent, AfButtonComponent, AfAlertComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title\n      [title]=\"document()?.title || 'Detalhe do Documento'\"\n      subtitle=\"Base de Conhecimento\"\n    />\n\n    @if (loading()) {\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n      >\n        <p class=\"text-sm text-neutral-500\">Carregando documento...</p>\n      </div>\n    } @else if (error()) {\n      <div class=\"p-4\">\n        <af-alert\n          variant=\"danger\"\n          title=\"Erro ao carregar documento\"\n          message=\"Não foi possível carregar este documento.\"\n        />\n      </div>\n    } @else if (document(); as doc) {\n      <!-- Document Info Card -->\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 mb-4\"\n      >\n        <div class=\"flex flex-col gap-3 md:flex-row md:items-center md:justify-between\">\n          <div>\n            <h2 class=\"text-lg font-semibold text-neutral-900 dark:text-neutral-100\">\n              {{ doc.title }}\n            </h2>\n            <p class=\"text-sm text-neutral-500\">{{ doc.original_filename }}</p>\n          </div>\n\n          <span\n            class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-xs font-medium border\"\n            [class]=\"statusClass(doc.status)\"\n          >\n            {{ formatStatus(doc.status) }}\n          </span>\n        </div>\n\n        <div class=\"grid grid-cols-1 gap-3 mt-4 md:grid-cols-2 xl:grid-cols-4\">\n          <div>\n            <p class=\"text-xs text-neutral-500\">Tipo</p>\n            <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100 uppercase\">\n              {{ doc.file_type }}\n            </p>\n          </div>\n          <div>\n            <p class=\"text-xs text-neutral-500\">Tamanho</p>\n            <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100\">\n              {{ doc.file_size_formatted }}\n            </p>\n          </div>\n          <div>\n            <p class=\"text-xs text-neutral-500\">Versão</p>\n            <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100\">\n              v{{ doc.version }}\n            </p>\n          </div>\n          <div>\n            <p class=\"text-xs text-neutral-500\">Chunks</p>\n            <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100\">\n              {{ doc.chunk_count }}\n            </p>\n          </div>\n        </div>\n\n        @if (doc.status === 'failed' && doc.error_message) {\n          <div\n            class=\"mt-4 rounded-lg border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 px-3 py-2 text-sm text-red-700 dark:text-red-400\"\n          >\n            {{ doc.error_message }}\n          </div>\n        }\n\n        <div class=\"flex flex-wrap gap-2 mt-4\">\n          <af-button variant=\"ghost\" size=\"sm\" (click)=\"goBack()\">Voltar</af-button>\n          <af-button variant=\"secondary\" size=\"sm\" (click)=\"reindex()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Reindexar\n          </af-button>\n          <af-button variant=\"danger\" size=\"sm\" (click)=\"removeDocument()\">\n            <lucide-icon name=\"trash-2\" [size]=\"14\" class=\"block\" />\n            Excluir\n          </af-button>\n        </div>\n      </div>\n\n      <!-- Chunks Card -->\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n      >\n        <div class=\"flex items-center justify-between mb-4\">\n          <h3 class=\"text-sm font-semibold text-neutral-900 dark:text-neutral-100\">Chunks</h3>\n          <span class=\"text-xs text-neutral-500\">Total: {{ totalChunks() }}</span>\n        </div>\n\n        @if (chunksLoading()) {\n          <p class=\"text-sm text-neutral-500\">Carregando chunks...</p>\n        } @else if (chunks().length === 0) {\n          <p class=\"text-sm text-neutral-500\">Nenhum chunk encontrado para este documento.</p>\n        } @else {\n          <div class=\"space-y-2\">\n            @for (chunk of chunks(); track chunk.id) {\n              <div class=\"rounded-lg border border-neutral-200 dark:border-neutral-700 p-3\">\n                <div class=\"flex items-center justify-between gap-2 mb-1\">\n                  <p class=\"text-xs text-neutral-500\">Chunk #{{ chunk.chunk_index }}</p>\n                  <p class=\"text-xs text-neutral-500\">Tokens: {{ chunk.token_count }}</p>\n                </div>\n\n                @if (expandedChunkId() === chunk.id) {\n                  <p class=\"text-sm text-neutral-700 dark:text-neutral-300 whitespace-pre-wrap\">\n                    {{ chunk.content }}\n                  </p>\n                } @else {\n                  <p class=\"text-sm text-neutral-700 dark:text-neutral-300 line-clamp-3\">\n                    {{ chunk.content }}\n                  </p>\n                }\n\n                <div class=\"mt-2\">\n                  <af-button variant=\"ghost\" size=\"sm\" (click)=\"toggleChunk(chunk.id)\">\n                    {{\n                      expandedChunkId() === chunk.id ? 'Ocultar conteúdo' : 'Ver conteúdo completo'\n                    }}\n                  </af-button>\n                </div>\n              </div>\n            }\n          </div>\n\n          <div\n            class=\"flex items-center justify-end gap-2 pt-4 mt-2 border-t border-neutral-200 dark:border-neutral-700\"\n          >\n            <af-button\n              variant=\"ghost\"\n              size=\"sm\"\n              [disabled]=\"!hasPreviousPage()\"\n              (click)=\"previousPage()\"\n            >\n              Anterior\n            </af-button>\n            <span class=\"text-xs text-neutral-500\">\n              Página {{ currentPage() }} de {{ lastPage() }}\n            </span>\n            <af-button variant=\"ghost\" size=\"sm\" [disabled]=\"!hasNextPage()\" (click)=\"nextPage()\">\n              Próxima\n            </af-button>\n          </div>\n        }\n      </div>\n    }\n  `,\n})\nexport class KnowledgeDetailComponent implements OnInit {\n  private readonly knowledgeService = inject(AiKnowledgeService);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly document = signal<AiKnowledge | null>(null);\n  readonly chunks = signal<KnowledgeChunk[]>([]);\n  readonly loading = signal(true);\n  readonly chunksLoading = signal(false);\n  readonly error = signal(false);\n\n  readonly currentPage = signal(1);\n  readonly lastPage = signal(1);\n  readonly totalChunks = signal(0);\n  readonly expandedChunkId = signal<string | null>(null);\n\n  readonly hasPreviousPage = computed(() => this.currentPage() > 1);\n  readonly hasNextPage = computed(() => this.currentPage() < this.lastPage());\n\n  ngOnInit(): void {\n    const id = this.route.snapshot.paramMap.get('id');\n\n    if (!id) {\n      this.error.set(true);\n      this.loading.set(false);\n\n      return;\n    }\n\n    this.loadDocument(id);\n    this.loadChunks(id, 1);\n  }\n\n  goBack(): void {\n    void this.router.navigate(['/ai/knowledge/base']);\n  }\n\n  reindex(): void {\n    const doc = this.document();\n    if (!doc) {\n      return;\n    }\n\n    this.knowledgeService\n      .reindex(doc.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (updated) => this.document.set(updated),\n      });\n  }\n\n  removeDocument(): void {\n    const doc = this.document();\n    if (!doc) {\n      return;\n    }\n\n    this.knowledgeService\n      .delete(doc.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => this.goBack(),\n      });\n  }\n\n  toggleChunk(chunkId: string): void {\n    this.expandedChunkId.set(this.expandedChunkId() === chunkId ? null : chunkId);\n  }\n\n  previousPage(): void {\n    const doc = this.document();\n    if (!doc || !this.hasPreviousPage()) {\n      return;\n    }\n\n    this.loadChunks(doc.id, this.currentPage() - 1);\n  }\n\n  nextPage(): void {\n    const doc = this.document();\n    if (!doc || !this.hasNextPage()) {\n      return;\n    }\n\n    this.loadChunks(doc.id, this.currentPage() + 1);\n  }\n\n  formatStatus(status: AiKnowledge['status']): string {\n    const labels: Record<AiKnowledge['status'], string> = {\n      pending: 'Pendente',\n      processing: 'Processando',\n      indexed: 'Indexado',\n      failed: 'Falhou',\n    };\n\n    return labels[status] ?? status;\n  }\n\n  statusClass(status: AiKnowledge['status']): string {\n    const classes: Record<AiKnowledge['status'], string> = {\n      pending:\n        'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/20 dark:text-amber-400 dark:border-amber-800',\n      processing:\n        'bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-900/20 dark:text-sky-400 dark:border-sky-800',\n      indexed:\n        'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-400 dark:border-emerald-800',\n      failed:\n        'bg-red-50 text-red-700 border-red-200 dark:bg-red-900/20 dark:text-red-400 dark:border-red-800',\n    };\n\n    return classes[status] ?? 'bg-neutral-100 text-neutral-600 border-neutral-200';\n  }\n\n  private loadDocument(id: string): void {\n    this.loading.set(true);\n    this.error.set(false);\n\n    this.knowledgeService\n      .get(id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (doc) => {\n          this.document.set(doc);\n          this.loading.set(false);\n        },\n        error: () => {\n          this.error.set(true);\n          this.loading.set(false);\n        },\n      });\n  }\n\n  private loadChunks(documentId: string, page: number): void {\n    this.chunksLoading.set(true);\n\n    this.knowledgeService\n      .getChunks(documentId, page, 20)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.chunks.set(response.data ?? []);\n          this.currentPage.set(response.meta.current_page);\n          this.lastPage.set(response.meta.last_page);\n          this.totalChunks.set(response.meta.total);\n          this.chunksLoading.set(false);\n        },\n        error: () => {\n          this.chunks.set([]);\n          this.chunksLoading.set(false);\n        },\n      });\n  }\n}\n\nexport default KnowledgeDetailComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/knowledge/knowledge-list/knowledge-list.ts","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":1,"message":"Missing return type on function.","line":157,"column":3,"nodeType":"ArrowFunctionExpression","messageId":"missingReturnType","endLine":157,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ChangeDetectionStrategy, Component, DestroyRef, inject, signal } from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { Router } from '@angular/router';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfCrudPageComponent,\n  AfDataTableComponent,\n  AfIconButtonComponent,\n} from '@shared/components';\nimport { ToastService } from '../../../../../core/services/toast.service';\nimport type { AiKnowledge } from '../../../models/ai.models';\nimport { AiKnowledgeService } from '../../../services/ai-knowledge.service';\n\n/**\n * List and manage AI knowledge base documents.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-knowledge-list',\n  standalone: true,\n  imports: [\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfDataTableComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Base de Conhecimento\"\n      subtitle=\"Inteligência Artificial\"\n      searchPlaceholder=\"Buscar por título...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Base de conhecimento vazia\"\n      emptyDescription=\"Adicione documentos para treinar seus agentes de IA.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"5\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <!-- Header actions slot -->\n      <div filters class=\"flex items-center justify-end w-full\">\n        <af-button variant=\"primary\" size=\"sm\" (click)=\"openUpload()\">\n          <lucide-icon name=\"plus\" [size]=\"16\" class=\"block\" />\n          Adicionar documento\n        </af-button>\n      </div>\n\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar documentos\"\n            message=\"Não foi possível carregar a base de conhecimento.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th>Documento</th>\n              <th>Tipo</th>\n              <th>Chunks</th>\n              <th>Tokens</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (item of documents(); track item.id) {\n              <tr>\n                <td>\n                  <div class=\"flex items-center gap-2\">\n                    <lucide-icon\n                      [name]=\"getTypeIcon(item.content_type)\"\n                      [size]=\"16\"\n                      class=\"text-neutral-400 shrink-0\"\n                    />\n                    <button\n                      type=\"button\"\n                      class=\"text-sm font-medium text-accent-600 hover:underline dark:text-accent-400 cursor-pointer\"\n                      (click)=\"openDetail(item.id)\"\n                    >\n                      {{ item.title }}\n                    </button>\n                  </div>\n                </td>\n                <td class=\"uppercase text-xs font-medium text-neutral-500\">\n                  {{ item.content_type }}\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ item.chunk_count }}\n                </td>\n                <td class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n                  {{ formatTokens(item.token_count) }}\n                </td>\n                <td>\n                  <span\n                    class=\"py-0.5 px-2.5 inline-flex items-center text-xs font-medium rounded\"\n                    [class]=\"statusClass(item.status)\"\n                  >\n                    {{ formatStatus(item.status) }}\n                  </span>\n                </td>\n                <td>\n                  <div class=\"flex items-center justify-end gap-1\">\n                    <af-icon-button\n                      label=\"Reindexar\"\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      (click)=\"reindex(item)\"\n                    >\n                      <lucide-icon name=\"refresh-cw\" [size]=\"15\" class=\"block\" />\n                    </af-icon-button>\n                    <af-icon-button\n                      label=\"Excluir\"\n                      variant=\"danger\"\n                      size=\"sm\"\n                      (click)=\"openDelete(item)\"\n                    >\n                      <lucide-icon name=\"trash-2\" [size]=\"15\" class=\"block\" />\n                    </af-icon-button>\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n  `,\n})\nexport class KnowledgeListComponent {\n  private readonly knowledgeService = inject(AiKnowledgeService);\n  private readonly router = inject(Router);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly documents = signal<AiKnowledge[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 10, total: 0 });\n\n  readonly isEmpty = () => !this.isLoading() && !this.hasError() && this.documents().length === 0;\n\n  private currentPage = 1;\n  private currentSearch = '';\n\n  constructor() {\n    this.fetchDocuments(1);\n  }\n\n  onSearch(term: string): void {\n    this.currentSearch = term.trim();\n    this.fetchDocuments(1);\n  }\n\n  loadPage(page: number): void {\n    this.fetchDocuments(page);\n  }\n\n  retry(): void {\n    this.fetchDocuments(this.currentPage);\n  }\n\n  openUpload(): void {\n    void this.router.navigate(['/ai/knowledge/upload']);\n  }\n\n  openDetail(id: string): void {\n    void this.router.navigate(['/ai/knowledge', id]);\n  }\n\n  openDelete(doc: AiKnowledge): void {\n    if (\n      !confirm(\n        'Tem certeza que deseja remover este documento da base de conhecimento? Os chunks indexados serão excluídos.',\n      )\n    )\n      return;\n    this.knowledgeService\n      .delete(doc.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.toast.success('Documento removido.');\n          this.fetchDocuments(this.currentPage);\n        },\n        error: () => this.toast.error('Erro ao remover documento.'),\n      });\n  }\n\n  /**\n   * Reindex a document.\n   */\n  reindex(doc: AiKnowledge): void {\n    this.knowledgeService\n      .reindex(doc.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.toast.success('Reindexação iniciada.');\n          this.fetchDocuments(this.currentPage);\n        },\n        error: () => this.toast.error('Erro ao reindexar documento.'),\n      });\n  }\n\n  /**\n   * Get icon name for content type.\n   */\n  getTypeIcon(type: AiKnowledge['content_type']): string {\n    const icons: Record<AiKnowledge['content_type'], string> = {\n      text: 'file-text',\n      pdf: 'file',\n      url: 'link',\n      csv: 'table',\n    };\n    return icons[type] ?? 'file-text';\n  }\n\n  /**\n   * Format status label.\n   */\n  formatStatus(status: AiKnowledge['status']): string {\n    const labels: Record<AiKnowledge['status'], string> = {\n      pending: 'Pendente',\n      processing: 'Processando',\n      indexed: 'Indexado',\n      failed: 'Falhou',\n    };\n    return labels[status] ?? status;\n  }\n\n  statusClass(status: AiKnowledge['status']): string {\n    const classes: Record<AiKnowledge['status'], string> = {\n      pending: 'bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400',\n      processing: 'bg-sky-50 text-sky-700 dark:bg-sky-900/20 dark:text-sky-400',\n      indexed: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-400',\n      failed: 'bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400',\n    };\n    return classes[status] ?? 'bg-neutral-100 text-neutral-600';\n  }\n\n  /**\n   * Format token count.\n   */\n  formatTokens(count: number): string {\n    if (count >= 1000) {\n      return `${(count / 1000).toFixed(1)}K`;\n    }\n    return String(count);\n  }\n\n  private fetchDocuments(page: number): void {\n    this.currentPage = page;\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    this.knowledgeService\n      .list({\n        page,\n        per_page: this.meta().per_page,\n        search: this.currentSearch || undefined,\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.documents.set(response.data ?? []);\n          this.meta.set(response.meta);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.hasError.set(true);\n          this.isLoading.set(false);\n        },\n      });\n  }\n}\n\nexport default KnowledgeListComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/knowledge/knowledge-search/knowledge-search.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/knowledge/knowledge-upload/knowledge-upload.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":95},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":173,"column":9,"nodeType":"ChainExpression","messageId":"conditionErrorNullableNumber","endLine":173,"endColumn":28,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[6641,6660],"text":"(input.files?.length) != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[6641,6660],"text":"(input.files?.length) ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[6641,6660],"text":"Boolean((input.files?.length))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":204,"column":9,"nodeType":"ChainExpression","messageId":"conditionErrorNullableNumber","endLine":204,"endColumn":42,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[7239,7272],"text":"(event.dataTransfer?.files?.length) != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[7239,7272],"text":"(event.dataTransfer?.files?.length) ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[7239,7272],"text":"Boolean((event.dataTransfer?.files?.length))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":226,"column":10,"nodeType":"ChainExpression","messageId":"conditionErrorNullableString","endLine":226,"endColumn":39,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[7847,7877],"text":"(this.form.get('title')?.value) == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[7848,7877],"text":"((this.form.get('title')?.value) ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[7847,7877],"text":"!Boolean((this.form.get('title')?.value))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected object value in conditional. The condition is always true.","line":237,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorObject","endLine":237,"endColumn":23},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":266,"column":19,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":266,"endColumn":49},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":266,"column":19,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":266,"endColumn":42,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[8793,8794],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@angular-eslint/template/label-has-associated-control","severity":1,"message":"A label component must be associated with a form element","line":52,"column":13,"nodeType":null,"messageId":"labelHasAssociatedControl","endLine":54,"endColumn":21}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef } from '@angular/core';\nimport { ChangeDetectionStrategy, Component, inject, signal, ViewChild } from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { Router } from '@angular/router';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfButtonComponent,\n  AfIconButtonComponent,\n  AfLoadingButtonComponent,\n  AfPageTitleComponent,\n  AfTextInputComponent,\n} from '@shared/components';\nimport { ToastService } from '../../../../../core/services/toast.service';\nimport { AiKnowledgeService } from '../../../services/ai-knowledge.service';\n\n/**\n * Upload documents to AI knowledge base.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-knowledge-upload',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfTextInputComponent,\n    AfButtonComponent,\n    AfLoadingButtonComponent,\n    AfIconButtonComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title title=\"Adicionar Documento\" subtitle=\"Base de Conhecimento\" />\n\n    <div class=\"grid grid-cols-1 gap-5 mb-5\">\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n      >\n        <form [formGroup]=\"form\" (ngSubmit)=\"submit()\" class=\"space-y-6\">\n          <!-- Title -->\n          <af-text-input\n            [control]=\"form.controls.title\"\n            label=\"Título do Documento\"\n            placeholder=\"Ex: FAQ de Produtos\"\n            [required]=\"true\"\n            dataTest=\"knowledge-title\"\n          />\n\n          <!-- File Drop Zone -->\n          <div>\n            <label class=\"block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5\">\n              Arquivo <span class=\"text-red-500\">*</span>\n            </label>\n            <button\n              type=\"button\"\n              class=\"w-full border-2 border-dashed rounded-xl p-8 text-center transition-colors cursor-pointer\"\n              [class.border-accent-500]=\"isDragging()\"\n              [class.bg-accent-50]=\"isDragging()\"\n              [class.dark:bg-accent-900/10]=\"isDragging()\"\n              [class.border-neutral-300]=\"!isDragging()\"\n              [class.dark:border-neutral-600]=\"!isDragging()\"\n              (dragover)=\"onDragOver($event)\"\n              (dragleave)=\"onDragLeave($event)\"\n              (drop)=\"onDrop($event)\"\n              (click)=\"openFileBrowser()\"\n            >\n              @if (selectedFile(); as file) {\n                <div class=\"flex items-center justify-center gap-3\">\n                  <lucide-icon name=\"file\" [size]=\"32\" class=\"text-accent-500\" />\n                  <div class=\"text-left\">\n                    <p class=\"font-medium text-neutral-900 dark:text-neutral-100\">\n                      {{ file.name }}\n                    </p>\n                    <p class=\"text-xs text-neutral-500\">{{ formatFileSize(file.size) }}</p>\n                  </div>\n                  <af-icon-button\n                    label=\"Remover arquivo\"\n                    variant=\"danger\"\n                    size=\"sm\"\n                    class=\"ms-auto\"\n                    (click)=\"clearFile(); $event.stopPropagation()\"\n                  >\n                    <lucide-icon name=\"x\" [size]=\"14\" class=\"block\" />\n                  </af-icon-button>\n                </div>\n              } @else {\n                <lucide-icon\n                  name=\"upload\"\n                  [size]=\"48\"\n                  class=\"text-neutral-300 dark:text-neutral-600 mx-auto mb-3\"\n                />\n                <p class=\"text-neutral-700 dark:text-neutral-300 font-medium\">\n                  Arraste e solte um arquivo aqui\n                </p>\n                <p class=\"text-sm text-neutral-500 mt-1\">ou clique para selecionar</p>\n                <p class=\"text-xs text-neutral-400 mt-3\">\n                  Formatos aceitos: TXT, CSV, MD, JSON, PDF (máx. 10MB)\n                </p>\n              }\n            </button>\n            <input\n              #fileInput\n              type=\"file\"\n              class=\"hidden\"\n              [accept]=\"allowedTypes.join(',')\"\n              (change)=\"onFileSelected($event)\"\n            />\n          </div>\n\n          <!-- Info Box -->\n          <div\n            class=\"bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 rounded-xl p-4\"\n          >\n            <h4 class=\"text-sm font-medium text-sky-700 dark:text-sky-400 mb-2\">Como funciona?</h4>\n            <ul class=\"text-xs text-sky-600 dark:text-sky-500 space-y-1 list-disc list-inside\">\n              <li>O documento será dividido em chunks menores</li>\n              <li>Cada chunk será vetorizado para busca semântica</li>\n              <li>Os agentes usarão o conhecimento ao responder</li>\n              <li>O processamento pode levar alguns minutos</li>\n            </ul>\n          </div>\n\n          <!-- Actions -->\n          <div\n            class=\"flex items-center justify-between pt-4 border-t border-neutral-200 dark:border-neutral-700\"\n          >\n            <af-button variant=\"ghost\" size=\"sm\" type=\"button\" (click)=\"goBack()\">\n              <lucide-icon name=\"arrow-left\" [size]=\"16\" class=\"block\" />\n              Voltar\n            </af-button>\n\n            <af-loading-button\n              variant=\"primary\"\n              size=\"sm\"\n              type=\"submit\"\n              [loading]=\"isUploading()\"\n              [disabled]=\"form.invalid || !selectedFile()\"\n            >\n              <lucide-icon name=\"upload\" [size]=\"16\" class=\"block\" />\n              Enviar documento\n            </af-loading-button>\n          </div>\n        </form>\n      </div>\n    </div>\n  `,\n})\nexport class KnowledgeUploadComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly router = inject(Router);\n  private readonly knowledgeService = inject(AiKnowledgeService);\n  private readonly toast = inject(ToastService);\n\n  @ViewChild('fileInput') fileInput!: ElementRef<HTMLInputElement>;\n\n  readonly isUploading = signal(false);\n  readonly isDragging = signal(false);\n  readonly selectedFile = signal<File | null>(null);\n\n  readonly form = this.fb.group({\n    title: ['', [Validators.required, Validators.minLength(3), Validators.maxLength(200)]],\n  });\n\n  readonly allowedTypes = ['.txt', '.csv', '.md', '.json', '.pdf'];\n  readonly maxFileSize = 10 * 1024 * 1024; // 10MB\n\n  /**\n   * Handle file selection from input.\n   */\n  onFileSelected(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    if (input.files?.length) {\n      this.validateAndSetFile(input.files[0]);\n    }\n  }\n\n  /**\n   * Handle drag over event.\n   */\n  onDragOver(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(true);\n  }\n\n  /**\n   * Handle drag leave event.\n   */\n  onDragLeave(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(false);\n  }\n\n  /**\n   * Handle file drop.\n   */\n  onDrop(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(false);\n\n    if (event.dataTransfer?.files?.length) {\n      this.validateAndSetFile(event.dataTransfer.files[0]);\n    }\n  }\n\n  /**\n   * Validate and set selected file.\n   */\n  private validateAndSetFile(file: File): void {\n    const extension = '.' + file.name.split('.').pop()?.toLowerCase();\n    if (!this.allowedTypes.includes(extension)) {\n      this.toast.error(`Tipo de arquivo não suportado. Use: ${this.allowedTypes.join(', ')}`);\n      return;\n    }\n\n    if (file.size > this.maxFileSize) {\n      this.toast.error('Arquivo muito grande. Máximo: 10MB');\n      return;\n    }\n\n    this.selectedFile.set(file);\n\n    if (!this.form.get('title')?.value) {\n      const titleWithoutExt = file.name.replace(/\\.[^/.]+$/, '');\n      this.form.patchValue({ title: titleWithoutExt });\n    }\n  }\n\n  /**\n   * Clear selected file.\n   */\n  clearFile(): void {\n    this.selectedFile.set(null);\n    if (this.fileInput) {\n      this.fileInput.nativeElement.value = '';\n    }\n  }\n\n  /**\n   * Open file browser.\n   */\n  openFileBrowser(): void {\n    this.fileInput.nativeElement.click();\n  }\n\n  /**\n   * Format file size for display.\n   */\n  formatFileSize(bytes: number): string {\n    if (bytes < 1024) return bytes + ' B';\n    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';\n    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';\n  }\n\n  /**\n   * Submit upload.\n   */\n  submit(): void {\n    const file = this.selectedFile();\n    if (!file || this.form.invalid || this.isUploading()) return;\n\n    this.isUploading.set(true);\n    const title = this.form.get('title')!.value!;\n\n    this.knowledgeService.upload(file, title).subscribe({\n      next: () => {\n        this.isUploading.set(false);\n        this.toast.success('Documento enviado. Processamento iniciado.');\n        void this.router.navigate(['/ai/knowledge/base']);\n      },\n      error: () => {\n        this.isUploading.set(false);\n        this.toast.error('Erro ao enviar documento.');\n      },\n    });\n  }\n\n  /**\n   * Navigate back to list.\n   */\n  goBack(): void {\n    void this.router.navigate(['/ai/knowledge/base']);\n  }\n}\n\nexport default KnowledgeUploadComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/pages/prompts/prompt-editor/prompt-editor.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":94},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":244,"column":45,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":244,"endColumn":71,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[10046,10047],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":245,"column":19,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":245,"endColumn":45,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[10107,10108],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":303,"column":22,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":303,"endColumn":55},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":303,"column":22,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":303,"endColumn":48,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[11592,11593],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { Router, RouterLink } from '@angular/router';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfButtonComponent,\n  AfLoadingButtonComponent,\n  AfPageTitleComponent,\n  AfTextareaInputComponent,\n} from '@shared/components';\nimport { ToastService } from '../../../../../core/services/toast.service';\nimport { AiPromptService } from '../../../services/ai-prompt.service';\nimport type { AiPrompt } from '../../../models/ai.models';\n\ninterface PromptVersion {\n  id: string;\n  template: string;\n  updated_at: string;\n  is_current: boolean;\n}\n\n/**\n * Editor for AI prompts with versioning support.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-prompt-editor',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    RouterLink,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfTextareaInputComponent,\n    AfButtonComponent,\n    AfLoadingButtonComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title title=\"Editor de Prompts\" subtitle=\"Inteligência Artificial\" />\n\n    @if (isLoading()) {\n      <!-- Loading State -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-5\">\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 animate-pulse\"\n        >\n          <div class=\"h-5 w-24 bg-neutral-200 dark:bg-neutral-700 rounded mb-4\"></div>\n          @for (row of [0, 1, 2, 3, 4]; track row) {\n            <div class=\"h-10 bg-neutral-200 dark:bg-neutral-700 rounded mb-2\"></div>\n          }\n        </div>\n        <div\n          class=\"lg:col-span-3 bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 animate-pulse\"\n        >\n          <div class=\"h-5 w-32 bg-neutral-200 dark:bg-neutral-700 rounded mb-4\"></div>\n          <div class=\"h-64 bg-neutral-200 dark:bg-neutral-700 rounded\"></div>\n        </div>\n      </div>\n    } @else if (hasError()) {\n      <!-- Error State -->\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-12 text-center\"\n      >\n        <lucide-icon name=\"alert-circle\" [size]=\"48\" class=\"text-red-500 mx-auto mb-3\" />\n        <h3 class=\"text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-2\">\n          Erro ao carregar prompts\n        </h3>\n        <p class=\"text-sm text-neutral-500 mb-4\">\n          Não foi possível carregar os templates de prompt.\n        </p>\n        <af-button variant=\"primary\" size=\"sm\" (click)=\"retry()\">Tentar novamente</af-button>\n      </div>\n    } @else if (prompts().length === 0) {\n      <!-- Empty State -->\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-12 text-center\"\n      >\n        <lucide-icon\n          name=\"message-square\"\n          [size]=\"48\"\n          class=\"text-neutral-300 dark:text-neutral-600 mx-auto mb-3\"\n        />\n        <h3 class=\"text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-2\">\n          Nenhum prompt encontrado\n        </h3>\n        <p class=\"text-sm text-neutral-500 mb-4\">\n          Crie um agente primeiro para configurar seus prompts.\n        </p>\n        <af-button variant=\"primary\" size=\"sm\" [routerLink]=\"['/ai/agents/new']\">\n          Criar agente\n        </af-button>\n      </div>\n    } @else {\n      <!-- Editor Layout -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-5\">\n        <!-- Prompt List Sidebar -->\n        <div\n          class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-4\"\n        >\n          <h3 class=\"text-sm font-medium text-neutral-900 dark:text-neutral-100 mb-3\">Prompts</h3>\n          <div class=\"space-y-1\">\n            @for (prompt of prompts(); track prompt.id) {\n              <button\n                type=\"button\"\n                class=\"w-full text-left px-3 py-2 rounded-lg text-sm transition-colors\"\n                [class.bg-accent-50]=\"selectedPrompt()?.id === prompt.id\"\n                [class.dark:bg-accent-900/20]=\"selectedPrompt()?.id === prompt.id\"\n                [class.text-accent-700]=\"selectedPrompt()?.id === prompt.id\"\n                [class.dark:text-accent-400]=\"selectedPrompt()?.id === prompt.id\"\n                [class.text-neutral-700]=\"selectedPrompt()?.id !== prompt.id\"\n                [class.dark:text-neutral-300]=\"selectedPrompt()?.id !== prompt.id\"\n                [class.hover:bg-neutral-100]=\"selectedPrompt()?.id !== prompt.id\"\n                [class.dark:hover:bg-neutral-700]=\"selectedPrompt()?.id !== prompt.id\"\n                (click)=\"selectPrompt(prompt)\"\n              >\n                {{ prompt.name }}\n              </button>\n            }\n          </div>\n        </div>\n\n        <!-- Editor Panel -->\n        <div\n          class=\"lg:col-span-3 bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n        >\n          @if (selectedPrompt(); as prompt) {\n            <div class=\"flex items-center justify-between mb-4\">\n              <div>\n                <h3 class=\"text-base font-medium text-neutral-900 dark:text-neutral-100\">\n                  {{ prompt.name }}\n                </h3>\n                @if (prompt.category) {\n                  <span class=\"text-xs text-neutral-500\">Categoria: {{ prompt.category }}</span>\n                }\n              </div>\n              <af-button variant=\"ghost\" size=\"sm\" (click)=\"toggleVersions()\">\n                <lucide-icon name=\"history\" [size]=\"14\" class=\"block\" />\n                Versões\n              </af-button>\n            </div>\n\n            <!-- Version History Panel -->\n            @if (showVersions() && versions().length > 0) {\n              <div class=\"mb-4 p-4 bg-neutral-50 dark:bg-neutral-900/50 rounded-xl\">\n                <h4 class=\"text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2\">\n                  Histórico de Versões\n                </h4>\n                <div class=\"space-y-2 max-h-40 overflow-y-auto\">\n                  @for (version of versions(); track version.id) {\n                    <div\n                      class=\"flex items-center justify-between p-2 bg-white dark:bg-neutral-800 rounded-lg border border-neutral-200 dark:border-neutral-700\"\n                    >\n                      <span class=\"text-xs text-neutral-600 dark:text-neutral-400\">\n                        {{ version.updated_at }}\n                      </span>\n                      @if (!version.is_current) {\n                        <af-button variant=\"ghost\" size=\"sm\" (click)=\"rollback(version)\">\n                          Restaurar\n                        </af-button>\n                      } @else {\n                        <span class=\"text-xs text-emerald-600 dark:text-emerald-400\">Atual</span>\n                      }\n                    </div>\n                  }\n                </div>\n              </div>\n            }\n\n            <!-- Template Editor -->\n            <form [formGroup]=\"form\" (ngSubmit)=\"save()\">\n              <af-textarea-input\n                [control]=\"form.controls.template\"\n                label=\"Template\"\n                placeholder=\"Escreva o template do prompt aqui...\"\n                [rows]=\"12\"\n                dataTest=\"prompt-template\"\n              />\n\n              <!-- Variables Preview -->\n              @if (variablesList().length > 0) {\n                <div class=\"mb-4 p-3 bg-sky-50 dark:bg-sky-900/20 rounded-xl\">\n                  <span class=\"text-xs font-medium text-sky-700 dark:text-sky-400\">\n                    Variáveis detectadas:\n                  </span>\n                  <span class=\"text-xs text-sky-600 dark:text-sky-500\">\n                    @for (v of variablesList(); track v; let last = $last) {\n                      <code class=\"bg-sky-100 dark:bg-sky-800 px-1 rounded font-mono\">\n                        {{ '{{' + v + '}}' }} </code\n                      >{{ last ? '' : ', ' }}\n                    }\n                  </span>\n                </div>\n              }\n\n              <!-- Actions -->\n              <div\n                class=\"flex items-center justify-between pt-4 border-t border-neutral-200 dark:border-neutral-700\"\n              >\n                <af-button variant=\"ghost\" size=\"sm\" type=\"button\" (click)=\"goBack()\">\n                  <lucide-icon name=\"arrow-left\" [size]=\"16\" class=\"block\" />\n                  Voltar\n                </af-button>\n\n                <af-loading-button\n                  variant=\"primary\"\n                  size=\"sm\"\n                  type=\"submit\"\n                  [loading]=\"isSaving()\"\n                  [disabled]=\"form.invalid || !hasChanges()\"\n                >\n                  <lucide-icon name=\"save\" [size]=\"16\" class=\"block\" />\n                  Salvar alterações\n                </af-loading-button>\n              </div>\n            </form>\n          }\n        </div>\n      </div>\n    }\n  `,\n})\nexport class PromptEditorComponent implements OnInit {\n  private readonly fb = inject(FormBuilder);\n  private readonly router = inject(Router);\n  private readonly promptService = inject(AiPromptService);\n  private readonly toast = inject(ToastService);\n\n  readonly isLoading = signal(true);\n  readonly isSaving = signal(false);\n  readonly hasError = signal(false);\n  readonly showVersions = signal(false);\n\n  readonly prompts = signal<AiPrompt[]>([]);\n  readonly selectedPrompt = signal<AiPrompt | null>(null);\n  readonly versions = signal<PromptVersion[]>([]);\n\n  readonly form = this.fb.group({\n    template: ['', [Validators.required, Validators.minLength(10)]],\n  });\n\n  private readonly templateValue = toSignal(this.form.get('template')!.valueChanges, {\n    initialValue: this.form.get('template')!.value ?? '',\n  });\n\n  readonly hasChanges = computed(() => {\n    const current = this.selectedPrompt();\n    if (!current) return false;\n    return this.templateValue() !== current.template;\n  });\n\n  readonly variablesList = computed(() => {\n    const template = this.form.get('template')?.value ?? '';\n    const matches = template.match(/\\{\\{(\\w+)\\}\\}/g) ?? [];\n    return [...new Set(matches.map((m: string) => m.replace(/\\{\\{|\\}\\}/g, '')))];\n  });\n\n  ngOnInit(): void {\n    this.loadPrompts();\n  }\n\n  /**\n   * Load all prompts for selection.\n   */\n  private loadPrompts(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n\n    this.promptService.list({ per_page: 50 }).subscribe({\n      next: (response) => {\n        this.prompts.set(response.data ?? []);\n        if (response.data?.length > 0) {\n          this.selectPrompt(response.data[0]);\n        }\n        this.isLoading.set(false);\n      },\n      error: () => {\n        this.isLoading.set(false);\n        this.hasError.set(true);\n      },\n    });\n  }\n\n  /**\n   * Select a prompt to edit.\n   */\n  selectPrompt(prompt: AiPrompt): void {\n    this.selectedPrompt.set(prompt);\n    this.form.patchValue({ template: prompt.template });\n    this.showVersions.set(false);\n  }\n\n  /**\n   * Save prompt changes.\n   */\n  save(): void {\n    const prompt = this.selectedPrompt();\n    if (!prompt || this.form.invalid || this.isSaving()) return;\n\n    this.isSaving.set(true);\n    const template = this.form.get('template')!.value!;\n\n    this.promptService.update(prompt.id, { template }).subscribe({\n      next: (updated) => {\n        this.selectedPrompt.set(updated);\n        this.isSaving.set(false);\n        this.toast.success('Prompt salvo com sucesso.');\n      },\n      error: () => {\n        this.isSaving.set(false);\n        this.toast.error('Erro ao salvar prompt.');\n      },\n    });\n  }\n\n  /**\n   * Rollback to a previous version.\n   */\n  rollback(version: PromptVersion): void {\n    this.form.patchValue({ template: version.template });\n    this.showVersions.set(false);\n    this.toast.info('Template restaurado. Salve para confirmar.');\n  }\n\n  /**\n   * Toggle version history panel.\n   */\n  toggleVersions(): void {\n    this.showVersions.update((v) => !v);\n  }\n\n  /**\n   * Navigate back.\n   */\n  goBack(): void {\n    void this.router.navigate(['/ai/agents']);\n  }\n\n  /**\n   * Retry loading.\n   */\n  retry(): void {\n    this.loadPrompts();\n  }\n}\n\nexport default PromptEditorComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/ai-agent.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":29,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":29,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1027,1038],"text":"params.page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1027,1038],"text":"params.page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1027,1038],"text":"Boolean(params.page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":30,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":30,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1106,1121],"text":"params.per_page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1106,1121],"text":"params.per_page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1106,1121],"text":"Boolean(params.per_page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":31,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":31,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1197,1208],"text":"params.type != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1197,1208],"text":"params.type ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1197,1208],"text":"Boolean(params.type)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":68,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":68,"endColumn":33}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Paginated } from '../../../shared/types/pagination';\nimport type { AiAgent, AiAgentPayload } from '../models/ai.models';\n\n/**\n * Service para gestão de Agentes de IA (sales, support, qualifier).\n *\n * Responsável por operações CRUD e ativação/desativação de agentes,\n * permitindo configurar comportamentos de bots por tipo.\n *\n * @class AiAgentService\n */\n@Injectable({ providedIn: 'root' })\nexport class AiAgentService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai/agents`;\n\n  /**\n   * Lista todos os agentes com paginação.\n   * @param params Parâmetros de paginação e filtros\n   */\n  list(\n    params: { page?: number; per_page?: number; type?: string } = {},\n  ): Observable<Paginated<AiAgent>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    if (params.type) httpParams = httpParams.set('type', params.type);\n\n    return this.http.get<Paginated<AiAgent>>(this.baseUrl, { params: httpParams });\n  }\n\n  /**\n   * Busca um agente específico por ID.\n   * @param id ID do agente\n   */\n  get(id: string): Observable<AiAgent> {\n    return this.http.get<{ data: AiAgent }>(`${this.baseUrl}/${id}`).pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Cria um novo agente.\n   * @param payload Dados do agente\n   */\n  create(payload: AiAgentPayload): Observable<AiAgent> {\n    return this.http.post<{ data: AiAgent }>(this.baseUrl, payload).pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Atualiza um agente existente.\n   * @param id ID do agente\n   * @param payload Dados a atualizar\n   */\n  update(id: string, payload: Partial<AiAgentPayload>): Observable<AiAgent> {\n    return this.http\n      .put<{ data: AiAgent }>(`${this.baseUrl}/${id}`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Remove um agente.\n   * @param id ID do agente\n   */\n  delete(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n\n  /**\n   * Ativa ou desativa um agente.\n   * @param id ID do agente\n   * @param isActive Novo estado\n   */\n  toggleActive(id: string, isActive: boolean): Observable<AiAgent> {\n    return this.update(id, { is_active: isActive });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/ai-knowledge.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":75,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":75,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1920,1931],"text":"params.page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1920,1931],"text":"params.page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1920,1931],"text":"Boolean(params.page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":76,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":76,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1999,2014],"text":"params.per_page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1999,2014],"text":"params.per_page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1999,2014],"text":"Boolean(params.per_page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":77,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":77,"endColumn":22,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2090,2103],"text":"params.status != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2090,2103],"text":"params.status ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2090,2103],"text":"Boolean(params.status)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":78,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":78,"endColumn":28,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2167,2186],"text":"params.content_type != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2167,2186],"text":"params.content_type ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2167,2186],"text":"Boolean(params.content_type)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":79,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":79,"endColumn":22,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2262,2275],"text":"params.search != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2262,2275],"text":"params.search ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2262,2275],"text":"Boolean(params.search)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":129,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":129,"endColumn":33}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Paginated } from '../../../shared/types/pagination';\nimport type {\n  AiKnowledge,\n  KnowledgeChunk,\n  AiKnowledgePayload,\n  KnowledgeSearchResult,\n  KnowledgeStats,\n} from '../models/ai.models';\n\ninterface AiKnowledgeApiItem {\n  id: string;\n  name: string;\n  original_filename: string;\n  file_type: 'txt' | 'csv' | 'markdown' | 'json' | 'pdf';\n  file_size_bytes: number;\n  file_size_formatted: string;\n  version: number;\n  chunk_count: number;\n  embedding_status: 'pending' | 'processing' | 'ready' | 'failed';\n  error_message?: string | null;\n  is_ready?: boolean;\n  is_processing?: boolean;\n  is_failed?: boolean;\n  can_reprocess?: boolean;\n  metadata?: Record<string, unknown> | null;\n  created_at?: string;\n  updated_at?: string;\n}\n\ninterface ApiDataResponse<T> {\n  data: T;\n}\n\ninterface ApiCollectionWithMeta<T> {\n  data: T[];\n  meta: {\n    current_page: number;\n    last_page: number;\n    per_page: number;\n    total: number;\n  };\n}\n\n/**\n * Service para gestão da Base de Conhecimento da IA.\n *\n * Responsável por upload, indexação e consulta de documentos\n * que alimentam o contexto dos agentes de IA.\n *\n * @class AiKnowledgeService\n */\n@Injectable({ providedIn: 'root' })\nexport class AiKnowledgeService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai/knowledge`;\n\n  /**\n   * Lista entradas da base de conhecimento com paginação.\n   * @param params Parâmetros de paginação e filtros\n   */\n  list(\n    params: {\n      page?: number;\n      per_page?: number;\n      status?: string;\n      content_type?: string;\n      search?: string;\n    } = {},\n  ): Observable<Paginated<AiKnowledge>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    if (params.status) httpParams = httpParams.set('status', params.status);\n    if (params.content_type) httpParams = httpParams.set('content_type', params.content_type);\n    if (params.search) httpParams = httpParams.set('search', params.search);\n\n    return this.http.get<Paginated<AiKnowledgeApiItem>>(this.baseUrl, { params: httpParams }).pipe(\n      map((response) => ({\n        ...response,\n        data: (response.data ?? []).map((item) => this.mapKnowledge(item)),\n      })),\n    );\n  }\n\n  /**\n   * Busca uma entrada específica por ID.\n   * @param id ID da entrada\n   */\n  get(id: string): Observable<AiKnowledge> {\n    return this.http\n      .get<ApiDataResponse<AiKnowledgeApiItem>>(`${this.baseUrl}/${id}`)\n      .pipe(map((resp) => this.mapKnowledge(resp.data)));\n  }\n\n  /**\n   * Cria uma nova entrada de conhecimento (texto).\n   * @param payload Dados da entrada\n   */\n  create(payload: AiKnowledgePayload): Observable<AiKnowledge> {\n    return this.http\n      .post<ApiDataResponse<AiKnowledgeApiItem>>(this.baseUrl, payload)\n      .pipe(map((resp) => this.mapKnowledge(resp.data)));\n  }\n\n  /**\n   * Upload de arquivo (PDF, CSV) para a base de conhecimento.\n   * @param file Arquivo a ser enviado\n   * @param title Título da entrada\n   */\n  upload(file: File, title: string): Observable<AiKnowledge> {\n    const formData = new FormData();\n    formData.append('file', file);\n    formData.append('name', title);\n\n    return this.http\n      .post<ApiDataResponse<AiKnowledgeApiItem>>(`${this.baseUrl}/upload`, formData)\n      .pipe(map((resp) => this.mapKnowledge(resp.data)));\n  }\n\n  /**\n   * Remove uma entrada da base de conhecimento.\n   * @param id ID da entrada\n   */\n  delete(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n\n  /**\n   * Reprocessa uma entrada para re-indexação.\n   * @param id ID da entrada\n   */\n  reindex(id: string): Observable<AiKnowledge> {\n    return this.http\n      .post<ApiDataResponse<AiKnowledgeApiItem>>(`${this.baseUrl}/${id}/reindex`, {})\n      .pipe(map((resp) => this.mapKnowledge(resp.data)));\n  }\n\n  /**\n   * Carrega estatísticas da base de conhecimento.\n   */\n  getStats(): Observable<KnowledgeStats> {\n    return this.http\n      .get<ApiDataResponse<KnowledgeStats>>(`${this.baseUrl}/stats`)\n      .pipe(map((response) => response.data));\n  }\n\n  /**\n   * Busca semântica na base de conhecimento.\n   * @param query Termo de busca\n   * @param limit Máximo de resultados\n   */\n  search(query: string, limit = 10): Observable<KnowledgeSearchResult[]> {\n    return this.http\n      .post<ApiDataResponse<KnowledgeSearchResult[]>>(`${this.baseUrl}/search`, { query, limit })\n      .pipe(map((resp) => resp.data));\n  }\n\n  /**\n   * Lista chunks de um documento específico.\n   */\n  getChunks(\n    documentId: string,\n    page = 1,\n    perPage = 20,\n  ): Observable<ApiCollectionWithMeta<KnowledgeChunk>> {\n    const params = new HttpParams().set('page', String(page)).set('per_page', String(perPage));\n\n    return this.http.get<ApiCollectionWithMeta<KnowledgeChunk>>(\n      `${this.baseUrl}/${documentId}/chunks`,\n      { params },\n    );\n  }\n\n  private mapKnowledge(item: AiKnowledgeApiItem): AiKnowledge {\n    const contentTypeMap: Record<AiKnowledgeApiItem['file_type'], AiKnowledge['content_type']> = {\n      txt: 'text',\n      markdown: 'text',\n      csv: 'csv',\n      json: 'text',\n      pdf: 'pdf',\n    };\n\n    const statusMap: Record<AiKnowledgeApiItem['embedding_status'], AiKnowledge['status']> = {\n      pending: 'pending',\n      processing: 'processing',\n      ready: 'indexed',\n      failed: 'failed',\n    };\n\n    return {\n      ...item,\n      title: item.name,\n      content_type: contentTypeMap[item.file_type],\n      status: statusMap[item.embedding_status],\n      token_count: 0,\n      file_path: null,\n      source_url: null,\n    };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/ai-prompt.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":41,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":41,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1247,1258],"text":"params.page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1247,1258],"text":"params.page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1247,1258],"text":"Boolean(params.page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":42,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":42,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1326,1341],"text":"params.per_page != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[1326,1341],"text":"params.per_page ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1326,1341],"text":"Boolean(params.per_page)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":43,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":43,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1417,1432],"text":"params.agent_id != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1417,1432],"text":"params.agent_id ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1417,1432],"text":"Boolean(params.agent_id)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":44,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":44,"endColumn":24,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1500,1515],"text":"params.category != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1500,1515],"text":"params.category ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1500,1515],"text":"Boolean(params.category)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":96,"column":10,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":96,"endColumn":26,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2982,2999],"text":"payload.template == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2983,2999],"text":"(payload.template ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2982,2999],"text":"!Boolean(payload.template)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":111,"column":27,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":111,"endColumn":31},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":163,"column":21,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":163,"endColumn":31,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[4954,4964],"text":"(expectedId != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[4954,4964],"text":"(expectedId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[4954,4964],"text":"(Boolean(expectedId))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Paginated } from '../../../shared/types/pagination';\nimport type { AiPrompt, AiPromptPayload } from '../models/ai.models';\n\ninterface TenantPromptApiResponse {\n  data: {\n    id: string;\n    tenant_id: string;\n    content: string;\n    segment?: { name?: string } | null;\n    is_active: boolean;\n    created_at?: string;\n    updated_at?: string;\n  } | null;\n}\n\n/**\n * Service para gestão de Templates de Prompt.\n *\n * Responsável por CRUD de prompts configuráveis por agente,\n * com suporte a variáveis de interpolação.\n *\n * @class AiPromptService\n */\n@Injectable({ providedIn: 'root' })\nexport class AiPromptService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/ai/prompt`;\n\n  /**\n   * Lista prompts com paginação e filtros.\n   * @param params Parâmetros de paginação e filtros\n   */\n  list(\n    params: { page?: number; per_page?: number; agent_id?: string; category?: string } = {},\n  ): Observable<Paginated<AiPrompt>> {\n    let httpParams = new HttpParams();\n    if (params.page) httpParams = httpParams.set('page', String(params.page));\n    if (params.per_page) httpParams = httpParams.set('per_page', String(params.per_page));\n    if (params.agent_id) httpParams = httpParams.set('agent_id', params.agent_id);\n    if (params.category) httpParams = httpParams.set('category', params.category);\n\n    return this.http.get<TenantPromptApiResponse>(this.baseUrl, { params: httpParams }).pipe(\n      map((response) => {\n        const prompt = this.mapTenantPromptToAiPrompt(response.data);\n        const data = prompt ? [prompt] : [];\n\n        return {\n          data,\n          meta: {\n            total: data.length,\n            per_page: params.per_page ?? 10,\n            current_page: 1,\n            last_page: 1,\n          },\n        };\n      }),\n    );\n  }\n\n  /**\n   * Busca um prompt específico por ID.\n   * @param id ID do prompt\n   */\n  get(id: string): Observable<AiPrompt> {\n    return this.http.get<TenantPromptApiResponse>(this.baseUrl).pipe(\n      map((response) => {\n        const prompt = this.mapTenantPromptToAiPrompt(response.data);\n        if (!prompt || prompt.id !== id) {\n          throw new Error('Prompt not found');\n        }\n        return prompt;\n      }),\n    );\n  }\n\n  /**\n   * Cria um novo prompt.\n   * @param payload Dados do prompt\n   */\n  create(payload: AiPromptPayload): Observable<AiPrompt> {\n    return this.http\n      .put<TenantPromptApiResponse>(this.baseUrl, { content: payload.template })\n      .pipe(map((response) => this.requirePrompt(response.data)));\n  }\n\n  /**\n   * Atualiza um prompt existente.\n   * @param id ID do prompt\n   * @param payload Dados a atualizar\n   */\n  update(id: string, payload: Partial<AiPromptPayload>): Observable<AiPrompt> {\n    if (!payload.template) {\n      throw new Error('Template is required to update prompt');\n    }\n\n    return this.http\n      .put<TenantPromptApiResponse>(this.baseUrl, { content: payload.template })\n      .pipe(map((response) => this.requirePrompt(response.data, id)));\n  }\n\n  /**\n   * Remove um prompt.\n   * @param id ID do prompt\n   */\n  delete(id: string): Observable<void> {\n    void id;\n    return this.http.post<void>(`${this.baseUrl}/rollback`, {});\n  }\n\n  /**\n   * Testa um prompt com variáveis de exemplo.\n   * @param id ID do prompt\n   * @param variables Variáveis para interpolação\n   */\n  test(id: string, variables: Record<string, string>): Observable<{ rendered: string }> {\n    return this.get(id).pipe(\n      map((prompt) => {\n        let rendered = prompt.template;\n        Object.entries(variables).forEach(([key, value]) => {\n          rendered = rendered.replaceAll(`{{${key}}}`, value).replaceAll(`{${key}}`, value);\n        });\n\n        return { rendered };\n      }),\n    );\n  }\n\n  /**\n   * Extrai variáveis de um template de prompt.\n   * @param template Template do prompt\n   */\n  extractVariables(template: string): string[] {\n    const matches = template.match(/\\{\\{(\\w+)\\}\\}|\\{(\\w+)\\}/g) ?? [];\n\n    return [...new Set(matches.map((match) => match.replace(/^\\{\\{?/, '').replace(/\\}\\}?$/, '')))];\n  }\n\n  private mapTenantPromptToAiPrompt(data: TenantPromptApiResponse['data']): AiPrompt | null {\n    if (!data) {\n      return null;\n    }\n\n    return {\n      id: data.id,\n      agent_id: data.tenant_id,\n      name: 'Prompt do Tenant',\n      template: data.content,\n      variables: this.extractVariables(data.content),\n      category: data.segment?.name ?? null,\n      is_active: data.is_active,\n      created_at: data.created_at,\n      updated_at: data.updated_at,\n    };\n  }\n\n  private requirePrompt(data: TenantPromptApiResponse['data'], expectedId?: string): AiPrompt {\n    const prompt = this.mapTenantPromptToAiPrompt(data);\n\n    if (!prompt || (expectedId && prompt.id !== expectedId)) {\n      throw new Error('Prompt not found');\n    }\n\n    return prompt;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ai/services/ai-realtime.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":124,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":124,"endColumn":15,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[3859,3865],"text":"(runId == null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[3860,3865],"text":"(runId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[3859,3865],"text":"(!Boolean(runId))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":124,"column":20,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":124,"endColumn":28,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[3869,3878],"text":"(tenantId == null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[3870,3878],"text":"(tenantId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[3869,3878],"text":"(!Boolean(tenantId))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. P