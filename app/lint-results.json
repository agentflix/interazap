8,"endColumn":45,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[5187,5209],"text":"(formValue.client_token != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[5187,5209],"text":"(formValue.client_token ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[5187,5209],"text":"(Boolean(formValue.client_token))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":162,"column":10,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":162,"endColumn":23,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[5249,5263],"text":"payload.token == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[5250,5263],"text":"(payload.token ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[5249,5263],"text":"!Boolean(payload.token)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":180,"column":21,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":180,"endColumn":41,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[5767,5787],"text":"(Boolean((error.error?.message)))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed, toSignal } from '@angular/core/rxjs-interop';\nimport { map, startWith } from 'rxjs';\nimport { toast } from 'ngx-sonner';\nimport type { Integration } from 'src/app/core/services/integration.service';\nimport { IntegrationService } from 'src/app/core/services/integration.service';\nimport type { SelectOption } from '@shared/components/inputs';\nimport {\n  TextInputComponent,\n  SelectInputComponent,\n  SwitchInputComponent,\n} from '@shared/components/inputs';\n\n@Component({\n  selector: 'app-integration-form',\n  standalone: true,\n  imports: [ReactiveFormsModule, TextInputComponent, SelectInputComponent, SwitchInputComponent],\n  templateUrl: './integration-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class IntegrationFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly integrationService = inject(IntegrationService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedIntegrationId = signal<string | null>(null);\n\n  readonly integration = input<Integration | null>(null);\n  readonly saved = output<Integration>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n\n  readonly providerOptions: SelectOption[] = [\n    { label: 'Evolution API', value: 'evolution' },\n    { label: 'Z-API', value: 'zapi' },\n    { label: 'CodeChat', value: 'codechat' },\n    { label: 'UaZapi', value: 'uazapi' },\n  ];\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    provider: this.fb.control('evolution', Validators.required),\n    token: this.fb.control(''),\n    instance: this.fb.control(''),\n    client_token: this.fb.control(''),\n    cellphone: this.fb.control('', Validators.required),\n    is_active: this.fb.control(true),\n    evaluation_enabled: this.fb.control(false),\n    evaluation_cutoff_score: this.fb.control(3, [\n      Validators.required,\n      Validators.min(1),\n      Validators.max(5),\n    ]),\n  });\n\n  readonly isZapi = toSignal(\n    this.form.controls.provider.valueChanges.pipe(\n      startWith(this.form.controls.provider.value),\n      map((provider) => provider === 'zapi'),\n    ),\n    { initialValue: false },\n  );\n\n  readonly isEvaluationEnabled = toSignal(\n    this.form.controls.evaluation_enabled.valueChanges.pipe(\n      startWith(this.form.controls.evaluation_enabled.value),\n      map((value) => value === true),\n    ),\n    { initialValue: false },\n  );\n\n  readonly isTokenRequired = toSignal(\n    this.form.controls.provider.valueChanges.pipe(\n      startWith(this.form.controls.provider.value),\n      map((provider) => provider === 'uazapi'),\n    ),\n    { initialValue: false },\n  );\n\n  constructor() {\n    effect(() => {\n      const integration = this.integration();\n      if (integration) {\n        if (this.lastLoadedIntegrationId() === String(integration.id)) {\n          return;\n        }\n\n        this.lastLoadedIntegrationId.set(String(integration.id));\n        this.form.reset({\n          name: integration.name,\n          provider: integration.provider,\n          token: '',\n          instance: integration.settings?.instance || '',\n          client_token: integration.settings?.client_token || '',\n          cellphone: integration.settings?.cellphone || '',\n          is_active: integration.is_active,\n          evaluation_enabled: integration.evaluation_enabled ?? false,\n          evaluation_cutoff_score: integration.evaluation_cutoff_score ?? 3,\n        });\n\n        this.form.enable({ emitEvent: false });\n        this.updateTokenValidators(integration.provider);\n        this.applyConnectionLock(integration);\n      } else {\n        this.lastLoadedIntegrationId.set(null);\n        this.resetForm();\n        this.form.enable({ emitEvent: false });\n        this.updateTokenValidators(this.form.controls.provider.value ?? 'evolution');\n      }\n    });\n\n    this.form.controls.provider.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((provider) => {\n        this.updateTokenValidators(provider ?? 'evolution');\n      });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n\n    const providerMap: Record<string, number> = {\n      zapi: 1,\n      codechat: 3,\n      uazapi: 5,\n      evolution: 6,\n    };\n\n    const provider = formValue.provider || 'evolution';\n    const integrationId = providerMap[provider] || 6;\n\n    const payload: Partial<Integration> = {\n      name: formValue.name || '',\n      provider,\n      token: formValue.token || undefined,\n      is_active: formValue.is_active ?? true,\n      evaluation_enabled: formValue.evaluation_enabled ?? false,\n      evaluation_cutoff_score: formValue.evaluation_cutoff_score ?? 3,\n      settings: {\n        integration_id: integrationId,\n        cellphone: formValue.cellphone || '',\n        instance: formValue.instance || undefined,\n        client_token: formValue.client_token || undefined,\n      },\n    };\n\n    if (!payload.token) {\n      delete payload.token;\n    }\n\n    const editing = this.integration();\n    this.isSaving.set(true);\n\n    const request = editing\n      ? this.integrationService.update(editing.id, payload)\n      : this.integrationService.create(payload);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response.data);\n      },\n      error: (error) => {\n        this.isSaving.set(false);\n        toast.error(error.error?.message || 'Não foi possível salvar a integração.');\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      provider: 'evolution',\n      token: '',\n      instance: '',\n      client_token: '',\n      cellphone: '',\n      is_active: true,\n      evaluation_enabled: false,\n      evaluation_cutoff_score: 3,\n    });\n\n    this.updateTokenValidators('evolution');\n  }\n\n  private updateTokenValidators(provider: string): void {\n    const tokenControl = this.form.controls.token;\n\n    if (provider === 'uazapi') {\n      tokenControl.setValidators([Validators.required]);\n    } else {\n      tokenControl.clearValidators();\n    }\n\n    tokenControl.updateValueAndValidity({ emitEvent: false });\n  }\n\n  private applyConnectionLock(integration: Integration): void {\n    if (integration.connection_status === 'connected') {\n      this.form.controls.provider.disable({ emitEvent: false });\n      this.form.controls.token.disable({ emitEvent: false });\n      this.form.controls.instance.disable({ emitEvent: false });\n      this.form.controls.client_token.disable({ emitEvent: false });\n      this.form.controls.is_active.disable({ emitEvent: false });\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/integration/integration.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/integration/integration.spec.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core/testing' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":49},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (94). Maximum allowed is 80.","line":9,"column":29,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":102,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ComponentFixture } from '@angular/core/testing';\nimport { TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\nimport { provideRouter } from '@angular/router';\nimport { IntegrationPage } from './integration';\nimport type { Integration } from 'src/app/core/services/integration.service';\n\ndescribe('IntegrationPage', () => {\n  let component: IntegrationPage;\n  let fixture: ComponentFixture<IntegrationPage>;\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [IntegrationPage],\n      providers: [provideHttpClient(), provideHttpClientTesting(), provideRouter([])],\n    }).compileComponents();\n\n    fixture = TestBed.createComponent(IntegrationPage);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should configure columns', () => {\n    const columns = component.columns();\n    expect(columns.length).toBeGreaterThan(0);\n    expect(columns.some((column) => column.field === 'name')).toBe(true);\n  });\n\n  it('should configure actions', () => {\n    expect(component.actions.some((action) => action.type === 'qr')).toBe(true);\n    expect(component.actions.some((action) => action.type === 'delete')).toBe(true);\n  });\n\n  it('should expose filter options', () => {\n    expect(component.filterStatusOptions.length).toBe(3);\n  });\n\n  it('should handle QR modal lifecycle', () => {\n    expect(component.isQrModalOpen()).toBe(false);\n\n    component.openQrModal({ id: 'int-1' } as Integration);\n    expect(component.isQrModalOpen()).toBe(true);\n\n    component.closeQrModal();\n    expect(component.isQrModalOpen()).toBe(false);\n  });\n\n  it('should handle pairing modal lifecycle', () => {\n    expect(component.isSyncModalOpen()).toBe(false);\n\n    component.openSyncModal({ id: 'int-1' } as Integration);\n    expect(component.isSyncModalOpen()).toBe(true);\n\n    component.closeSyncModal();\n    expect(component.isSyncModalOpen()).toBe(false);\n  });\n\n  it('should handle disconnect confirmation', () => {\n    expect(component.isDisconnectModalOpen()).toBe(false);\n\n    component.openDisconnectModal({ id: 'int-1' } as Integration);\n    expect(component.isDisconnectModalOpen()).toBe(true);\n\n    component.closeDisconnectModal();\n    expect(component.isDisconnectModalOpen()).toBe(false);\n  });\n\n  it('should configure crud service with all methods', () => {\n    expect(component.crudService.list).toBeDefined();\n    expect(component.crudService.find).toBeDefined();\n    expect(component.crudService.create).toBeDefined();\n    expect(component.crudService.update).toBeDefined();\n    expect(component.crudService.delete).toBeDefined();\n  });\n\n  it('should filter integrations by status', () => {\n    const activeFilter = component.filterStatusOptions.find((opt) => opt.value === 'active');\n    const inactiveFilter = component.filterStatusOptions.find((opt) => opt.value === 'inactive');\n\n    expect(activeFilter).toBeDefined();\n    expect(inactiveFilter).toBeDefined();\n  });\n\n  it('should handle realtime connection updates', () => {\n    expect(component).toBeDefined();\n    // Realtime service is injected and should be available\n  });\n\n  it('should validate integration data before save', () => {\n    const invalidData = { name: '' };\n    const validData = { name: 'Test Integration', provider: 'z-api' };\n\n    expect(invalidData.name).toBeFalsy();\n    expect(validData.name).toBeTruthy();\n    expect(validData.provider).toBeTruthy();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/integration/integration.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'rxjs' import is duplicated.","line":13,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":13,"endColumn":28},{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/integration.service' import is duplicated.","line":27,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":27,"endColumn":80},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@shared/components/inputs' import is duplicated.","line":39,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":39,"endColumn":66},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":229,"column":9,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":229,"endColumn":13,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[7103,7107],"text":"Boolean(crud)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":236,"column":9,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":236,"endColumn":13,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[7237,7241],"text":"Boolean(crud)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpecte