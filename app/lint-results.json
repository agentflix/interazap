n  selector: 'app-guardrail-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfTextInputComponent,\n    AfTextareaInputComponent,\n    AfSelectInputComponent,\n    AfSwitchInputComponent,\n  ],\n  templateUrl: './guardrail-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class GuardrailFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly autopilotService = inject(AutopilotService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  readonly guardrail = input<AutopilotGuardrail | null>(null);\n  readonly saved = output<AutopilotGuardrail>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n\n  readonly ruleTypeOptions: AfSelectOption[] = [\n    { label: 'Bloquear', value: 'BLOCK' },\n    { label: 'Requer Aprovação', value: 'REQUIRE_APPROVAL' },\n    { label: 'Monitorar', value: 'LOG_ONLY' },\n  ];\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    description: this.fb.control(''),\n    rule_type: this.fb.control('REQUIRE_APPROVAL', Validators.required),\n    priority: this.fb.control(0, Validators.required),\n    conditions: this.fb.control('{\\n  \"tool\": \"SEND_MESSAGE\"\\n}', Validators.required),\n    is_active: this.fb.control(true),\n  });\n\n  constructor() {\n    effect(() => {\n      const guardrail = this.guardrail();\n      if (guardrail) {\n        if (this.lastLoadedId() === String(guardrail.id)) {\n          return;\n        }\n        this.lastLoadedId.set(String(guardrail.id));\n        this.form.reset({\n          name: guardrail.name,\n          description: guardrail.description ?? '',\n          rule_type: guardrail.rule_type,\n          priority: guardrail.priority,\n          conditions: JSON.stringify(guardrail.conditions ?? { tool: 'SEND_MESSAGE' }, null, 2),\n          is_active: guardrail.is_active,\n        });\n      } else {\n        this.lastLoadedId.set(null);\n        this.resetForm();\n      }\n    });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n    let conditions: AutopilotGuardrailPayload['conditions'];\n\n    try {\n      conditions = JSON.parse(formValue.conditions ?? '{}');\n    } catch {\n      toast.error('JSON de condições inválido.');\n      return;\n    }\n\n    const payload: AutopilotGuardrailPayload = {\n      name: formValue.name || '',\n      description: formValue.description || undefined,\n      rule_type: formValue.rule_type || 'REQUIRE_APPROVAL',\n      priority: Number(formValue.priority) || 0,\n      conditions,\n      is_active: formValue.is_active ?? true,\n    };\n\n    const editing = this.guardrail();\n    this.isSaving.set(true);\n\n    const request = editing\n      ? this.autopilotService.updateGuardrail(editing.id, payload)\n      : this.autopilotService.createGuardrail(payload);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response);\n      },\n      error: (error) => {\n        this.isSaving.set(false);\n        toast.error(error.error?.message || 'Erro ao salvar guardrail.');\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      description: '',\n      rule_type: 'REQUIRE_APPROVAL',\n      priority: 0,\n      conditions: '{\\n  \"tool\": \"SEND_MESSAGE\"\\n}',\n      is_active: true,\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/guardrails/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"use