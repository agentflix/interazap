 this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":6,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef, OnDestroy } from '@angular/core';\nimport {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  effect,\n  inject,\n  viewChild,\n} from '@angular/core';\nimport { ThemeService } from '../../../core/services/theme.service';\n\n/**\n * AfApexchartComponent — Lightweight wrapper around the ApexCharts library\n * that applies AgentFlix design tokens and reacts to dark mode changes.\n *\n * > Note: Requires `apexcharts` to be installed (`npm install apexcharts`).\n * > This component uses the vanilla JS API directly to avoid the need for\n * > the `ngx-apexcharts` Angular wrapper dependency.\n *\n * @example\n * ```html\n * <af-apexchart\n *   type=\"bar\"\n *   [series]=\"[{ name: 'Receita', data: [44, 55, 41, 67, 22] }]\"\n *   [categories]=\"['Jan', 'Fev', 'Mar', 'Abr', 'Mai']\"\n *   height=\"320\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-apexchart',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `<div #chartContainer></div>`,\n})\nexport class AfApexchartComponent implements OnDestroy {\n  /** Chart type */\n  readonly type = input<'line' | 'bar' | 'area' | 'donut' | 'pie' | 'radialBar'>('bar');\n\n  /** Data series */\n  readonly series = input.required<ApexAxisChartSeries | ApexNonAxisChartSeries>();\n\n  /** X-axis category labels */\n  readonly categories = input<string[]>([]);\n\n  /** Chart height in pixels */\n  readonly height = input('320');\n\n  /** Optional chart title */\n  readonly chartTitle = input<string>();\n\n  /** Custom color palette (defaults to AgentFlix tokens) */\n  readonly colors = input<string[]>([\n    '#6366f1', // accent-500\n    '#8b5cf6', // violet\n    '#06b6d4', // cyan\n    '#f59e0b', // amber\n    '#ef4444', // red\n    '#10b981', // emerald\n  ]);\n\n  /** Labels for donut/pie/radialBar charts */\n  readonly labels = input<string[]>([]);\n\n  /** Extra ApexCharts options deep-merged into defaults (stacked, horizontal, radialBar, etc.) */\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  readonly extraOptions = input<Record<string, any>>({});\n\n  private readonly theme = inject(ThemeService);\n  private readonly chartContainer = viewChild<ElementRef<HTMLDivElement>>('chartContainer');\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  private chart: any = null;\n  private renderVersion = 0;\n\n  constructor() {\n    // Render chart when inputs or theme changes\n    effect(() => {\n      // Read reactive inputs to track them\n      const type = this.type();\n      const series = this.series();\n      const categories = this.categories();\n      const height = this.height();\n      const colors = this.colors();\n      const labels = this.labels();\n      const extraOptions = this.extraOptions();\n      const isDark = this.theme.isDark();\n      const container = this.chartContainer();\n\n      if (!container) return;\n\n      this.renderChart(container.nativeElement, {\n        type,\n        series,\n        categories,\n        height: parseInt(height, 10),\n        colors,\n        labels,\n        extraOptions,\n        isDark,\n      });\n    });\n  }\n\n  private async renderChart(\n    container: HTMLDivElement,\n    opts: {\n      type: string;\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      series: any;\n      categories: string[];\n      height: number;\n      colors: string[];\n      labels: string[];\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      extraOptions: Record<string, any>;\n      isDark: boolean;\n    },\n  ): Promise<void> {\n    const currentRenderVersion = ++this.renderVersion;\n\n    if (!container.isConnected) {\n      return;\n    }\n\n    try {\n      // Standard dynamic import (CSP-safe)\n\n      const mod = await import('apexcharts');\n      const ApexCharts = mod.default;\n\n      if (currentRenderVersion !== this.renderVersion || !container.isConnected) {\n        return;\n      }\n\n      if (this.chart) {\n        this.chart.destroy();\n      }\n\n      const textColor = opts.isDark ? '#a3a3a3' : '#737373';\n      const gridColor = opts.isDark ? '#262626' : '#f5f5f5';\n\n      const options = {\n        chart: {\n          type: opts.type,\n          height: opts.height,\n          toolbar: { show: false },\n          background: 'transparent',\n          fontFamily: 'Inter, system-ui, sans-serif',\n        },\n        series: opts.series,\n        xaxis: {\n          categories: opts.categories,\n          labels: { style: { colors: textColor, fontSize: '12px' } },\n          axisBorder: { color: gridColor },\n          axisTicks: { color: gridColor },\n        },\n        yaxis: {\n          labels: { style: { colors: textColor, fontSize: '12px' } },\n        },\n        colors: opts.colors,\n        grid: {\n          borderColor: gridColor,\n          strokeDashArray: 4,\n        },\n        dataLabels: { enabled: false },\n        stroke: { curve: 'smooth' as const, width: 2 },\n        fill: {\n          type: opts.type === 'area' ? 'gradient' : 'solid',\n          gradient: { opacityFrom: 0.4, opacityTo: 0.05 },\n        },\n        tooltip: {\n          theme: opts.isDark ? 'dark' : 'light',\n        },\n        legend: {\n          labels: { colors: textColor },\n          fontSize: '12px',\n        },\n        plotOptions: {\n          bar: { borderRadius: 4, columnWidth: '60%' },\n          pie: { donut: { size: '65%' } },\n        },\n        theme: { mode: opts.isDark ? ('dark' as const) : ('light' as const) },\n      };\n\n      const merged = this.deepMerge(options, opts.extraOptions);\n      if (opts.labels.length > 0) {\n        merged['labels'] = opts.labels;\n      }\n\n      this.chart = new ApexCharts(container, merged);\n      this.chart.render();\n    } catch {\n      if (!container.isConnected) {\n        return;\n      }\n\n      // ApexCharts not installed — show fallback\n      container.innerHTML = `\n        <div class=\"flex items-center justify-center h-[${opts.height}px] text-sm text-neutral-400 dark:text-neutral-500\">\n          <p>Instale <code class=\"text-accent-500\">apexcharts</code> para visualizar gráficos.</p>\n        </div>\n      `;\n    }\n  }\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  private deepMerge(target: Record<string, any>, source: Record<string, any>): Record<string, any> {\n    const result = { ...target };\n    for (const key of Object.keys(source)) {\n      if (\n        source[key] !== null &&\n        typeof source[key] === 'object' &&\n        !Array.isArray(source[key]) &&\n        target[key] !== null &&\n        typeof target[key] === 'object' &&\n        !Array.isArray(target[key])\n      ) {\n        result[key] = this.deepMerge(\n          target[key] as Record<string, any>,\n          source[key] as Record<string, any>,\n        );\n      } else {\n        result[key] = source[key];\n      }\n    }\n    return result;\n  }\n\n  ngOnDestroy(): void {\n    this.renderVersion++;\n    if (this.chart) {\n      this.chart.destroy();\n      this.chart = null;\n    }\n  }\n}\n\n// Type aliases for ApexCharts series (to avoid importing the full library types)\ntype ApexAxisChartSeries = { name?: string; data: number[] }[];\ntype ApexNonAxisChartSeries = number[];\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/aspect-ratio/aspect-ratio.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'computed' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":53,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":61}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, computed } from '@angular/core';\n\n/**\n * AfAspectRatioComponent — Enforces aspect ratio on child content.\n *\n * @example\n * ```html\n * <af-aspect-ratio ratio=\"16/9\">\n *   <img src=\"video-thumb.jpg\" class=\"w-full h-full object-cover\" />\n * </af-aspect-ratio>\n * ```\n */\n@Component({\n  selector: 'af-aspect-ratio',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"relative w-full\" [style.aspect-ratio]=\"ratio()\">\n      <div class=\"absolute inset-0\">\n        <ng-content />\n      </div>\n    </div>\n  `,\n})\nexport class AfAspectRatioComponent {\n  /** CSS aspect-ratio value (e.g. '16/9', '4/3', '1/1') */\n  readonly ratio = input('16/9');\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/autocomplete/autocomplete.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":11,"endColumn":24}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef } from '@angular/core';\nimport {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  output,\n  signal,\n  computed,\n  HostListener,\n  viewChild,\n} from '@angular/core';\nimport { type FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { AfFormLabelComponent } from '../form-label/form-label';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/** Autocomplete option */\nexport interface AfAutocompleteOption {\n  value: string;\n  label: string;\n}\n\n/**\n * AfAutocompleteComponent — Text input with filtered suggestion dropdown.\n *\n * @example\n * ```html\n * <af-autocomplete\n *   [control]=\"cityCtrl\"\n *   [options]=\"cities\"\n *   label=\"Cidade\"\n *   (optionSelected)=\"onCity($event)\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-autocomplete',\n  standalone: true,\n  imports: [ReactiveFormsModule, AfFormLabelComponent, LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"relative\" #root>\n      @if (label()) {\n        <af-form-label [label]=\"label()\" [required]=\"required()\" />\n      }\n      <div class=\"relative\">\n        <lucide-icon\n          name=\"search\"\n          [size]=\"15\"\n          class=\"absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400\"\n        />\n        <input\n          type=\"text\"\n          [formControl]=\"control()\"\n          [placeholder]=\"placeholder()\"\n          class=\"w-full pl-9 pr-3 py-2 rounded-md border border-neutral-300 dark:border-neutral-600\n            bg-white dark:bg-neutral-800 text-sm text-neutral-900 dark:text-neutral-50\n            placeholder:text-neutral-400 focus:outline-none focus:ring-2\n            focus:ring-accent-500/30 focus:border-accent-500\"\n          (input)=\"onInput()\"\n          (focus)=\"showDropdown.set(true)\"\n        />\n      </div>\n      @if (showDropdown() && filtered().length > 0) {\n        <div\n          class=\"absolute z-20 mt-1 w-full max-h-48 overflow-y-auto rounded-lg border border-neutral-200\n          dark:border-neutral-700 bg-white dark:bg-neutral-900 shadow-md p-1\"\n        >\n          @for (opt of filtered(); track opt.value) {\n            <button\n              type=\"button\"\n              class=\"w-full text-left px-3 py-2 rounded-md text-sm text-neutral-700\n                dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800\"\n              (click)=\"selectOption(opt)\"\n            >\n              {{ opt.label }}\n            </button>\n          }\n        </div>\n      }\n    </div>\n  `,\n})\nexport class AfAutocompleteComponent {\n  /** FormControl binding */\n  readonly control = input.required<FormControl<string>>();\n\n  /** Available options */\n  readonly options = input<AfAutocompleteOption[]>([]);\n\n  /** Field label */\n  readonly label = input('');\n\n  /** Placeholder */\n  readonly placeholder = input('Buscar...');\n\n  /** Required */\n  readonly required = input(false);\n\n  /** Emitted when an option is selected */\n  readonly optionSelected = output<string>();\n\n  protected readonly showDropdown = signal(false);\n\n  private readonly rootRef = viewChild<ElementRef<HTMLElement>>('root');\n\n  protected readonly filtered = computed(() => {\n    const term = this.control().value?.toLowerCase() ?? '';\n    if (!term) return this.options().slice(0, 20);\n    return this.options()\n      .filter((o) => o.label.toLowerCase().includes(term))\n      .slice(0, 20);\n  });\n\n  protected onInput(): void {\n    this.showDropdown.set(true);\n  }\n\n  protected selectOption(opt: AfAutocompleteOption): void {\n    this.control().setValue(opt.label);\n    this.optionSelected.emit(opt.value);\n    this.showDropdown.set(false);\n  }\n\n  @HostListener('document:click', ['$event'])\n  protected onDocumentClick(event: MouseEvent): void {\n    const root = this.rootRef()?.nativeElement;\n    if (root && event.target instanceof Node && !root.contains(event.target)) {\n      this.showDropdown.set(false);\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/avatar-group/avatar-group.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/avatar/avatar.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/badge/badge.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/banner/banner.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":58,"column":35,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":58,"endColumn":39},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":61,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":61,"endColumn":35}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, computed } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * AfBannerComponent — Full-width banner notification (top of page).\n *\n * @example\n * ```html\n * <af-banner variant=\"info\" message=\"Nova versão disponível.\" [dismissible]=\"true\" />\n * ```\n */\n@Component({\n  selector: 'af-banner',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div [class]=\"bannerClasses()\" role=\"status\">\n      <div class=\"flex items-center justify-center gap-2 px-4 py-2\">\n        <lucide-icon [name]=\"iconName()\" [size]=\"16\" />\n        <span class=\"text-sm font-medium\">{{ message() }}</span>\n        @if (actionLabel()) {\n          <button\n            type=\"button\"\n            class=\"text-sm font-semibold underline cursor-pointer hover:no-underline ml-1\"\n            (click)=\"actionClicked.emit()\"\n          >\n            {{ actionLabel() }}\n          </button>\n        }\n        @if (dismissible()) {\n          <button\n            type=\"button\"\n            class=\"ml-auto cursor-pointer opacity-70 hover:opacity-100\"\n            (click)=\"dismissed.emit()\"\n          >\n            <lucide-icon name=\"x\" [size]=\"16\" />\n          </button>\n        }\n      </div>\n    </div>\n  `,\n})\nexport class AfBannerComponent {\n  /** Variant */\n  readonly variant = input<'info' | 'success' | 'warning' | 'danger'>('info');\n\n  /** Banner message */\n  readonly message = input('');\n\n  /** Optional action button label */\n  readonly actionLabel = input('');\n\n  /** Dismissible */\n  readonly dismissible = input(false);\n\n  /** Action button clicked */\n  readonly actionClicked = output<void>();\n\n  /** Dismiss clicked */\n  readonly dismissed = output<void>();\n\n  protected readonly iconName = computed(() => {\n    const map: Record<string, string> = {\n      info: 'circle-info',\n      success: 'circle-check',\n      warning: 'triangle-alert',\n      danger: 'circle-alert',\n    };\n    return map[this.variant()];\n  });\n\n  protected readonly bannerClasses = computed(() => {\n    const variants: Record<string, string> = {\n      info: 'bg-blue-600 text-white',\n      success: 'bg-accent-600 text-white',\n      warning: 'bg-amber-500 text-white',\n      danger: 'bg-red-600 text-white',\n    };\n    return `w-full ${variants[this.variant()]}`;\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/base-list/base-list.ts","messages":[{"ruleId":"@typescript-eslint/no-extraneous-class","severity":2,"message":"Unexpected empty class.","line":43,"column":14,"nodeType":"Identifier","messageId":"empty","endLine":43,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy } from '@angular/core';\n\n/**\n * AfBaseListComponent — Card wrapper with named content projection slots\n * for building standard list pages: header, filters, table, pagination.\n *\n * @example\n * ```html\n * <af-base-list>\n *   <div header>Title + actions</div>\n *   <div filters>Search + filter chips</div>\n *   <div table>Table content</div>\n *   <div pagination>Pagination controls</div>\n * </af-base-list>\n * ```\n */\n@Component({\n  selector: 'af-base-list',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"card\">\n      <div class=\"card-header border-b border-neutral-200 dark:border-neutral-700 px-5 py-4\">\n        <ng-content select=\"[header]\" />\n      </div>\n\n      <div\n        class=\"px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50\"\n      >\n        <ng-content select=\"[filters]\" />\n      </div>\n\n      <div class=\"overflow-x-auto\">\n        <ng-content select=\"[table]\" />\n      </div>\n\n      <div class=\"px-5 py-3 border-t border-neutral-200 dark:border-neutral-700\">\n        <ng-content select=\"[pagination]\" />\n      </div>\n    </div>\n  `,\n})\nexport class AfBaseListComponent {}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/breadcrumb/breadcrumb.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/button-group/button-group.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/button/button.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/buttons.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/calendar/calendar.ts","messages":[{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":60,"column":11,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":91,"endColumn":17},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":60,"column":11,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":91,"endColumn":17}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, computed, signal } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/** Calendar event */\nexport interface AfCalendarEvent {\n  id: string;\n  title: string;\n  date: string; // YYYY-MM-DD\n  color?: string;\n}\n\n/**\n * AfCalendarComponent — Monthly calendar view with events.\n *\n * @example\n * ```html\n * <af-calendar [events]=\"events\" (dateSelected)=\"onDate($event)\" />\n * ```\n */\n@Component({\n  selector: 'af-calendar',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div\n      class=\"bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-700 overflow-hidden\"\n    >\n      <!-- Header -->\n      <div\n        class=\"flex items-center justify-between px-4 py-3 border-b border-neutral-200 dark:border-neutral-700\"\n      >\n        <button\n          type=\"button\"\n          class=\"p-1 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded cursor-pointer\"\n          (click)=\"prevMonth()\"\n        >\n          <lucide-icon name=\"chevron-left\" [size]=\"18\" />\n        </button>\n        <span class=\"text-sm font-semibold text-neutral-900 dark:text-neutral-50\">{{\n          monthYearLabel()\n        }}</span>\n        <button\n          type=\"button\"\n          class=\"p-1 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded cursor-pointer\"\n          (click)=\"nextMonth()\"\n        >\n          <lucide-icon name=\"chevron-right\" [size]=\"18\" />\n        </button>\n      </div>\n      <!-- Weekday headers -->\n      <div class=\"grid grid-cols-7 border-b border-neutral-200 dark:border-neutral-700\">\n        @for (day of weekdays; track day) {\n          <div class=\"text-center text-xs font-medium text-neutral-500 py-2\">{{ day }}</div>\n        }\n      </div>\n      <!-- Days -->\n      <div class=\"grid grid-cols-7\">\n        @for (cell of calendarDays(); track $index) {\n          <div\n            class=\"min-h-[60px] p-1 border-r border-b border-neutral-100 dark:border-neutral-800\n              last:border-r-0 cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-800/50\"\n            [class.opacity-40]=\"!cell.currentMonth\"\n            (click)=\"dateSelected.emit(cell.dateStr)\"\n          >\n            <span\n              class=\"inline-flex items-center justify-center text-xs w-6 h-6 rounded-full\"\n              [class.bg-accent-600]=\"cell.isToday\"\n              [class.text-white]=\"cell.isToday\"\n              [class.text-neutral-700]=\"!cell.isToday\"\n              [class.dark:text-neutral-300]=\"!cell.isToday\"\n            >\n              {{ cell.day }}\n            </span>\n            @if (cell.events.length > 0) {\n              <div class=\"flex gap-0.5 mt-0.5 flex-wrap\">\n                @for (ev of cell.events.slice(0, 2); track ev.id) {\n                  <span\n                    class=\"block w-full truncate text-[10px] px-1 rounded\"\n                    [style.background-color]=\"ev.color ?? '#6366f1'\"\n                    style=\"color: white\"\n                  >\n                    {{ ev.title }}\n                  </span>\n                }\n                @if (cell.events.length > 2) {\n                  <span class=\"text-[10px] text-neutral-400\">+{{ cell.events.length - 2 }}</span>\n                }\n              </div>\n            }\n          </div>\n        }\n      </div>\n    </div>\n  `,\n})\nexport class AfCalendarComponent {\n  /** Events to display */\n  readonly events = input<AfCalendarEvent[]>([]);\n\n  /** Emitted when a date cell is clicked */\n  readonly dateSelected = output<string>();\n\n  protected readonly weekdays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];\n\n  protected readonly currentMonth = signal(new Date().getMonth());\n  protected readonly currentYear = signal(new Date().getFullYear());\n\n  protected readonly monthYearLabel = computed(() => {\n    const months = [\n      'Janeiro',\n      'Fevereiro',\n      'Março',\n      'Abril',\n      'Maio',\n      'Junho',\n      'Julho',\n      'Agosto',\n      'Setembro',\n      'Outubro',\n      'Novembro',\n      'Dezembro',\n    ];\n    return `${months[this.currentMonth()]} ${this.currentYear()}`;\n  });\n\n  protected readonly calendarDays = computed(() => {\n    const year = this.currentYear();\n    const month = this.currentMonth();\n    const today = new Date();\n    const firstDay = new Date(year, month, 1).getDay();\n    const daysInMonth = new Date(year, month + 1, 0).getDate();\n    const daysInPrevMonth = new Date(year, month, 0).getDate();\n    const events = this.events();\n\n    const cells: {\n      day: number;\n      currentMonth: boolean;\n      isToday: boolean;\n      dateStr: string;\n      events: AfCalendarEvent[];\n    }[] = [];\n\n    // Previous month fill\n    for (let i = firstDay - 1; i >= 0; i--) {\n      const d = daysInPrevMonth - i;\n      const dt = new Date(year, month - 1, d);\n      const ds = this.formatDate(dt);\n      cells.push({\n        day: d,\n        currentMonth: false,\n        isToday: false,\n        dateStr: ds,\n        events: events.filter((e) => e.date === ds),\n      });\n    }\n\n    // Current month\n    for (let d = 1; d <= daysInMonth; d++) {\n      const dt = new Date(year, month, d);\n      const ds = this.formatDate(dt);\n      const isTd =\n        dt.getDate() === today.getDate() &&\n        dt.getMonth() === today.getMonth() &&\n        dt.getFullYear() === today.getFullYear();\n      cells.push({\n        day: d,\n        currentMonth: true,\n        isToday: isTd,\n        dateStr: ds,\n        events: events.filter((e) => e.date === ds),\n      });\n    }\n\n    // Next month fill\n    const remaining = 42 - cells.length;\n    for (let d = 1; d <= remaining; d++) {\n      const dt = new Date(year, month + 1, d);\n      const ds = this.formatDate(dt);\n      cells.push({\n        day: d,\n        currentMonth: false,\n        isToday: false,\n        dateStr: ds,\n        events: events.filter((e) => e.date === ds),\n      });\n    }\n\n    return cells;\n  });\n\n  protected prevMonth(): void {\n    if (this.currentMonth() === 0) {\n      this.currentMonth.set(11);\n      this.currentYear.update((y) => y - 1);\n    } else {\n      this.currentMonth.update((m) => m - 1);\n    }\n  }\n\n  protected nextMonth(): void {\n    if (this.currentMonth() === 11) {\n      this.currentMonth.set(0);\n      this.currentYear.update((y) => y + 1);\n    } else {\n      this.currentMonth.update((m) => m + 1);\n    }\n  }\n\n  private formatDate(d: Date): string {\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/callout/callout.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/card/card.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/chat-bubble/chat-bubble.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/chat-composer/chat-composer.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":134,"column":39,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":134,"endColumn":43}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef, AfterViewInit } from '@angular/core';\nimport {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  output,\n  signal,\n  viewChild,\n  HostListener,\n} from '@angular/core';\nimport { AfButtonComponent } from '../button/button';\nimport { AfIconButtonComponent } from '../icon-button/icon-button';\nimport { LucideAngularModule } from 'lucide-angular';\n\ntype AttachmentType = 'document' | 'image' | 'video' | 'audio';\n\ninterface AttachmentOption {\n  type: AttachmentType;\n  label: string;\n  icon: string;\n}\n\n/**\n * AfChatComposerComponent — Message composition area with auto-resizing textarea,\n * attachment button, and send action. Supports Enter to send and Shift+Enter for newline.\n *\n * @example\n * ```html\n * <af-chat-composer\n *   placeholder=\"Digite sua mensagem...\"\n *   (messageSent)=\"onSend($event)\"\n *   (attachmentClicked)=\"openFileDialog()\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-chat-composer',\n  standalone: true,\n  imports: [AfButtonComponent, AfIconButtonComponent, LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div\n      class=\"border-t border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-4 py-3\"\n    >\n      <div #composerRoot class=\"relative\">\n        <div\n          class=\"flex items-center gap-2 rounded-xl border border-neutral-300 dark:border-neutral-600\n            bg-neutral-50 dark:bg-neutral-800 px-2 py-2 transition-colors\n            focus-within:ring-2 focus-within:ring-accent-500/30 focus-within:border-accent-500\"\n        >\n          <div class=\"relative\">\n            <af-icon-button\n              label=\"Anexar arquivo\"\n              variant=\"ghost\"\n              size=\"sm\"\n              [disabled]=\"disabled()\"\n              (click)=\"toggleAttachmentMenu()\"\n            >\n              <lucide-icon name=\"paperclip\" [size]=\"18\" />\n            </af-icon-button>\n\n            @if (attachmentMenuOpen()) {\n              <div\n                class=\"absolute left-0 bottom-10 z-20 w-52 rounded-lg border border-neutral-200 dark:border-neutral-700\n                  bg-white dark:bg-neutral-900 shadow-lg p-1\"\n              >\n                @for (option of attachmentOptions; track option.type) {\n                  <button\n                    type=\"button\"\n                    class=\"w-full flex items-center gap-2 px-3 py-2 rounded-md text-left text-sm\n                      text-neutral-700 dark:text-neutral-200\n                      hover:bg-neutral-100 dark:hover:bg-neutral-800\"\n                    (click)=\"selectAttachment(option.type)\"\n                  >\n                    <lucide-icon [name]=\"option.icon\" [size]=\"16\" class=\"text-accent-500\" />\n                    <span>{{ option.label }}</span>\n                  </button>\n                }\n              </div>\n            }\n          </div>\n\n          <div class=\"flex-1 relative\">\n            <textarea\n              #textarea\n              [placeholder]=\"placeholder()\"\n              [disabled]=\"disabled()\"\n              [maxLength]=\"maxLength() ?? undefined\"\n              rows=\"1\"\n              class=\"w-full resize-none border-0 bg-transparent text-sm text-neutral-900 dark:text-neutral-50\n              placeholder:text-neutral-400 dark:placeholder:text-neutral-500\n              px-2 py-1.5 leading-5 min-h-8\n              focus:outline-none focus:ring-0 focus:border-0\n              disabled:opacity-50 disabled:cursor-not-allowed\n              max-h-32 overflow-y-auto\"\n              (input)=\"onInput()\"\n              (keydown)=\"onKeydown($event)\"\n            ></textarea>\n          </div>\n\n          <af-button\n            variant=\"primary\"\n            size=\"sm\"\n            [disabled]=\"disabled() || !canSend()\"\n            (click)=\"send()\"\n          >\n            <lucide-icon name=\"send\" [size]=\"16\" class=\"block\" />\n          </af-button>\n        </div>\n      </div>\n\n      @if (maxLength()) {\n        <p class=\"text-[10px] text-neutral-400 dark:text-neutral-500 text-right mt-1 tabular-nums\">\n          {{ messageLength() }}/{{ maxLength() }}\n        </p>\n      }\n    </div>\n  `,\n})\nexport class AfChatComposerComponent implements AfterViewInit {\n  /** Placeholder text */\n  readonly placeholder = input('Digite sua mensagem...');\n\n  /** Whether the composer is disabled */\n  readonly disabled = input(false);\n\n  /** Maximum message length */\n  readonly maxLength = input<number | null>(null);\n\n  /** Emitted with the message text when sent */\n  readonly messageSent = output<string>();\n\n  /** Emitted when the attachment button is clicked */\n  readonly attachmentClicked = output<void>();\n\n  /** Emitted with attachment type selected from dropdown */\n  readonly attachmentTypeSelected = output<AttachmentType>();\n\n  /** Current message length */\n  protected readonly messageLength = signal(0);\n\n  /** Whether there is content to send */\n  protected readonly canSend = signal(false);\n\n  /** Attachment dropdown visibility */\n  protected readonly attachmentMenuOpen = signal(false);\n\n  protected readonly attachmentOptions: AttachmentOption[] = [\n    { type: 'document', label: 'Documento', icon: 'file-text' },\n    { type: 'image', label: 'Foto', icon: 'image' },\n    { type: 'video', label: 'Vídeo', icon: 'video' },\n    { type: 'audio', label: 'Áudio', icon: 'music' },\n  ];\n\n  private readonly textareaRef = viewChild<ElementRef<HTMLTextAreaElement>>('textarea');\n  private readonly composerRootRef = viewChild<ElementRef<HTMLElement>>('composerRoot');\n\n  ngAfterViewInit(): void {\n    this.autoResize();\n  }\n\n  /** Handle input for auto-resize and state updates */\n  protected onInput(): void {\n    const el = this.textareaRef()?.nativeElement;\n    if (el) {\n      const value = el.value.trim();\n      this.messageLength.set(el.value.length);\n      this.canSend.set(value.length > 0);\n      this.autoResize();\n    }\n  }\n\n  protected toggleAttachmentMenu(): void {\n    if (this.disabled()) {\n      return;\n    }\n\n    this.attachmentClicked.emit();\n    this.attachmentMenuOpen.update((open) => !open);\n  }\n\n  protected selectAttachment(type: AttachmentType): void {\n    this.attachmentTypeSelected.emit(type);\n    this.attachmentMenuOpen.set(false);\n  }\n\n  /** Handle keyboard shortcuts */\n  protected onKeydown(event: KeyboardEvent): void {\n    if (event.key === 'Enter' && !event.shiftKey) {\n      event.preventDefault();\n      this.send();\n    }\n  }\n\n  /** Emit the message and clear the input */\n  protected send(): void {\n    const el = this.textareaRef()?.nativeElement;\n    if (!el) return;\n\n    const value = el.value.trim();\n    if (value.length === 0) return;\n\n    this.messageSent.emit(value);\n    el.value = '';\n    this.messageLength.set(0);\n    this.canSend.set(false);\n    this.autoResize();\n  }\n\n  @HostListener('document:click', ['$event'])\n  protected onDocumentClick(event: MouseEvent): void {\n    if (!this.attachmentMenuOpen()) {\n      return;\n    }\n\n    const root = this.composerRootRef()?.nativeElement;\n    const target = event.target;\n    if (!(target instanceof Node) || !root) {\n      return;\n    }\n\n    if (!root.contains(target)) {\n      this.attachmentMenuOpen.set(false);\n    }\n  }\n\n  /** Auto-resize textarea based on content */\n  private autoResize(): void {\n    const el = this.textareaRef()?.nativeElement;\n    if (el) {\n      el.style.height = 'auto';\n      el.style.height = `${Math.min(el.scrollHeight, 128)}px`;\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/chat-list-item/chat-list-item.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":83,"column":30,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":83,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, computed } from '@angular/core';\nimport { AfAvatarComponent } from '../avatar/avatar';\nimport { AfBadgeComponent } from '../badge/badge';\n\n/**\n * AfChatListItemComponent — A single conversation item in the chat inbox list.\n * Displays avatar, name, last message preview, timestamp, and unread count.\n *\n * @example\n * ```html\n * <af-chat-list-item\n *   name=\"Maria Silva\"\n *   lastMessage=\"Obrigada pela ajuda!\"\n *   timestamp=\"14:32\"\n *   [unreadCount]=\"3\"\n *   [online]=\"true\"\n *   (selected)=\"openChat(contact.id)\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-chat-list-item',\n  standalone: true,\n  imports: [AfAvatarComponent, AfBadgeComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <button type=\"button\" [class]=\"itemClasses()\" (click)=\"selected.emit()\">\n      <!-- Avatar with online indicator -->\n      <div class=\"relative shrink-0\">\n        <af-avatar size=\"md\" [initials]=\"initials()\" [src]=\"avatarUrl()\" />\n        @if (online()) {\n          <span\n            class=\"absolute -bottom-0.5 -right-0.5 size-3 rounded-full bg-accent-500 border-2 border-white dark:border-neutral-900\"\n          ></span>\n        }\n      </div>\n\n      <!-- Content -->\n      <div class=\"flex-1 min-w-0\">\n        <div class=\"flex items-center justify-between gap-2\">\n          <span class=\"text-sm font-semibold text-neutral-900 dark:text-neutral-50 truncate\">\n            {{ name() }}\n          </span>\n          <span class=\"text-[10px] text-neutral-400 dark:text-neutral-500 shrink-0 tabular-nums\">\n            {{ timestamp() }}\n          </span>\n        </div>\n        <div class=\"flex items-center justify-between gap-2 mt-0.5\">\n          <p class=\"text-xs text-neutral-500 dark:text-neutral-400 truncate\">\n            {{ lastMessage() }}\n          </p>\n          @if (unreadCount() > 0) {\n            <af-badge variant=\"info\" size=\"sm\">{{ unreadCount() }}</af-badge>\n          }\n        </div>\n      </div>\n    </button>\n  `,\n})\nexport class AfChatListItemComponent {\n  /** Contact/conversation name */\n  readonly name = input.required<string>();\n\n  /** Avatar image URL */\n  readonly avatarUrl = input<string>();\n\n  /** Preview of the last message */\n  readonly lastMessage = input('');\n\n  /** Timestamp string */\n  readonly timestamp = input('');\n\n  /** Number of unread messages */\n  readonly unreadCount = input(0);\n\n  /** Whether the contact is online */\n  readonly online = input(false);\n\n  /** Whether this item is the active/selected conversation */\n  readonly active = input(false);\n\n  /** Emitted when the item is clicked */\n  readonly selected = output<void>();\n\n  /** Generate initials from name */\n  protected readonly initials = computed(() => {\n    const parts = this.name().trim().split(' ');\n    if (parts.length >= 2) {\n      return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();\n    }\n    return this.name().slice(0, 2).toUpperCase();\n  });\n\n  /** Dynamic classes based on active state */\n  protected readonly itemClasses = computed(() => {\n    const base =\n      'w-full flex items-center gap-3 px-4 py-3 text-left transition-colors cursor-pointer border-b border-neutral-100 dark:border-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent-500/50';\n    const activeClass = this.active()\n      ? 'bg-accent-50 dark:bg-accent-950/30'\n      : 'hover:bg-neutral-50 dark:hover:bg-neutral-800/50';\n    return `${base} ${activeClass}`;\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/checkbox-input/checkbox-input.ts","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":1,"message":"Missing return type on function.","line":106,"column":3,"nodeType":"ArrowFunctionExpression","messageId":"missingReturnType","endLine":106,"endColumn":35},{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":72,"column":9,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":78,"endColumn":17},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":72,"column":9,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":78,"endColumn":17}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Component,\n  ChangeDetectionStrategy,\n  DestroyRef,\n  effect,\n  inject,\n  input,\n  signal,\n} from '@angular/core';\nimport { type FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { startWith } from 'rxjs';\n\n/**\n * Checkbox input component for AgentFlix UI Kit.\n *\n * @description Styled checkbox with inline label and FormControl integration.\n * Uses a custom visual checkbox (hidden native input + styled div overlay) to\n * ensure the checked state is always visible, including when set programmatically\n * (e.g. selectAll / bulk operations).\n *\n * @example\n * ```html\n * <af-checkbox-input\n *   [control]=\"form.controls.acceptTerms\"\n *   label=\"Li e aceito os termos\"\n *   dataTest=\"login-accept-terms\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-checkbox-input',\n  standalone: true,\n  imports: [ReactiveFormsModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"flex items-start gap-2.5\">\n      <!-- Hidden native input keeps reactive-forms integration intact -->\n      <input\n        [id]=\"checkboxId\"\n        type=\"checkbox\"\n        class=\"sr-only\"\n        [formControl]=\"control()\"\n        [attr.data-test]=\"dataTest()\"\n        [attr.aria-label]=\"ariaLabel() || label() || null\"\n        (change)=\"onNativeChange($event)\"\n      />\n      <!-- Custom visual checkbox — reacts to the signal, no OnPush issues -->\n      <button\n        type=\"button\"\n        role=\"checkbox\"\n        [attr.aria-checked]=\"isChecked()\"\n        [attr.aria-label]=\"ariaLabel() || label() || 'checkbox'\"\n        [class]=\"boxClasses()\"\n        (click)=\"toggle()\"\n      >\n        @if (isChecked()) {\n          <svg\n            viewBox=\"0 0 12 12\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            class=\"size-3 stroke-white\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <polyline points=\"1.5,6 4.5,9 10.5,3\" />\n          </svg>\n        }\n      </button>\n      @if (label()) {\n        <label\n          [for]=\"checkboxId\"\n          class=\"text-sm text-neutral-700 dark:text-neutral-300 cursor-pointer select-none leading-5\"\n          (click)=\"toggle()\"\n        >\n          {{ label() }}\n        </label>\n      }\n    </div>\n  `,\n})\nexport class AfCheckboxInputComponent {\n  private readonly destroyRef = inject(DestroyRef);\n  private syncedControl: FormControl<boolean> | null = null;\n\n  /** FormControl for the checkbox */\n  readonly control = input.required<FormControl<boolean>>();\n\n  /** Inline label text */\n  readonly label = input<string>('');\n\n  /** data-test attribute for E2E tests */\n  readonly dataTest = input<string>();\n\n  /** aria-label for accessibility when no visible label is present */\n  readonly ariaLabel = input<string>();\n\n  /** Unique ID for label-input association */\n  protected readonly checkboxId = `checkbox-${Math.random().toString(36).slice(2, 9)}`;\n\n  /** Reactive checked state — updated via valueChanges subscription */\n  protected readonly isChecked = signal(false);\n\n  /** Dynamic box classes based on checked state */\n  protected readonly boxClasses = () => {\n    const base = [\n      'mt-0.5 size-4 shrink-0 rounded border cursor-pointer',\n      'flex items-center justify-center',\n      'transition-colors duration-150',\n      'focus:outline-none focus:ring-2 focus:ring-accent-500/30 focus:ring-offset-0',\n    ];\n    const state = this.isChecked()\n      ? 'bg-accent-500 border-accent-500'\n      : 'bg-white dark:bg-neutral-900 border-neutral-300 dark:border-neutral-600';\n    return [...base, state].join(' ');\n  };\n\n  constructor() {\n    // Subscribe to control value changes (including programmatic setValue) to keep\n    // the isChecked signal in sync — fixes bulk-select / selectAll with OnPush.\n    effect(() => {\n      const ctrl = this.control();\n      if (ctrl === this.syncedControl) return;\n      this.syncedControl = ctrl;\n\n      ctrl.valueChanges\n        .pipe(startWith(ctrl.value), takeUntilDestroyed(this.destroyRef))\n        .subscribe((val) => this.isChecked.set(!!val));\n    });\n  }\n\n  /** Toggle the control value when the custom box or label is clicked */\n  protected toggle(): void {\n    if (this.control().disabled) return;\n    this.control().setValue(!this.control().value);\n    this.control().markAsTouched();\n  }\n\n  /** Keep native checkbox in sync when the user interacts with it directly */\n  protected onNativeChange(event: Event): void {\n    const checked = (event.target as HTMLInputElement).checked;\n    this.isChecked.set(checked);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/clipboard/clipboard.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/code-block/code-block.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/collapsible/collapsible.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'output' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":53,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":59}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, signal } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * AfCollapsibleComponent — Generic expandable/collapsible container.\n *\n * @example\n * ```html\n * <af-collapsible title=\"Opções avançadas\">\n *   <p>Hidden content...</p>\n * </af-collapsible>\n * ```\n */\n@Component({\n  selector: 'af-collapsible',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div>\n      <button\n        type=\"button\"\n        class=\"flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-300\n          hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors cursor-pointer\"\n        (click)=\"toggle()\"\n      >\n        <lucide-icon\n          name=\"chevron-right\"\n          [size]=\"14\"\n          class=\"transition-transform\"\n          [class.rotate-90]=\"isOpen()\"\n        />\n        {{ title() }}\n      </button>\n      @if (isOpen()) {\n        <div class=\"mt-2 pl-5\">\n          <ng-content />\n        </div>\n      }\n    </div>\n  `,\n})\nexport class AfCollapsibleComponent {\n  /** Collapsible trigger label */\n  readonly title = input('');\n\n  /** Start expanded */\n  readonly open = input(false);\n\n  protected readonly isOpen = signal(false);\n\n  constructor() {\n    queueMicrotask(() => this.isOpen.set(this.open()));\n  }\n\n  protected toggle(): void {\n    this.isOpen.update((v) => !v);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/color-input/color-input.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected object value in conditional. The condition is always true.","line":116,"column":9,"nodeType":"Identifier","messageId":"conditionErrorObject","endLine":116,"endColumn":13}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  type OnInit,\n  type ElementRef,\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  computed,\n  signal,\n  viewChild,\n  DestroyRef,\n  inject,\n} from '@angular/core';\nimport { type FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { AfFormLabelComponent } from '../form-label/form-label';\nimport { AfFormErrorComponent } from '../form-error/form-error';\n\n/**\n * Color picker input for AgentFlix UI Kit.\n *\n * @description Swatch circle + hex text input. The swatch opens the native\n * browser color picker. Both directions stay in sync via FormControl.\n *\n * @example\n * ```html\n * <af-color-input\n *   [control]=\"brandColorControl\"\n *   label=\"Cor da marca\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-color-input',\n  standalone: true,\n  imports: [ReactiveFormsModule, AfFormLabelComponent, AfFormErrorComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div [class]=\"classContainer()\">\n      @if (label()) {\n        <af-form-label [label]=\"label()\" [for]=\"inputId\" [required]=\"required()\" />\n      }\n\n      <div class=\"flex items-center gap-2\">\n        <!-- Color swatch (clickable) -->\n        <button\n          type=\"button\"\n          class=\"size-10 rounded-md border-2 border-neutral-300 dark:border-neutral-600 cursor-pointer transition-shadow hover:ring-2 hover:ring-accent-500/30 shrink-0\"\n          [style.background-color]=\"currentColor()\"\n          (click)=\"openPicker()\"\n          [attr.aria-label]=\"'Selecionar cor'\"\n        ></button>\n\n        <!-- Hidden native color input -->\n        <input\n          #colorPicker\n          type=\"color\"\n          class=\"sr-only\"\n          [value]=\"currentColor()\"\n          (input)=\"onNativeColorChange($event)\"\n        />\n\n        <!-- Hex text input -->\n        <input\n          [id]=\"inputId\"\n          type=\"text\"\n          class=\"flex-1 h-10 px-3 text-sm rounded-md border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-50 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 focus:border-accent-500 transition-colors font-mono uppercase\"\n          [formControl]=\"control()\"\n          [placeholder]=\"placeholder()\"\n          [attr.data-test]=\"dataTest()\"\n          maxlength=\"7\"\n          (input)=\"onTextInput()\"\n        />\n      </div>\n\n      <af-form-error [show]=\"showError()\" [message]=\"errorMessage()\" />\n    </div>\n  `,\n})\nexport class AfColorInputComponent implements OnInit {\n  /** FormControl for the hex color value */\n  readonly control = input.required<FormControl<string>>();\n\n  /** Label text */\n  readonly label = input<string>();\n\n  /** Container CSS class */\n  readonly classContainer = input<string>('mb-4');\n\n  /** Placeholder */\n  readonly placeholder = input('#000000');\n\n  /** Required asterisk */\n  readonly required = input(false);\n\n  /** Error message */\n  readonly errorMessage = input('Cor inválida.');\n\n  /** data-test attribute */\n  readonly dataTest = input<string>();\n\n  /** Current color for the swatch */\n  protected readonly currentColor = signal('#000000');\n\n  /** Unique ID */\n  protected readonly inputId = `color-${Math.random().toString(36).slice(2, 9)}`;\n\n  private readonly colorPickerRef = viewChild.required<ElementRef<HTMLInputElement>>('colorPicker');\n\n  private readonly destroyRef = inject(DestroyRef);\n\n  /** Whether to show error */\n  protected readonly showError = computed(() => this.control()?.invalid && this.control()?.touched);\n\n  ngOnInit(): void {\n    const ctrl = this.control();\n    if (ctrl) {\n      // Set initial color\n      const initial = ctrl.value || '#000000';\n      this.currentColor.set(initial);\n\n      // Watch for value changes\n      ctrl.valueChanges.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((value) => {\n        if (value && /^#[0-9a-fA-F]{6}$/.test(value)) {\n          this.currentColor.set(value);\n        }\n      });\n    }\n  }\n\n  /** Open native color picker */\n  protected openPicker(): void {\n    this.colorPickerRef().nativeElement.click();\n  }\n\n  /** Handle native color picker change */\n  protected onNativeColorChange(event: Event): void {\n    const value = (event.target as HTMLInputElement).value;\n    this.currentColor.set(value);\n    this.control().setValue(value);\n    this.control().markAsTouched();\n  }\n\n  /** Handle text input change */\n  protected onTextInput(): void {\n    const value = this.control().value;\n    if (value && /^#[0-9a-fA-F]{6}$/.test(value)) {\n      this.currentColor.set(value);\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/color-palette/color-palette.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'signal' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":61,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":67},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'computed' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":69,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":77}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, signal, computed } from '@angular/core';\n\n/** Color option */\nexport interface AfColorOption {\n  label: string;\n  value: string;\n}\n\n/**\n * AfColorPaletteComponent — Selectable color palette.\n *\n * @example\n * ```html\n * <af-color-palette [colors]=\"brandColors\" [selected]=\"selectedColor()\" (colorSelected)=\"onColor($event)\" />\n * ```\n */\n@Component({\n  selector: 'af-color-palette',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"flex flex-wrap gap-2\">\n      @for (color of colors(); track color.value) {\n        <button\n          type=\"button\"\n          class=\"w-8 h-8 rounded-full border-2 transition-all cursor-pointer\n            hover:scale-110\"\n          [style.background-color]=\"color.value\"\n          [class.border-accent-600]=\"selected() === color.value\"\n          [class.border-transparent]=\"selected() !== color.value\"\n          [class.ring-2]=\"selected() === color.value\"\n          [class.ring-accent-600]=\"selected() === color.value\"\n          [class.ring-offset-2]=\"selected() === color.value\"\n          [title]=\"color.label\"\n          (click)=\"colorSelected.emit(color.value)\"\n        ></button>\n      }\n    </div>\n  `,\n})\nexport class AfColorPaletteComponent {\n  /** Available color options */\n  readonly colors = input<AfColorOption[]>([]);\n\n  /** Currently selected color value */\n  readonly selected = input('');\n\n  /** Emitted when a color is selected */\n  readonly colorSelected = output<string>();\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/command-palette/command-palette.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","se