ATION_WON' },\n    { label: 'Negociação Perdida', value: 'NEGOTIATION_LOST' },\n    { label: 'Contato Criado', value: 'CONTACT_CREATED' },\n    { label: 'Atendimento Humano Encerrado', value: 'HUMAN_TAKEOVER_ENDED' },\n    { label: 'Agendado', value: 'SCHEDULED' },\n    { label: 'Tag Adicionada', value: 'TAG_ADDED' },\n    { label: 'Lead Score Atingido', value: 'LEAD_SCORE_THRESHOLD' },\n    { label: 'Sem Resposta', value: 'NO_RESPONSE_TIMEOUT' },\n  ];\n\n  readonly metaForm = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    trigger_type: this.fb.control('INBOUND_MESSAGE', Validators.required),\n    is_active: this.fb.control(false, Validators.required),\n  });\n\n  readonly stepsControl = this.fb.control('{\\n  \"steps\": []\\n}', Validators.required);\n\n  constructor() {\n    const id = this.route.snapshot.paramMap.get('id');\n    if (id) {\n      this.loadPlaybook(id);\n    }\n\n    this.stepsControl.valueChanges.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((value) => {\n      try {\n        JSON.parse(value ?? '{}');\n        this.jsonError.set(null);\n      } catch {\n        this.jsonError.set('JSON inválido');\n      }\n    });\n  }\n\n  loadPlaybook(id: string): void {\n    this.autopilotService\n      .getPlaybook(id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (playbook) => {\n          this.playbook.set(playbook);\n          this.metaForm.patchValue({\n            name: playbook.name,\n            trigger_type: playbook.trigger_type ?? 'INBOUND_MESSAGE',\n            is_active: playbook.is_active,\n          });\n\n          if (playbook.steps) {\n            this.stepsControl.setValue(JSON.stringify(playbook.steps, null, 2));\n          }\n        },\n        error: () => toast.error('Erro ao carregar playbook'),\n      });\n  }\n\n  save(): void {\n    const current = this.playbook();\n    if (!current || this.metaForm.invalid || this.jsonError() || this.isSaving()) {\n      this.metaForm.markAllAsTouched();\n      this.stepsControl.markAsTouched();\n      return;\n    }\n\n    let stepsPayload: Record<string, unknown>;\n    try {\n      stepsPayload = JSON.parse(this.stepsControl.value ?? '{}') as Record<string, unknown>;\n    } catch {\n      this.jsonError.set('JSON inválido');\n      return;\n    }\n\n    this.isSaving.set(true);\n\n    this.autopilotService\n      .updatePlaybook(current.id, {\n        ...(this.metaForm.getRawValue() as Partial<AutopilotPlaybook>),\n        steps: stepsPayload,\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (updated) => {\n          this.playbook.set(updated);\n          this.isSaving.set(false);\n          toast.success('Playbook salvo com sucesso!');\n        },\n        error: () => {\n          this.isSaving.set(false);\n          toast.error('Erro ao salvar playbook.');\n        },\n      });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/playbooks.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/playbooks.spec.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (115). Maximum allowed is 80.","line":16,"column":23,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":130,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { type ComponentFixture, TestBed } from '@angular/core/testing';\nimport { Router, provideRouter } from '@angular/router';\nimport { of } from 'rxjs';\nimport { Playbooks } from './playbooks';\nimport { type AutopilotPlaybook, AutopilotService } from 'src/app/core/services/autopilot.service';\n\nclass AutopilotServiceStub {\n  listPlaybooks = vi.fn();\n  getPlaybook = vi.fn();\n  createPlaybook = vi.fn();\n  updatePlaybook = vi.fn();\n  deletePlaybook = vi.fn();\n}\n\ndescribe('Playbooks', () => {\n  let component: Playbooks;\n  let fixture: ComponentFixture<Playbooks>;\n  let autopilot: AutopilotServiceStub;\n  let router: Router;\n\n  const playbooks: AutopilotPlaybook[] = [\n    {\n      id: 'p-1',\n      name: 'Boas vindas',\n      description: 'Início',\n      trigger_type: 'welcome',\n      current_version: 1,\n      version: 1,\n      is_active: true,\n    },\n    {\n      id: 'p-2',\n      name: 'Follow up',\n      description: 'Recuperar',\n      trigger_type: 'follow',\n      current_version: 2,\n      version: 2,\n      is_active: false,\n    },\n  ];\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [Playbooks],\n      providers: [provideRouter([]), { provide: AutopilotService, useClass: AutopilotServiceStub }],\n    }).compileComponents();\n\n    autopilot = TestBed.inject(AutopilotService) as unknown as AutopilotServiceStub;\n    router = TestBed.inject(Router);\n    vi.spyOn(router, 'navigate').mockImplementation(() => Promise.resolve(true));\n    autopilot.listPlaybooks.mockReturnValue(\n      of({ data: playbooks, meta: { current_page: 1, per_page: 10, total: 2, last_page: 1 } }),\n    );\n    autopilot.getPlaybook.mockReturnValue(of(playbooks[0]));\n    autopilot.createPlaybook.mockReturnValue(of(playbooks[0]));\n    autopilot.updatePlaybook.mockReturnValue(of(playbooks[1]));\n    autopilot.deletePlaybook.mockReturnValue(of(void 0));\n\n    fixture = TestBed.createComponent(Playbooks);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should configure actions', () => {\n    expect(component.actions.some((action) => action.type === 'edit')).toBe(true);\n    expect(component.actions.some((action) => action.type === 'delete')).toBe(true);\n    expect(component.actions.some((action) => action.type === 'editor')).toBe(true);\n  });\n\n  it('should configure columns', () => {\n    const columns = component.columns();\n    expect(columns.some((column) => column.field === 'name')).toBe(true);\n  });\n\n  it('should list playbooks with search and status filter', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotPlaybook[] }>((resolve) => {\n      component.crudService\n        .list({ page: 1, per_page: 10, search: 'follow', is_active: false })\n        .subscribe((res) => resolve(res));\n    });\n    expect(result.data.length).toBe(1);\n    expect(result.data[0].id).toBe('p-2');\n  });\n\n  it('should create playbook', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotPlaybook }>((resolve) => {\n      component.crudService.create({ name: 'Novo' } as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('p-1');\n  });\n\n  it('should update playbook', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotPlaybook }>((resolve) => {\n      component.crudService.update('playbook-1', {} as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('p-2');\n  });\n\n  it('should delete playbook', async (): Promise<void> => {\n    await new Promise<void>((resolve) => {\n      component.crudService.delete('playbook-1').subscribe(() => resolve());\n    });\n    expect(autopilot.deletePlaybook).toHaveBeenCalledWith('playbook-1');\n  });\n\n  it('should delegate form actions to CrudPage', (): void => {\n    const crudPage = {\n      handleFormSaved: vi.fn(),\n      closeModal: vi.fn(),\n    };\n    (component as unknown as { crudPage: () => typeof crudPage }).crudPage = (): typeof crudPage =>\n      crudPage;\n\n    component.handleFormSaved(playbooks[0]);\n    component.handleFormCancelled();\n\n    expect(crudPage.handleFormSaved).toHaveBeenCalledWith(playbooks[0]);\n    expect(crudPage.closeModal).toHaveBeenCalled();\n  });\n\n  it('should navigate to visual editor', (): void => {\n    component.handleCustomAction({ action: 'editor', item: playbooks[0] });\n    expect(router.navigate).toHaveBeenCalledWith(['settings', 'autopilot', 'playbooks', 'p-1']);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/playbooks.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/autopilot.service' import is duplicated.","line":13,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":13,"endColumn":69},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":195,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":195,"endColumn":21,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[6166,6178],"text":"triggerType == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[6167,6178],"text":"(triggerType ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[6166,6178],"text":"!Boolean(triggerType)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":228,"column":7,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":228,"endColumn":83,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[6915,6915],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[6915,6915],"text":"await "},"desc":"Add await operator."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TemplateRef } from '@angular/core';\nimport {\n  CUSTOM_ELEMENTS_SCHEMA,\n  ChangeDetectionStrategy,\n  Component,\n  computed,\n  inject,\n  viewChild,\n} from '@angular/core';\nimport { Router } from '@angular/router';\nimport { type Observable, map } from 'rxjs';\nimport type { AutopilotPlaybook, AutopilotPlaybookPayload } from '@core/services/autopilot.service';\nimport { AutopilotService } from '@core/services/autopilot.service';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n  CrudPageLikeRef,\n} from '../autopilot-crud.types';\nimport type { AfSelectOption } from '@shared/components';\nimport { PlaybookFormComponent } from './components';\n\n/**\n * Componente para gestão de Playbooks do IA Autopilot.\n *\n * Permite listar, criar, editar e excluir roteiros (playbooks) que definem\n * o comportamento da IA durante o atendimento automático.\n *\n * @class Playbooks\n * @extends {BaseListPage<AutopilotPlaybook>}\n * @description Central de gerenciamento de roteiros inteligentes da IA.\n */\n@Component({\n  selector: 'app-playbooks',\n  standalone: true,\n  imports: [PlaybookFormComponent],\n  templateUrl: './playbooks.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n})\nexport class Playbooks {\n  private readonly autopilotService = inject(AutopilotService);\n  private readonly router = inject(Router);\n  private readonly triggerLabelMap: Record<string, string> = {\n    MANUAL: 'Manual (API)',\n    INBOUND_MESSAGE: 'Mensagem Recebida',\n    TICKET_CREATED: 'Ticket Criado',\n    TICKET_IDLE: 'Ticket Ocioso',\n    NEGOTIATION_STAGE_CHANGED: 'Etapa Alterada',\n    NEGOTIATION_WON: 'Negociação Ganha',\n    NEGOTIATION_LOST: 'Negociação Perdida',\n    CONTACT_CREATED: 'Contato Criado',\n    HUMAN_TAKEOVER_ENDED: 'Atendimento Humano Encerrado',\n    SCHEDULED: 'Agendado',\n    TAG_ADDED: 'Tag Adicionada',\n    LEAD_SCORE_THRESHOLD: 'Lead Score Atingido',\n    NO_RESPONSE_TIMEOUT: 'Sem Resposta',\n  };\n\n  readonly crudPage = viewChild<CrudPageLikeRef<AutopilotPlaybook>>('crudPage');\n  readonly playbookForm = viewChild<PlaybookFormComponent>('playbookForm');\n  readonly nameCell = viewChild<TemplateRef<{ $implicit: AutopilotPlaybook }>>('nameCell');\n  readonly triggerCell = viewChild<TemplateRef<{ $implicit: AutopilotPlaybook }>>('triggerCell');\n  readonly versionCell = viewChild<TemplateRef<{ $implicit: AutopilotPlaybook }>>('versionCell');\n\n  readonly crudService: CrudService<AutopilotPlaybook> = {\n    list: (params) =>\n      this.autopilotService.listPlaybooks({ page: 1, per_page: 1000 }).pipe(\n        map((response) => {\n          const search = params.search?.toLowerCase() ?? '';\n          const isActive = params.is_active;\n          const perPage = params.per_page ?? 10;\n          const page = params.page ?? 1;\n\n          let data = [...response.data];\n\n          if (search) {\n            data = data.filter((item) =>\n              `${item.name} ${item.description ?? ''}`.toLowerCase().includes(search),\n            );\n          }\n\n          if (isActive !== undefined) {\n            data = data.filter((item) => item.is_active === isActive);\n          }\n\n          const total = data.length;\n          const lastPage = Math.max(1, Math.ceil(total / perPage));\n          const start = (page - 1) * perPage;\n          const paged = data.slice(start, start + perPage);\n\n          return {\n            data: paged,\n            meta: {\n              total,\n              per_page: perPage,\n              current_page: page,\n              last_page: lastPage,\n            },\n          };\n        }),\n      ) as Observable<CrudPaginatedResponse<AutopilotPlaybook>>,\n    find: (id: string) =>\n      this.autopilotService\n        .getPlaybook(id)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotPlaybook>\n      >,\n    create: (data: Partial<AutopilotPlaybook>) =>\n      this.autopilotService\n        .createPlaybook(data as AutopilotPlaybookPayload)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotPlaybook>\n      >,\n    update: (id: string, data: Partial<AutopilotPlaybook>) =>\n      this.autopilotService\n        .updatePlaybook(id, data)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotPlaybook>\n      >,\n    delete: (id: string) => this.autopilotService.deletePlaybook(id),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    {\n      field: 'name',\n      label: 'Nome',\n      template: this.nameCell() ?? undefined,\n    },\n    {\n      field: 'trigger_type',\n      label: 'Gatilho',\n      template: this.triggerCell() ?? undefined,\n    },\n    {\n      field: 'current_version',\n      label: 'Versão',\n      template: this.versionCell() ?? undefined,\n    },\n    { field: 'is_active', label: 'Status', type: 'status' },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'editor',\n      icon: 'lucideGitBranchPlus',\n      label: 'Editor Visual',\n      variant: 'ghost',\n    },\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Playbook',\n      plural: 'Playbooks',\n      createButton: 'Novo Playbook',\n      modalCreate: 'Novo Playbook',\n      modalEdit: 'Editar Playbook',\n    },\n    subtitle: 'Autopilot',\n    searchPlaceholder: 'Buscar playbooks...',\n    emptyState: {\n      icon: 'lucideGitBranchPlus',\n      title: 'Nenhum playbook encontrado',\n      description: 'Comece criando seu primeiro playbook.',\n    },\n    enableSelection: true,\n    enableSearch: true,\n    enableFilters: true,\n    enableBulkDelete: true,\n  };\n\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  readonly resolveTriggerLabel = (triggerType?: string | null): string => {\n    if (!triggerType) {\n      return '-';\n    }\n\n    return this.triggerLabelMap[triggerType] ?? triggerType;\n  };\n\n  readonly resolveVersionLabel = (playbook: AutopilotPlaybook): string => {\n    const version = playbook.current_version ?? playbook.version;\n\n    if (version === null || version === undefined) {\n      return '-';\n    }\n\n    return `v${version}`;\n  };\n\n  handleFormSaved(item: AutopilotPlaybook): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.handleFormSaved(item);\n    }\n  }\n\n  handleFormCancelled(): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.closeModal();\n    }\n  }\n\n  handleCustomAction(event: { action: string; item: AutopilotPlaybook }): void {\n    if (event.action === 'editor') {\n      this.router.navigate(['settings', 'autopilot', 'playbooks', event.item.id]);\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/simulator/simulator.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/simulator/simulator.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/autopilot.service' import is duplicated.","line":22,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":22,"endColumn":69},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":125,"column":30,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":125,"endColumn":40},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":136,"column":22,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":136,"endColumn":38},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":147,"column":23,"nodeType":"ChainExpression","messageId":"conditionErrorNullableString","endLine":147,"endColumn":42,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[4070,4089],"text":"((err?.error?.message) != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[4070,4089],"text":"((err?.error?.message) ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[4070,4089],"text":"(Boolean((err?.error?.message)))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":158,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":158,"endColumn":14,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[4342,4347],"text":"date == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[4343,4347],"text":"(date ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[4342,4347],"text":"!Boolean(date)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { CommonModule } from '@angular/common';\nimport {\n  CUSTOM_ELEMENTS_SCHEMA,\n  Component,\n  ChangeDetectionStrategy,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { toast } from 'ngx-sonner';\nimport {\n  AfLoadingButtonComponent,\n  AfPageTitleComponent,\n  AfSelectInputComponent,\n  type AfSelectOption,\n  AfTextareaInputComponent,\n} from '@shared/components';\nimport type { AutopilotPlaybook, SimulatorRunResponse } from '@core/services/autopilot.service';\nimport { AutopilotService } from '@core/services/autopilot.service';\n\n/**\n * Componente simulador para testes de roteiros (playbooks) do IA Autopilot.\n *\n * Permite que o usuário teste a lógica de um roteiro enviando uma entrada JSON\n * e visualizando o resultado das ações e chamadas de ferramentas processadas pela IA.\n *\n * @class Simulator\n * @description Ferramenta de testes para validação de fluxos do Autopilot.\n */\n@Component({\n  selector: 'app-simulator',\n  standalone: true,\n  imports: [\n    CommonModule,\n    ReactiveFormsModule,\n    AfPageTitleComponent,\n    AfSelectInputComponent,\n    AfTextareaInputComponent,\n    AfLoadingButtonComponent,\n  ],\n  templateUrl: './simulator.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n})\nexport class Simulator {\n  /**\n   * Serviço de comunicação com o backend do Autopilot.\n   * @private\n   */\n  private readonly autopilotService = inject(AutopilotService);\n\n  /**\n   * Serviço utilitário para construção de formulários reativos.\n   * @private\n   */\n  private readonly fb = inject(FormBuilder);\n  private readonly destroyRef = inject(DestroyRef);\n\n  /**\n   * Lista de playbooks disponíveis para simulação.\n   * @type {WritableSignal<AutopilotPlaybook[]>}\n   */\n  playbooks = signal<AutopilotPlaybook[]>([]);\n\n  /**\n   * Opções de playbooks formatadas para o SelectInputComponent.\n   * @type {Signal<SelectOption[]>}\n   */\n  readonly playbookOptions = computed<AfSelectOption[]>(() =>\n    this.playbooks().map((p) => ({ value: p.id, label: `${p.name} (v${p.current_version})` })),\n  );\n\n  /**\n   * Indica se existe uma simulação em curso no servidor.\n   * @type {WritableSignal<boolean>}\n   */\n  isRunning = signal(false);\n\n  /**\n   * Resultado detalhado da última execução simulada.\n   * @type {WritableSignal<SimulatorRunResponse | null>}\n   */\n  result = signal<SimulatorRunResponse | null>(null);\n\n  /**\n   * Formulário reativo para configuração da entrada da simulação.\n   */\n  form = this.fb.group({\n    playbook_id: ['', Validators.required],\n    input: ['{\\n  \"message\": \"Olá, gostaria de saber o preço\"\\n}', Validators.required],\n  });\n\n  /**\n   * Construtor do componente Simulator.\n   */\n  constructor() {\n    this.loadPlaybooks();\n  }\n\n  /**\n   * Carrega a lista de playbooks disponíveis para seleção no simulador.\n   */\n  loadPlaybooks(): void {\n    this.autopilotService\n      .listPlaybooks()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (res) => this.playbooks.set(res.data),\n        error: () => toast.error('Erro ao carregar playbooks'),\n      });\n  }\n\n  /**\n   * Executa a simulação enviando os parâmetros do formulário para o backend.\n   */\n  run(): void {\n    if (this.form.invalid || this.isRunning()) return;\n\n    const val = this.form.value;\n    let inputJson;\n    try {\n      inputJson = JSON.parse(val.input!);\n    } catch {\n      toast.error('JSON de entrada inválido');\n      return;\n    }\n\n    this.isRunning.set(true);\n    this.result.set(null);\n\n    this.autopilotService\n      .runSimulation({\n        playbook_id: val.playbook_id!,\n        input: inputJson,\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (res) => {\n          this.isRunning.set(false);\n          this.result.set(res.data);\n        },\n        error: (err: { error?: { message?: string } }) => {\n          this.isRunning.set(false);\n          toast.error(err?.error?.message || 'Erro na simulação');\n        },\n      });\n  }\n\n  /**\n   * Formata uma string de data para exibição amigável.\n   * @param date String de data ISO.\n   * @returns {string} Data formatada.\n   */\n  formatDate(date: string | undefined): string {\n    if (!date) return '-';\n    return new Date(date).toLocaleString();\n  }\n\n  /**\n   * Conta o número de chamadas de ferramentas executadas na última simulação.\n   * @returns {number} Quantidade de TOOL_CALL interceptadas.\n   */\n  countToolCalls(): number {\n    const res = this.result();\n    if (!res) return 0;\n    return res.actions.filter((a) => a.action_type === 'TOOL_CALL').length;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/components/tool-form/tool-form.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/components/tool-form/tool-form.spec.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/autopilot.service' import is duplicated.","line":9,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":76},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (154). Maximum allowed is 80.","line":34,"column":31,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":187,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { type ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\nimport { importProvidersFrom } from '@angular/core';\nimport { LucideAngularModule, icons } from 'lucide-angular';\nimport { of, throwError, type Observable } from 'rxjs';\nimport { ToolFormComponent } from './tool-form';\nimport type { AutopilotTool, AutopilotToolPayload } from 'src/app/core/services/autopilot.service';\nimport { AutopilotService } from 'src/app/core/services/autopilot.service';\n\nclass MockAutopilotService {\n  private _makeTool(id: string, payload: AutopilotToolPayload): AutopilotTool {\n    return {\n      id,\n      name: payload.name,\n      display_name: payload.display_name ?? null,\n      description: payload.description ?? null,\n      parameters_schema: payload.parameters_schema ?? null,\n      handler_class: payload.handler_class ?? null,\n      is_system: payload.is_system ?? false,\n      is_active: payload.is_active ?? true,\n    };\n  }\n\n  createTool(payload: AutopilotToolPayload): Observable<AutopilotTool> {\n    return of(this._makeTool('1', payload));\n  }\n\n  updateTool(id: string, payload: AutopilotToolPayload): Observable<AutopilotTool> {\n    return of(this._makeTool(id, payload));\n  }\n}\n\ndescribe('ToolFormComponent', () => {\n  let component: ToolFormComponent;\n  let fixture: ComponentFixture<ToolFormComponent>;\n  let autopilotService: AutopilotService;\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [ToolFormComponent],\n      providers: [\n        provideHttpClient(),\n        provideHttpClientTesting(),\n        importProvidersFrom(LucideAngularModule.pick(icons)),\n        { provide: AutopilotService, useClass: MockAutopilotService },\n      ],\n    }).compileComponents();\n\n    fixture = TestBed.createComponent(ToolFormComponent);\n    component = fixture.componentInstance;\n    autopilotService = TestBed.inject(AutopilotService);\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should initialize empty form', () => {\n    expect(component.form.value.name).toBe('');\n    expect(component.form.value.is_active).toBe(true);\n  });\n\n  it('should have available handlers with 12 options', () => {\n    expect(component.availableHandlers.length).toBe(12);\n    expect(component.availableHandlers.some((h) => h.value === 'SearchKnowledgeTool')).toBe(true);\n    expect(component.availableHandlers.some((h) => h.value === 'SendMessageTool')).toBe(true);\n  });\n\n  it('should fill form when tool input changes', () => {\n    const tool: AutopilotTool = {\n      id: '1',\n      name: 'Search',\n      display_name: 'Search Tool',\n      handler_class: 'SearchKnowledgeTool',\n      is_active: false,\n      is_system: false,\n    };\n\n    fixture.componentRef.setInput('tool', tool);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('Search');\n    expect(component.form.value.display_name).toBe('Search Tool');\n    expect(component.form.value.handler_class).toBe('SearchKnowledgeTool');\n    expect(component.form.value.is_active).toBe(false);\n  });\n\n  it('should reset form when tool input is null', () => {\n    const tool: AutopilotTool = {\n      id: '1',\n      name: 'Search',\n      is_active: true,\n      is_system: false,\n    };\n    fixture.componentRef.setInput('tool', tool);\n    fixture.detectChanges();\n\n    fixture.componentRef.setInput('tool', null);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('');\n  });\n\n  it('should accept valid handler_class', () => {\n    component.form.patchValue({\n      name: 'New Tool',\n      display_name: 'New',\n      handler_class: 'SearchKnowledgeTool',\n    });\n\n    expect(component.form.get('handler_class')?.valid).toBe(true);\n  });\n\n  it('should reject invalid handler_class', () => {\n    component.form.patchValue({\n      name: 'New Tool',\n      display_name: 'New',\n      handler_class: 'InvalidHandlerThatDoesNotExist',\n    });\n\n    expect(component.form.get('handler_class')?.hasError('invalidHandler')).toBe(true);\n  });\n\n  it('should submit creation with valid handler', () => {\n    const createSpy = vi.spyOn(autopilotService, 'createTool');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n\n    component.form.patchValue({\n      name: 'New Tool',\n      display_name: 'New',\n      handler_class: 'SearchKnowledgeTool',\n    });\n    component.submit();\n\n    expect(createSpy).toHaveBeenCalledWith(\n      expect.objectContaining({ name: 'New Tool', handler_class: 'SearchKnowledgeTool' }),\n    );\n    expect(savedSpy).toHaveBeenCalled();\n  });\n\n  it('should submit update', () => {\n    const updateSpy = vi.spyOn(autopilotService, 'updateTool');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n    const tool: AutopilotTool = {\n      id: '99',\n      name: 'Old',\n      display_name: 'Old Display',\n      handler_class: 'SendMessageTool',\n      is_active: true,\n      is_system: false,\n    };\n\n    fixture.componentRef.setInput('tool', tool);\n    fixture.detectChanges();\n\n    component.form.patchValue({ name: 'Updated' });\n    component.submit();\n\n    expect(updateSpy).toHaveBeenCalledWith('99', expect.objectContaining({ name: 'Updated' }));\n    expect(savedSpy).toHaveBeenCalled();\n  });\n\n  it('should handle submit error', () => {\n    vi.spyOn(autopilotService, 'createTool').mockReturnValue(\n      throwError(() => ({ error: { message: 'Fail' } })),\n    );\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n\n    component.form.patchValue({\n      name: 'New Tool',\n      display_name: 'New',\n      handler_class: 'SendMessageTool',\n    });\n    component.submit();\n\n    expect(savedSpy).not.toHaveBeenCalled();\n    expect(component.isSaving()).toBe(false);\n  });\n\n  it('should cancel', () => {\n    const cancelledSpy = vi.spyOn(component.cancelled, 'emit');\n    component.cancel();\n    expect(cancelledSpy).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/components/tool-form/tool-form.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":45,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":45,"endColumn":35},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":70,"column":14,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":70,"endColumn":19,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[2057,2062],"text":"(Boolean(value))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":121,"column":21,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":121,"endColumn":41,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[3446,3466],"text":"(Boolean((error.error?.message)))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { toast } from 'ngx-sonner';\nimport {\n  AfTextInputComponent,\n  AfTextareaInputComponent,\n  AfSwitchInputComponent,\n  AfSelectInputComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { type AutopilotTool, AutopilotService } from '@core/services/autopilot.service';\nimport { AVAILABLE_HANDLERS, isValidHandler } from '../../constants/available-handlers.const';\n\n@Component({\n  selector: 'app-tool-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfTextInputComponent,\n    AfTextareaInputComponent,\n    AfSwitchInputComponent,\n    AfSelectInputComponent,\n  ],\n  templateUrl: './tool-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class ToolFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly autopilotService = inject(AutopilotService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  readonly tool = input<AutopilotTool | null>(null);\n  readonly saved = output<AutopilotTool>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n\n  /**\n   * Opções de handlers disponíveis (12 handlers fixos).\n   */\n  readonly availableHandlers = AVAILABLE_HANDLERS.map(\n    (handler): AfSelectOption => ({\n      label: handler.label,\n      value: handler.value,\n    }),\n  );\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    display_name: this.fb.control('', Validators.required),\n    description: this.fb.control(''),\n    handler_class: this.fb.control('', [\n      Validators.required,\n      /**\n       * Validador customizado: garante que handler_class é um dos 12 válidos.\n       */\n      (control) => {\n        const value = control.value;\n        if (!value) return null; // deixa Validators.required validar\n\n        return isValidHandler(value) ? null : { invalidHandler: { value } };\n      },\n    ]),\n    is_active: this.fb.control(true),\n  });\n\n  constructor() {\n    effect(() => {\n      const tool = this.tool();\n      if (tool) {\n        if (this.lastLoadedId() === String(tool.id)) {\n          return;\n        }\n        this.lastLoadedId.set(String(tool.id));\n        this.form.reset({\n          name: tool.name,\n          display_name: tool.display_name ?? '',\n          description: tool.description ?? '',\n          handler_class: tool.handler_class ?? '',\n          is_active: tool.is_active,\n        });\n      } else {\n        this.lastLoadedId.set(null);\n        this.resetForm();\n      }\n    });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const payload = this.form.getRawValue();\n    const editing = this.tool();\n    this.isSaving.set(true);\n\n    const request = editing\n      ? this.autopilotService.updateTool(editing.id, payload)\n      : this.autopilotService.createTool(payload);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response);\n      },\n      error: (error) => {\n        this.isSaving.set(false);\n        toast.error(error.error?.message || 'Erro ao salvar tool.');\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      display_name: '',\n      description: '',\n      handler_class: '',\n      is_active: true,\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/constants/available-handlers.const.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/constants/available-handlers.const.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":88,"column":8,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":88,"endColumn":15,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2341,2349],"text":"handler == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2342,2349],"text":"(handler ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2341,2349],"text":"!Boolean(handler)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":96,"column":8,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":96,"endColumn":15,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2567,2575],"text":"handler == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2568,2575],"text":"(handler ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[2567,2575],"text":"!Boolean(handler)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Lista de handlers de Tools disponíveis no Autopilot.\n *\n * Esses handlers correspondem às classes PHP implementadas em:\n * api/src/Domain/Ai/Tools/\n *\n * SINCRONIZAÇÃO: Esta lista DEVE estar em sync com os handlers realmente\n * implementados no backend. Se adicionar/remover handler, atualizar aqui também.\n */\n\nexport interface AvailableHandler {\n  value: string;\n  label: string;\n  description?: string;\n  icon?: string;\n}\n\n/**\n * 12 Handlers de Tools reais implementadas no sistema.\n */\nexport const AVAILABLE_HANDLERS: AvailableHandler[] = [\n  {\n    value: 'SearchKnowledgeTool',\n    label: 'Buscar Conhecimento (SearchKnowledgeTool)',\n    description: 'Busca na base de conhecimento (KB)',\n  },\n  {\n    value: 'SendMessageTool',\n    label: 'Enviar Mensagem (SendMessageTool)',\n    description: 'Envia mensagem em um ticket',\n  },\n  {\n    value: 'ReadTicketTool',\n    label: 'Ler Ticket (ReadTicketTool)',\n    description: 'Lê dados de um ticket',\n  },\n  {\n    value: 'CloseTicketTool',\n    label: 'Fechar Ticket (CloseTicketTool)',\n    description: 'Fecha um ticket',\n  },\n  {\n    value: 'TransferToHumanTool',\n    label: 'Transferir para Humano (TransferToHumanTool)',\n    description: 'Escalona para agente humano',\n  },\n  {\n    value: 'NotifySellerTool',\n    label: 'Notificar Vendedor (NotifySellerTool)',\n    description: 'Notifica vendedor',\n  },\n  {\n    value: 'CreateNoteTool',\n    label: 'Criar Nota (CreateNoteTool)',\n    description: 'Cria nota no ticket',\n  },\n  {\n    value: 'CreateTaskTool',\n    label: 'Criar Tarefa (CreateTaskTool)',\n    description: 'Cria tarefa',\n  },\n  {\n    value: 'UpdateContactTagsTool',\n    label: 'Atualizar Tags do Contato (UpdateContactTagsTool)',\n    description: 'Atualiza tags de contato',\n  },\n  {\n    value: 'UpdateLeadScoreTool',\n    label: 'Atualizar Score do Lead (UpdateLeadScoreTool)',\n    description: 'Atualiza score de lead',\n  },\n  {\n    value: 'GetContactInfoTool',\n    label: 'Obter Informações do Contato (GetContactInfoTool)',\n    description: 'Retorna dados do contato',\n  },\n  {\n    value: 'MovePipelineTool',\n    label: 'Mover no Pipeline (MovePipelineTool)',\n    description: 'Move contato no pipeline',\n  },\n];\n\n/**\n * Validar se um handler_class é válido (existe na lista).\n */\nexport function isValidHandler(handler: string | null | undefined): boolean {\n  if (!handler) return false;\n  return AVAILABLE_HANDLERS.some((h) => h.value === handler);\n}\n\n/**\n * Obter label de um handler pelo seu value.\n */\nexport function getHandlerLabel(handler: string | null | undefined): string {\n  if (!handler) return 'Unknown';\n  const found = AVAILABLE_HANDLERS.find((h) => h.value === handler);\n  return found?.label ?? handler;\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/tools.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/tools.spec.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (112). Maximum allowed is 80.","line":16,"column":19,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":127,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { type ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideRouter } from '@angular/router';\nimport { of } from 'rxjs';\nimport { Tools } from './tools';\nimport { type AutopilotTool, AutopilotService } from 'src/app/core/services/autopilot.service';\n\nclass AutopilotServiceStub {\n  listTools = vi.fn();\n  getTool = vi.fn();\n  createTool = vi.fn();\n  updateTool = vi.fn();\n  deleteTool = vi.fn();\n}\n\ndescribe('Tools', () => {\n  let component: Tools;\n  let fixture: ComponentFixture<Tools>;\n  let autopilot: AutopilotServiceStub;\n\n  const tools: AutopilotTool[] = [\n    {\n      id: 't-1',\n      name: 'SearchKnowledgeTool',\n      display_name: 'Search Knowledge',\n      handler_class: 'SearchKnowledgeTool',\n      is_system: true,\n      is_active: true,\n    },\n    {\n      id: 't-2',\n      name: 'SendMessageTool',\n      display_name: 'Send Message',\n      handler_class: 'SendMessageTool',\n      is_system: true,\n      is_active: true,\n    },\n  ];\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [Tools],\n      providers: [provideRouter([]), { provide: AutopilotService, useClass: AutopilotServiceStub }],\n    }).compileComponents();\n\n    autopilot = TestBed.inject(AutopilotService) as unknown as AutopilotServiceStub;\n    autopilot.listTools.mockReturnValue(\n      of({ data: tools, meta: { current_page: 1, per_page: 10, total: 2, last_page: 1 } }),\n    );\n    autopilot.getTool.mockReturnValue(of(tools[0]));\n    autopilot.createTool.mockReturnValue(of(tools[0]));\n    autopilot.updateTool.mockReturnValue(of(tools[0]));\n    autopilot.deleteTool.mockReturnValue(of(void 0));\n\n    fixture = TestBed.createComponent(Tools);\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should configure actions', () => {\n    expect(component.actions.some((action) => action.type === 'edit')).toBe(true);\n    expect(component.actions.some((action) => action.type === 'delete')).toBe(true);\n  });\n\n  it('should configure columns', () => {\n    const columns = component.columns();\n    expect(columns.some((column) => column.field === 'display_name')).toBe(true);\n  });\n\n  it('should list tools with search and filter', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotTool[] }>((resolve) => {\n      component.crudService\n        .list({ page: 1, per_page: 10, search: 'Search', is_active: true })\n        .subscribe((res) => resolve(res));\n    });\n    expect(result.data.length).toBe(1);\n    expect(result.data[0].id).toBe('t-1');\n  });\n\n  it('should create tool', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotTool }>((resolve) => {\n      component.crudService.create({ name: 'nova' } as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('t-1');\n  });\n\n  it('should update tool', async (): Promise<void> => {\n    const result = await new Promise<{ data: AutopilotTool }>((resolve) => {\n      component.crudService.update('tool-1', {} as unknown).subscribe((res) => resolve(res));\n    });\n    expect(result.data.id).toBe('t-1');\n  });\n\n  it('should delete tool', async (): Promise<void> => {\n    await new Promise<void>((resolve) => {\n      component.crudService.delete('tool-1').subscribe(() => resolve());\n    });\n    expect(autopilot.deleteTool).toHaveBeenCalledWith('tool-1');\n  });\n\n  it('should hide actions for system tools', (): void => {\n    const hideEdit = component.actions.find((action) => action.type === 'edit')?.hidden;\n    const hideDelete = component.actions.find((action) => action.type === 'delete')?.hidden;\n\n    expect(hideEdit?.(tools[1])).toBe(true);\n    expect(hideDelete?.(tools[1])).toBe(true);\n  });\n\n  it('should delegate form actions to CrudPage', (): void => {\n    const crudPage = {\n      handleFormSaved: vi.fn(),\n      closeModal: vi.fn(),\n    };\n    (component as unknown as { crudPage: () => typeof crudPage }).crudPage = (): typeof crudPage =>\n      crudPage;\n\n    component.handleFormSaved(tools[0]);\n    component.handleFormCancelled();\n\n    expect(crudPage.handleFormSaved).toHaveBeenCalledWith(tools[0]);\n    expect(crudPage.closeModal).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/tools/tools.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/autopilot.service' import is duplicated.","line":13,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":13,"endColumn":69}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TemplateRef } from '@angular/core';\nimport {\n  CUSTOM_ELEMENTS_SCHEMA,\n  ChangeDetectionStrategy,\n  Component,\n  computed,\n  inject,\n  viewChild,\n} from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { getHandlerLabel } from './constants/available-handlers.const';\nimport type { AutopilotTool, AutopilotToolPayload } from '@core/services/autopilot.service';\nimport { AutopilotService } from '@core/services/autopilot.service';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n  CrudPageLikeRef,\n} from '../autopilot-crud.types';\nimport type { AfSelectOption } from '@shared/components';\nimport { ToolFormComponent } from './components';\n\n/**\n * Componente para gestão de Ferramentas (Tools) do IA Autopilot.\n *\n * Permite listar e configurar as capacidades e integrações que a IA\n * pode utilizar para executar tarefas durante o atendimento.\n *\n * @class Tools\n * @extends {BaseListPage<AutopilotTool>}\n * @description Central de ferramentas e extensões operacionais da IA.\n */\n@Component({\n  selector: 'app-tools',\n  standalone: true,\n  imports: [ToolFormComponent],\n  templateUrl: './tools.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n})\nexport class Tools {\n  private readonly autopilotService = inject(AutopilotService);\n\n  // Expose getHandlerLabel para acesso no template\n  readonly getHandlerLabel = getHandlerLabel;\n\n  readonly crudPage = viewChild<CrudPageLikeRef<AutopilotTool>>('crudPage');\n  readonly toolForm = viewChild<ToolFormComponent>('toolForm');\n  readonly nameCell = viewChild<TemplateRef<{ $implicit: AutopilotTool }>>('nameCell');\n  readonly handlerCell = viewChild<TemplateRef<{ $implicit: AutopilotTool }>>('handlerCell');\n  readonly typeCell = viewChild<TemplateRef<{ $implicit: AutopilotTool }>>('typeCell');\n\n  readonly crudService: CrudService<AutopilotTool> = {\n    list: (params) =>\n      this.autopilotService.listTools({ page: 1, per_page: 1000 }).pipe(\n        map((response) => {\n          const search = params.search?.toLowerCase() ?? '';\n          const isActive = params.is_active;\n          const perPage = params.per_page ?? 10;\n          const page = params.page ?? 1;\n\n          let data = [...response.data];\n\n          if (search) {\n            data = data.filter((item) =>\n              [item.name, item.display_name ?? '', item.handler_class ?? '']\n                .join(' ')\n                .toLowerCase()\n                .includes(search),\n            );\n          }\n\n          if (isActive !== undefined) {\n            data = data.filter((item) => item.is_active === isActive);\n          }\n\n          const total = data.length;\n          const lastPage = Math.max(1, Math.ceil(total / perPage));\n          const start = (page - 1) * perPage;\n          const paged = data.slice(start, start + perPage);\n\n          return {\n            data: paged,\n            meta: {\n              total,\n              per_page: perPage,\n              current_page: page,\n              last_page: lastPage,\n            },\n          };\n        }),\n      ) as Observable<CrudPaginatedResponse<AutopilotTool>>,\n    find: (id: string) =>\n      this.autopilotService.getTool(id).pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotTool>\n      >,\n    create: (data: Partial<AutopilotTool>) =>\n      this.autopilotService\n        .createTool(data as AutopilotToolPayload)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotTool>\n      >,\n    update: (id: string, data: Partial<AutopilotTool>) =>\n      this.autopilotService\n        .updateTool(id, data)\n        .pipe(map((response) => ({ data: response }))) as Observable<\n        CrudItemResponse<AutopilotTool>\n      >,\n    delete: (id: string) => this.autopilotService.deleteTool(id),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    {\n      field: 'display_name',\n      label: 'Nome',\n      template: this.nameCell() ?? undefined,\n    },\n    {\n      field: 'handler_class',\n      label: 'Ferramenta',\n      template: this.handlerCell() ?? undefined,\n    },\n    {\n      field: 'is_system',\n      label: 'Tipo',\n      template: this.typeCell() ?? undefined,\n    },\n    { field: 'is_active', label: 'Status', type: 'status' },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n      hidden: (item: AutopilotTool) => item.is_system,\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n      hidden: (item: AutopilotTool) => item.is_system,\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Tool',\n      plural: 'Ferramentas',\n      createButton: 'Nova Tool',\n      modalCreate: 'Nova Tool',\n      modalEdit: 'Editar Tool',\n    },\n    subtitle: 'Autopilot',\n    searchPlaceholder: 'Buscar tools...',\n    emptyState: {\n      icon: 'lucideWrench',\n      title: 'Nenhuma tool encontrada',\n      description: 'Adicione tools customizadas para seu autopilot.',\n    },\n    enableSelection: false,\n    enableSearch: true,\n    enableFilters: true,\n    enableBulkDelete: false,\n    enablePagination: false,\n  };\n\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  handleFormSaved(item: AutopilotTool): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.handleFormSaved(item);\n    }\n  }\n\n  handleFormCancelled(): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.closeModal();\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/trigger-logs/trigger-logs.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/trigger-logs/trigger-logs.spec.ts