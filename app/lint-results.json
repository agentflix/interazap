imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"relative inline-block\" #root>\n      <div (click)=\"toggle()\">\n        <ng-content />\n      </div>\n      @if (isOpen()) {\n        <div\n          class=\"absolute z-30 mt-1 w-48 rounded-lg border border-neutral-200 dark:border-neutral-700\n            bg-white dark:bg-neutral-900 shadow-md py-1\"\n          [class.right-0]=\"align() === 'end'\"\n          [class.left-0]=\"align() === 'start'\"\n        >\n          @for (item of items(); track item.value) {\n            @if (item.divider) {\n              <div class=\"my-1 border-t border-neutral-200 dark:border-neutral-700\"></div>\n            } @else {\n              <button\n                type=\"button\"\n                [disabled]=\"item.disabled ?? false\"\n                class=\"w-full flex items-center gap-2 px-3 py-2 text-left text-sm transition-colors\n                  disabled:opacity-40 disabled:cursor-not-allowed\"\n                [class.text-red-600]=\"item.destructive\"\n                [class.dark:text-red-400]=\"item.destructive\"\n                [class.text-neutral-700]=\"!item.destructive\"\n                [class.dark:text-neutral-200]=\"!item.destructive\"\n                [class.hover:bg-neutral-100]=\"true\"\n                [class.dark:hover:bg-neutral-800]=\"true\"\n                (click)=\"select(item)\"\n              >\n                @if (item.icon) {\n                  <lucide-icon [name]=\"item.icon\" [size]=\"15\" />\n                }\n                {{ item.label }}\n              </button>\n            }\n          }\n        </div>\n      }\n    </div>\n  `,\n})\nexport class AfDropdownMenuComponent {\n  /** Menu items */\n  readonly items = input<AfDropdownMenuItem[]>([]);\n\n  /** Menu alignment */\n  readonly align = input<'start' | 'end'>('end');\n\n  /** Emitted when an item is selected */\n  readonly itemSelected = output<string>();\n\n  protected readonly isOpen = signal(false);\n\n  private readonly rootRef = viewChild<ElementRef<HTMLElement>>('root');\n\n  protected toggle(): void {\n    this.isOpen.update((v) => !v);\n  }\n\n  protected select(item: AfDropdownMenuItem): void {\n    if (item.disabled) return;\n    this.itemSelected.emit(item.value);\n    this.isOpen.set(false);\n  }\n\n  @HostListener('document:click', ['$event'])\n  protected onDocumentClick(event: MouseEvent): void {\n    if (!this.isOpen()) return;\n    const root = this.rootRef()?.nativeElement;\n    if (root && event.target instanceof Node && !root.contains(event.target)) {\n      this.isOpen.set(false);\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/empty-state/empty-state.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/error-boundary/error-boundary.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":53,"column":34,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":53,"endColumn":38}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * AfErrorBoundaryComponent — Fallback UI for error states.\n *\n * @example\n * ```html\n * <af-error-boundary title=\"Algo deu errado\" message=\"Tente novamente mais tarde.\" (retryClicked)=\"retry()\" />\n * ```\n */\n@Component({\n  selector: 'af-error-boundary',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"flex flex-col items-center justify-center py-12 px-4 text-center\">\n      <div\n        class=\"w-16 h-16 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mb-4\"\n      >\n        <lucide-icon name=\"alert-circle\" [size]=\"32\" class=\"text-red-500\" />\n      </div>\n      <h3 class=\"text-lg font-semibold text-neutral-900 dark:text-neutral-50 mb-1\">\n        {{ title() }}\n      </h3>\n      <p class=\"text-sm text-neutral-500 mb-6 max-w-md\">{{ message() }}</p>\n      @if (showRetry()) {\n        <button\n          type=\"button\"\n          class=\"inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg\n            bg-accent-600 text-white hover:bg-accent-700 transition-colors cursor-pointer\"\n          (click)=\"retryClicked.emit()\"\n        >\n          <lucide-icon name=\"refresh-cw\" [size]=\"14\" />\n          Tentar novamente\n        </button>\n      }\n    </div>\n  `,\n})\nexport class AfErrorBoundaryComponent {\n  /** Error title */\n  readonly title = input('Algo deu errado');\n\n  /** Error message */\n  readonly message = input('Ocorreu um erro inesperado. Por favor, tente novamente.');\n\n  /** Show retry button */\n  readonly showRetry = input(true);\n\n  /** Retry clicked */\n  readonly retryClicked = output<void>();\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/fab/fab.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":49,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":49,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, computed } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/**\n * AfFabComponent — Floating Action Button positioned fixed on screen.\n *\n * @example\n * ```html\n * <af-fab icon=\"plus\" position=\"bottom-right\" (clicked)=\"onCreate()\" />\n * ```\n */\n@Component({\n  selector: 'af-fab',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <button\n      type=\"button\"\n      [attr.aria-label]=\"ariaLabel()\"\n      [disabled]=\"disabled()\"\n      [class]=\"buttonClasses()\"\n      (click)=\"clicked.emit()\"\n    >\n      <lucide-icon [name]=\"icon()\" [size]=\"iconSize()\" />\n    </button>\n  `,\n})\nexport class AfFabComponent {\n  /** Lucide icon name */\n  readonly icon = input.required<string>();\n\n  /** Accessible label */\n  readonly ariaLabel = input('Action');\n\n  /** Visual variant */\n  readonly variant = input<'primary' | 'secondary' | 'danger'>('primary');\n\n  /** Button size */\n  readonly size = input<'sm' | 'md' | 'lg'>('md');\n\n  /** Screen position */\n  readonly position = input<'bottom-right' | 'bottom-left' | 'bottom-center'>('bottom-right');\n\n  /** Disabled state */\n  readonly disabled = input(false);\n\n  /** Click event */\n  readonly clicked = output<void>();\n\n  protected readonly iconSize = computed(() => {\n    const map: Record<string, number> = { sm: 18, md: 22, lg: 26 };\n    return map[this.size()];\n  });\n\n  protected readonly buttonClasses = computed(() => {\n    const sizes: Record<string, string> = { sm: 'size-10', md: 'size-12', lg: 'size-14' };\n    const variants: Record<string, string> = {\n      primary:\n        'bg-accent-500 text-white hover:bg-accent-600 active:bg-accent-700 focus-visible:ring-accent-500/50',\n      secondary:\n        'bg-primary-900 text-white hover:bg-primary-700 active:bg-primary-950 focus-visible:ring-primary-900/50',\n      danger:\n        'bg-red-600 text-white hover:bg-red-700 active:bg-red-800 focus-visible:ring-red-600/50',\n    };\n    const positions: Record<string, string> = {\n      'bottom-right': 'fixed bottom-6 right-6',\n      'bottom-left': 'fixed bottom-6 left-6',\n      'bottom-center': 'fixed bottom-6 left-1/2 -translate-x-1/2',\n    };\n    return [\n      'inline-flex items-center justify-center rounded-full shadow-lg',\n      'transition-all duration-150 cursor-pointer z-50',\n      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',\n      'disabled:opacity-50 disabled:cursor-not-allowed',\n      sizes[this.size()],\n      variants[this.variant()],\n      positions[this.position()],\n    ].join(' ');\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/file-input/file-input.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":75,"column":13,"nodeType":"ChainExpression","messageId":"conditionErrorNullableBoolean","endLine":75,"endColumn":36,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[2217,2240],"text":"((this.control()?.invalid) ?? false)"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareFalse","fix":{"range":[2216,2240],"text":"((this.control()?.invalid) === false)"},"desc":"Change condition to check if false (`value === false`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":75,"column":42,"nodeType":"ChainExpression","messageId":"conditionErrorNullableBoolean","endLine":75,"endColumn":65,"suggestions":