2587,12592],"text":"(Boolean(runId))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":398,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":398,"endColumn":15,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[13953,13959],"text":"(runId == null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[13954,13959],"text":"(runId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[13953,13959],"text":"(!Boolean(runId))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":557,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":557,"endColumn":26,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[18353,18370],"text":"this.pollingTimer != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[18353,18370],"text":"this.pollingTimer ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[18353,18370],"text":"Boolean(this.pollingTimer)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":581,"column":10,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":581,"endColumn":27,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[18927,18945],"text":"this.pollingTimer == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[18928,18945],"text":"(this.pollingTimer ?? 0)"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[18927,18945],"text":"!Boolean(this.pollingTimer)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  effect,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { DatePipe, JsonPipe } from '@angular/common';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfButtonComponent,\n  AfLoadingButtonComponent,\n  AfPageTitleComponent,\n  AfSelectInputComponent,\n  AfTextareaInputComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { ToastService } from '../../../core/services/toast.service';\nimport type {\n  AutopilotRun,\n  AiRunCompletedEvent,\n  AiRunEvent,\n  AiRunToolCallEvent,\n  AiRunToolResultEvent,\n} from '../models/ai.models';\nimport { AiAgentService } from '../services/ai-agent.service';\nimport { AiRealtimeService } from '../services/ai-realtime.service';\nimport { AutopilotPlaybookService } from '../services/autopilot-playbook.service';\nimport { AutopilotRunService } from '../services/autopilot-run.service';\n\ntype SimulatorTimelineType =\n  | 'ai.run.started'\n  | 'ai.run.thinking'\n  | 'ai.run.tool_call'\n  | 'ai.run.tool_result'\n  | 'ai.run.completed'\n  | 'ai.run.failed'\n  | 'ai.run.blocked';\n\ninterface SimulatorTimelineEvent {\n  id: string;\n  type: SimulatorTimelineType;\n  runId: string;\n  payload: Record<string, unknown>;\n  createdAt: string;\n}\n\n/**\n * AI Autopilot simulator with realtime timeline.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-ai-simulator',\n  standalone: true,\n  imports: [\n    DatePipe,\n    JsonPipe,\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfPageTitleComponent,\n    AfButtonComponent,\n    AfSelectInputComponent,\n    AfTextareaInputComponent,\n    AfLoadingButtonComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-page-title title=\"Simulador\" subtitle=\"IA\" />\n\n    @if (isLoadingData()) {\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n      >\n        <p class=\"text-sm text-neutral-500\">Carregando dados do simulador...</p>\n      </div>\n    } @else if (loadError()) {\n      <div\n        class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-red-200 dark:border-red-800 p-6\"\n      >\n        <p class=\"text-sm text-red-600 dark:text-red-400\">{{ loadError() }}</p>\n      </div>\n    } @else {\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-5 mb-5\">\n        <!-- Input Panel -->\n        <div class=\"lg:col-span-4\">\n          <div\n            class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n          >\n            <af-select-input\n              label=\"Agente\"\n              [control]=\"form.controls.agent_id\"\n              [options]=\"agentOptions()\"\n              placeholder=\"Selecione um agente\"\n              [required]=\"true\"\n            />\n\n            <af-select-input\n              label=\"Playbook\"\n              [control]=\"form.controls.playbook_id\"\n              [options]=\"playbookOptions()\"\n              placeholder=\"Selecione um playbook\"\n              [required]=\"true\"\n            />\n\n            <af-textarea-input\n              label=\"Context (JSON)\"\n              [control]=\"form.controls.context_json\"\n              [rows]=\"12\"\n            />\n          </div>\n        </div>\n\n        <!-- Output Panel -->\n        <div class=\"lg:col-span-8\">\n          <div\n            class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 flex flex-col min-h-140\"\n          >\n            <div class=\"flex items-center justify-between gap-2 mb-3\">\n              <div class=\"text-sm font-medium text-neutral-700 dark:text-neutral-300\">\n                Simulação\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <af-button\n                  [variant]=\"activeTab() === 'timeline' ? 'primary' : 'ghost'\"\n                  size=\"sm\"\n                  (click)=\"selectTab('timeline')\"\n                >\n                  Timeline\n                </af-button>\n                <af-button\n                  [variant]=\"activeTab() === 'history' ? 'primary' : 'ghost'\"\n                  size=\"sm\"\n                  (click)=\"selectTab('history')\"\n                >\n                  Histórico\n                </af-button>\n              </div>\n            </div>\n\n            @if (activeTab() === 'timeline') {\n              <div #timelineContainer class=\"flex-1 overflow-y-auto space-y-3\">\n                @if (timeline().length === 0) {\n                  <p class=\"text-sm text-neutral-500\">Nenhuma execução iniciada.</p>\n                }\n                @for (event of timeline(); track trackTimeline($index, event)) {\n                  <div\n                    class=\"rounded-lg border border-neutral-200 dark:border-neutral-700 p-3 bg-neutral-50 dark:bg-neutral-900/30\"\n                  >\n                    <div class=\"flex items-center justify-between gap-2\">\n                      <div class=\"text-sm font-medium text-neutral-800 dark:text-neutral-200\">\n                        {{ labelFor(event.type) }}\n                      </div>\n                      <div class=\"text-xs text-neutral-500\">\n                        {{ event.createdAt | date: 'HH:mm:ss' }}\n                      </div>\n                    </div>\n                    <pre\n                      class=\"mt-2 text-xs text-neutral-600 dark:text-neutral-400 whitespace-pre-wrap font-mono\"\n                      >{{ event.payload | json }}</pre\n                    >\n                  </div>\n                }\n              </div>\n            } @else {\n              <div class=\"flex-1 overflow-y-auto space-y-3\">\n                @if (historyLoading()) {\n                  <p class=\"text-sm text-neutral-500\">Carregando histórico...</p>\n                } @else if (historyRuns().length === 0) {\n                  <p class=\"text-sm text-neutral-500\">Nenhuma execução encontrada.</p>\n                } @else {\n                  @for (run of historyRuns(); track run.id) {\n                    <div\n                      class=\"rounded-lg border border-neutral-200 dark:border-neutral-700 p-3 bg-neutral-50 dark:bg-neutral-900/30\"\n                    >\n                      <div class=\"flex items-center justify-between gap-2\">\n                        <div>\n                          <div class=\"text-sm font-medium text-neutral-800 dark:text-neutral-200\">\n                            Run {{ run.id }}\n                          </div>\n                          <div class=\"text-xs text-neutral-500\">\n                            Status: {{ run.status }} ·\n                            {{\n                              run.created_at || run.started_at || run.completed_at\n                                | date: 'dd/MM/yyyy HH:mm'\n                            }}\n                          </div>\n                        </div>\n                        <af-button variant=\"ghost\" size=\"sm\" (click)=\"viewHistoryRun(run.id)\">\n                          Detalhes\n                        </af-button>\n                      </div>\n                    </div>\n                  }\n\n                  <div\n                    class=\"flex items-center justify-between gap-2 border-t border-neutral-200 dark:border-neutral-700 pt-3\"\n                  >\n                    <af-button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      [disabled]=\"historyPage() <= 1\"\n                      (click)=\"goToHistoryPage(historyPage() - 1)\"\n                    >\n                      Anterior\n                    </af-button>\n                    <div class=\"text-xs text-neutral-500\">\n                      Página {{ historyPage() }} de {{ historyLastPage() }}\n                    </div>\n                    <af-button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      [disabled]=\"historyPage() >= historyLastPage()\"\n                      (click)=\"goToHistoryPage(historyPage() + 1)\"\n                    >\n                      Próxima\n                    </af-button>\n                  </div>\n\n                  @if (selectedHistoryRun()) {\n                    <div\n                      class=\"rounded-lg border border-neutral-200 dark:border-neutral-700 p-3 bg-neutral-50 dark:bg-neutral-900/30\"\n                    >\n                      <div class=\"text-sm font-medium text-neutral-800 dark:text-neutral-200 mb-2\">\n                        Detalhes da execução\n                      </div>\n                      <pre\n                        class=\"text-xs text-neutral-600 dark:text-neutral-400 whitespace-pre-wrap font-mono\"\n                        >{{ selectedHistoryRun() | json }}</pre\n                      >\n                    </div>\n                  }\n                }\n              </div>\n            }\n\n            @if (activeTab() === 'timeline') {\n              <div\n                class=\"mt-4 flex items-center gap-2 border-t border-neutral-200 dark:border-neutral-700 pt-4\"\n              >\n                <af-loading-button\n                  variant=\"primary\"\n                  size=\"sm\"\n                  [loading]=\"isExecuting()\"\n                  [disabled]=\"form.invalid || isExecuting()\"\n                  (click)=\"execute()\"\n                >\n                  Executar\n                </af-loading-button>\n\n                <af-loading-button\n                  variant=\"danger\"\n                  size=\"sm\"\n                  [loading]=\"isCancelling()\"\n                  [disabled]=\"!activeRunId() || !isExecuting()\"\n                  (click)=\"cancel()\"\n                >\n                  Cancelar\n                </af-loading-button>\n              </div>\n            }\n          </div>\n        </div>\n      </div>\n    }\n  `,\n})\nexport class AiSimulatorComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly agentService = inject(AiAgentService);\n  private readonly playbookService = inject(AutopilotPlaybookService);\n  private readonly runService = inject(AutopilotRunService);\n  private readonly toast = inject(ToastService);\n  readonly realtimeService = inject(AiRealtimeService);\n\n  readonly timelineContainer = viewChild<ElementRef<HTMLElement>>('timelineContainer');\n  readonly agentOptions = signal<AfSelectOption[]>([]);\n  readonly playbookOptions = signal<AfSelectOption[]>([]);\n  readonly timeline = signal<SimulatorTimelineEvent[]>([]);\n  readonly activeTab = signal<'timeline' | 'history'>('timeline');\n  readonly historyRuns = signal<AutopilotRun[]>([]);\n  readonly historyPage = signal(1);\n  readonly historyLastPage = signal(1);\n  readonly historyLoading = signal(false);\n  readonly selectedHistoryRun = signal<AutopilotRun | null>(null);\n  readonly activeRunId = signal<string | null>(null);\n  readonly isExecuting = signal(false);\n  readonly isCancelling = signal(false);\n  readonly isLoadingData = signal(true);\n  readonly loadError = signal<string | null>(null);\n  readonly hasConnectedOnce = signal(false);\n\n  private pollingTimer: ReturnType<typeof setInterval> | null = null;\n\n  readonly form = this.fb.group({\n    agent_id: this.fb.nonNullable.control('', [Validators.required]),\n    playbook_id: this.fb.nonNullable.control('', [Validators.required]),\n    context_json: this.fb.nonNullable.control('{}', [Validators.required]),\n  });\n\n  constructor() {\n    this.loadDependencies();\n    this.loadHistory();\n    this.realtimeService.connect();\n\n    effect(() => {\n      const event = this.realtimeService.lastEvent();\n      if (!event.type || event.version === 0) {\n        return;\n      }\n\n      const runId = this.activeRunId();\n      if (!runId) {\n        return;\n      }\n\n      const timelineEvent = this.toTimelineEvent(event.type, runId, event);\n      if (!timelineEvent || timelineEvent.runId !== runId) {\n        return;\n      }\n\n      this.timeline.update((items) => [...items, timelineEvent]);\n      this.syncRunningState(timelineEvent.type);\n      this.scrollTimelineToBottom();\n    });\n\n    effect(() => {\n      const connected = this.realtimeService.connected();\n      const runId = this.activeRunId();\n      const executing = this.isExecuting();\n\n      if (connected) {\n        this.hasConnectedOnce.set(true);\n        this.stopPolling();\n        return;\n      }\n\n      if (this.hasConnectedOnce() && executing && runId) {\n        this.startPolling(runId);\n      }\n    });\n  }\n\n  execute(): void {\n    if (this.form.invalid || this.isExecuting()) {\n      return;\n    }\n\n    const playbookId = this.form.controls.playbook_id.value;\n    const agentId = this.form.controls.agent_id.value;\n    const context = this.parseContextJson();\n\n    if (!playbookId || !agentId || !context) {\n      return;\n    }\n\n    this.timeline.set([]);\n    this.isExecuting.set(true);\n\n    this.runService\n      .run(playbookId, {\n        context: {\n          ...context,\n          agent_id: agentId,\n        },\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (run) => {\n          this.activeRunId.set(run.id);\n          this.activeTab.set('timeline');\n          this.timeline.update((items) => [\n            ...items,\n            {\n              id: `queued-${run.id}`,\n              type: 'ai.run.started',\n              runId: run.id,\n              payload: { status: run.status, message: 'Execução enfileirada...' },\n              createdAt: new Date().toISOString(),\n            },\n          ]);\n          this.scrollTimelineToBottom();\n        },\n        error: () => {\n          this.isExecuting.set(false);\n          this.toast.error('Falha ao iniciar execução');\n        },\n      });\n  }\n\n  cancel(): void {\n    const runId = this.activeRunId();\n    if (!runId || this.isCancelling()) {\n      return;\n    }\n\n    this.isCancelling.set(true);\n    this.runService\n      .cancel(runId)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isCancelling.set(false);\n          this.isExecuting.set(false);\n          this.stopPolling();\n          this.timeline.update((items) => [\n            ...items,\n            {\n              id: `cancel-${runId}-${Date.now()}`,\n              type: 'ai.run.failed',\n              runId,\n              payload: { message: 'Execução cancelada.' },\n              createdAt: new Date().toISOString(),\n            },\n          ]);\n          this.scrollTimelineToBottom();\n        },\n        error: () => {\n          this.isCancelling.set(false);\n          this.toast.error('Falha ao cancelar execução');\n        },\n      });\n  }\n\n  selectTab(tab: 'timeline' | 'history'): void {\n    this.activeTab.set(tab);\n    if (tab === 'history') {\n      this.loadHistory();\n    }\n  }\n\n  goToHistoryPage(page: number): void {\n    if (page < 1 || page > this.historyLastPage()) {\n      return;\n    }\n    this.historyPage.set(page);\n    this.loadHistory();\n  }\n\n  viewHistoryRun(runId: string): void {\n    this.runService\n      .get(runId)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (run) => {\n          this.selectedHistoryRun.set(run);\n        },\n        error: () => {\n          this.toast.error('Falha ao carregar histórico da execução');\n        },\n      });\n  }\n\n  trackTimeline = (_index: number, event: SimulatorTimelineEvent): string => event.id;\n\n  labelFor(type: SimulatorTimelineType): string {\n    switch (type) {\n      case 'ai.run.started':\n        return '🤖 Execução iniciada...';\n      case 'ai.run.thinking':\n        return '💭 Processando...';\n      case 'ai.run.tool_call':\n        return '🔧 Chamada de ferramenta';\n      case 'ai.run.tool_result':\n        return '✅ Resultado da ferramenta';\n      case 'ai.run.completed':\n        return '💬 Resposta final';\n      case 'ai.run.blocked':\n        return '🛑 Bloqueado por guardrail';\n      case 'ai.run.failed':\n        return '❌ Execução com falha';\n    }\n  }\n\n  private loadDependencies(): void {\n    this.isLoadingData.set(true);\n    this.loadError.set(null);\n\n    this.agentService\n      .list({ page: 1, per_page: 100 })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.agentOptions.set(\n            response.data.map((agent) => ({\n              value: agent.id,\n              label: agent.name,\n            })),\n          );\n        },\n        error: () => {\n          this.loadError.set('Falha ao carregar agentes');\n        },\n      });\n\n    this.playbookService\n      .list({ page: 1, per_page: 100 })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.playbookOptions.set(\n            response.data.map((playbook) => ({\n              value: playbook.id,\n              label: playbook.name,\n            })),\n          );\n          this.isLoadingData.set(false);\n        },\n        error: () => {\n          this.loadError.set('Falha ao carregar playbooks');\n          this.isLoadingData.set(false);\n        },\n      });\n  }\n\n  private loadHistory(): void {\n    this.historyLoading.set(true);\n\n    this.runService\n      .list({ page: this.historyPage(), per_page: 10 })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.historyRuns.set(response.data);\n          this.historyLastPage.set(response.meta.last_page);\n          this.historyLoading.set(false);\n        },\n        error: () => {\n          this.historyLoading.set(false);\n          this.toast.error('Falha ao carregar histórico');\n        },\n      });\n  }\n\n  private parseContextJson(): Record<string, unknown> | null {\n    const rawValue = this.form.controls.context_json.value;\n\n    try {\n      const parsedValue: unknown = JSON.parse(rawValue || '{}');\n      if (typeof parsedValue !== 'object' || parsedValue === null) {\n        this.toast.error('Contexto JSON deve ser um objeto válido');\n        return null;\n      }\n      return parsedValue as Record<string, unknown>;\n    } catch {\n      this.toast.error('Contexto JSON inválido');\n      return null;\n    }\n  }\n\n  private startPolling(runId: string): void {\n    if (this.pollingTimer) {\n      return;\n    }\n\n    this.pollingTimer = setInterval(() => {\n      this.runService\n        .get(runId)\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe({\n          next: (run) => {\n            const status = run.status;\n            if (status !== 'queued' && status !== 'running') {\n              this.isExecuting.set(false);\n              this.stopPolling();\n            }\n          },\n          error: () => {\n            this.stopPolling();\n          },\n        });\n    }, 3000);\n  }\n\n  private stopPolling(): void {\n    if (!this.pollingTimer) {\n      return;\n    }\n    clearInterval(this.pollingTimer);\n    this.pollingTimer = null;\n  }\n\n  private toTimelineEvent(\n    eventType: string,\n    activeRunId: string,\n    events: {\n      started: AiRunEvent | null;\n      thinking: AiRunEvent | null;\n      toolCall: AiRunToolCallEvent | null;\n      toolResult: AiRunToolResultEvent | null;\n      completed: AiRunCompletedEvent | null;\n      failed: AiRunEvent | null;\n      blocked: AiRunEvent | null;\n      type: string | null;\n      version: number;\n    },\n  ): SimulatorTimelineEvent | null {\n    const payload =\n      eventType === 'ai.run.started'\n        ? events.started\n        : eventType === 'ai.run.thinking'\n          ? events.thinking\n          : eventType === 'ai.run.tool_call'\n            ? events.toolCall\n            : eventType === 'ai.run.tool_result'\n              ? events.toolResult\n              : eventType === 'ai.run.completed'\n                ? events.completed\n                : eventType === 'ai.run.failed'\n                  ? events.failed\n                  : events.blocked;\n\n    if (!payload || payload.run_id !== activeRunId) {\n      return null;\n    }\n\n    return {\n      id: `${eventType}-${events.version}`,\n      type: eventType as SimulatorTimelineType,\n      runId: payload.run_id,\n      payload: { ...payload },\n      createdAt: new Date().toISOString(),\n    };\n  }\n\n  private syncRunningState(eventType: SimulatorTimelineType): void {\n    if (\n      eventType === 'ai.run.completed' ||\n      eventType === 'ai.run.failed' ||\n      eventType === 'ai.run.blocked'\n    ) {\n      this.isExecuting.set(false);\n      this.stopPolling();\n    }\n  }\n\n  private scrollTimelineToBottom(): void {\n    queueMicrotask(() => {\n      const container = this.timelineContainer()?.nativeElement;\n      if (!container) {\n        return;\n      }\n      container.scrollTop = container.scrollHeight;\n    });\n  }\n}\n\nexport default AiSimulatorComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/auth/create-password/create-password.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/auth/create-password/create-password.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/forms' import is duplicated.","line":3,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":3,"endColumn":79},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":106,"column":9,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":106,"endColumn":29,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[3496,3516],"text":"Boolean((errors?.['required']))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ChangeDetectionStrategy, Component, computed, inject } from '@angular/core';\nimport type { FormControl, FormGroup } from '@angular/forms';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { RouterLink } from '@angular/router';\nimport {\n  AfButtonComponent,\n  AfCheckboxInputComponent,\n  AfFormErrorComponent,\n  AfPasswordInputComponent,\n  AfPasswordStrengthComponent,\n} from '../../../shared/components';\n\nimport { AuthPageWrapperComponent } from '../../../layout/auth-layout/auth-page-wrapper.component';\n\n@Component({\n  selector: 'app-create-password',\n  standalone: true,\n  imports: [\n    RouterLink,\n    ReactiveFormsModule,\n    AfButtonComponent,\n    AfPasswordStrengthComponent,\n    AfPasswordInputComponent,\n    AfCheckboxInputComponent,\n    AfFormErrorComponent,\n    AuthPageWrapperComponent,\n  ],\n  template: `\n    <app-auth-page-wrapper\n      title=\"Defina uma nova senha\"\n      subtitle=\"Sua nova senha deve ser diferente das anteriores\"\n    >\n      <form [formGroup]=\"form\" (ngSubmit)=\"submit()\" class=\"w-full\">\n        <af-password-strength\n          [control]=\"form.controls.password\"\n          label=\"Senha\"\n          placeholder=\"Senha\"\n          [required]=\"true\"\n          [minLength]=\"6\"\n          errorMessage=\"Senha obrigatória\"\n          dataTest=\"create-password\"\n        />\n\n        <af-password-input\n          [control]=\"form.controls.passwordConfirmation\"\n          label=\"Confirmar senha\"\n          placeholder=\"Confirmar senha\"\n          [required]=\"true\"\n          [errorMessage]=\"passwordConfirmationErrorMessage()\"\n          dataTest=\"create-password-confirmation\"\n        />\n\n        <af-form-error [show]=\"passwordsMismatch()\" message=\"As senhas precisam ser idênticas.\" />\n\n        <div class=\"mt-4\">\n          <af-checkbox-input [control]=\"form.controls.remember\" label=\"Lembrar de mim\" />\n        </div>\n\n        <div class=\"mt-8\">\n          <af-button\n            variant=\"primary\"\n            size=\"md\"\n            type=\"submit\"\n            [block]=\"true\"\n            [disabled]=\"form.invalid || passwordsMismatch()\"\n          >\n            Redefinir senha\n          </af-button>\n        </div>\n        <div class=\"mt-4 text-center\">\n          <p class=\"text-base text-neutral-800 dark:text-neutral-200\">\n            Opa, lembrei minha senha...\n            <a routerLink=\"/auth/login\" class=\"text-primary-500 underline\">Clique aqui</a>\n          </p>\n        </div>\n      </form>\n    </app-auth-page-wrapper>\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport default class CreatePasswordComponent {\n  private readonly fb = inject(FormBuilder);\n\n  readonly form: FormGroup<{\n    password: FormControl<string>;\n    passwordConfirmation: FormControl<string>;\n    remember: FormControl<boolean>;\n  }> = this.fb.group({\n    password: this.fb.control('', { nonNullable: true, validators: [Validators.required] }),\n    passwordConfirmation: this.fb.control('', {\n      nonNullable: true,\n      validators: [Validators.required],\n    }),\n    remember: this.fb.control(false, { nonNullable: true }),\n  });\n\n  readonly passwordsMismatch = computed(() => {\n    const password = this.form.controls.password.value;\n    const confirmation = this.form.controls.passwordConfirmation.value;\n    return Boolean(password && confirmation && password !== confirmation);\n  });\n\n  readonly passwordConfirmationErrorMessage = computed(() => {\n    const errors = this.form.controls.passwordConfirmation.errors;\n\n    if (errors?.['required']) {\n      return 'Confirmação de senha é obrigatória.';\n    }\n\n    return 'Campo inválido.';\n  });\n\n  submit(): void {\n    if (this.form.invalid || this.passwordsMismatch()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/auth/login/login.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pag