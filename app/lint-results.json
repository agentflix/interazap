 AutopilotService } from '@core/services/autopilot.service';\n\n@Component({\n  selector: 'app-playbook-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    AfTextInputComponent,\n    AfTextareaInputComponent,\n    AfSelectInputComponent,\n    AfSwitchInputComponent,\n  ],\n  templateUrl: './playbook-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class PlaybookFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly autopilotService = inject(AutopilotService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  readonly playbook = input<AutopilotPlaybook | null>(null);\n  readonly saved = output<AutopilotPlaybook>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n\n  readonly triggerOptions: AfSelectOption[] = [\n    { label: 'Manual (API)', value: 'MANUAL' },\n    { label: 'Mensagem Recebida', value: 'INBOUND_MESSAGE' },\n    { label: 'Ticket Criado', value: 'TICKET_CREATED' },\n    { label: 'Ticket Ocioso', value: 'TICKET_IDLE' },\n    { label: 'Etapa Alterada', value: 'NEGOTIATION_STAGE_CHANGED' },\n    { label: 'Negociação Ganha', value: 'NEGOTIATION_WON' },\n    { label: 'Negociação Perdida', value: 'NEGOTIATION_LOST' },\n    { label: 'Contato Criado', value: 'CONTACT_CREATED' },\n    { label: 'Atendimento Humano Encerrado', value: 'HUMAN_TAKEOVER_ENDED' },\n    { label: 'Agendado', value: 'SCHEDULED' },\n    { label: 'Tag Adicionada', value: 'TAG_ADDED' },\n    { label: 'Lead Score Atingido', value: 'LEAD_SCORE_THRESHOLD' },\n    { label: 'Sem Resposta', value: 'NO_RESPONSE_TIMEOUT' },\n  ];\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    description: this.fb.control(''),\n    trigger_type: this.fb.control('INBOUND_MESSAGE', Validators.required),\n    trigger_conditions: this.fb.control(''),\n    trigger_cooldown_seconds: this.fb.control(60, [Validators.min(1)]),\n    is_active: this.fb.control(false),\n  });\n\n  constructor() {\n    effect(() => {\n      const playbook = this.playbook();\n      if (playbook) {\n        if (this.lastLoadedId() === String(playbook.id)) {\n          return;\n        }\n        this.lastLoadedId.set(String(playbook.id));\n\n        const metadata = (playbook.metadata ?? {}) as Record<string, unknown>;\n        const triggerConditions = metadata['trigger_conditions'];\n        const triggerCooldownSeconds = Number(metadata['trigger_cooldown_seconds'] ?? 60);\n\n        this.form.reset({\n          name: playbook.name,\n          description: playbook.description ?? '',\n          trigger_type: playbook.trigger_type ?? 'INBOUND_MESSAGE',\n          trigger_conditions:\n            triggerConditions && typeof triggerConditions === 'object'\n              ? JSON.stringify(triggerConditions, null, 2)\n              : '',\n          trigger_cooldown_seconds:\n            Number.isFinite(triggerCooldownSeconds) && triggerCooldownSeconds > 0\n              ? triggerCooldownSeconds\n              : 60,\n          is_active: playbook.is_active,\n        });\n      } else {\n        this.lastLoadedId.set(null);\n        this.resetForm();\n      }\n    });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n    const triggerConditionsText = (formValue.trigger_conditions ?? '').trim();\n\n    let parsedTriggerConditions: Record<string, unknown> | undefined;\n    if (triggerConditionsText) {\n      try {\n        const parsed = JSON.parse(triggerConditionsText) as Record<string, unknown>;\n        if (typeof parsed !== 'object' || Array.isArray(parsed) || parsed === null) {\n          toast.error('Trigger conditions deve ser um objeto JSON válido.');\n          return;\n        }\n        parsedTriggerConditions = parsed;\n      } catch {\n        toast.error('Trigger conditions contém JSON inválido.');\n        return;\n      }\n    }\n\n    const editing = this.playbook();\n    const baseMetadata = ((editing?.metadata ?? {}) as Record<string, unknown>) ?? {};\n    const metadata: Record<string, unknown> = { ...baseMetadata };\n\n    if (parsedTriggerConditions && Object.keys(parsedTriggerConditions).length > 0) {\n      metadata['trigger_conditions'] = parsedTriggerConditions;\n    } else {\n      delete metadata['trigger_conditions'];\n    }\n\n    const cooldown = Number(formValue.trigger_cooldown_seconds ?? 60);\n    metadata['trigger_cooldown_seconds'] =\n      Number.isFinite(cooldown) && cooldown > 0 ? cooldown : 60;\n\n    const payload = {\n      name: formValue.name || '',\n      description: formValue.description || undefined,\n      trigger_type: formValue.trigger_type || 'INBOUND_MESSAGE',\n      metadata,\n      is_active: formValue.is_active ?? false,\n    };\n\n    this.isSaving.set(true);\n\n    const request = editing\n      ? this.autopilotService.updatePlaybook(editing.id, payload)\n      : this.autopilotService.createPlaybook(payload);\n\n    request.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({\n      next: (response) => {\n        this.isSaving.set(false);\n        this.saved.emit(response);\n      },\n      error: (error) => {\n        this.isSaving.set(false);\n        toast.error(error.error?.message || 'Erro ao salvar playbook.');\n      },\n    });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      description: '',\n      trigger_type: 'INBOUND_MESSAGE',\n      trigger_conditions: '',\n      trigger_cooldown_seconds: 60,\n      is_active: false,\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/editor/playbook-editor.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0