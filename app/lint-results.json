e":237,"column":29,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":237,"endColumn":45,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[6962,6979],"text":"(run.completed_at == null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[6963,6979],"text":"(run.completed_at ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[6962,6979],"text":"(!Boolean(run.completed_at))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { CommonModule } from '@angular/common';\nimport type { TemplateRef } from '@angular/core';\nimport {\n  CUSTOM_ELEMENTS_SCHEMA,\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { type Observable, map, of, throwError } from 'rxjs';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n  CrudPageLikeRef,\n} from '../autopilot-crud.types';\nimport {\n  type AutopilotRun,\n  type AutopilotAction,\n  AutopilotService,\n} from '@core/services/autopilot.service';\n\n/**\n * Componente para visualização do histórico de execuções do IA Autopilot.\n *\n * Permite acompanhar o status, duração e detalhes das ações tomadas pela IA\n * em diferentes roteiros (playbooks).\n *\n * @class History\n * @extends {BaseListPage<AutopilotRun>}\n * @description Central de rastreamento e auditoria de execuções da IA.\n */\n@Component({\n  selector: 'app-history',\n  standalone: true,\n  imports: [CommonModule, ReactiveFormsModule],\n  templateUrl: './history.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  schemas: [CUSTOM_ELEMENTS_SCHEMA],\n})\nexport class History {\n  private readonly autopilotService = inject(AutopilotService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly crudPage = viewChild<CrudPageLikeRef<AutopilotRun>>('crudPage');\n  readonly idCell = viewChild<TemplateRef<{ $implicit: AutopilotRun }>>('idCell');\n  readonly playbookCell = viewChild<TemplateRef<{ $implicit: AutopilotRun }>>('playbookCell');\n  readonly startedAtCell = viewChild<TemplateRef<{ $implicit: AutopilotRun }>>('startedAtCell');\n  readonly durationCell = viewChild<TemplateRef<{ $implicit: AutopilotRun }>>('durationCell');\n  readonly statusCell = viewChild<TemplateRef<{ $implicit: AutopilotRun }>>('statusCell');\n\n  readonly crudService: CrudService<AutopilotRun> = {\n    list: (params) =>\n      this.autopilotService\n        .listRuns({ page: params.page, per_page: params.per_page })\n        .pipe(map((response) => ({ data: response.data, meta: response.meta }))) as Observable<\n        CrudPaginatedResponse<AutopilotRun>\n      >,\n    find: (id: string) =>\n      this.autopilotService\n        .getRun(id)\n        .pipe(map((response) => ({ data: response.data }))) as Observable<\n        CrudItemResponse<AutopilotRun>\n      >,\n    create: () => throwError(() => new Error('Not supported')),\n    update: () => throwError(() => new Error('Not supported')),\n    delete: () => of(undefined),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    { field: 'id', label: 'ID', template: this.idCell() ?? undefined },\n    {\n      field: 'playbook_version',\n      label: 'Playbook',\n      template: this.playbookCell() ?? undefined,\n    },\n    {\n      field: 'started_at',\n      label: 'Início',\n      template: this.startedAtCell() ?? undefined,\n    },\n    {\n      field: 'duration',\n      label: 'Duração',\n      template: this.durationCell() ?? undefined,\n    },\n    {\n      field: 'status',\n      label: 'Status',\n      template: this.statusCell() ?? undefined,\n    },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'details',\n      icon: 'lucideEye',\n      label: 'Ver Detalhes',\n      variant: 'ghost',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Execução',\n      plural: 'Histórico',\n    },\n    subtitle: 'Autopilot',\n    searchPlaceholder: 'Buscar histórico...',\n    emptyState: {\n      icon: 'lucideHistory',\n      title: 'Nenhum registro encontrado',\n      description: 'As execuções de playbooks aparecerão aqui.',\n    },\n    enableSelection: false,\n    enableSearch: true,\n    enableFilters: false,\n    enableBulkDelete: false,\n  };\n\n  /**\n   * Armazena os dados da execução selecionada para visualização detalhada.\n   * @type {WritableSignal<AutopilotRun | null>}\n   */\n  selectedRun = signal<AutopilotRun | null>(null);\n\n  /**\n   * Lista de ações individuais executadas durante a corrida selecionada.\n   * @type {WritableSignal<AutopilotAction[]>}\n   */\n  selectedRunActions = signal<AutopilotAction[]>([]);\n\n  /**\n   * Controla a visibilidade do painel de detalhes da execução.\n   * @type {WritableSignal<boolean>}\n   */\n  isDetailOpen = signal(false);\n  readonly isCancelConfirmOpen = signal(false);\n  readonly runToCancel = signal<AutopilotRun | null>(null);\n\n  handleCustomAction(event: { action: string; item: AutopilotRun }): void {\n    if (event.action === 'details') {\n      this.viewDetails(event.item);\n    }\n  }\n\n  /**\n   * Abre o painel de detalhes e carrega as ações completas de uma execução.\n   * @param run Objeto da execução selecionada.\n   */\n  viewDetails(run: AutopilotRun): void {\n    this.selectedRun.set(run);\n    this.isDetailOpen.set(true);\n\n    // Fetch full details including actions\n    this.autopilotService\n      .getRun(run.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (res) => {\n          this.selectedRun.set(res.data);\n          this.selectedRunActions.set(res.data.actions || []);\n        },\n        error: () => this.showError('Erro ao carregar detalhes.'),\n      });\n  }\n\n  /**\n   * Fecha o painel de detalhes e limpa o estado da execução selecionada.\n   */\n  closeDetails(): void {\n    this.isDetailOpen.set(false);\n    this.selectedRun.set(null);\n    this.selectedRunActions.set([]);\n  }\n\n  /**\n   * Solicita o cancelamento/interrupção de uma execução em curso.\n   * @param run A execução a ser cancelada.\n   */\n  cancelRun(run: AutopilotRun): void {\n    if (run.status !== 'RUNNING' && run.status !== 'PAUSED') return;\n\n    this.runToCancel.set(run);\n    this.isCancelConfirmOpen.set(true);\n  }\n\n  confirmCancel(): void {\n    const run = this.runToCancel();\n    if (!run) {\n      return;\n    }\n\n    this.autopilotService\n      .cancelRun(run.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isCancelConfirmOpen.set(false);\n          this.runToCancel.set(null);\n          this.showSuccess('Execução cancelada/interrompida.');\n          this.crudPage()?.reloadList();\n        },\n        error: () => this.showError('Erro ao cancelar execução.'),\n      });\n  }\n\n  cancelConfirmModal(): void {\n    this.isCancelConfirmOpen.set(false);\n    this.runToCancel.set(null);\n  }\n\n  /**\n   * Formata uma string de data ISO para o padrão local do navegador.\n   * @param date String de data ISO.\n   * @returns {string} Data formatada.\n   */\n  formatDate(date: string | undefined): string {\n    if (!date) return '-';\n    return new Date(date).toLocaleString();\n  }\n\n  /**\n   * Calcula a duração total da execução em segundos.\n   * @param run Objeto da execução.\n   * @returns {string} Duração formatada (ex: \"10s\").\n   */\n  calculateDuration(run: AutopilotRun): string {\n    if (!run.started_at || !run.completed_at) return '-';\n    const start = new Date(run.started_at).getTime();\n    const end = new Date(run.completed_at).getTime();\n    const diffMs = end - start;\n    const diffSec = Math.round(diffMs / 1000);\n    return `${diffSec}s`;\n  }\n\n  private showError(message: string): void {\n    this.crudPage()?.showError?.(message);\n  }\n\n  private showSuccess(message: string): void {\n    this.crudPage()?.showSuccess?.(message);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/components/playbook-form/playbook-form.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/components/playbook-form/playbook-form.spec.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/autopilot.service' import is duplicated.","line":12,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":12,"endColumn":76},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (117). Maximum allowed is 80.","line":37,"column":35,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":153,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { type ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\nimport { importProvidersFrom } from '@angular/core';\nimport { LucideAngularModule, icons } from 'lucide-angular';\nimport { of, throwError, type Observable } from 'rxjs';\nimport { PlaybookFormComponent } from './playbook-form';\nimport type {\n  AutopilotPlaybook,\n  AutopilotPlaybookPayload,\n} from 'src/app/core/services/autopilot.service';\nimport { AutopilotService } from 'src/app/core/services/autopilot.service';\n\nclass MockAutopilotService {\n  private _makePlaybook(id: string, payload: AutopilotPlaybookPayload): AutopilotPlaybook {\n    return {\n      id,\n      name: payload.name,\n      description: payload.description ?? null,\n      trigger_type: payload.trigger_type ?? 'INBOUND_MESSAGE',\n      version: payload.version ?? 1,\n      steps: payload.steps ?? null,\n      metadata: payload.metadata ?? null,\n      is_active: payload.is_active ?? true,\n    };\n  }\n\n  createPlaybook(payload: AutopilotPlaybookPayload): Observable<AutopilotPlaybook> {\n    return of(this._makePlaybook('1', payload));\n  }\n\n  updatePlaybook(id: string, payload: AutopilotPlaybookPayload): Observable<AutopilotPlaybook> {\n    return of(this._makePlaybook(id, payload));\n  }\n}\n\ndescribe('PlaybookFormComponent', () => {\n  let component: PlaybookFormComponent;\n  let fixture: ComponentFixture<PlaybookFormComponent>;\n  let autopilotService: AutopilotService;\n\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [PlaybookFormComponent],\n      providers: [\n        provideHttpClient(),\n        provideHttpClientTesting(),\n        importProvidersFrom(LucideAngularModule.pick(icons)),\n        { provide: AutopilotService, useClass: MockAutopilotService },\n      ],\n    }).compileComponents();\n\n    fixture = TestBed.createComponent(PlaybookFormComponent);\n    component = fixture.componentInstance;\n    autopilotService = TestBed.inject(AutopilotService);\n    fixture.detectChanges();\n  });\n\n  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n  it('should initialize empty form', () => {\n    expect(component.form.value.name).toBe('');\n    expect(component.form.value.trigger_type).toBe('INBOUND_MESSAGE');\n  });\n\n  it('should fill form when playbook input changes', () => {\n    const playbook: AutopilotPlaybook = {\n      id: '1',\n      name: 'Test Playbook',\n      trigger_type: 'MANUAL',\n      is_active: true,\n      version: 1,\n    };\n\n    fixture.componentRef.setInput('playbook', playbook);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('Test Playbook');\n    expect(component.form.value.trigger_type).toBe('MANUAL');\n    expect(component.form.value.is_active).toBe(true);\n  });\n\n  it('should reset form when playbook input is null', () => {\n    const playbook: AutopilotPlaybook = {\n      id: '1',\n      name: 'Test Playbook',\n      version: 1,\n      is_active: true,\n    };\n    fixture.componentRef.setInput('playbook', playbook);\n    fixture.detectChanges();\n\n    fixture.componentRef.setInput('playbook', null);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('');\n  });\n\n  it('should submit creation', () => {\n    const createSpy = vi.spyOn(autopilotService, 'createPlaybook');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n\n    component.form.patchValue({ name: 'New Playbook' });\n    component.submit();\n\n    expect(createSpy).toHaveBeenCalledWith(expect.objectContaining({ name: 'New Playbook' }));\n    expect(savedSpy).toHaveBeenCalled();\n  });\n\n  it('should submit update', () => {\n    const updateSpy = vi.spyOn(autopilotService, 'updatePlaybook');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n    const playbook: AutopilotPlaybook = {\n      id: '123',\n      name: 'Old Name',\n      version: 1,\n      is_active: true,\n    };\n\n    fixture.componentRef.setInput('playbook', playbook);\n    fixture.detectChanges();\n\n    component.form.patchValue({ name: 'Updated Name' });\n    component.submit();\n\n    expect(updateSpy).toHaveBeenCalledWith(\n      '123',\n      expect.objectContaining({ name: 'Updated Name' }),\n    );\n    expect(savedSpy).toHaveBeenCalled();\n  });\n\n  it('should handle submit error', () => {\n    vi.spyOn(autopilotService, 'createPlaybook').mockReturnValue(\n      throwError(() => ({ error: { message: 'Fail' } })),\n    );\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n\n    component.form.patchValue({ name: 'Fail' });\n    component.submit();\n\n    expect(savedSpy).not.toHaveBeenCalled();\n    expect(component.isSaving()).toBe(false);\n  });\n\n  it('should cancel', () => {\n    const cancelledSpy = vi.spyOn(component.cancelled, 'emit');\n    component.cancel();\n    expect(cancelledSpy).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/playbooks/components/playbook-form/playbook-form.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":44,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":44,"endColumn":35},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 11. Maximum allowed is 10.","line":74,"column":15,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":74,"endColumn":17},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":91,"column":13,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":91,"endColumn":30,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[3230,3247],"text":"(Boolean(triggerConditions))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ru