lumn":18,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[29061,29070],"text":"calledId == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[29062,29070],"text":"(calledId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[29061,29070],"text":"!Boolean(calledId)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"complexity","severity":1,"message":"Method 'next' has a complexity of 14. Maximum allowed is 10.","line":1046,"column":7,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":1046,"endColumn":13},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected object value in conditional. The condition is always true.","line":1071,"column":19,"nodeType":"Identifier","messageId":"conditionErrorObject","endLine":1071,"endColumn":32},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":1191,"column":11,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":1191,"endColumn":35,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[34286,34310],"text":"this.quickAnswerDebounce != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[34286,34310],"text":"this.quickAnswerDebounce ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[34286,34310],"text":"Boolean(this.quickAnswerDebounce)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":1204,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":1204,"endColumn":33,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[34653,34677],"text":"this.quickAnswerDebounce != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[34653,34677],"text":"this.quickAnswerDebounce ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[34653,34677],"text":"Boolean(this.quickAnswerDebounce)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable number value in conditional. Please handle the nullish/zero/NaN cases explicitly.","line":1235,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableNumber","endLine":1235,"endColumn":33,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[35512,35536],"text":"this.quickAnswerDebounce != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultZero","fix":{"range":[35512,35536],"text":"this.quickAnswerDebounce ?? 0"},"desc":"Explicitly treat nullish value the same as 0 (`value ?? 0`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[35512,35536],"text":"Boolean(this.quickAnswerDebounce)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/consistent-type-imports","severity":2,"message":"`import()` type annotations are forbidden.","line":1274,"column":39,"nodeType":"TSImportType","messageId":"noImportTypeAnnotations","endLine":1274,"endColumn":91},{"ruleId":"max-lines-per-function","severity":1,"message":"Method 'uploadFile' has too many lines (98). Maximum allowed is 80.","line":1300,"column":3,"nodeType":"MethodDefinition","messageId":"exceed","endLine":1397,"endColumn":4},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":1302,"column":10,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":1302,"endColumn":18,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[37422,37431],"text":"calledId == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[37423,37431],"text":"(calledId ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[37422,37431],"text":"!Boolean(calledId)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"complexity","severity":1,"message":"Method 'next' has a complexity of 11. Maximum allowed is 10.","line":1340,"column":7,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":1340,"endColumn":13},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected object value in conditional. The condition is always true.","line":1369,"column":19,"nodeType":"Identifier","messageId":"conditionErrorObject","endLine":1369,"endColumn":32}],"suppressedMessages":[],"errorCount":29,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef, OnDestroy, OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  HostListener,\n  ViewChild,\n  computed,\n  inject,\n  signal,\n  effect,\n} from '@angular/core';\nimport { ActivatedRoute } from '@angular/router';\nimport { FormControl } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { NgIcon, provideIcons } from '@ng-icons/core';\nimport {\n  lucideBot,\n  lucideChevronsLeft,\n  lucideImage,\n  lucideMessagesSquare,\n  lucideMic,\n  lucidePanelRightOpen,\n  lucideLogOut,\n  lucidePlus,\n  lucideScrollText,\n  lucideSearch,\n  lucideSend,\n  lucideSettings,\n  lucideCalendar,\n  lucideHandshake,\n  lucideSquareUser,\n  lucideUser,\n  lucideVideo,\n  lucideRefreshCw,\n  lucideVolume2,\n  lucideVolumeX,\n  lucideTrash,\n  lucidePause,\n  lucidePlay,\n  lucideMic2,\n  lucideUsers,\n  lucidePaperclip,\n  lucideFile,\n  lucideMapPin,\n  lucideLayoutTemplate,\n  lucideX,\n  lucideReply,\n} from '@ng-icons/lucide';\nimport { ChatSidebar } from './components/chat-sidebar/chat-sidebar';\nimport { UserChat } from './components/user-chat/user-chat';\nimport { ChatNavbar } from './components/chat-navbar/chat-navbar';\nimport { ChatSidebarActions } from './components/chat-sidebar-actions/chat-sidebar-actions';\nimport { ContactSectionComponent } from './chat-sidebar/contact-section/contact-section';\nimport { CRMSectionComponent } from './chat-sidebar/crm-section/crm-section';\nimport { ChatContactPicker } from './components/chat-contact-picker/chat-contact-picker';\nimport { ChatLocationPicker } from './components/chat-location-picker/chat-location-picker';\nimport { MediaPreviewComponent } from './components/media-preview/media-preview';\nimport { AppShellService } from 'src/app/core/services/app-shell.service';\nimport {\n  type CalledMessage,\n  CalledMessageService,\n} from 'src/app/core/services/called-message.service';\nimport { type Called, CalledService } from 'src/app/core/services/called.service';\nimport { ChatRefreshService } from 'src/app/core/services/chat-refresh.service';\nimport type { Contact } from 'src/app/core/models/contact.model';\nimport { ChatPresenceService } from 'src/app/core/services/chat-presence.service';\nimport { ChatMediaBatchService } from 'src/app/core/services/chat-media-batch.service';\nimport { ChatRealtimeService } from 'src/app/core/services/chat-realtime.service';\nimport { toast } from 'ngx-sonner';\nimport { type Subscription, startWith } from 'rxjs';\nimport type { MediaPreviewItem, MediaPreviewType } from './types/media-preview.types';\nimport { ChatQuickAnswerService } from './services/chat-quick-answer.service';\nimport type { ChatQuickAnswer } from './types/chat-quick-answer.types';\nimport { ChatRecorderService } from './services/chat-recorder.service';\nimport { ButtonComponent, IconButtonComponent } from 'src/app/shared/components/buttons';\nimport { TextInputComponent } from 'src/app/shared/components/text-input/text-input';\n\n/**\n * Componente principal da interface de Chat (Atendimento).\n *\n * Atua como um Smart Component que orquestra a exibição de conversas,\n * gerenciamento de estado de mensagens, gravação de áudio e integração com o backend.\n *\n * @class Chat\n * @description Gerenciador central de atendimento por chat.\n */\n@Component({\n  selector: 'app-chat',\n  standalone: true,\n  imports: [\n    NgIcon,\n    ButtonComponent,\n    IconButtonComponent,\n    TextInputComponent,\n    ChatSidebar,\n    UserChat,\n    ChatNavbar,\n    ChatSidebarActions,\n    ContactSectionComponent,\n    CRMSectionComponent,\n    ChatContactPicker,\n    ChatLocationPicker,\n    MediaPreviewComponent,\n  ],\n  templateUrl: './chat.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  viewProviders: [\n    provideIcons({\n      lucideBot,\n      lucideChevronsLeft,\n      lucideImage,\n      lucideMessagesSquare,\n      lucideMic,\n      lucidePanelRightOpen,\n      lucideLogOut,\n      lucidePlus,\n      lucideScrollText,\n      lucideRefreshCw,\n      lucideSearch,\n      lucideSend,\n      lucideSettings,\n      lucideCalendar,\n      lucideHandshake,\n      lucideSquareUser,\n      lucideUser,\n      lucideVideo,\n      lucideVolume2,\n      lucideVolumeX,\n      lucideTrash,\n      lucidePause,\n      lucidePlay,\n      lucideMic2,\n      lucideUsers,\n      lucidePaperclip,\n      lucideFile,\n      lucideMapPin,\n      lucideLayoutTemplate,\n      lucideX,\n      lucideReply,\n    }),\n  ],\n})\nexport class Chat implements OnDestroy, OnInit {\n  private readonly appShell = inject(AppShellService);\n  private readonly messageService = inject(CalledMessageService);\n  private readonly calledService = inject(CalledService);\n  private readonly chatRefresh = inject(ChatRefreshService);\n  private readonly route = inject(ActivatedRoute);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly presenceService = inject(ChatPresenceService);\n  private readonly mediaBatch = inject(ChatMediaBatchService);\n  private readonly recorder = inject(ChatRecorderService);\n  private readonly realtime = inject(ChatRealtimeService);\n\n  /**\n   * Identificador do timeout para o indicador de digitação.\n   * @private\n   */\n  private typingTimeout: ReturnType<typeof setTimeout> | null = null;\n\n  private mediaBatchSub?: Subscription;\n\n  /**\n   * Timestamp do último sinal de digitação enviado.\n   * @private\n   */\n  private lastTypingSent = 0;\n\n  /**\n   * Referência ao componente de visualização de mensagens.\n   * @private\n   */\n  @ViewChild(UserChat) private readonly userChat?: UserChat;\n\n  /**\n   * Referência ao input de mensagem para foco ao responder.\n   * @private\n   */\n  @ViewChild('messageInputEl')\n  private readonly messageInputEl?: ElementRef<HTMLElement>;\n\n  /**\n   * Conteúdo atual do campo de entrada de mensagem.\n   * @type {WritableSignal<string>}\n   */\n  readonly messageInput = signal('');\n  readonly messageInputControl = new FormControl('', { nonNullable: true });\n\n  /**\n   * Mensagem sendo respondida (Quote).\n   * @type {WritableSignal<CalledMessage | null>}\n   */\n  readonly replyingTo = signal<CalledMessage | null>(null);\n\n  /**\n   * Iniciar o processo de resposta a uma mensagem.\n   * @param message Mensagem a ser respondida.\n   */\n  startReply(message: CalledMessage): void {\n    this.replyingTo.set(message);\n    queueMicrotask(() => {\n      this.focusMessageInput();\n    });\n  }\n\n  /**\n   * Cancelar o processo de resposta.\n   */\n  cancelReply(): void {\n    this.replyingTo.set(null);\n  }\n\n  /**\n   * Estado de envio de mensagem (previne múltiplos disparos).\n   * @type {WritableSignal<boolean>}\n   */\n  readonly isSending = signal(false);\n\n  /**\n   * Batch media sending state.\n   */\n  readonly isMediaBatchSending = signal(false);\n\n  /**\n   * Preview media items.\n   */\n  readonly mediaPreviewItems = signal<MediaPreviewItem[]>([]);\n\n  /**\n   * Selected item in the gallery.\n   */\n  readonly selectedMediaId = signal<string | null>(null);\n\n  /**\n   * Preview overlay open state.\n   */\n  readonly mediaPreviewOpen = computed(() => this.mediaPreviewItems().length > 0);\n\n  /**\n   * Aggregate upload progress (0-1).\n   */\n  readonly mediaPreviewProgress = computed(() => {\n    const items = this.mediaPreviewItems();\n    const total = items.reduce((sum, item) => sum + (item.progress.total || 0), 0);\n    if (total === 0) return 0;\n    const loaded = items.reduce((sum, item) => sum + (item.progress.loaded || 0), 0);\n    return Math.min(1, loaded / total);\n  });\n\n  /**\n   * Identificador do atendimento selecionado.\n   * @type {WritableSignal<string | null>}\n   */\n  readonly selectedCalledId = signal<string | null>(null);\n\n  /**\n   * Dados do atendimento selecionado no momento.\n   * @type {WritableSignal<Called | null>}\n   */\n  readonly selectedCalled = signal<Called | null>(null);\n\n  /**\n   * Indica se os dados do atendimento estão sendo carregados.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly isLoadingCalled = signal(false);\n\n  /**\n   * Verifica se existe um atendimento selecionado.\n   * @type {Signal<boolean>}\n   */\n  readonly hasSelection = computed(() => Boolean(this.selectedCalledId()));\n\n  /**\n   * Verifica se o usuário pode enviar mensagens no atendimento atual.\n   * @type {Signal<boolean>}\n   */\n  readonly canSendMessage = computed(() => this.selectedCalled()?.status === 'in_progress');\n\n  /**\n   * Contato associado ao atendimento selecionado.\n   * @type {Signal<Contact | null>}\n   */\n  readonly selectedContact = computed(() => this.selectedCalled()?.contact ?? null);\n\n  /**\n   * ID do contato selecionado como string.\n   * @type {Signal<string>}\n   */\n  readonly selectedContactId = computed(() => {\n    const contactId = this.selectedContact()?.id;\n    return contactId !== undefined ? String(contactId) : '';\n  });\n\n  /**\n   * Aba ativa na visualização lateral (detalhes do contato, negociação, etc).\n   * @type {WritableSignal<'chat' | 'contact' | 'negotiation' | 'agenda'>}\n   */\n  readonly activeTab = signal<'chat' | 'contact' | 'negotiation' | 'agenda'>('chat');\n\n  /**\n   * Inicializa o componente, esconde rodapés e processa parâmetros de rota.\n   * Configura effects para eventos realtime.\n   */\n  constructor() {\n    this.appShell.hideFooter();\n    this.appShell.disableContentScroll();\n\n    this.route.paramMap.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((params) => {\n      const calledId = params.get('calledId');\n      this.selectedCalledId.set(calledId);\n      if (!calledId) {\n        this.selectedCalled.set(null);\n        return;\n      }\n      this.fetchCalled(calledId);\n    });\n\n    // Effect para atualização de contato via WebSocket\n    effect(() => {\n      const { event, version } = this.realtime.contactUpdated();\n      if (event && version > 0) {\n        const current = this.selectedCalled();\n        if (!current?.contact) return;\n        if (String(current.contact.id) !== String(event.contact_id)) return;\n\n        const updated = {\n          ...current.contact,\n          ...(event.data as Partial<Contact>),\n          id: current.contact.id,\n        };\n\n        this.selectedCalled.set({ ...current, contact: updated });\n      }\n    });\n\n    // Effect para atualização de deal via WebSocket\n    effect(() => {\n      const { version } = this.realtime.dealUpdated();\n      if (version > 0) {\n        if (this.activeTab() === 'negotiation') {\n          this.chatRefresh.request();\n        }\n      }\n    });\n  }\n\n  /**\n   * Carrega recursos iniciais do chat.\n   */\n  ngOnInit(): void {\n    this.loadQuickAnswers();\n    this.messageInputControl.valueChanges\n      .pipe(startWith(this.messageInputControl.value), takeUntilDestroyed(this.destroyRef))\n      .subscribe((value) => this.onMessageInput(value));\n    this.recorder.recordingCompleted$\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((audio) => {\n        if (this.sendAfterStop) {\n          this.sendRecordedAudio(audio.blob);\n        }\n      });\n  }\n\n  /**\n   * Limpeza de estados e reativação de scroll ao destruir o componente.\n   */\n  ngOnDestroy(): void {\n    this.appShell.showFooter();\n    this.appShell.enableContentScroll();\n    this.clearTypingTimeout();\n    this.mediaBatchSub?.unsubscribe();\n  }\n\n  /**\n   * Indica se o menu de anexos está aberto.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly isAttachmentMenuOpen = signal(false);\n\n  /**\n   * Alternar visibilidade do menu de anexos.\n   */\n  toggleAttachmentMenu(): void {\n    this.isAttachmentMenuOpen.update((v) => !v);\n  }\n\n  /**\n   * Acionar o input de upload de arquivo específico.\n   * @param type Tipo de arquivo ('media' ou 'document').\n   */\n  triggerFileUploadByType(type: 'media' | 'document'): void {\n    this.isAttachmentMenuOpen.set(false);\n\n    if (this.fileInput?.nativeElement) {\n      if (type === 'document') {\n        this.fileInput.nativeElement.accept = '*/*';\n      } else {\n        this.fileInput.nativeElement.accept = 'image/*,video/*,audio/*';\n      }\n      this.fileInput.nativeElement.click();\n    }\n  }\n\n  /**\n   * Indica se o picker de contatos está aberto.\n   */\n  readonly isContactPickerOpen = signal(false);\n\n  /**\n   * Abrir modal de envio de contato.\n   */\n  openContactPicker(): void {\n    this.isAttachmentMenuOpen.set(false);\n    this.isContactPickerOpen.set(true);\n  }\n\n  /**\n   * Contato selecionado para envio.\n   */\n  onContactSelected(contact: Contact): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n\n    this.isContactPickerOpen.set(false);\n\n    this.messageService\n      .sendContact(calledId, {\n        fullName: contact.name,\n        phoneNumber: contact.phone || '',\n        email: contact.email,\n        organization: contact.company?.name,\n      })\n      .subscribe({\n        next: (res) => {\n          this.userChat?.appendMessage(res.data);\n          this.userChat?.scrollToBottomForce();\n          toast.success('Contato enviado');\n        },\n        error: () => toast.error('Erro ao enviar contato'),\n      });\n  }\n\n  /**\n   * Indica se o picker de localização está aberto.\n   */\n  readonly isLocationPickerOpen = signal(false);\n\n  /**\n   * Abrir modal de envio de localização.\n   */\n  openLocationPicker(): void {\n    this.isAttachmentMenuOpen.set(false);\n    this.isLocationPickerOpen.set(true);\n  }\n\n  /**\n   * Localização selecionada para envio.\n   */\n  onLocationSelected(loc: { latitude: number; longitude: number; address?: string }): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n\n    this.isLocationPickerOpen.set(false);\n\n    this.messageService\n      .sendLocation(calledId, {\n        latitude: loc.latitude,\n        longitude: loc.longitude,\n        name: loc.address,\n        address: loc.address,\n      })\n      .subscribe({\n        next: (res) => {\n          this.userChat?.appendMessage(res.data);\n          this.userChat?.scrollToBottomForce();\n          toast.success('Localização enviada');\n        },\n        error: () => toast.error('Erro ao enviar localização'),\n      });\n  }\n\n  /**\n   * Abrir modal de envio de template.\n   */\n  openTemplatePicker(): void {\n    this.isAttachmentMenuOpen.set(false);\n    toast.info('Funcionalidade de template em desenvolvimento');\n  }\n\n  /**\n   * Fecha o menu de anexos ao clicar fora.\n   */\n  closeAttachmentMenu(): void {\n    this.isAttachmentMenuOpen.set(false);\n  }\n\n  @HostListener('document:dragover', ['$event'])\n  onDragOver(event: DragEvent): void {\n    if (!event.dataTransfer) return;\n    if (Array.from(event.dataTransfer.types).includes('Files')) {\n      event.preventDefault();\n    }\n  }\n\n  @HostListener('document:drop', ['$event'])\n  onDrop(event: DragEvent): void {\n    if (!this.canSendMessage()) return;\n    const files = event.dataTransfer?.files;\n    if (!files || files.length === 0) return;\n    event.preventDefault();\n    this.addMediaPreviewFiles(files);\n  }\n\n  @HostListener('document:paste', ['$event'])\n  onPaste(event: ClipboardEvent): void {\n    if (!this.canSendMessage()) return;\n    const files = event.clipboardData?.files;\n    if (!files || files.length === 0) return;\n    event.preventDefault();\n    this.addMediaPreviewFiles(files);\n  }\n\n  private isSupportedFile(file: File): boolean {\n    if (file.type.startsWith('image/')) return true;\n    if (file.type.startsWith('video/')) return true;\n    if (file.type.startsWith('audio/')) return true;\n    if (file.type === 'application/pdf') return true;\n    if (file.type === '') {\n      const name = file.name.toLowerCase();\n      return name.endsWith('.pdf') || name.endsWith('.doc') || name.endsWith('.docx');\n    }\n    return false;\n  }\n\n  private resolveMediaType(file: File): MediaPreviewType {\n    if (file.type.startsWith('image/')) {\n      if (file.type === 'image/webp') return 'sticker';\n      return 'image';\n    }\n    if (file.type.startsWith('video/')) {\n      return 'video';\n    }\n    if (file.type.startsWith('audio/')) {\n      if (file.type.includes('ogg')) return 'ptt';\n      return 'audio';\n    }\n    return 'document';\n  }\n\n  private createPreviewUrl(file: File): string | null {\n    if (\n      file.type.startsWith('image/') ||\n      file.type.startsWith('video/') ||\n      file.type.startsWith('audio/')\n    ) {\n      return URL.createObjectURL(file);\n    }\n    return null;\n  }\n\n  addMediaPreviewFiles(files: FileList | File[]): void {\n    const incoming = Array.from(files)\n      .filter((file) => this.isSupportedFile(file))\n      .map((file) => {\n        const id = `media-${Date.now()}-${Math.random().toString(36).slice(2)}`;\n        return {\n          id,\n          file,\n          type: this.resolveMediaType(file),\n          caption: '',\n          previewUrl: this.createPreviewUrl(file),\n          status: 'pending' as const,\n          progress: {\n            loaded: 0,\n            total: file.size ?? 0,\n          },\n        } satisfies MediaPreviewItem;\n      });\n\n    if (incoming.length === 0) {\n      toast.error('Nenhum arquivo compatível para envio.');\n      return;\n    }\n\n    this.mediaPreviewItems.update((items) => [...items, ...incoming]);\n    if (!this.selectedMediaId() && incoming.length > 0) {\n      this.selectedMediaId.set(incoming[0].id);\n    }\n  }\n\n  selectMediaPreviewItem(id: string): void {\n    this.selectedMediaId.set(id);\n  }\n\n  updateMediaPreviewCaption(event: { id: string; caption: string }): void {\n    this.mediaPreviewItems.update((items) =>\n      items.map((item) => (item.id === event.id ? { ...item, caption: event.caption } : item)),\n    );\n  }\n\n  removeMediaPreviewItem(id: string): void {\n    const target = this.mediaPreviewItems().find((item) => item.id === id);\n    if (target?.previewUrl) {\n      URL.revokeObjectURL(target.previewUrl);\n    }\n    this.mediaPreviewItems.update((items) => items.filter((item) => item.id !== id));\n    const remaining = this.mediaPreviewItems();\n    if (remaining.length === 0) {\n      this.selectedMediaId.set(null);\n      return;\n    }\n    if (!remaining.some((item) => item.id === this.selectedMediaId())) {\n      this.selectedMediaId.set(remaining[0].id);\n    }\n  }\n\n  closeMediaPreview(): void {\n    this.mediaBatchSub?.unsubscribe();\n    this.mediaBatchSub = undefined;\n    this.mediaPreviewItems().forEach((item) => {\n      if (item.previewUrl) URL.revokeObjectURL(item.previewUrl);\n    });\n    this.mediaPreviewItems.set([]);\n    this.selectedMediaId.set(null);\n    this.isMediaBatchSending.set(false);\n  }\n\n  sendMediaBatch(): void {\n    if (this.isMediaBatchSending()) return;\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n\n    const items = this.mediaPreviewItems();\n    if (items.length === 0) return;\n\n    this.isMediaBatchSending.set(true);\n\n    this.mediaPreviewItems.update((state) =>\n      state.map((item) => ({\n        ...item,\n        status: 'uploading' as const,\n        progress: {\n          loaded: 0,\n          total: item.file.size ?? 0,\n        },\n      })),\n    );\n\n    this.mediaBatchSub = this.mediaBatch\n      .dispatchBatch(calledId, items, 2)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((event) => {\n        if (event.phase === 'uploading') {\n          this.mediaPreviewItems.update((state) =>\n            state.map((item) =>\n              item.id === event.id\n                ? {\n                    ...item,\n                    status: 'uploading',\n                    progress: {\n                      loaded: event.loaded ?? item.progress.loaded,\n                      total: event.total ?? item.progress.total,\n                    },\n                  }\n                : item,\n            ),\n          );\n          return;\n        }\n\n        if (event.phase === 'sent' && event.message) {\n          this.mediaPreviewItems.update((state) =>\n            state.map((item) =>\n              item.id === event.id\n                ? {\n                    ...item,\n                    status: 'done',\n                    progress: {\n                      loaded: item.progress.total,\n                      total: item.progress.total,\n                    },\n                  }\n                : item,\n            ),\n          );\n          this.userChat?.appendMessage(event.message);\n          this.userChat?.scrollToBottomForce();\n        }\n\n        if (event.phase === 'failed') {\n          this.mediaPreviewItems.update((state) =>\n            state.map((item) =>\n              item.id === event.id ? { ...item, status: 'failed' as const } : item,\n            ),\n          );\n        }\n\n        if (this.mediaPreviewItems().every((item) => item.status === 'done')) {\n          this.closeMediaPreview();\n        }\n      });\n  }\n\n  /**\n   * Processar a entrada de texto do usuário no campo de mensagem.\n   * @param value O texto digitado pelo usuário.\n   */\n  onMessageInput(value: string): void {\n    this.messageInput.set(value);\n    this.sendTypingIndicator();\n    this.updateQuickAnswerQuery(value);\n  }\n\n  /**\n   * Processa atalhos do autocomplete no teclado.\n   */\n  onMessageKeydown(event: KeyboardEvent): void {\n    if (this.showQuickAnswerAutocomplete()) {\n      const items = this.filteredQuickAnswers();\n      if (items.length === 0) return;\n\n      if (event.key === 'ArrowDown') {\n        event.preventDefault();\n        this.activeQuickAnswerIndex.update((value) => Math.min(items.length - 1, value + 1));\n        return;\n      }\n\n      if (event.key === 'ArrowUp') {\n        event.preventDefault();\n        this.activeQuickAnswerIndex.update((value) => Math.max(0, value - 1));\n        return;\n      }\n\n      if (event.key === 'Enter') {\n        event.preventDefault();\n        const selected = items[this.activeQuickAnswerIndex()];\n        if (selected) this.selectQuickAnswer(selected);\n        return;\n      }\n\n      if (event.key === 'Escape') {\n        event.preventDefault();\n        this.resetQuickAnswerAutocomplete();\n        return;\n      }\n    }\n\n    if (event.key === 'Enter') {\n      event.preventDefault();\n      this.sendMessage();\n      return;\n    }\n\n    if (event.key === 'Escape') {\n      this.cancelReply();\n    }\n  }\n\n  private setMessageInputValue(value: string): void {\n    this.messageInput.set(value);\n    this.messageInputControl.setValue(value, { emitEvent: false });\n  }\n\n  private focusMessageInput(): void {\n    const host = this.messageInputEl?.nativeElement;\n    const input = host?.querySelector('input') as HTMLInputElement | null;\n    input?.focus();\n  }\n\n  /**\n   * Envia indicador de digitação com debounce.\n   */\n  /**\n   * Envia o sinal de que o atendente está digitando.\n   * Implementa um mecanismo de debounce temporal (3 segundos) para evitar spam no gateway.\n   * @private\n   */\n  private sendTypingIndicator(): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId || !this.canSendMessage()) return;\n\n    const now = Date.now();\n    // Só envia se passou mais de 3s desde o último envio\n    if (now - this.lastTypingSent < 3000) return;\n\n    this.lastTypingSent = now;\n    this.presenceService.startTyping(calledId, 5000).subscribe();\n\n    // Limpa timeout anterior e agenda novo\n    this.clearTypingTimeout();\n    this.typingTimeout = setTimeout(() => {\n      // Typing expira automaticamente, não precisa enviar paused\n    }, 5000);\n  }\n\n  /**\n   * Limpa o temporizador de indicação de digitação.\n   * @private\n   */\n  private clearTypingTimeout(): void {\n    if (this.typingTimeout) {\n      clearTimeout(this.typingTimeout);\n      this.typingTimeout = null;\n    }\n  }\n\n  /**\n   * Realizar o envio da mensagem de texto atual.\n   * Implementa o envio otimista (mostra na tela antes da confirmação do servidor)\n   * e gerencia estados de falha.\n   */\n  sendMessage(): void {\n    const content = this.messageInput().trim();\n    if (!content || this.isSending()) return;\n\n    const calledId = this.route.snapshot.paramMap.get('calledId');\n    if (!calledId) {\n      toast.error('Selecione um atendimento para enviar mensagem.');\n      return;\n    }\n\n    const replyContext = this.replyingTo();\n    const metadata = replyContext ? { quoted_message_id: replyContext.id } : undefined;\n\n    // Create optimistic message with pending status\n    const optimisticMessage: CalledMessage = {\n      id: `temp-${Date.now()}`,\n      called_id: calledId,\n      content,\n      type: 'text',\n      direction: 'outgoing',\n      status: 'pending',\n      created_at: new Date().toISOString(),\n      metadata,\n    };\n\n    // Add to chat immediately\n    this.userChat?.appendMessage(optimisticMessage);\n    this.userChat?.scrollToBottomForce();\n    this.setMessageInputValue('');\n    this.resetQuickAnswerAutocomplete();\n    this.replyingTo.set(null); // Clear reply context\n    this.isSending.set(true);\n\n    const tempId = optimisticMessage.id;\n\n    // Send to server\n    this.messageService.send(calledId, content, 'text', metadata).subscribe({\n      next: (response) => {\n        const serverMessage = response?.data;\n        if (serverMessage) {\n          this.userChat?.replaceMessage(tempId, serverMessage);\n        }\n        this.isSending.set(false);\n        // Status will be updated via WebSocket event\n      },\n      error: () => {\n        this.isSending.set(false);\n        this.userChat?.replaceMessage(tempId, {\n          ...optimisticMessage,\n          status: 'failed',\n        });\n        toast.error('Não foi possível enviar a mensagem.');\n      },\n    });\n  }\n\n  /**\n   * Iniciar formalmente o atendimento para o ticket selecionado.\n   * Altera o status do atendimento no backend e atualiza a interface.\n   */\n  startAttendance(): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n    const current = this.selectedCalled();\n    if (current) {\n      this.selectedCalled.set({ ...current, status: 'in_progress' });\n    }\n    this.calledService.open(calledId).subscribe({\n      next: (response) => {\n        this.selectedCalled.set(response.data);\n        this.chatRefresh.request();\n        toast.success('Atendimento iniciado.');\n        this.fetchCalled(calledId);\n      },\n      error: () => {\n        if (current) {\n          this.selectedCalled.set(current);\n        }\n        toast.error('Não foi possível iniciar o atendimento.');\n      },\n    });\n  }\n\n  /**\n   * Atualizar os dados do contato exibidos no chat.\n   * @param contact Objeto contendo os dados atualizados do contato.\n   */\n  onContactUpdated(contact: Contact): void {\n    const current = this.selectedCalled();\n    if (!current) return;\n    this.selectedCalled.set({ ...current, contact });\n  }\n\n  /**\n   * Buscar os detalhes de um atendimento específico.\n   * @param id Identificador do atendimento.\n   * @private\n   */\n  private fetchCalled(id: string): void {\n    this.isLoadingCalled.set(true);\n    this.calledService.get(id).subscribe({\n      next: (response) => {\n        this.selectedCalled.set(response.data);\n        this.isLoadingCalled.set(false);\n      },\n      error: () => {\n        this.selectedCalled.set(null);\n        this.isLoadingCalled.set(false);\n      },\n    });\n  }\n\n  // Audio Recording State\n  /**\n   * Estado atual da gravação de áudio.\n   */\n  readonly recordingState = this.recorder.state;\n\n  /**\n   * Duração acumulada da gravação em milissegundos.\n   */\n  readonly recordingDuration = this.recorder.duration;\n\n  /**\n   * Sequência de valores para renderização visual das ondas sonoras.\n   */\n  readonly recordingWaveforms = this.recorder.waveforms;\n\n  /**\n   * Control flags for recorder flow.\n   */\n  private sendAfterStop = false;\n\n  /**\n   * Iniciar o processo de gravação de áudio.\n   * Ativa o sinal de presença \"gravando\" para o cliente remoto.\n   */\n  async startRecording(): Promise<void> {\n    if (this.recordingState() !== 'text') return;\n    this.sendAfterStop = false;\n\n    const started = await this.recorder.start();\n    if (started) {\n      const calledId = this.selectedCalledId();\n      if (calledId) {\n        this.presenceService.startRecording(calledId, 60000).subscribe();\n      }\n    }\n  }\n\n  /**\n   * Pausar a gravação de áudio atual.\n   * Interrompe o cronômetro e desativa o sinal de presença.\n   */\n  pauseRecording(): void {\n    this.recorder.pause();\n    const calledId = this.selectedCalledId();\n    if (calledId) {\n      this.presenceService.stop(calledId).subscribe();\n    }\n  }\n\n  /**\n   * Retomar uma gravação que estava pausada.\n   */\n  resumeRecording(): void {\n    this.recorder.resume();\n    const calledId = this.selectedCalledId();\n    if (calledId) {\n      this.presenceService.startRecording(calledId, 60000).subscribe();\n    }\n  }\n\n  /**\n   * Cancelar a gravação atual e descartar os dados capturados.\n   */\n  cancelRecording(): void {\n    this.recorder.cancel();\n    this.sendAfterStop = false;\n    const calledId = this.selectedCalledId();\n    if (calledId) {\n      this.presenceService.stop(calledId).subscribe();\n    }\n  }\n\n  /**\n   * Finalizar e enviar o arquivo de áudio gravado.\n   */\n  sendAudio(): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId || this.isSending()) return;\n\n    this.sendAfterStop = true;\n    this.recorder.stop();\n    this.presenceService.stop(calledId).subscribe();\n  }\n\n  /**\n   * Send recorded audio to backend (upload + send).\n   */\n  private sendRecordedAudio(blob: Blob): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n\n    const mimeType = blob.type || 'audio/webm';\n    const extension = mimeType.includes('ogg') ? 'ogg' : mimeType.includes('wav') ? 'wav' : 'webm';\n    const file = new File([blob], `audio-${Date.now()}.${extension}`, {\n      type: mimeType,\n    });\n\n    const tempId = `temp-${Date.now()}`;\n    const blobUrl = URL.createObjectURL(blob);\n\n    const optimisticMessage: CalledMessage = {\n      id: tempId,\n      called_id: calledId,\n      content: '',\n      type: 'audio',\n      direction: 'outgoing',\n      status: 'sending',\n      file_url: blobUrl,\n      file_name: file.name,\n      mime_type: mimeType,\n      file_size: file.size,\n      created_at: new Date().toISOString(),\n    };\n\n    this.userChat?.appendMessage(optimisticMessage);\n    this.userChat?.scrollToBottomForce();\n    this.isSending.set(true);\n\n    this.messageService.uploadMedia(file).subscribe({\n      next: (res) => {\n        const url = res?.data?.url;\n        if (!url) {\n          this.userChat?.replaceMessage(tempId, { ...optimisticMessage, status: 'failed' });\n          this.isSending.set(false);\n          toast.error('Erro no retorno do upload.');\n          return;\n        }\n\n        this.messageService\n          .send(\n            calledId,\n            '',\n            'audio',\n            {},\n            {\n              file_url: url,\n              file_name: res?.data?.file_name ?? file.name,\n              mime_type: res?.data?.mime_type ?? mimeType,\n              file_size: res?.data?.size ?? file.size,\n            },\n          )\n          .subscribe({\n            next: (sendRes) => {\n              const serverMessage = sendRes?.data;\n              if (serverMessage) {\n                this.userChat?.replaceMessage(tempId, serverMessage);\n                URL.revokeObjectURL(blobUrl);\n              }\n              this.isSending.set(false);\n            },\n            error: () => {\n              this.userChat?.replaceMessage(tempId, { ...optimisticMessage, status: 'failed' });\n              this.isSending.set(false);\n              toast.error('Erro ao enviar o áudio.');\n            },\n          });\n      },\n      error: () => {\n        this.userChat?.replaceMessage(tempId, { ...optimisticMessage, status: 'failed' });\n        this.isSending.set(false);\n        toast.error('Erro ao fazer upload do áudio.');\n      },\n    });\n  }\n\n  /**\n   * Formatar a milissegundos em uma string legível de MM:SS.\n   * @param ms Valor em milissegundos.\n   * @returns String formatada.\n   */\n  formatDuration(ms: number): string {\n    const totalSeconds = Math.floor(ms / 1000);\n    const minutes = Math.floor(totalSeconds / 60);\n    const seconds = totalSeconds % 60;\n    return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;\n  }\n\n  // Quick Answers Logic\n  /**\n   * Serviço de gestão de respostas rápidas.\n   * @private\n   */\n  private readonly qaService = inject(ChatQuickAnswerService);\n\n  /**\n   * Controle de visibilidade do menu de respostas rápidas.\n   * @type {WritableSignal<boolean>}\n   */\n  readonly showQuickAnswers = signal(false);\n\n  /**\n   * Lista de respostas rápidas carregadas do backend.\n   * @type {WritableSignal<ChatQuickAnswer[]>}\n   */\n  readonly quickAnswers = signal<ChatQuickAnswer[]>([]);\n\n  /**\n   * Controla se o autocomplete por slash está ativo.\n   */\n  readonly quickAnswerActive = signal(false);\n\n  /**\n   * Termo com debounce para filtragem.\n   */\n  readonly debouncedQuickAnswerQuery = signal('');\n\n  /**\n   * Índice de seleção atual no dropdown.\n   */\n  readonly activeQuickAnswerIndex = signal(0);\n\n  /**\n   * Lista filtrada de respostas rápidas.\n   */\n  readonly filteredQuickAnswers = computed(() => {\n    if (!this.quickAnswerActive()) return [];\n    const query = this.debouncedQuickAnswerQuery().trim().toLowerCase();\n    const items = this.quickAnswers();\n\n    if (!query) return items;\n    return items.filter((item) => item.shortcut.toLowerCase().includes(query));\n  });\n\n  /**\n   * Indica se o dropdown de autocomplete deve aparecer.\n   */\n  readonly showQuickAnswerAutocomplete = computed(\n    () => this.quickAnswerActive() && this.filteredQuickAnswers().length > 0,\n  );\n\n  /**\n   * Timeout para debounce do filtro de respostas rápidas.\n   */\n  private quickAnswerDebounce?: ReturnType<typeof setTimeout>;\n\n  /**\n   * Alternar a exibição do diálogo de respostas rápidas.\n   */\n  toggleQuickAnswers(): void {\n    this.showQuickAnswers.update((v) => !v);\n    if (this.showQuickAnswers() && this.quickAnswers().length === 0) {\n      this.loadQuickAnswers();\n    }\n  }\n\n  /**\n   * Selecionar uma resposta rápida e inseri-la no campo de mensagem.\n   * @param qa Objeto da resposta rápida selecionada.\n   */\n  selectQuickAnswer(qa: ChatQuickAnswer): void {\n    const nextValue = this.replaceQuickAnswerToken(this.messageInput(), qa.content);\n    this.setMessageInputValue(nextValue);\n    this.showQuickAnswers.set(false);\n    this.resetQuickAnswerAutocomplete();\n    queueMicrotask(() => this.focusMessageInput());\n  }\n\n  /**\n   * Atualiza o termo de busca do autocomplete com debounce.\n   */\n  private updateQuickAnswerQuery(value: string): void {\n    const match = this.extractQuickAnswerQuery(value);\n\n    if (match === null) {\n      if (this.quickAnswerDebounce) {\n        clearTimeout(this.quickAnswerDebounce);\n        this.quickAnswerDebounce = undefined;\n      }\n      this.quickAnswerActive.set(false);\n      this.debouncedQuickAnswerQuery.set('');\n      this.activeQuickAnswerIndex.set(0);\n      return;\n    }\n\n    this.quickAnswerActive.set(true);\n    this.activeQuickAnswerIndex.set(0);\n\n    if (this.quickAnswerDebounce) {\n      clearTimeout(this.quickAnswerDebounce);\n    }\n\n    this.quickAnswerDebounce = setTimeout(() => {\n      this.debouncedQuickAnswerQuery.set(match);\n    }, 300);\n  }\n\n  /**\n   * Extrai o termo digitado após \"/\".\n   */\n  private extractQuickAnswerQuery(value: string): string | null {\n    const match = value.match(/(^|\\s)\\/([^\\s]*)$/);\n    if (!match) return null;\n    return match[2] ?? '';\n  }\n\n  /**\n   * Substitui o atalho digitado pelo conteúdo escolhido.\n   */\n  private replaceQuickAnswerToken(value: string, content: string): string {\n    if (!value) return content;\n    if (!/(^|\\s)\\/[^\\s]*$/.test(value)) return content;\n    return value.replace(/(^|\\s)\\/[^\\s]*$/, (full, prefix) => `${prefix}${content}`);\n  }\n\n  /**\n   * Limpa o estado do autocomplete.\n   */\n  private resetQuickAnswerAutocomplete(): void {\n    if (this.quickAnswerDebounce) {\n      clearTimeout(this.quickAnswerDebounce);\n      this.quickAnswerDebounce = undefined;\n    }\n    this.quickAnswerActive.set(false);\n    this.debouncedQuickAnswerQuery.set('');\n    this.activeQuickAnswerIndex.set(0);\n  }\n\n  /**\n   * Retorna os pedaços do atalho para destaque visual.\n   */\n  getQuickAnswerHighlight(\n    shortcut: string,\n    query: string,\n  ): {\n    before: string;\n    match: string;\n    after: string;\n  } {\n    if (!query) {\n      return { before: '', match: shortcut, after: '' };\n    }\n\n    const lowerShortcut = shortcut.toLowerCase();\n    const lowerQuery = query.toLowerCase();\n    const index = lowerShortcut.indexOf(lowerQuery);\n\n    if (index === -1) {\n      return { before: shortcut, match: '', after: '' };\n    }\n\n    const before = shortcut.slice(0, index);\n    const match = shortcut.slice(index, index + query.length);\n    const after = shortcut.slice(index + query.length);\n    return { before, match, after };\n  }\n\n  // File Upload Logic\n  @ViewChild('fileInput') fileInput!: import('@angular/core').ElementRef<HTMLInputElement>;\n\n  /**\n   * Acionar o seletor de arquivos do sistema operacional via código.\n   */\n  triggerFileUpload(): void {\n    this.fileInput.nativeElement.click();\n  }\n\n  /**\n   * Tratar o evento de seleção de arquivo pelo usuário.\n   * @param event O evento de mudança do input de arquivo.\n   */\n  onFileSelected(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    if (input.files && input.files.length > 0) {\n      this.addMediaPreviewFiles(input.files);\n    }\n    input.value = ''; // Reset\n  }\n\n  /**\n   * Executar o upload do arquivo para o servidor de mídia.\n   * Determina o tipo de mensagem (imagem, vídeo, áudio ou arquivo) com base no MIME type.\n   * @param file O objeto File a ser enviado.\n   */\n  uploadFile(file: File): void {\n    const calledId = this.selectedCalledId();\n    if (!calledId) return;\n\n    const replyContext = this.replyingTo();\n    const metadata = replyContext ? { quoted_message_id: replyContext.id } : {};\n\n    // 1. Determine type\n    let type = 'file';\n    if (file.type.startsWith('image/')) type = 'image';\n    else if (file.type.startsWith('video/')) type = 'video';\n    else if (file.type.startsWith('audio/')) type = 'audio';\n\n    // 2. Optimistic UI: Create temporary message with Blob URL\n    const tempId = `temp-${Date.now()}`;\n    const blobUrl = URL.createObjectURL(file);\n\n    const optimisticMessage: CalledMessage = {\n      id: tempId,\n      called_id: calledId,\n      content: '',\n      type,\n      direction: 'outgoing',\n      status: 'sending', // Custom status for UI spinner\n      file_url: blobUrl, // Show immediately\n      file_name: file.name,\n      mime_type: file.type,\n      file_size: file.size,\n      created_at: new Date().toISOString(),\n      metadata,\n    };\n\n    this.userChat?.appendMessage(optimisticMessage);\n    this.userChat?.scrollToBottomForce();\n    this.isSending.set(true);\n    if (replyContext) {\n      this.replyingTo.set(null);\n    }\n\n    this.messageService.uploadMedia(file).subscribe({\n      next: (res) => {\n        const url = res?.data?.url;\n        const file_name = res?.data?.file_name;\n        const mime_type = res?.data?.mime_type;\n        const size = res?.data?.size;\n\n        if (!url) {\n          this.userChat?.replaceMessage(tempId, {\n            ...optimisticMessage,\n            status: 'failed',\n          });\n          this.isSending.set(false);\n          toast.error('Erro no retorno do upload.');\n          return;\n        }\n\n        // 3. Send message with real URL\n        this.messageService\n          .send(calledId, '', type, metadata, {\n            file_url: url,\n            file_name,\n            mime_type,\n            file_size: size,\n          })\n          .subscribe({\n            next: (sendRes) => {\n              // 4. Update optimistic message with real server message\n              const serverMessage = sendRes?.data;\n\n              if (serverMessage) {\n                this.userChat?.replaceMessage(tempId, serverMessage);\n                URL.revokeObjectURL(blobUrl); // Cleanup\n              }\n              // If server message missing, keep optimistic message with tempId\n              this.isSending.set(false);\n            },\n            error: () => {\n              // Handle send error\n              this.userChat?.replaceMessage(tempId, {\n                ...optimisticMessage,\n                status: 'failed',\n              });\n              this.isSending.set(false);\n              toast.error('Erro ao enviar mensagem.');\n            },\n          });\n      },\n      error: () => {\n        // Handle upload error\n        this.userChat?.replaceMessage(tempId, {\n          ...optimisticMessage,\n          status: 'failed',\n        });\n        this.isSending.set(false);\n        toast.error('Erro ao fazer upload da mídia.');\n      },\n    });\n  }\n\n  /**\n   * Carregar a lista de respostas rápidas configuradas.\n   * @private\n   */\n  private loadQuickAnswers(): void {\n    this.qaService.list().subscribe({\n      next: (items) => {\n        this.quickAnswers.set(items);\n      },\n      error: () => {\n        this.quickAnswers.set([]);\n        this.resetQuickAnswerAutocomplete();\n      },\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chatbot/chatbot.spec.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (113). Maximum allowed is 80.","line":41,"column":21,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":153,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { TestBed } from '@angular/core/testing';\nimport { of } from 'rxjs';\nimport { Chatbot } from './chatbot';\nimport { ChatbotRuleService } from '@core/services/chatbot-rule.service';\nimport { DepartmentService } from '@core/services/department.service';\n\nclass ChatbotRuleServiceStub {\n  list = vi.fn().mockReturnValue(of({ success: true, data: { data: [] } }));\n\n  create = vi.fn().mockReturnValue(\n    of({\n      success: true,\n      data: {\n        id: 'rule-1',\n        company_id: 'company-1',\n        name: 'Regra menu',\n        match_type: 'contains',\n        patterns: ['menu'],\n        actions: [{ type: 'send_message', message: 'Olá!', message_type: '1' }],\n        cooldown_seconds: 60,\n        priority: 0,\n        is_active: true,\n        respect_business_hours: true,\n        is_welcome: true,\n        created_at: '2026-01-21 00:00:00',\n        updated_at: '2026-01-21 00:00:00',\n      },\n    }),\n  );\n\n  update = vi.fn().mockReturnValue(of({ success: true, data: { id: 'rule-1' } }));\n  validateKeyword = vi.fn().mockReturnValue(of({ success: true, data: { available: true } }));\n  delete = vi.fn().mockReturnValue(of(void 0));\n  toggle = vi.fn().mockReturnValue(of({ data: { id: 'rule-1' } }));\n}\n\nclass DepartmentServiceStub {\n  list = vi.fn().mockReturnValue(of({ data: [] }));\n}\n\ndescribe('Chatbot', () => {\n  let component: Chatbot;\n  let chatbotRules: ChatbotRuleServiceStub;\n  let departments: DepartmentServiceStub;\n\n  beforeEach((): void => {\n    TestBed.configureTestingModule({\n      providers: [\n        { provide: ChatbotRuleService, useClass: ChatbotRuleServiceStub },\n        { provide: DepartmentService, useClass: DepartmentServiceStub },\n      ],\n    });\n\n    chatbotRules = TestBed.inject(ChatbotRuleService) as unknown as ChatbotRuleServiceStub;\n    departments = TestBed.inject(DepartmentService) as unknown as DepartmentServiceStub;\n    component = TestBed.runInInjectionContext(() => new Chatbot());\n    component.ngOnInit();\n  });\n\n  it('should list chatbot rules and departments on init', () => {\n    expect(chatbotRules.list).toHaveBeenCalled();\n    expect(departments.list).toHaveBeenCalled();\n  });\n\n  it('opens create modal with reset form state', () => {\n    component.openCreate();\n\n    expect(component.isEditOpen()).toBe(true);\n    expect(component.editingRuleId()).toBeNull();\n    expect(component.form.controls.keyword.value).toBe('');\n  });\n\n  it('saves new rule with is_welcome payload', () => {\n    component.openCreate();\n    component.form.patchValue({\n      keyword: 'menu',\n      caption: 'Olá!',\n      actionType: 'message',\n      isWelcome: true,\n    });\n    component.keywordStatus.set('available');\n\n    component.saveEdit();\n\n    expect(chatbotRules.create).toHaveBeenCalled();\n    const payload = chatbotRules.create.mock.calls.at(-1)?.[0] as { is_welcome?: boolean };\n    expect(payload.is_welcome).toBe(true);\n  });\n\n  it('validates keyword with debounce', () => {\n    vi.useFakeTimers();\n\n    component.form.controls.keyword.setValue('menu');\n    vi.advanceTimersByTime(450);\n\n    expect(chatbotRules.validateKeyword).toHaveBeenCalledWith({\n      keyword: 'menu',\n      match_type: 'contains',\n      instance_id: null,\n      department_id: null,\n      rule_id: null,\n    });\n\n    vi.useRealTimers();\n  });\n\n  it('opens delete confirmation and removes rule', () => {\n    const rule = {\n      id: 'rule-9',\n      name: 'Excluir',\n      patterns: ['excluir'],\n      is_welcome: false,\n      company_id: 'company-1',\n      match_type: 'contains' as const,\n      actions: [],\n      cooldown_seconds: 60,\n      priority: 0,\n      is_active: true,\n      respect_business_hours: true,\n      created_at: '2026-01-30',\n      updated_at: '2026-01-30',\n    };\n\n    component.rules.set([rule]);\n    component.openDelete(rule);\n    component.confirmDelete();\n\n    expect(chatbotRules.delete).toHaveBeenCalledWith('rule-9');\n    expect(component.rules()).toEqual([]);\n  });\n\n  it('toggles rule status', () => {\n    const rule = {\n      id: 'rule-1',\n      name: 'Menu',\n      patterns: ['menu'],\n      is_welcome: false,\n      company_id: 'company-1',\n      match_type: 'contains' as const,\n      actions: [],\n      cooldown_seconds: 60,\n      priority: 0,\n      is_active: true,\n      respect_business_hours: true,\n      created_at: '2026-01-30',\n      updated_at: '2026-01-30',\n    };\n\n    component.toggleRule(rule);\n\n    expect(chatbotRules.toggle).toHaveBeenCalledWith('rule-1');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/chatbot/chatbot.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/chatbot-rule.service' import is duplicated.","line":37,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":37,"endColumn":74},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":455,"column":29,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":455,"endColumn":34,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[17165,17170],"text":"(value != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"r