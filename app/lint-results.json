, () => {\n    expect(component.getTypeClass('meeting')).toContain('bg-info');\n    expect(component.getTypeClass('call')).toContain('bg-primary');\n    expect(component.getTypeClass('task')).toContain('bg-success');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // View Mode Tests\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should start with calendar view by default', () => {\n    expect(component.viewMode()).toBe('calendar');\n  });\n\n  it('should switch to calendar view', () => {\n    component.setView('list');\n    component.setView('calendar');\n    expect(component.viewMode()).toBe('calendar');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Event Type Classes\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should return correct class for deadline type', () => {\n    expect(component.getTypeClass('deadline')).toContain('bg-danger');\n  });\n\n  it('should return correct class for reminder type', () => {\n    expect(component.getTypeClass('reminder')).toContain('bg-warning');\n  });\n\n  it('should return default class for other type', () => {\n    expect(component.getTypeClass('other')).toContain('bg-default');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Status Options\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should have correct status options', () => {\n    expect(component.statusOptions.length).toBe(3);\n    expect(component.statusOptions.some((opt) => opt.id === 'scheduled')).toBe(true);\n    expect(component.statusOptions.some((opt) => opt.id === 'completed')).toBe(true);\n    expect(component.statusOptions.some((opt) => opt.id === 'cancelled')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Type Options\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should have correct type options', () => {\n    expect(component.typeOptions.length).toBe(6);\n    expect(component.typeOptions.some((opt) => opt.id === 'meeting')).toBe(true);\n    expect(component.typeOptions.some((opt) => opt.id === 'call')).toBe(true);\n    expect(component.typeOptions.some((opt) => opt.id === 'task')).toBe(true);\n    expect(component.typeOptions.some((opt) => opt.id === 'deadline')).toBe(true);\n    expect(component.typeOptions.some((opt) => opt.id === 'reminder')).toBe(true);\n    expect(component.typeOptions.some((opt) => opt.id === 'other')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Filter Status Options\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should expose filter status options', () => {\n    expect(component.filterStatusOptions.length).toBe(4);\n    expect(component.filterStatusOptions[0].value).toBe('all');\n    expect(component.filterStatusOptions.some((opt) => opt.value === 'scheduled')).toBe(true);\n    expect(component.filterStatusOptions.some((opt) => opt.value === 'completed')).toBe(true);\n    expect(component.filterStatusOptions.some((opt) => opt.value === 'cancelled')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Status Class\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should return correct status class for scheduled', () => {\n    expect(component.statusClass('scheduled')).toContain('info');\n  });\n\n  it('should return correct status class for completed', () => {\n    expect(component.statusClass('completed')).toContain('success');\n  });\n\n  it('should return correct status class for cancelled', () => {\n    expect(component.statusClass('cancelled')).toContain('danger');\n  });\n\n  it('should return default status class for unknown status', () => {\n    expect(\n      component.statusClass('unknown' as unknown as Parameters<typeof component.statusClass>[0]),\n    ).toContain('default');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Status Label\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should return correct status label for scheduled', () => {\n    expect(component.statusLabel('scheduled')).toBe('Agendado');\n  });\n\n  it('should return correct status label for completed', () => {\n    expect(component.statusLabel('completed')).toBe('Concluído');\n  });\n\n  it('should return correct status label for cancelled', () => {\n    expect(component.statusLabel('cancelled')).toBe('Cancelado');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Type Label\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should return correct type label for meeting', () => {\n    expect(component.typeLabel('meeting')).toBe('Reunião');\n  });\n\n  it('should return correct type label for call', () => {\n    expect(component.typeLabel('call')).toBe('Ligação');\n  });\n\n  it('should return correct type label for task', () => {\n    expect(component.typeLabel('task')).toBe('Tarefa');\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // CRUD Service Configuration\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure crud service with all required methods', () => {\n    expect(component.crudService.list).toBeDefined();\n    expect(component.crudService.find).toBeDefined();\n    expect(component.crudService.create).toBeDefined();\n    expect(component.crudService.update).toBeDefined();\n    expect(component.crudService.delete).toBeDefined();\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Actions Configuration\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure actions with edit and delete', () => {\n    expect(component.actions.some((action) => action.type === 'edit')).toBe(true);\n    expect(component.actions.some((action) => action.type === 'delete')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // CRUD Config\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure crudConfig with correct labels', () => {\n    expect(component.crudConfig.labels?.singular).toBe('Evento');\n    expect(component.crudConfig.labels?.plural).toBe('Agenda');\n  });\n\n  it('should configure crudConfig with empty state', () => {\n    expect(component.crudConfig.emptyState?.title).toBe('Nenhum evento encontrado');\n    expect(component.crudConfig.emptyState?.icon).toBe('lucideCalendar');\n  });\n\n  it('should have selection enabled', () => {\n    expect(component.crudConfig.enableSelection).toBe(true);\n  });\n\n  it('should have search enabled', () => {\n    expect(component.crudConfig.enableSearch).toBe(true);\n  });\n\n  it('should have filters enabled', () => {\n    expect(component.crudConfig.enableFilters).toBe(true);\n  });\n\n  it('should have bulk delete enabled', () => {\n    expect(component.crudConfig.enableBulkDelete).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Calendar Modal\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should start with calendar modal closed', () => {\n    expect(component.isCalendarModalOpen()).toBe(false);\n  });\n\n  it('should open calendar modal for create', () => {\n    component.openCalendarCreate();\n    expect(component.isCalendarModalOpen()).toBe(true);\n    expect(component.calendarEditingItem()).toBeNull();\n  });\n\n  it('should close calendar modal', () => {\n    component.openCalendarCreate();\n    component.closeCalendarModal();\n    expect(component.isCalendarModalOpen()).toBe(false);\n  });\n\n  it('should open calendar modal for edit', () => {\n    component.openCalendarEdit(mockEvent);\n    expect(component.isCalendarModalOpen()).toBe(true);\n    expect(component.calendarEditingItem()).toEqual(mockEvent);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Columns Configuration\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should configure columns with title', () => {\n    expect(component.columns.some((column) => column.field === 'title')).toBe(true);\n  });\n\n  it('should configure columns with type', () => {\n    expect(component.columns.some((column) => column.field === 'type')).toBe(true);\n  });\n\n  it('should configure columns with starts_at', () => {\n    expect(component.columns.some((column) => column.field === 'starts_at')).toBe(true);\n  });\n\n  it('should configure columns with ends_at', () => {\n    expect(component.columns.some((column) => column.field === 'ends_at')).toBe(true);\n  });\n\n  it('should configure columns with status', () => {\n    expect(component.columns.some((column) => column.field === 'status')).toBe(true);\n  });\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Form Callbacks\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  it('should call handleFormSaved when form is saved', () => {\n    const listSpy = vi\n      .spyOn(eventService, 'list')\n      .mockReturnValue(\n        of({ data: [], meta: { current_page: 1, last_page: 1, per_page: 10, total: 0 } }),\n      );\n\n    component.handleFormSaved(mockEvent);\n\n    // Should trigger calendar reload\n    expect(listSpy).toHaveBeenCalled();\n  });\n\n  it('should handle calendar saved', () => {\n    const listSpy = vi\n      .spyOn(eventService, 'list')\n      .mockReturnValue(\n        of({ data: [], meta: { current_page: 1, last_page: 1, per_page: 10, total: 0 } }),\n      );\n\n    component.openCalendarCreate();\n    component.handleCalendarSaved(mockEvent);\n\n    expect(component.isCalendarModalOpen()).toBe(false);\n    expect(listSpy).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/crm/agenda/agenda.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":3,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"no-duplicate-imports","severity":2,"message":"'rxjs' import is duplicated.","line":15,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":15,"endColumn":30},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@fullcalendar/angular' import is duplicated.","line":26,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":26,"endColumn":60},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@fullcalendar/interaction' import is duplicated.","line":32,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":32,"endColumn":74},{"ruleId":"no-duplicate-imports","severity":2,"message":"'@shared/components/inputs' import is duplicated.","line":48,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":52,"endColumn":36},{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/event.service' import is duplicated.","line":60,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":60,"endColumn":68},{"ruleId":"no-duplicate-imports","severity":2,"message":"'src/app/core/services/crm-company.service' import is duplicated.","line":64,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":64,"endColumn":79},{"ruleId":