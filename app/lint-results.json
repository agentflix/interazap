olean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":476,"column":14,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":476,"endColumn":19,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[14791,14797],"text":"token == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[14792,14797],"text":"(token ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[14791,14797],"text":"!Boolean(token)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":483,"column":15,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":483,"endColumn":29,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[15061,15075],"text":"(Boolean(connectedValue))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":488,"column":13,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":488,"endColumn":17,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[15185,15189],"text":"Boolean(crud)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":547,"column":9,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":547,"endColumn":13,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[17014,17018],"text":"Boolean(crud)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":556,"column":9,"nodeType":"Identifier","messageId":"conditionErrorAny","endLine":556,"endColumn":13,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[17193,17197],"text":"Boolean(crud)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TemplateRef } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport type { Observable } from 'rxjs';\nimport { map } from 'rxjs';\nimport { NgIcon, provideIcons } from '@ng-icons/core';\nimport {\n  lucideQrCode,\n  lucideSmartphone,\n  lucideUnplug,\n  lucideRefreshCw,\n  lucidePlus,\n  lucideTrash2,\n  lucidePencil,\n  lucideSlidersHorizontal,\n  lucidePackage,\n} from '@ng-icons/lucide';\nimport type { Integration, IntegrationFilters } from 'src/app/core/services/integration.service';\nimport { IntegrationService } from 'src/app/core/services/integration.service';\nimport { RealtimeService } from 'src/app/core/services/realtime.service';\nimport { CrudPageComponent } from '@shared/components/crud-page';\nimport type {\n  CrudActionDef,\n  CrudColumnDef,\n  CrudConfig,\n  CrudItemResponse,\n  CrudPaginatedResponse,\n  CrudService,\n} from '@shared/components/crud-page/models';\nimport type { SelectOption } from '@shared/components/inputs';\nimport { SelectInputComponent } from '@shared/components/inputs';\nimport { ModalComponent } from '@shared/components/modal/modal';\nimport { ConfirmModalComponent } from '@shared/components/confirm-modal/confirm-modal';\nimport { ButtonComponent, LoadingButtonComponent } from '@shared/components/buttons';\nimport { toast } from 'ngx-sonner';\nimport { IntegrationFormComponent } from './components';\n\n/**\n * Componente principal para gestão das integrações de canais de atendimento (WhatsApp).\n *\n * Permite cadastrar instâncias de diferentes provedores (Z-API, Evolution, etc.),\n * gerenciar o ciclo de vida da conexão (QR Code, Pareamento por código) e\n * monitorar o status em tempo real via WebSockets.\n *\n * @class IntegrationPage\n * @description Central de integrações e conectividade de instâncias.\n */\n@Component({\n  selector: 'app-integration',\n  standalone: true,\n  imports: [\n    CrudPageComponent,\n    IntegrationFormComponent,\n    NgIcon,\n    ModalComponent,\n    ConfirmModalComponent,\n    ButtonComponent,\n    LoadingButtonComponent,\n    SelectInputComponent,\n  ],\n  templateUrl: './integration.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  viewProviders: [\n    provideIcons({\n      lucideQrCode,\n      lucideSmartphone,\n      lucideUnplug,\n      lucideRefreshCw,\n      lucidePlus,\n      lucideTrash2,\n      lucidePencil,\n      lucideSlidersHorizontal,\n      lucidePackage,\n    }),\n  ],\n})\nexport class IntegrationPage {\n  private readonly integrationService = inject(IntegrationService);\n  private readonly realtime = inject(RealtimeService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly crudPage = viewChild<CrudPageComponent<Integration>>('crudPage');\n  readonly integrationForm = viewChild<IntegrationFormComponent>('integrationForm');\n  readonly providerCell = viewChild<TemplateRef<{ $implicit: Integration }>>('providerCell');\n  readonly connectionStatusCell =\n    viewChild<TemplateRef<{ $implicit: Integration }>>('connectionStatusCell');\n\n  readonly filterStatusOptions: SelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  readonly crudService: CrudService<Integration> = {\n    list: (params: IntegrationFilters) =>\n      this.integrationService\n        .list({\n          ...params,\n          sort_by: 'name',\n          sort_dir: 'asc',\n        })\n        .pipe(\n          map((response) => ({\n            data: response.data.map((item) => ({\n              ...item,\n              connection_status: this.resolveConnectionStatus(item),\n            })),\n            meta: response.meta,\n          })),\n        ) as Observable<CrudPaginatedResponse<Integration>>,\n    find: (id: string) =>\n      this.integrationService\n        .find(id)\n        .pipe(map((response) => ({ data: response.data }))) as Observable<\n        CrudItemResponse<Integration>\n      >,\n    create: (data: Partial<Integration>) =>\n      this.integrationService\n        .create(data)\n        .pipe(map((response) => ({ data: response.data }))) as Observable<\n        CrudItemResponse<Integration>\n      >,\n    update: (id: string, data: Partial<Integration>) =>\n      this.integrationService\n        .update(id, data)\n        .pipe(map((response) => ({ data: response.data }))) as Observable<\n        CrudItemResponse<Integration>\n      >,\n    delete: (id: string) => this.integrationService.delete(id),\n  };\n\n  readonly columns = computed<CrudColumnDef[]>(() => [\n    { field: 'name', label: 'Nome', type: 'text' },\n    {\n      field: 'provider',\n      label: 'Provedor',\n      template: this.providerCell() ?? undefined,\n    },\n    { field: 'is_active', label: 'Status', type: 'status' },\n    {\n      field: 'connection_status',\n      label: 'Conexão',\n      template: this.connectionStatusCell() ?? undefined,\n    },\n  ]);\n\n  readonly actions: CrudActionDef[] = [\n    {\n      type: 'qr',\n      icon: 'lucideQrCode',\n      label: 'Gerar QR Code',\n      variant: 'ghost',\n      hidden: (item: Integration) => item.connection_status === 'connected',\n    },\n    {\n      type: 'sync',\n      icon: 'lucideSmartphone',\n      label: 'Gerar Código de Sincronia',\n      variant: 'ghost',\n      hidden: (item: Integration) => item.connection_status === 'connected',\n    },\n    {\n      type: 'edit',\n      icon: 'lucidePencil',\n      label: 'Editar',\n      variant: 'ghost',\n    },\n    {\n      type: 'disconnect',\n      icon: 'lucideUnplug',\n      label: 'Desconectar',\n      variant: 'ghost',\n      hidden: (item: Integration) => item.connection_status !== 'connected',\n    },\n    {\n      type: 'delete',\n      icon: 'lucideTrash2',\n      label: 'Excluir',\n      variant: 'danger',\n      hidden: (item: Integration) => item.connection_status !== 'disconnected',\n    },\n  ];\n\n  readonly crudConfig: CrudConfig = {\n    labels: {\n      singular: 'Integração',\n      plural: 'Integrações',\n      createButton: 'Nova integração',\n      modalCreate: 'Nova integração',\n      modalEdit: 'Editar integração',\n    },\n    subtitle: 'Chat',\n    searchPlaceholder: 'Buscar por...',\n    emptyState: {\n      icon: 'lucidePackage',\n      title: 'Nenhuma integração encontrada',\n      description: 'Adicione suas integrações para conectar serviços externos.',\n    },\n    enableSelection: true,\n    enableSearch: true,\n    enableFilters: true,\n    enableBulkDelete: true,\n  };\n\n  readonly isQrModalOpen = signal(false);\n  readonly isSyncModalOpen = signal(false);\n  readonly isDisconnectModalOpen = signal(false);\n  readonly qrCodeData = signal<string | null>(null);\n  readonly syncCodeData = signal<string | null>(null);\n  readonly connectionItem = signal<Integration | null>(null);\n  readonly disconnectingItem = signal<Integration | null>(null);\n  readonly isConnecting = signal(false);\n  readonly connectError = signal<string | null>(null);\n\n  constructor() {\n    this.setupRealtime();\n  }\n\n  handleFormSaved(integration: Integration): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.handleFormSaved(integration);\n    }\n  }\n\n  handleFormCancelled(): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.closeModal();\n    }\n  }\n\n  handleCustomAction(event: { action: string; item: Integration }): void {\n    if (event.action === 'qr') {\n      this.openQrModal(event.item);\n      return;\n    }\n    if (event.action === 'sync') {\n      this.openSyncModal(event.item);\n      return;\n    }\n    if (event.action === 'disconnect') {\n      this.openDisconnectModal(event.item);\n    }\n  }\n\n  /**\n   * Iniciar processo de conexão via QR Code solicitando os dados ao provedor.\n   * @param item A integração a ser conectada.\n   */\n  openQrModal(item: Integration): void {\n    this.connectionItem.set(item);\n    this.connectError.set(null);\n    this.qrCodeData.set(null);\n    this.isQrModalOpen.set(true);\n    this.isConnecting.set(true);\n\n    this.integrationService\n      .connect(item.id, { mode: 'qr' })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const qr = this.extractQrCode(response.data.connection as Record<string, unknown>);\n          this.qrCodeData.set(qr);\n          this.isConnecting.set(false);\n        },\n        error: (error) => {\n          this.isConnecting.set(false);\n          this.connectError.set(error.error?.message || 'Não foi possível gerar o QR Code.');\n        },\n      });\n  }\n\n  /**\n   * Renovar o QR Code solicitando uma nova geração ao provedor.\n   */\n  refreshQrCode(): void {\n    const item = this.connectionItem();\n    if (!item) return;\n    this.openQrModal(item);\n  }\n\n  /**\n   * Fechar modal de QR Code e limpar estados de carregamento de conexão.\n   */\n  closeQrModal(): void {\n    this.isQrModalOpen.set(false);\n    this.qrCodeData.set(null);\n    this.connectionItem.set(null);\n    this.isConnecting.set(false);\n    this.connectError.set(null);\n  }\n\n  /**\n   * Iniciar processo de pareamento por código solicitando os dados ao provedor.\n   * @param item A integração a ser pareada.\n   */\n  openSyncModal(item: Integration): void {\n    this.connectionItem.set(item);\n    this.isSyncModalOpen.set(true);\n    this.syncCodeData.set(null);\n    this.connectError.set(null);\n    this.isConnecting.set(true);\n\n    this.integrationService\n      .connect(item.id, { mode: 'pair' })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const code = this.extractPairCode(response.data.connection as Record<string, unknown>);\n          this.syncCodeData.set(code ?? '---');\n          this.isConnecting.set(false);\n        },\n        error: (error) => {\n          this.isConnecting.set(false);\n          this.connectError.set(\n            error.error?.message || 'Não foi possível obter o código de pareamento.',\n          );\n        },\n      });\n  }\n\n  /**\n   * Fechar modal de pareamento e limpar estados.\n   */\n  closeSyncModal(): void {\n    this.isSyncModalOpen.set(false);\n    this.syncCodeData.set(null);\n    this.connectionItem.set(null);\n    this.isConnecting.set(false);\n    this.connectError.set(null);\n  }\n\n  // ─────────────────────────────────────────────────────────────────────────────\n  // Disconnect Actions\n  // ─────────────────────────────────────────────────────────────────────────────\n\n  /**\n   * Abrir confirmação de desconexão (logout da conta WhatsApp).\n   * @param item Integração a ser desconectada.\n   */\n  openDisconnectModal(item: Integration): void {\n    this.disconnectingItem.set(item);\n    this.isDisconnectModalOpen.set(true);\n  }\n\n  /**\n   * Fechar modal de desconexão.\n   */\n  closeDisconnectModal(): void {\n    this.isDisconnectModalOpen.set(false);\n    this.disconnectingItem.set(null);\n  }\n\n  /**\n   * Enviar solicitação de desconexão da instância ao servidor.\n   */\n  confirmDisconnect(): void {\n    const item = this.disconnectingItem();\n    if (!item) return;\n\n    this.integrationService\n      .disconnect(item.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.closeDisconnectModal();\n          this.showSuccess('Integração desconectada com sucesso!');\n          this.crudPage()?.reloadList();\n        },\n        error: () => {\n          // Since endpoint is likely mocked/missing, we might get an error.\n          // For UI testing purposes, we can simulate success if 404/405 occurs,\n          // but strictly we should show error.\n          // Let's assume we want to show error unless it's a dev environment.\n          this.showError('Não foi possível desconectar a integração.');\n        },\n      });\n  }\n\n  /**\n   * Analisar recursivamente e extrair a string de QR Code de diferentes estruturas de resposta dos provedores.\n   * @param connection Objeto de conexão vindo da API.\n   * @returns {string | null} QR Code formatado para uso em <img>.\n   * @private\n   */\n  private extractQrCode(connection: Record<string, unknown>): string | null {\n    const candidates = [\n      this.readValue(connection, ['qr_code']),\n      this.readValue(connection, ['qrCode']),\n      this.readValue(connection, ['qr']),\n      this.readValue(connection, ['qrcode']),\n      this.readValue(connection, ['instance', 'qrcode']),\n      this.readValue(connection, ['instance', 'qr_code']),\n      this.readValue(connection, ['data', 'qr_code']),\n      this.readValue(connection, ['base64']),\n    ];\n\n    for (const candidate of candidates) {\n      if (typeof candidate === 'string' && candidate.trim()) {\n        const value = candidate.trim();\n        if (value.startsWith('data:image')) {\n          return value;\n        }\n        if (value.startsWith('http')) {\n          return value;\n        }\n        return `data:image/png;base64,${value}`;\n      }\n    }\n\n    return null;\n  }\n\n  /**\n   * Analisar recursivamente e extrair o código de pareamento de diferentes estruturas de resposta dos provedores.\n   * @param connection Objeto de conexão vindo da API.\n   * @returns {string | null} Código de 8 caracteres.\n   * @private\n   */\n  private extractPairCode(connection: Record<string, unknown>): string | null {\n    const candidates = [\n      this.readValue(connection, ['pair_code']),\n      this.readValue(connection, ['pairCode']),\n      this.readValue(connection, ['code']),\n      this.readValue(connection, ['data', 'code']),\n      this.readValue(connection, ['data', 'pairing']),\n      this.readValue(connection, ['instance', 'paircode']),\n    ];\n\n    for (const candidate of candidates) {\n      if (typeof candidate === 'string' && candidate.trim()) {\n        return candidate.trim();\n      }\n    }\n\n    return null;\n  }\n\n  /**\n   * Utilitário para ler valor de um objeto aninhado via array de chaves.\n   * @private\n   */\n  private readValue(obj: Record<string, unknown> | null | undefined, path: string[]): unknown {\n    return path.reduce<unknown>((acc, key) => {\n      if (acc && typeof acc === 'object' && key in acc) {\n        return (acc as Record<string, unknown>)[key];\n      }\n      return undefined;\n    }, obj);\n  }\n\n  /**\n   * Configurar ouvintes de eventos em tempo real para atualização automática dos status das instâncias.\n   * Responde a eventos como 'connected', 'qr_received', etc.\n   * @private\n   */\n  private setupRealtime(): void {\n    this.realtime.connect();\n    this.realtime\n      .on<unknown>('integration.connection')\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((payload) => {\n        const payloadRecord =\n          payload && typeof payload === 'object' ? (payload as Record<string, unknown>) : null;\n        const tokenValue = this.readValue(payloadRecord, ['token']);\n        const token = typeof tokenValue === 'string' ? tokenValue : null;\n        if (!token) return;\n\n        const statusValue = this.readValue(payloadRecord, ['status']);\n        const connectedValue = this.readValue(payloadRecord, ['connected']);\n        const status =\n          typeof statusValue === 'string'\n            ? statusValue\n            : connectedValue\n              ? 'connected'\n              : 'connecting';\n\n        const crud = this.crudPage();\n        if (crud) {\n          const updated = crud.items().map((item) => {\n            if (item.settings?.token === token || item.token === token) {\n              return {\n                ...item,\n                connection_status: status as 'connected' | 'disconnected' | 'connecting' | 'qr',\n                status,\n              };\n            }\n            return item;\n          });\n\n          crud.items.set(updated);\n        }\n\n        const qrcodeCandidate =\n          this.readValue(payloadRecord, ['qrcode']) ??\n          this.readValue(\n            (this.readValue(payloadRecord, ['raw']) as\n              | Record<string, unknown>\n              | null\n              | undefined) ?? {},\n            ['raw', 'instance', 'qrcode'],\n          ) ??\n          this.readValue(\n            (this.readValue(payloadRecord, ['raw']) as\n              | Record<string, unknown>\n              | null\n              | undefined) ?? {},\n            ['instance', 'qrcode'],\n          );\n        const currentItem = this.connectionItem();\n        if (\n          typeof qrcodeCandidate === 'string' &&\n          currentItem &&\n          (currentItem.settings?.token === token || currentItem.token === token)\n        ) {\n          this.qrCodeData.set(qrcodeCandidate);\n        }\n\n        if (status === 'connected') {\n          this.isQrModalOpen.set(false);\n          this.isSyncModalOpen.set(false);\n          this.showSuccess('Integração conectada com sucesso!');\n        }\n      });\n  }\n\n  private resolveConnectionStatus(item: Integration): Integration['connection_status'] {\n    const status = (item.connection_status ?? item.status ?? 'disconnected') as\n      | 'connected'\n      | 'disconnected'\n      | 'connecting'\n      | 'qr';\n    return status;\n  }\n\n  private showError(message: string): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.showError(message);\n      return;\n    }\n    toast.error(message);\n  }\n\n  private showSuccess(message: string): void {\n    const crud = this.crudPage();\n    if (crud) {\n      crud.showSuccess(message);\n      return;\n    }\n    toast.success(message);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/models/chat-realtime.model.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/models/chat-recorder.model.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/quick-answers/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/quick-answers/components/quick-answer-form/quick-answer-form.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@core/services/quick-answer.service' import is duplicated.","line":15,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":15,"endColumn":74},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only