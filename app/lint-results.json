asterPromptPayload,\n  SegmentPrompt,\n  SegmentPromptPayload,\n  PlanPrompt,\n  PlanPromptPayload,\n  QuarantinedPrompt,\n} from '../../pages/ai/models/ai.models';\n\n/** Single-item API response wrapper. */\ninterface ApiDataResponse<T> {\n  data: T;\n}\n\n/** Shape returned by the prompt resolve preview endpoint. */\ninterface PromptResolveResponse {\n  resolved_prompt: string;\n  components: {\n    master: string;\n    segment: string;\n    plan: string;\n    tenant: string;\n  };\n}\n\n/**\n * Service for super admin AI prompt governance endpoints.\n */\n@Injectable({ providedIn: 'root' })\nexport class AiGovernanceService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/platform/ai/prompts`;\n\n  listMasters(): Observable<Paginated<MasterPrompt>> {\n    return this.http.get<Paginated<MasterPrompt>>(`${this.baseUrl}/masters`);\n  }\n\n  getMaster(id: string): Observable<MasterPrompt> {\n    return this.http\n      .get<ApiDataResponse<MasterPrompt>>(`${this.baseUrl}/masters/${id}`)\n      .pipe(map((response) => response.data));\n  }\n\n  createMaster(payload: MasterPromptPayload): Observable<MasterPrompt> {\n    return this.http\n      .post<ApiDataResponse<MasterPrompt>>(`${this.baseUrl}/masters`, payload)\n      .pipe(map((response) => response.data));\n  }\n\n  updateMaster(id: string, payload: MasterPromptPayload): Observable<MasterPrompt> {\n    return this.http\n      .put<ApiDataResponse<MasterPrompt>>(`${this.baseUrl}/masters/${id}`, payload)\n      .pipe(map((response) => response.data));\n  }\n\n  deleteMaster(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/masters/${id}`);\n  }\n\n  listSegments(): Observable<Paginated<SegmentPrompt>> {\n    return this.http.get<Paginated<SegmentPrompt>>(`${this.baseUrl}/segments`);\n  }\n\n  getSegment(id: string): Observable<SegmentPrompt> {\n    return this.http\n      .get<ApiDataResponse<SegmentPrompt>>(`${this.baseUrl}/segments/${id}`)\n      .pipe(map((response) => response.data));\n  }\n\n  createSegment(payload: SegmentPromptPayload): Observable<SegmentPrompt> {\n    return this.http\n      .post<ApiDataResponse<SegmentPrompt>>(`${this.baseUrl}/segments`, payload)\n      .pipe(map((response) => response.data));\n  }\n\n  updateSegment(id: string, payload: SegmentPromptPayload): Observable<SegmentPrompt> {\n    return this.http\n      .put<ApiDataResponse<SegmentPrompt>>(`${this.baseUrl}/segments/${id}`, payload)\n      .pipe(map((response) => response.data));\n  }\n\n  deleteSegment(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/segments/${id}`);\n  }\n\n  listPlans(): Observable<Paginated<PlanPrompt>> {\n    return this.http.get<Paginated<PlanPrompt>>(`${this.baseUrl}/plans`);\n  }\n\n  getPlan(id: string): Observable<PlanPrompt> {\n    return this.http\n      .get<ApiDataResponse<PlanPrompt>>(`${this.baseUrl}/plans/${id}`)\n      .pipe(map((response) => response.data));\n  }\n\n  updatePlan(id: string, payload: PlanPromptPayload): Observable<PlanPrompt> {\n    return this.http\n      .put<ApiDataResponse<PlanPrompt>>(`${this.baseUrl}/plans/${id}`, payload)\n      .pipe(map((response) => response.data));\n  }\n\n  listQuarantine(): Observable<Paginated<QuarantinedPrompt>> {\n    return this.http.get<Paginated<QuarantinedPrompt>>(`${this.baseUrl}/quarantine`);\n  }\n\n  approvePrompt(id: string): Observable<void> {\n    return this.http.post<void>(`${this.baseUrl}/quarantine/${id}/approve`, {});\n  }\n\n  rejectPrompt(id: string, reason: string): Observable<void> {\n    return this.http.post<void>(`${this.baseUrl}/quarantine/${id}/reject`, { reason });\n  }\n\n  assignSegment(tenantId: string, segmentId: string): Observable<void> {\n    return this.http.put<void>(`${environment.apiUrl}/platform/tenants/${tenantId}/segment`, {\n      segment_id: segmentId,\n    });\n  }\n\n  resolvePromptPreview(): Observable<PromptResolveResponse> {\n    return this.http\n      .get<ApiDataResponse<PromptResolveResponse>>(`${environment.apiUrl}/ai/prompt/resolve`)\n      .pipe(map((response) => response.data));\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/app-shell.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/auth-store.service.ts","messages":[{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":54,"column":26,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":54,"endColumn":31,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[1390,1395],"text":"(token != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[1390,1395],"text":"(token ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[1390,1395],"text":"(Boolean(token))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":98,"column":12,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":98,"endColumn":15,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[2537,2541],"text":"raw == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[2538,2541],"text":"(raw ?? \"\")"},"desc":"Explicitly 