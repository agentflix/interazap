ment?: string;\n  email?: string;\n  phone?: string;\n  street?: string;\n  number?: string;\n  complement?: string;\n  district?: string;\n  address?: string;\n  city?: string;\n  state?: string;\n  zip?: string;\n  zip_code?: string;\n  zipcode?: string;\n  is_active: boolean;\n  tenant_code?: string;\n  primary_email?: string;\n  created_at?: string;\n  deleted_at?: string;\n}\n\nexport interface PaginatedResponse<T> {\n  data: T[];\n  meta: {\n    current_page: number;\n    total: number;\n    per_page: number;\n    last_page: number;\n  };\n}\n\nexport interface CompanyFilters {\n  search?: string;\n  is_active?: boolean;\n  trashed?: boolean;\n  created_from?: string;\n  created_to?: string;\n  per_page?: number;\n  page?: number;\n  sort_by?: 'name' | 'document' | 'is_active' | 'created_at';\n  sort_dir?: 'asc' | 'desc';\n  plan_id?: string | number;\n}\n\n@Injectable({ providedIn: 'root' })\nexport class CompanyService {\n  private readonly baseUrl = `${environment.apiUrl}/platform/tenants`;\n  private readonly http = inject(HttpClient);\n\n  list(filters: CompanyFilters = {}): Observable<PaginatedResponse<Company>> {\n    let params = new HttpParams();\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.is_active !== undefined)\n      params = params.set('is_active', String(filters.is_active));\n    if (filters.trashed) params = params.set('trashed', 'true');\n    if (filters.per_page) params = params.set('per_page', String(filters.per_page));\n    if (filters.page) params = params.set('page', String(filters.page));\n    if (filters.sort_by) params = params.set('sort_by', filters.sort_by);\n    if (filters.sort_dir) params = params.set('sort_dir', filters.sort_dir);\n    if (filters.plan_id) params = params.set('plan_id', String(filters.plan_id));\n    if (filters.created_from) params = params.set('created_from', filters.created_from);\n    if (filters.created_to) params = params.set('created_to', filters.created_to);\n\n    return this.http.get<PaginatedResponse<Company>>(this.baseUrl, { params });\n  }\n\n  create(data: Partial<Company>): Observable<{ data: Company }> {\n    return this.http.post<{ data: Company }>(this.baseUrl, data);\n  }\n\n  find(id: string | number): Observable<{ data: Company }> {\n    return this.http.get<{ data: Company }>(`${this.baseUrl}/${id}`);\n  }\n\n  update(id: string | number, data: Partial<Company>): Observable<{ data: Company }> {\n    return this.http.put<{ data: Company }>(`${this.baseUrl}/${id}`, data);\n  }\n\n  delete(id: string | number): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n\n  toggleActive(id: string | number): Observable<{ data: Company }> {\n    return this.http.patch<{ data: Company }>(`${this.baseUrl}/${id}/toggle-active`, {});\n  }\n\n  restore(id: string | number): Observable<{ data: Company }> {\n    return this.http.post<{ data: Company }>(`${this.baseUrl}/${id}/restore`, {});\n  }\n\n  forceDelete(id: string | number): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}/force`);\n  }\n\n  export(filters: CompanyFilters = {}): Observable<HttpResponse<Blob>> {\n    let params = new HttpParams();\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.is_active !== undefined)\n      params = params.set('is_active', String(filters.is_active));\n    if (filters.trashed) params = params.set('trashed', 'true');\n    if (filters.sort_by) params = params.set('sort_by', filters.sort_by);\n    if (filters.sort_dir) params = params.set('sort_dir', filters.sort_dir);\n    if (filters.created_from) params = params.set('created_from', filters.created_from);\n    if (filters.created_to) params = params.set('created_to', filters.created_to);\n\n    return this.http.get(`${this.baseUrl}/export`, {\n      params,\n      responseType: 'blob',\n      observe: 'response',\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.