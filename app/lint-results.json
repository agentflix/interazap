mponent,\n  AfRadioInputComponent,\n  AfTextInputComponent,\n  type AfRadioOption,\n} from '@shared/components';\nimport type {\n  BillingInvoice,\n  BillingInvoicePaymentMethod,\n} from '../../../../../core/services/billing-invoice.service';\nimport { BillingInvoiceService } from '../../../../../core/services/billing-invoice.service';\nimport { ToastService } from '../../../../../core/services/toast.service';\n\n@Component({\n  selector: 'app-invoice-payment-modal',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfModalComponent,\n    AfRadioInputComponent,\n    AfTextInputComponent,\n    AfButtonComponent,\n    AfLoadingButtonComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-modal [open]=\"isOpen()\" title=\"Pagamento\" size=\"lg\" (closed)=\"close()\">\n      <div class=\"space-y-4\">\n        @if (paymentStage() === 'select') {\n          <div class=\"space-y-4\">\n            <p class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n              Escolha o método de pagamento para a fatura selecionada.\n            </p>\n\n            <af-radio-input\n              [control]=\"paymentMethodControl\"\n              [options]=\"paymentMethodOptions\"\n              name=\"payment_method\"\n              orientation=\"vertical\"\n              classContainer=\"mb-0\"\n            />\n\n            @if (paymentMethod() === 'CREDIT_CARD') {\n              <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div class=\"md:col-span-2\">\n                  <af-text-input\n                    label=\"Nome no cartão\"\n                    [control]=\"cardForm.controls.holder_name\"\n                    placeholder=\"Ex: João Silva\"\n                    [required]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n\n                <div class=\"md:col-span-2\">\n                  <af-text-input\n                    label=\"Número do cartão\"\n                    [control]=\"cardForm.controls.number\"\n                    placeholder=\"4111 1111 1111 1111\"\n                    [required]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n\n                <af-text-input\n                  label=\"Mês\"\n                  [control]=\"cardForm.controls.expiry_month\"\n                  placeholder=\"12\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"Ano\"\n                  [control]=\"cardForm.controls.expiry_year\"\n                  placeholder=\"2028\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"CVV\"\n                  [control]=\"cardForm.controls.cvv\"\n                  placeholder=\"123\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"CPF/CNPJ\"\n                  [control]=\"holderForm.controls.cpf_cnpj\"\n                  placeholder=\"123.456.789-00\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"Email\"\n                  [control]=\"holderForm.controls.email\"\n                  type=\"email\"\n                  placeholder=\"joao@empresa.com\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"CEP\"\n                  [control]=\"holderForm.controls.postal_code\"\n                  placeholder=\"01310100\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <af-text-input\n                  label=\"Número\"\n                  [control]=\"holderForm.controls.address_number\"\n                  placeholder=\"123\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0\"\n                />\n\n                <div class=\"md:col-span-2\">\n                  <af-text-input\n                    label=\"Nome do titular\"\n                    [control]=\"holderForm.controls.name\"\n                    placeholder=\"João Silva\"\n                    [required]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n\n                <div class=\"md:col-span-2\">\n                  <af-text-input\n                    label=\"Telefone\"\n                    [control]=\"holderForm.controls.phone\"\n                    placeholder=\"11999999999\"\n                    [required]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            }\n          </div>\n        }\n\n        @if (paymentStage() === 'pix') {\n          <div class=\"space-y-4\">\n            <div class=\"flex items-center gap-3\">\n              <span class=\"size-10 text-accent-600 dark:text-accent-400\">\n                <lucide-icon name=\"qr-code\" [size]=\"36\" class=\"block\" />\n              </span>\n              <div>\n                <p class=\"text-sm font-medium text-neutral-800 dark:text-neutral-100\">\n                  PIX disponível\n                </p>\n                <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                  Escaneie o QR Code ou copie o código abaixo.\n                </p>\n              </div>\n            </div>\n\n            @if (pixQrCodeDataUrl()) {\n              <div class=\"flex justify-center\">\n                <img\n                  [src]=\"pixQrCodeDataUrl()\"\n                  alt=\"QR Code PIX\"\n                  class=\"h-40 w-40 rounded border border-neutral-200 dark:border-neutral-700\"\n                />\n              </div>\n            }\n\n            <div\n              class=\"bg-neutral-100 dark:bg-neutral-800 rounded p-3 text-xs text-neutral-600 dark:text-neutral-300 break-all\"\n            >\n              {{ pixPayload() || '-' }}\n            </div>\n\n            @if (pixExpiresAt()) {\n              <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                Expira em: {{ pixExpiresAt() }}\n              </p>\n            }\n          </div>\n        }\n      </div>\n\n      <div\n        footer\n        class=\"flex justify-end gap-2 px-6 py-4 border-t border-neutral-200 dark:border-neutral-700\"\n      >\n        @if (paymentStage() === 'select') {\n          <af-button variant=\"ghost\" size=\"sm\" (click)=\"close()\">Cancelar</af-button>\n          <af-loading-button\n            variant=\"primary\"\n            size=\"sm\"\n            [loading]=\"isPaying()\"\n            (click)=\"submitPayment()\"\n          >\n            Confirmar pagamento\n          </af-loading-button>\n        }\n\n        @if (paymentStage() === 'pix') {\n          <af-button variant=\"ghost\" size=\"sm\" (click)=\"close()\">Fechar</af-button>\n          <af-button\n            variant=\"primary\"\n            size=\"sm\"\n            [disabled]=\"!pixPayload()\"\n            (click)=\"copyPixPayload()\"\n          >\n            Copiar PIX\n          </af-button>\n        }\n      </div>\n    </af-modal>\n  `,\n})\nexport class InvoicePaymentModalComponent {\n  private readonly billingService = inject(BillingInvoiceService);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly fb = inject(NonNullableFormBuilder);\n\n  readonly invoice = input<BillingInvoice | null>(null);\n  readonly isOpen = input(false);\n  readonly closed = output<void>();\n  readonly paymentSuccess = output<void>();\n\n  readonly paymentMethodControl = new FormControl<string>('PIX', { nonNullable: true });\n  readonly paymentMethod = signal<BillingInvoicePaymentMethod>('PIX');\n  readonly paymentMethodOptions: AfRadioOption[] = [\n    { value: 'PIX', label: 'PIX' },\n    { value: 'CREDIT_CARD', label: 'Cartão de crédito' },\n  ];\n\n  readonly paymentStage = signal<'select' | 'pix'>('select');\n  readonly isPaying = signal(false);\n  readonly pixPayload = signal<string | null>(null);\n  readonly pixQrCode = signal<string | null>(null);\n  readonly pixExpiresAt = signal<string | null>(null);\n\n  readonly cardForm = this.fb.group({\n    holder_name: this.fb.control('', Validators.required),\n    number: this.fb.control('', Validators.required),\n    expiry_month: this.fb.control('', Validators.required),\n    expiry_year: this.fb.control('', Validators.required),\n    cvv: this.fb.control('', Validators.required),\n  });\n\n  readonly holderForm = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    email: this.fb.control('', [Validators.required, Validators.email]),\n    cpf_cnpj: this.fb.control('', Validators.required),\n    postal_code: this.fb.control('', Validators.required),\n    address_number: this.fb.control('', Validators.required),\n    phone: this.fb.control('', Validators.required),\n  });\n\n  readonly pixQrCodeDataUrl = computed(() => {\n    const qr = this.pixQrCode();\n    return qr ? `data:image/png;base64,${qr}` : null;\n  });\n\n  constructor() {\n    this.paymentMethodControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((value) => this.paymentMethod.set(value as BillingInvoicePaymentMethod));\n  }\n\n  submitPayment(): void {\n    const currentInvoice = this.invoice();\n    if (!currentInvoice || this.isPaying()) return;\n\n    const method = this.paymentMethod();\n    this.isPaying.set(true);\n\n    if (method === 'CREDIT_CARD' && (this.cardForm.invalid || this.holderForm.invalid)) {\n      this.cardForm.markAllAsTouched();\n      this.holderForm.markAllAsTouched();\n      this.isPaying.set(false);\n      return;\n    }\n\n    const payload = {\n      method,\n      card: method === 'CREDIT_CARD' ? this.cardForm.getRawValue() : undefined,\n      holder_info: method === 'CREDIT_CARD' ? this.holderForm.getRawValue() : undefined,\n    } as const;\n\n    this.billingService\n      .pay(currentInvoice.id, payload)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          if (method === 'PIX') {\n            const qr = response.data.qr_code_base64 ?? null;\n            const base64 = qr?.replace('data:image/png;base64,', '') ?? null;\n            this.pixQrCode.set(base64);\n            this.pixPayload.set(response.data.pix_copy_paste ?? null);\n            this.pixExpiresAt.set(response.data.expires_at ?? null);\n            this.paymentStage.set('pix');\n            this.isPaying.set(false);\n            return;\n          }\n\n          this.isPaying.set(false);\n          this.paymentSuccess.emit();\n        },\n        error: (error: { error?: { message?: string } }) => {\n          this.isPaying.set(false);\n          this.toast.error(error?.error?.message || 'Erro ao gerar cobrança.');\n        },\n      });\n  }\n\n  copyPixPayload(): void {\n    const payload = this.pixPayload();\n    if (!payload) return;\n    void navigator.clipboard.writeText(payload);\n    this.toast.success('Código PIX copiado.');\n  }\n\n  close(): void {\n    this.resetState();\n    this.closed.emit();\n  }\n\n  private resetState(): void {\n    this.isPaying.set(false);\n    this.paymentStage.set('select');\n    this.paymentMethod.set('PIX');\n    this.paymentMethodControl.setValue('PIX', { emitEvent: false });\n    this.pixPayload.set(null);\n    this.pixQrCode.set(null);\n    this.pixExpiresAt.set(null);\n    this.cardForm.reset();\n    this.holderForm.reset();\n  }\n}\n\nexport default InvoicePaymentModalComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/billing/invoices/invoices.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'FormControl' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":13,"endColumn":21},{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../core/services/billing-invoice.service' import is duplicated.","line":29,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":29,"endColumn":88},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected value in conditional. A boolean expression is required.","line":238,"column":72,"nodeType":"MemberExpression","messageId":"conditionErrorOther","endLine":238,"endColumn":86},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 11. Maximum allowed is 10.","line":270,"column":40,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":270,"endColumn":42},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":346,"column":10,"nodeType":"MemberExpression","messageId":"conditionErrorNullableString","endLine":346,"endColumn":29,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[10942,10962],"text":"invoice.payment_url == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[10943,10962],"text":"(invoice.payment_url ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[10942,10962],"text":"!Boolean(invoice.payment_url)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  effect,\n  inject,\n  signal,\n} from '@angular/core';\nimport { DatePipe } from '@angular/common';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { FormControl, NonNullableFormBuilder, ReactiveFormsModule } from '@angular/forms';\nimport { merge } from 'rxjs';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfBadgeComponent,\n  AfButtonComponent,\n  AfCrudPageComponent,\n  AfDataTableComponent,\n  AfIconButtonComponent,\n  AfSelectInputComponent,\n  AfTextInputComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { AuthStoreService } from '../../../core/services/auth-store.service';\nimport type { BillingInvoice } from '../../../core/services/billing-invoice.service';\nimport { BillingInvoiceService } from '../../../core/services/billing-invoice.service';\nimport { type Company, CompanyService } from '../../../core/services/company.service';\nimport { ToastService } from '../../../core/services/toast.service';\nimport { InvoicePaymentModalComponent } from './components/invoice-payment-modal/invoice-payment-modal';\n\n@Component({\n  selector: 'app-billing-invoices',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    DatePipe,\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfDataTableComponent,\n    AfBadgeComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfSelectInputComponent,\n    AfTextInputComponent,\n    AfAlertComponent,\n    InvoicePaymentModalComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Faturas\"\n      subtitle=\"Billing\"\n      searchPlaceholder=\"Buscar por mês...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhuma fatura encontrada\"\n      emptyDescription=\"Assim que houver cobranças, elas aparecerão aqui.\"\n      [skeletonColumns]=\"7\"\n      [skeletonRows]=\"6\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <div\n        filters\n        class=\"w-full flex flex-col gap-3 sm:flex-row sm:items-end sm:flex-wrap sm:justify-end\"\n      >\n        <div class=\"w-full sm:w-40\">\n          <af-text-input\n            label=\"Vencimento de\"\n            type=\"date\"\n            [control]=\"dueDateFromControl\"\n            size=\"sm\"\n            classContainer=\"mb-0\"\n          />\n        </div>\n        <div class=\"w-full sm:w-40\">\n          <af-text-input\n            label=\"Vencimento até\"\n            type=\"date\"\n            [control]=\"dueDateToControl\"\n            size=\"sm\"\n            classContainer=\"mb-0\"\n          />\n        </div>\n        <div class=\"w-full sm:w-44\">\n          <af-select-input\n            label=\"Método\"\n            [control]=\"paymentMethodFilterControl\"\n            [options]=\"paymentMethodOptions\"\n            size=\"sm\"\n            classContainer=\"mb-0\"\n          />\n        </div>\n        <div class=\"w-full sm:w-44\">\n          <af-select-input\n            label=\"Status\"\n            [control]=\"invoiceStatusControl\"\n            [options]=\"statusOptions\"\n            size=\"sm\"\n            classContainer=\"mb-0\"\n          />\n        </div>\n        @if (isAdminView()) {\n          <div class=\"w-full sm:w-52\">\n            <af-select-input\n              label=\"Empresa\"\n              [control]=\"tenantControl\"\n              [options]=\"tenantOptions()\"\n              size=\"sm\"\n              classContainer=\"mb-0\"\n            />\n          </div>\n        }\n        <div class=\"self-end\">\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"refresh()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Atualizar\n          </af-button>\n        </div>\n      </div>\n\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar faturas\"\n            message=\"Não foi possível carregar a listagem de faturas.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th>Referência</th>\n              <th>Plano</th>\n              <th class=\"text-right\">Valor</th>\n              <th>Vencimento</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (invoice of invoices(); track invoice.id) {\n              <tr>\n                <td>\n                  <div class=\"font-medium text-neutral-800 dark:text-neutral-100\">\n                    {{ invoice.reference_month }}\n                  </div>\n                  <p class=\"text-xs text-neutral-500\">ID: {{ invoice.id }}</p>\n                </td>\n                <td>{{ invoice.plan?.name || '-' }}</td>\n                <td class=\"text-right font-medium\">{{ formatCurrency(invoice.amount) }}</td>\n                <td>{{ invoice.due_date | date: 'dd/MM/yyyy' }}</td>\n                <td>\n                  <af-badge [variant]=\"statusVariant(invoice.status_color)\">\n                    {{ invoice.status_label || invoice.status }}\n                  </af-badge>\n                </td>\n                <td>\n                  <div class=\"flex items-center justify-end gap-1\">\n                    @if (invoice.payment_url) {\n                      <af-icon-button\n                        label=\"Ver pagamento\"\n                        variant=\"ghost\"\n                        size=\"sm\"\n                        (click)=\"openPaymentUrl(invoice)\"\n                      >\n                        <lucide-icon name=\"eye\" [size]=\"15\" class=\"block\" />\n                      </af-icon-button>\n                    }\n\n                    @if (canPay(invoice)) {\n                      <af-icon-button\n                        label=\"Pagar\"\n                        variant=\"outline\"\n                        size=\"sm\"\n                        (click)=\"openPay(invoice)\"\n                      >\n                        <lucide-icon name=\"credit-card\" [size]=\"15\" class=\"block\" />\n                      </af-icon-button>\n                    }\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <app-invoice-payment-modal\n      [invoice]=\"selectedInvoice()\"\n      [isOpen]=\"isPayModalOpen()\"\n      (closed)=\"closePay()\"\n      (paymentSuccess)=\"onPaymentSuccess()\"\n    />\n  `,\n})\nexport class BillingInvoices implements OnInit {\n  private readonly billingService = inject(BillingInvoiceService);\n  private readonly authStore = inject(AuthStoreService);\n  private readonly companyService = inject(CompanyService);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly fb = inject(NonNullableFormBuilder);\n\n  readonly invoices = signal<BillingInvoice[]>([]);\n  readonly isLoading = signal(true);\n  readonly hasError = signal(false);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n\n  readonly selectedInvoice = signal<BillingInvoice | null>(null);\n  readonly isPayModalOpen = signal(false);\n\n  readonly companies = signal<Company[]>([]);\n  readonly isLoadingCompanies = signal(false);\n\n  readonly dueDateFromControl = this.fb.control('');\n  readonly dueDateToControl = this.fb.control('');\n  readonly invoiceStatusControl = this.fb.control('');\n  readonly paymentMethodFilterControl = this.fb.control('');\n  readonly tenantControl = this.fb.control('');\n\n  readonly isAdminView = computed(() => {\n    const user = this.authStore.user();\n    if (!user) return false;\n    return this.authStore.hasPermission('billing.invoices.manage') || !user.tenant_id;\n  });\n\n  readonly statusOptions: AfSelectOption[] = [\n    { value: '', label: 'Todos' },\n    { value: 'draft', label: 'Rascunho' },\n    { value: 'pending', label: 'Pendente' },\n    { value: 'paid', label: 'Pago' },\n    { value: 'overdue', label: 'Atrasado' },\n    { value: 'cancelled', label: 'Cancelado' },\n  ];\n\n  readonly paymentMethodOptions: AfSelectOption[] = [\n    { value: '', label: 'Todos' },\n    { value: 'pix', label: 'PIX' },\n    { value: 'credit_card', label: 'Cartão' },\n  ];\n\n  readonly tenantOptions = computed<AfSelectOption[]>(() => {\n    if (this.isLoadingCompanies()) {\n      return [{ value: '', label: 'Carregando...', disabled: true }];\n    }\n\n    return [\n      { value: '', label: 'Todas' },\n      ...this.companies().map((company) => ({\n        value: String(company.id),\n        label: company.name,\n      })),\n    ];\n  });\n\n  readonly activeFilters = computed(() => ({\n    dueDateFrom: this.dueDateFromControl.value?.trim() || '',\n    dueDateTo: this.dueDateToControl.value?.trim() || '',\n    status: this.invoiceStatusControl.value?.trim() || '',\n    paymentMethod: this.paymentMethodFilterControl.value?.trim() || '',\n    tenantId: this.tenantControl.value?.trim() || '',\n  }));\n\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.invoices().length === 0,\n  );\n\n  private currentPage = 1;\n  private currentSearch = '';\n\n  constructor() {\n    merge(\n      this.dueDateFromControl.valueChanges,\n      this.dueDateToControl.valueChanges,\n      this.invoiceStatusControl.valueChanges,\n      this.paymentMethodFilterControl.valueChanges,\n      this.tenantControl.valueChanges,\n    )\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe(() => this.onFiltersChanged());\n\n    effect(() => {\n      if (!this.isAdminView() || this.isLoadingCompanies() || this.companies().length > 0) {\n        return;\n      }\n      this.loadCompanies();\n    });\n  }\n\n  ngOnInit(): void {\n    this.fetchInvoices(1);\n  }\n\n  onSearch(term: string): void {\n    this.currentSearch = term.trim();\n    this.fetchInvoices(1);\n  }\n\n  loadPage(page: number): void {\n    this.fetchInvoices(page);\n  }\n\n  refresh(): void {\n    this.fetchInvoices(this.currentPage, true);\n  }\n\n  retry(): void {\n    this.fetchInvoices(this.currentPage, true);\n  }\n\n  canPay(invoice: BillingInvoice): boolean {\n    return ['draft', 'pending', 'overdue'].includes(invoice.status);\n  }\n\n  openPay(invoice: BillingInvoice): void {\n    this.selectedInvoice.set(invoice);\n    this.isPayModalOpen.set(true);\n  }\n\n  closePay(): void {\n    this.isPayModalOpen.set(false);\n    this.selectedInvoice.set(null);\n  }\n\n  onPaymentSuccess(): void {\n    this.toast.success('Cobrança gerada com sucesso!');\n    this.fetchInvoices(this.currentPage, true);\n    this.closePay();\n  }\n\n  openPaymentUrl(invoice: BillingInvoice): void {\n    if (!invoice.payment_url) return;\n    window.open(invoice.payment_url, '_blank');\n  }\n\n  statusVariant(color?: string): 'default' | 'success' | 'warning' | 'danger' | 'info' {\n    const palette: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {\n      success: 'success',\n      primary: 'info',\n      danger: 'danger',\n      warning: 'warning',\n      default: 'default',\n    };\n\n    return palette[color ?? 'default'] ?? 'default';\n  }\n\n  formatCurrency(value: number): string {\n    return new Intl.NumberFormat('pt-BR', {\n      style: 'currency',\n      currency: 'BRL',\n    }).format(value);\n  }\n\n  private onFiltersChanged(): void {\n    if (this.currentPage !== 1) {\n      this.fetchInvoices(1);\n      return;\n    }\n\n    this.fetchInvoices(this.currentPage);\n  }\n\n  private fetchInvoices(page: number, keepData = false): void {\n    this.currentPage = page;\n    this.hasError.set(false);\n    this.isLoading.set(true);\n\n    this.billingService\n      .list({\n        search: this.currentSearch || undefined,\n        page,\n        per_page: this.meta().per_page,\n        status: this.activeFilters().status || undefined,\n        payment_method: this.activeFilters().paymentMethod || undefined,\n        due_date_from: this.activeFilters().dueDateFrom || undefined,\n        due_date_to: this.activeFilters().dueDateTo || undefined,\n        tenant_id:\n          this.isAdminView() && this.activeFilters().tenantId\n            ? this.activeFilters().tenantId\n            : undefined,\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.invoices.set(response.data ?? []);\n          this.meta.set(response.meta);\n          this.hasError.set(false);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          if (!keepData) {\n            this.invoices.set([]);\n          }\n          this.hasError.set(true);\n          this.isLoading.set(false);\n        },\n      });\n  }\n\n  private loadCompanies(): void {\n    this.isLoadingCompanies.set(true);\n    this.companyService\n      .list({\n        per_page: 100,\n        page: 1,\n        sort_by: 'name',\n        sort_dir: 'asc',\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.companies.set(response.data ?? []);\n          this.isLoadingCompanies.set(false);\n        },\n        error: () => {\n          this.isLoadingCompanies.set(false);\n          this.toast.error('Não foi possível carregar as empresas.');\n        },\n      });\n  }\n}\n\nexport default BillingInvoices;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/autopilot-crud.types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/chat/autopilot/autopilot.ts","messages":[{"ruleId":"@typescript-eslint/no-extraneous-class","severity":2,"message":"Unexpected empty class.","line":83,"column":14,"nodeType":"Identifier","messageId":"empty","endLine":83,"endColumn":29}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy } from '@angular/core';\nimport { RouterLink, RouterLinkActive, RouterOutlet } from '@angular/router';\nimport { AfPageTitleComponent } from '@shared/components';\n\n/**\n * Componente de layout para o módulo IA Autopilot.\n *\n * Fornece a estrutura de navegação por abas para as sub-áreas do Autopilot,\n * incluindo Playbooks, Ferramentas, Segurança, Simulador e Histórico.\n *\n * @class AutopilotLayout\n * @description Layout base com navegação para as funcionalidades de IA.\n */\n@Component({\n  selector: 'app-autopilot-layout',\n  standalone: true,\n  imports: [RouterOutlet, RouterLink, RouterLinkActive, AfPageTitleComponent],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"px-6 py-4\">\n      <af-page-title\n        title=\"IA Autopilot\"\n       