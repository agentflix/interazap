gEvent);\n      fixture.detectChanges();\n\n      expect(component.contactTyping()?.is_typing).toBe(false);\n    });\n\n    it('should subscribe to typing events on init', () => {\n      fixture.detectChanges();\n      component.ngOnInit();\n      // Effects são configurados no construtor, verificamos se o signal existe\n      expect(realtime.typing).toBeDefined();\n    });\n  });\n\n  describe('Real-time Events', () => {\n    it('should subscribe to message status updates', () => {\n      fixture.detectChanges();\n      // Effects são configurados no construtor, verificamos se o signal existe\n      expect(realtime.messageStatus).toBeDefined();\n    });\n\n    it('should subscribe to new messages', () => {\n      fixture.detectChanges();\n      // Effects são configurados no construtor, verificamos se o signal existe\n      expect(realtime.newMessage).toBeDefined();\n    });\n\n    it('should subscribe to message deletes', () => {\n      fixture.detectChanges();\n      // Effects são configurados no construtor, verificamos se o signal existe\n      expect(realtime.delete).toBeDefined();\n    });\n\n    it('should join realtime room when calledId is set', async () => {\n      fixture.detectChanges();\n      paramMapSubject.next(convertToParamMap({ calledId: 'called-123' }));\n\n      await new Promise((resolve) => setTimeout(resolve, 100));\n\n      expect(realtime.joinTicket).toHaveBeenCalledWith('called-123');\n    });\n\n    it('should leave room when switching to different called', async () => {\n      fixture.detectChanges();\n\n      paramMapSubject.next(convertToParamMap({ calledId: 'called-123' }));\n      await new Promise((resolve) => setTimeout(resolve, 100));\n\n      paramMapSubject.next(convertToParamMap({ calledId: 'called-456' }));\n      await new Promise((resolve) => setTimeout(resolve, 100));\n\n      expect(realtime.leaveTicket).toHaveBeenCalledWith('called-123');\n      expect(realtime.joinTicket).toHaveBeenCalledWith('called-456');\n    });\n  });\n\n  describe('Reply Functionality', () => {\n    it('should emit reply event when onReply is called', () => {\n      const replySpy = vi.fn();\n      component.reply.subscribe(replySpy);\n\n      component.onReply(mockMessage);\n\n      expect(replySpy).toHaveBeenCalledWith(mockMessage);\n    });\n  });\n\n  describe('UI Helpers', () => {\n    it('should return correct status icon', () => {\n      const msg = { ...mockMessage, direction: 'outgoing' } as CalledMessage;\n\n      msg.status = 'pending';\n      expect(component.getStatusIcon(msg)).toBe('lucideClock');\n\n      msg.status = 'sent';\n      expect(component.getStatusIcon(msg)).toBe('lucideCheck');\n\n      msg.status = 'delivered';\n      expect(component.getStatusIcon(msg)).toBe('lucideCheckCheck');\n\n      msg.status = 'read';\n      expect(component.getStatusIcon(msg)).toBe('lucideCheckCheck');\n\n      msg.status = 'failed';\n      expect(component.getStatusIcon(msg)).toBe('lucideAlertCircle');\n\n      const incoming = { ...mockMessage, direction: 'incoming' } as CalledMessage;\n      expect(component.getStatusIcon(incoming)).toBe('');\n    });\n\n    it('should return correct status class', () => {\n      const msg = { ...mockMessage, direction: 'outgoing' } as CalledMessage;\n\n      msg.status = 'pending';\n      expect(component.getStatusClass(msg)).toBe('text-default-400');\n\n      msg.status = 'read';\n      expect(component.getStatusClass(msg)).toBe('text-success');\n\n      msg.status = 'failed';\n      expect(component.getStatusClass(msg)).toBe('text-danger');\n    });\n\n    it('should format user initials correctly', () => {\n      (authStore.user as unknown as { set: (v: unknown) => void }).set({\n        ...mockUser,\n        name: 'Rafael Silva',\n      });\n      fixture.detectChanges();\n      expect(component.getUserInitials()).toBe('RS');\n\n      (authStore.user as unknown as { set: (v: unknown) => void }).set({\n        ...mockUser,\n        name: 'Rafael',\n      });\n     