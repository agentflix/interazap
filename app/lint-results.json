);\n  private readonly route = inject(ActivatedRoute);\n  private readonly router = inject(Router);\n\n  readonly currentReportTitle = signal('Relatórios');\n\n  ngOnInit(): void {\n    this.router.events\n      .pipe(\n        filter((event) => event instanceof NavigationEnd),\n        startWith(null),\n        map(() => this.resolveCurrentReportTitle()),\n        takeUntilDestroyed(this.destroyRef),\n      )\n      .subscribe((title) => this.currentReportTitle.set(title));\n  }\n\n  private resolveCurrentReportTitle(): string {\n    let currentRoute: ActivatedRoute | null = this.route;\n\n    while (currentRoute?.firstChild) {\n      currentRoute = currentRoute.firstChild;\n    }\n\n    return (currentRoute?.snapshot.data['title'] as string | undefined) ?? 'Relatórios';\n  }\n}\n\nexport default ReportsComponent;\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/ui-kit/ui-kit.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AfCurrencyInputComponent' is defined but never used. Allowed unused vars must match /^_/u.","line":48,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":48,"endColumn":27},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AfDocumentInputComponent' is defined but never used. Allowed unused vars must match /^_/u.","line":49,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":49,"endColumn":27},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AfFileInputComponent' is defined but never used. Allowed unused vars must match /^_/u.","line":50,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":50,"endColumn":23},{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../shared/components' import is duplicated.","line":114,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":129,"endColumn":34}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount"