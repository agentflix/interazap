ngCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { HttpClient, HttpParams } from '@angular/common/http';\nimport { Injectable, inject } from '@angular/core';\nimport { type Observable, map } from 'rxjs';\nimport { environment } from '@env/environment';\n\nexport interface Paginated<T> {\n  data: T[];\n  meta: {\n    current_page: number;\n    total: number;\n    per_page: number;\n    last_page: number;\n  };\n}\n\nexport type UazapiInstanceStatus = 'connected' | 'disconnected' | 'connecting' | 'qr' | 'all';\n\nexport interface ApiResponse<T> {\n  success: boolean;\n  message: string;\n  data: T;\n}\n\nexport interface UazapiInstance {\n  id: string;\n  name: string | null;\n  system_name: string | null;\n  token?: string | null;\n  admin_field_01?: string | null;\n  admin_field_02?: string | null;\n  status?: string | null;\n  last_seen_at?: string | null;\n  updated_at?: string | null;\n  token_preview?: string | null;\n}\n\nexport interface UazapiInstanceFilters {\n  search?: string;\n  status?: UazapiInstanceStatus;\n  page?: number;\n  per_page?: number;\n}\n\nexport interface CreateUazapiInstancePayload {\n  name: string;\n  system_name: string;\n  admin_field_01?: string | null;\n  admin_field_02?: string | null;\n}\n\nexport interface UpdateAdminFieldsPayload {\n  admin_field_01?: string | null;\n  admin_field_02?: string | null;\n}\n\nexport interface ConnectInstancePayload {\n  mode: 'qr' | 'pair';\n  phone?: string | null;\n}\n\nexport interface ConnectInstanceResponse {\n  instance: UazapiInstance;\n  connection: Record<string, unknown>;\n}\n\nexport interface StatusInstanceResponse {\n  instance: UazapiInstance;\n  status: Record<string, unknown>;\n}\n\nexport interface DisconnectInstanceResponse {\n  instance: UazapiInstance;\n  connection: Record<string, unknown>;\n}\n\n@Injectable({ providedIn: 'root' })\nexport class UazapiInstancesService {\n  private readonly baseUrl = `${environment.apiUrl}/platform/uazapi/instances`;\n  private readonly http = inject(HttpClient);\n\n  list(filters: UazapiInstanceFilters = {}): Observable<Paginated<UazapiInstance>> {\n    let params = new HttpParams();\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.status && filters.status !== 'all') params = params.set('status', filters.status);\n    if (filters.page) params = params.set('page', String(filters.page));\n    if (filters.per_page) params = params.set('per_page', String(filters.per_page));\n\n    return this.http\n      .get<Paginated<UazapiInstance>>(this.baseUrl, { params })\n      .pipe(map((resp) => this.normalize(resp)));\n  }\n\n  create(payload: CreateUazapiInstancePayload): Observable<UazapiInstance> {\n    return this.http\n      .post<ApiResponse<UazapiInstance>>(this.baseUrl, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  updateAdminFields(id: string, payload: UpdateAdminFieldsPayload): Observable<UazapiInstance> {\n    return this.http\n      .patch<ApiResponse<UazapiInstance>>(`${this.baseUrl}/${id}/admin-fields`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  updateName(id: string, name: string): Observable<UazapiInstance> {\n    return this.http\n      .patch<ApiResponse<UazapiInstance>>(`${this.baseUrl}/${id}/name`, { name })\n      .pipe(map((resp) => resp.data));\n  }\n\n  connect(id: string, payload: ConnectInstancePayload): Observable<ConnectInstanceResponse> {\n    return this.http\n      .post<ApiResponse<ConnectInstanceResponse>>(`${this.baseUrl}/${id}/connect`, payload)\n      .pipe(map((resp) => resp.data));\n  }\n\n  disconnect(id: string): Observable<DisconnectInstanceResponse> {\n    return this.http\n      .post<ApiResponse<DisconnectInstanceResponse>>(`${this.baseUrl}/${id}/disconnect`, {})\n      .pipe(map((resp) => resp.data));\n  }\n\n  status(id: string): Observable<StatusInstanceResponse> {\n    return this.http\n      .get<ApiResponse<StatusInstanceResponse>>(`${this.baseUrl}/${id}/status`)\n      .pipe(map((resp) => resp.data));\n  }\n\n  delete(id: string): Observable<void> {\n    return this.http.delete<ApiResponse<void>>(`${this.baseUrl}/${id}`).pipe(map(() => void 0));\n  }\n\n  private normalize(resp: Paginated<UazapiInstance>): Paginated<UazapiInstance> {\n    return {\n      data: resp.data ?? [],\n      meta: resp.meta ?? {\n        current_page: 1,\n        total: (resp.data ?? []).length,\n        per_page: (resp.data ?? []).length,\n        last_page: 1,\n      },\n    };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/user.service.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":70,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":70,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Injectable, inject } from '@angular/core';\nimport { HttpClient, HttpParams } from '@angular/common/http';\nimport type { Observable } from 'rxjs';\nimport { environment } from '@env/environment';\nimport type { Company } from './company.service';\n\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  role?: string;\n  avatar_url?: string;\n  department_id?: string | number;\n  company_id?: string | number;\n  company?: Company;\n  is_active: boolean;\n  is_primary_tenant_user?: boolean;\n}\n\nexport interface UserListResponse {\n  data: User[];\n  meta?: {\n    total: number;\n    per_page: number;\n    current_page: number;\n    last_page: number;\n  };\n}\n\nexport interface UserFilters {\n  search?: string;\n  is_active?: boolean;\n  page?: number;\n  per_page?: number;\n  sort_by?: string;\n  sort_dir?: string;\n}\n\n@Injectable({\n  providedIn: 'root',\n})\nexport class UserService {\n  private readonly http = inject(HttpClient);\n  private readonly apiUrl = `${environment.apiUrl}/users`;\n\n  list(params: UserFilters = {}): Observable<UserListResponse> {\n    let httpParams = new HttpParams();\n    Object.keys(params).forEach((key) => {\n      const value = (params as Record<string, string | number | boolean | undefined>)[key];\n      if (value !== undefined && value !== null) {\n        httpParams = httpParams.set(key, String(value));\n      }\n    });\n    return this.http.get<UserListResponse>(this.apiUrl, { params: httpParams });\n  }\n\n  show(id: string): Observable<{ data: User }> {\n    return this.http.get<{ data: User }>(`${this.apiUrl}/${id}`);\n  }\n\n  create(data: Partial<User> & { password?: string }): Observable<{ data: User }> {\n    return this.http.post<{ data: User }>(this.apiUrl, data);\n  }\n\n  update(id: string, data: Partial<User> & { password?: string }): Observable<{ data: User }> {\n    return this.http.put<{ data: User }>(`${this.apiUrl}/${id}`, data);\n  }\n\n  delete(id: string): Observable<void> {\n    return this.http.delete<void>(`${this.apiUrl}/${id}`);\n  }\n\n  toggleActive(id: string): Observable<{ data: User }> {\n    return this.http.patch<{ data: User }>(`${this.apiUrl}/${id}/toggle-active`, {});\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/layout/auth-layout/auth-layout.ts","messages":[{"ruleId":"@typescript-eslint/no-extraneous-class","severity":2,"message":"Unexpected empty class.","line":72,"column":14,"nodeType":"Identifier","messageId":"empty","endLine":72,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ChangeDetectionStrategy, Component } from '@angular/core';\nimport { RouterLink, RouterOutlet } from '@angular/router';\nimport { AfCardComponent } from '../../shared/components/card/card';\nimport { AfContainerComponent } from '../../shared/components/contai