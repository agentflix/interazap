t,\n    AfPageTitleComponent,\n    AfEmptyStateComponent,\n    AfStatusBadgeComponent,\n    AfSkeletonComponent,\n    AfTooltipComponent,\n    AfDividerComponent,\n    AfTextInputComponent,\n    AfCheckboxInputComponent,\n    AfSwitchInputComponent,\n    AfModalComponent,\n    AfConfirmModalComponent,\n    AfSearchInputComponent,\n    AfAddonInputComponent,\n    AfPhoneInputComponent,\n    AfMaskedInputComponent,\n    AfPasswordInputComponent,\n    AfPasswordStrengthComponent,\n    AfCopyInputComponent,\n    AfColorInputComponent,\n    AfFileUploadComponent,\n    AfSelectInputComponent,\n    AfTagInputComponent,\n    AfPaginationComponent,\n    AfSkeletonTableRowComponent,\n    AfCrudPageComponent,\n    AfRadioInputComponent,\n    AfTextareaInputComponent,\n    AfKpiCardComponent,\n    AfReportFiltersComponent,\n    AfReportExportComponent,\n    AfChatBubbleComponent,\n    AfChatListItemComponent,\n    AfChatComposerComponent,\n    AfButtonGroupComponent,\n    AfFabComponent,\n    AfDropdownButtonComponent,\n    AfTableActionsComponent,\n    AfBaseListComponent,\n    AfUnifiedListComponent,\n    AfBreadcrumbComponent,\n    AfTabsComponent,\n    AfStepperComponent,\n    AfAccordionItemComponent,\n    AfDrawerComponent,\n    AfCollapsibleComponent,\n    AfNavbarComponent,\n    AfSidebarItemComponent,\n    AfAlertComponent,\n    AfProgressBarComponent,\n    AfProgressCircleComponent,\n    AfTimelineComponent,\n    AfDescriptionListComponent,\n    AfCardComponent,\n    AfDataTableComponent,\n    AfCodeBlockComponent,\n    AfMeterComponent,\n    AfStatCardComponent,\n    AfDatePickerComponent,\n    AfDateRangePickerComponent,\n    AfTimePickerComponent,\n    AfAutocompleteComponent,\n    AfNumberInputComponent,\n    AfSliderComponent,\n    AfRatingComponent,\n    AfOtpInputComponent,\n    AfRangeSliderComponent,\n    AfBannerComponent,\n    AfCalloutComponent,\n    AfPopoverComponent,\n    AfSheetComponent,\n    AfClipboardComponent,\n    AfThemeSwitchComponent,\n    AfKbdComponent,\n    AfContainerComponent,\n    AfGridComponent,\n    AfStackComponent,\n    AfAspectRatioComponent,\n    AfScrollAreaComponent,\n    AfResizablePanelComponent,\n    AfSplitPaneComponent,\n    AfStickyHeaderComponent,\n    AfAvatarGroupComponent,\n    AfMentionInputComponent,\n    AfKanbanColumnComponent,\n    AfSortableListComponent,\n    AfTreeViewComponent,\n    AfCalendarComponent,\n    AfColorPaletteComponent,\n    AfImageCropperComponent,\n    AfDropdownMenuComponent,\n    AfCommandPaletteComponent,\n    AfCountdownComponent,\n    AfMarqueeComponent,\n    AfTypewriterComponent,\n    AfShortcutKeyComponent,\n    AfLocaleSwitchComponent,\n    AfInfiniteScrollComponent,\n    AfVirtualScrollComponent,\n    AfErrorBoundaryComponent,\n    LucideAngularModule,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"min-h-screen bg-surface-50 dark:bg-neutral-950 transition-colors duration-200\">\n      <!-- Header -->\n      <div\n        class=\"sticky top-0 z-20 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md border-b border-neutral-200/60 dark:border-neutral-800/60\"\n      >\n        <div class=\"max-w-7xl mx-auto px-6 py-4 flex items-center justify-between\">\n          <div>\n            <h1\n              class=\"text-2xl font-extrabold tracking-tight text-primary-900 dark:text-accent-500\"\n            >\n              UI Kit Showcase\n            </h1>\n            <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mt-0.5\">\n              AgentFlix Design System · {{ componentCount }} components\n            </p>\n          </div>\n          <div class=\"flex items-center gap-3\">\n            <button\n              (click)=\"toggleTheme()\"\n              class=\"px-3 py-1.5 text-sm font-medium rounded-lg border border-neutral-300 dark:border-neutral-600 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer\"\n            >\n              {{ theme.isDark() ? '☀️ Light' : '🌙 Dark' }}\n            </button>\n            <a\n              href=\"/\"\n              class=\"px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-900 text-white hover:bg-primary-700 transition-colors\"\n            >\n              ← Back to App\n            </a>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"max-w-7xl mx-auto px-6 py-10 space-y-16\">\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- � BUTTON & ACTION EXTENSIONS                 -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Button & Action Extensions\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Button Group · Dropdown · Table Actions · FAB</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Button Group & Dropdown -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Button Group & Dropdown\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-button-group · af-dropdown-button · grouped actions\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-center gap-6\">\n                  <af-button-group spacing=\"sm\">\n                    <af-button size=\"sm\" variant=\"secondary\">Voltar</af-button>\n                    <af-button size=\"sm\" variant=\"primary\">Salvar</af-button>\n                  </af-button-group>\n\n                  <af-dropdown-button\n                    label=\"Ações rápidas\"\n                    [options]=\"previewDropdownButtonOptions\"\n                    (optionSelected)=\"lastPreviewAction.set($event)\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Table Actions -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Table Actions\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-table-actions · view, edit, delete controls\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <af-table-actions [showView]=\"true\" />\n                <p class=\"mt-3 text-xs text-neutral-500 dark:text-neutral-400\">\n                  FAB ativo no canto inferior direito da tela.\n                </p>\n              </div>\n            </section>\n\n            <!-- Lists -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Lists</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-base-list · af-unified-list · structured list containers\n              </p>\n              <div class=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n                <div\n                  class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden\"\n                >\n                  <af-base-list>\n                    <div header class=\"font-semibold\">Base List</div>\n                    <div filters class=\"text-sm text-neutral-500\">Filtros rápidos</div>\n                    <div table class=\"p-3 text-sm\">Conteúdo da tabela</div>\n                    <div pagination class=\"text-xs text-neutral-500\">Paginação</div>\n                  </af-base-list>\n                </div>\n\n                <div\n                  class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden\"\n                >\n                  <af-unified-list\n                    [total]=\"2\"\n                    [currentPage]=\"1\"\n                    [lastPage]=\"1\"\n                    [perPage]=\"10\"\n                    createLabel=\"Adicionar\"\n                  >\n                    <ng-template #tableHeader>\n                      <tr>\n                        <th class=\"px-3 py-2 text-left text-xs\">Nome</th>\n                        <th class=\"px-3 py-2 text-left text-xs\">Email</th>\n                      </tr>\n                    </ng-template>\n                    <ng-template #tableBody>\n                      <tr>\n                        <td class=\"px-3 py-2 text-sm\">Ana</td>\n                        <td class=\"px-3 py-2 text-sm\">ana&#64;agentflix.dev</td>\n                      </tr>\n                      <tr>\n                        <td class=\"px-3 py-2 text-sm\">Bruno</td>\n                        <td class=\"px-3 py-2 text-sm\">bruno&#64;agentflix.dev</td>\n                      </tr>\n                    </ng-template>\n                  </af-unified-list>\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 🧭 NAVIGATION                                 -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">Navigation</h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Breadcrumb · Tabs · Stepper · Accordion · Drawer</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Breadcrumb, Tabs & Stepper -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Breadcrumb, Tabs & Stepper\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-breadcrumb · af-tabs · af-stepper · route navigation\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-6\"\n              >\n                <af-breadcrumb [items]=\"previewBreadcrumbItems\" />\n                <af-tabs\n                  [tabs]=\"previewTabs\"\n                  [activeTab]=\"previewActiveTab()\"\n                  (tabChange)=\"previewActiveTab.set($event)\"\n                />\n                <af-stepper [steps]=\"previewSteps\" [currentStep]=\"1\" />\n              </div>\n            </section>\n\n            <!-- Accordion & Collapsible -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Accordion & Collapsible\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-accordion-item · af-collapsible · expand/collapse panels\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <af-accordion-item title=\"Accordion item\" [open]=\"true\">\n                  <p class=\"text-sm text-neutral-500\">Conteúdo expandido do accordion.</p>\n                </af-accordion-item>\n                <af-collapsible title=\"Collapsible section\" [open]=\"true\">\n                  <p class=\"text-sm text-neutral-500\">Bloco colapsável.</p>\n                </af-collapsible>\n              </div>\n            </section>\n\n            <!-- Navbar, Sidebar & Drawer -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Navbar, Sidebar & Drawer\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-navbar · af-sidebar-item · af-drawer · app shell\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <af-navbar title=\"CRM\" [showBack]=\"true\" />\n                <div class=\"flex gap-3\">\n                  <af-sidebar-item icon=\"users\" label=\"Contatos\" [active]=\"true\" />\n                  <af-sidebar-item icon=\"message-circle\" label=\"Mensagens\" [badge]=\"3\" />\n                </div>\n                <div>\n                  <af-button size=\"sm\" variant=\"outline\" (click)=\"previewDrawerOpen.set(true)\">\n                    Abrir Drawer\n                  </af-button>\n                </div>\n                <af-drawer\n                  [open]=\"previewDrawerOpen()\"\n                  title=\"Menu lateral\"\n                  (closed)=\"previewDrawerOpen.set(false)\"\n                >\n                  <p class=\"text-sm text-neutral-500\">Conteúdo do drawer.</p>\n                </af-drawer>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 📊 DATA DISPLAY                               -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Data Display\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Progress · Timeline · Card · Table · Stat Card</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Data Display Components\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-progress-circle · af-timeline · af-card · af-stat-card · af-code-block\n              </p>\n              <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                <af-progress-circle [value]=\"72\" />\n                <af-timeline [entries]=\"previewTimelineEntries\" />\n                <af-description-list [items]=\"previewDescriptionItems\" layout=\"horizontal\" />\n                <af-card>\n                  <div header class=\"font-semibold\">Card Header</div>\n                  <p class=\"text-sm text-neutral-500\">Conteúdo do card</p>\n                </af-card>\n                <af-data-table [striped]=\"true\">\n                  <table>\n                    <thead>\n                      <tr>\n                        <th class=\"px-3 py-2\">Nome</th>\n                        <th class=\"px-3 py-2\">Status</th>\n                      </tr>\n                    </thead>\n                    <tbody>\n                      <tr>\n                        <td class=\"px-3 py-2\">Conta 1</td>\n                        <td class=\"px-3 py-2\">Ativa</td>\n                      </tr>\n                    </tbody>\n                  </table>\n                </af-data-table>\n                <af-code-block label=\"TypeScript\" language=\"ts\" code=\"const ok = true;\" />\n                <af-meter [value]=\"64\" label=\"Utilização\" />\n                <af-stat-card label=\"MRR\" value=\"R$ 98.300\" change=\"+12%\" changeType=\"positive\" />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- ✏️ ADVANCED FORM INPUTS                       -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Advanced Form Inputs\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Date · Time · Autocomplete · Slider · Rating · OTP</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Date, Time & Range Inputs\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-date-picker · af-time-picker · af-autocomplete · af-slider · af-rating\n              </p>\n              <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n                <af-date-picker [control]=\"demoDateControl\" label=\"Data\" />\n                <af-date-range-picker\n                  [startControl]=\"demoStartDateControl\"\n                  [endControl]=\"demoEndDateControl\"\n                  label=\"Período\"\n                />\n                <af-time-picker [control]=\"demoTimeControl\" label=\"Hora\" />\n                <af-autocomplete\n                  [control]=\"demoAutocompleteControl\"\n                  [options]=\"previewAutocompleteOptions\"\n                  label=\"Cidade\"\n                />\n                <af-number-input\n                  [control]=\"demoNumberControl\"\n                  [min]=\"1\"\n                  [max]=\"10\"\n                  label=\"Quantidade\"\n                />\n                <af-slider [value]=\"35\" label=\"Satisfação\" />\n                <af-rating [value]=\"4\" />\n                <af-otp-input [length]=\"6\" label=\"OTP\" />\n                <af-range-slider\n                  [minControl]=\"demoRangeMinControl\"\n                  [maxControl]=\"demoRangeMaxControl\"\n                  [min]=\"0\"\n                  [max]=\"100\"\n                  label=\"Faixa\"\n                />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 💬 FEEDBACK & OVERLAY                         -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Feedback & Overlay\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Alert · Banner · Callout · Popover · Sheet</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Alerts, Banners & Overlays\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-alert · af-banner · af-callout · af-popover · af-sheet\n              </p>\n              <div class=\"space-y-4\">\n                <af-alert\n                  variant=\"warning\"\n                  title=\"Atenção\"\n                  message=\"Este é um alerta real renderizado pelo af-alert\"\n                />\n                <af-alert\n                  variant=\"info\"\n                  title=\"Informação\"\n                  message=\"Alerta informativo com variante info\"\n                />\n                <div class=\"rounded-lg overflow-hidden -mx-6\">\n                  <af-banner variant=\"info\" message=\"Banner de informação\" />\n                </div>\n                <af-callout variant=\"success\" [title]=\"'Callout'\">\n                  <p>Mensagem destacada usando o componente.</p>\n                </af-callout>\n                <af-popover>\n                  <af-button trigger variant=\"outline\" size=\"sm\">Abrir Popover</af-button>\n                  <div content class=\"text-sm text-neutral-500\">Conteúdo do popover.</div>\n                </af-popover>\n                <af-button variant=\"outline\" size=\"sm\" (click)=\"previewSheetOpen.set(true)\"\n                  >Abrir Sheet</af-button\n                >\n                <af-sheet\n                  [open]=\"previewSheetOpen()\"\n                  title=\"Ações\"\n                  (closed)=\"previewSheetOpen.set(false)\"\n                >\n                  <p class=\"text-sm text-neutral-500\">Conteúdo do sheet.</p>\n                </af-sheet>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 📐 LAYOUT PRIMITIVES                          -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Layout Primitives\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Container · Grid · Stack · Scroll Area · Split Pane</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Layout Components\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-container · af-grid · af-stack · af-scroll-area · af-split-pane\n              </p>\n              <div class=\"space-y-4\">\n                <af-container size=\"md\">\n                  <p class=\"text-sm text-neutral-500\">Container centralizado</p>\n                </af-container>\n                <af-grid [cols]=\"3\" gap=\"sm\">\n                  <div class=\"h-10 rounded bg-neutral-100 dark:bg-neutral-700\"></div>\n                  <div class=\"h-10 rounded bg-neutral-100 dark:bg-neutral-700\"></div>\n                  <div class=\"h-10 rounded bg-neutral-100 dark:bg-neutral-700\"></div>\n                </af-grid>\n                <af-stack direction=\"row\" gap=\"sm\" align=\"center\">\n                  <af-badge variant=\"info\">Stack</af-badge>\n                  <af-badge variant=\"success\">Horizontal</af-badge>\n                </af-stack>\n                <af-aspect-ratio ratio=\"16/9\">\n                  <div\n                    class=\"w-full h-full rounded bg-neutral-100 dark:bg-neutral-700 flex items-center justify-center text-xs\"\n                  >\n                    16:9\n                  </div>\n                </af-aspect-ratio>\n                <af-scroll-area maxHeight=\"90px\">\n                  <div class=\"space-y-1 text-sm\">\n                    <p>Item 1</p>\n                    <p>Item 2</p>\n                    <p>Item 3</p>\n                    <p>Item 4</p>\n                    <p>Item 5</p>\n                    <p>Item 6</p>\n                  </div>\n                </af-scroll-area>\n                <div\n                  class=\"h-32 border border-neutral-200 dark:border-neutral-700 rounded overflow-hidden\"\n                >\n                  <af-resizable-panel [initialWidth]=\"140\">\n                    <div class=\"p-2 text-xs\">Resizable</div>\n                  </af-resizable-panel>\n                </div>\n                <div\n                  class=\"h-24 border border-neutral-200 dark:border-neutral-700 rounded overflow-hidden\"\n                >\n                  <af-split-pane [splitRatio]=\"35\">\n                    <div left class=\"p-2 text-xs\">Left</div>\n                    <div right class=\"p-2 text-xs\">Right</div>\n                  </af-split-pane>\n                </div>\n                <af-sticky-header>\n                  <div header class=\"p-2 bg-neutral-100 dark:bg-neutral-700 rounded text-xs\">\n                    Sticky header slot\n                  </div>\n                  <div class=\"p-2 text-xs text-neutral-500\">Conteúdo abaixo</div>\n                </af-sticky-header>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 🧩 ADVANCED / COMPOSITE                       -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Advanced / Composite\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Kanban · Tree View · Calendar · Image Cropper</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Composite Components\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-mention-input · af-kanban-column · af-tree-view · af-calendar\n              </p>\n              <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                <af-mention-input\n                  [users]=\"previewMentionUsers\"\n                  placeholder=\"Digite @ para mencionar\"\n                />\n                <af-kanban-column\n                  title=\"Em progresso\"\n                  [cards]=\"previewKanbanCards\"\n                  color=\"#f59e0b\"\n                />\n                <af-sortable-list [items]=\"previewSortableItems\" />\n                <af-tree-view [nodes]=\"previewTreeNodes\" />\n                <af-calendar [events]=\"previewCalendarEvents\" />\n                <af-image-cropper src=\"https://picsum.photos/400/300\" [aspectRatio]=\"1.5\" />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 🎯 INTERACTIVE                                -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Interactive\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Dropdown · Command Palette · Clipboard · Avatar Group</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Progress Bar -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Progress Bar\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-progress-bar · linear progress indicator · 3 variants\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <af-progress-bar [value]=\"68\" label=\"Progresso da migração\" variant=\"accent\" />\n                <af-progress-bar [value]=\"42\" label=\"Upload de dados\" variant=\"info\" />\n                <af-progress-bar [value]=\"90\" label=\"Processamento\" variant=\"warning\" />\n              </div>\n            </section>\n\n            <!-- Clipboard & Keyboard -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Clipboard & Keyboard Shortcuts\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-clipboard · af-kbd · copy to clipboard + keyboard key display\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <af-clipboard text=\"npm run build\" />\n                <af-clipboard text=\"git push origin main\" />\n                <div class=\"flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300\">\n                  <span>Atalhos:</span>\n                  <af-kbd>⌘</af-kbd><af-kbd>K</af-kbd>\n                  <span class=\"mx-2\">|</span>\n                  <af-kbd>Ctrl</af-kbd><af-kbd>Shift</af-kbd><af-kbd>P</af-kbd>\n                </div>\n              </div>\n            </section>\n\n            <!-- Avatar Group & Theme -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Avatar Group & Theme\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-avatar-group · af-theme-switch · af-color-palette · group + theme controls\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-6\"\n              >\n                <div class=\"flex items-center justify-between\">\n                  <af-avatar-group [items]=\"previewAvatars\" [max]=\"4\" size=\"sm\" />\n                  <af-theme-switch\n                    [mode]=\"previewThemeMode()\"\n                    (modeChange)=\"previewThemeMode.set($event)\"\n                  />\n                </div>\n                <af-color-palette\n                  [colors]=\"previewColors\"\n                  [selected]=\"selectedPreviewColor()\"\n                  (colorSelected)=\"selectedPreviewColor.set($event)\"\n                />\n              </div>\n            </section>\n\n            <!-- Dropdown Menu & Command Palette -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Dropdown Menu & Command Palette\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-dropdown-menu · af-command-palette · action menus + command search\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <div class=\"flex flex-wrap items-center gap-4\">\n                  <af-dropdown-menu\n                    [items]=\"previewMenuItems\"\n                    (itemSelected)=\"lastPreviewAction.set($event)\"\n                  >\n                    <af-button variant=\"outline\" size=\"sm\">Abrir menu</af-button>\n                  </af-dropdown-menu>\n                  <span class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                    ação: {{ lastPreviewAction() || '—' }}\n                  </span>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-4\">\n                  <af-button variant=\"secondary\" size=\"sm\" (click)=\"previewPaletteOpen.set(true)\">\n                    Abrir Command Palette\n                  </af-button>\n                  <span class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                    comando: {{ lastPreviewCommand() || '—' }}\n                  </span>\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- ⚙️ UTILITY                                    -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">Utility</h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Countdown · Marquee · Typewriter · Shortcuts · Scroll</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section\n              class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n            >\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Utility Components\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-countdown · af-marquee · af-typewriter · af-shortcut-key · af-locale-switch\n              </p>\n              <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4 items-start\">\n                <af-countdown [targetDate]=\"previewCountdownTarget\" />\n                <af-marquee>\n                  <span class=\"text-sm\">AgentFlix UI Kit • novos componentes renderizados •</span>\n                </af-marquee>\n                <af-typewriter [texts]=\"['UI Kit completo', '112 componentes', 'Preview real']\" />\n                <af-shortcut-key [keys]=\"['⌘', 'Shift', 'K']\" />\n                <af-locale-switch [locales]=\"previewLocales\" current=\"pt-BR\" />\n                <af-infinite-scroll>\n                  <div class=\"space-y-1 text-xs\">\n                    <div>Item A</div>\n                    <div>Item B</div>\n                    <div>Item C</div>\n                  </div>\n                </af-infinite-scroll>\n                <af-virtual-scroll [itemCount]=\"20\" [itemHeight]=\"28\" [containerHeight]=\"120\">\n                  <div\n                    class=\"px-2 py-1 text-xs border-b border-neutral-200 dark:border-neutral-700\"\n                  >\n                    Linha virtual\n                  </div>\n                </af-virtual-scroll>\n                <af-error-boundary\n                  title=\"Exemplo de erro\"\n                  message=\"Fallback visual do componente.\"\n                  [showRetry]=\"true\"\n                />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 🎨 FOUNDATION                                 -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">Foundation</h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Buttons · Badges · Avatars</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Buttons -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Buttons</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-button · 6 variants · 3 sizes\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-button variant=\"primary\">Primary</af-button>\n                  <af-button variant=\"secondary\">Secondary</af-button>\n                  <af-button variant=\"outline\">Outline</af-button>\n                  <af-button variant=\"ghost\">Ghost</af-button>\n                  <af-button variant=\"danger\">Danger</af-button>\n                  <af-button variant=\"ghost\">Link</af-button>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-button size=\"sm\">Small</af-button>\n                  <af-button size=\"md\">Medium</af-button>\n                  <af-button size=\"lg\">Large</af-button>\n                  <af-button [disabled]=\"true\">Disabled</af-button>\n                  <af-button [block]=\"true\">Block</af-button>\n                </div>\n              </div>\n            </section>\n\n            <!-- Loading / Icon buttons -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Button Variations\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-loading-button · af-icon-button\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-loading-button [loading]=\"isLoading()\" variant=\"primary\"\n                    >Salvar</af-loading-button\n                  >\n                  <af-loading-button [loading]=\"isLoading()\" variant=\"secondary\"\n                    >Processar</af-loading-button\n                  >\n                  <af-icon-button label=\"Adicionar\" variant=\"outline\"\n                    ><lucide-icon name=\"plus\" [size]=\"18\"\n                  /></af-icon-button>\n                  <af-icon-button label=\"Editar\" variant=\"outline\"\n                    ><lucide-icon name=\"pencil\" [size]=\"18\"\n                  /></af-icon-button>\n                  <af-icon-button label=\"Excluir\" variant=\"danger\"\n                    ><lucide-icon name=\"trash-2\" [size]=\"18\"\n                  /></af-icon-button>\n                  <af-icon-button label=\"Configurações\" variant=\"ghost\"\n                    ><lucide-icon name=\"settings\" [size]=\"18\"\n                  /></af-icon-button>\n                </div>\n              </div>\n            </section>\n\n            <!-- Badge & Status Badge -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Badges</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-badge · af-status-badge · variants + pulse\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-badge variant=\"default\">Default</af-badge>\n                  <af-badge variant=\"success\">Success</af-badge>\n                  <af-badge variant=\"warning\">Warning</af-badge>\n                  <af-badge variant=\"danger\">Danger</af-badge>\n                  <af-badge variant=\"info\">Info</af-badge>\n                </div>\n                <af-divider />\n                <div class=\"flex flex-wrap items-center gap-6\">\n                  <af-status-badge status=\"online\" [pulse]=\"true\">Online</af-status-badge>\n                  <af-status-badge status=\"offline\">Offline</af-status-badge>\n                  <af-status-badge status=\"warning\">Warning</af-status-badge>\n                  <af-status-badge status=\"error\" [pulse]=\"true\">Error</af-status-badge>\n                  <af-status-badge status=\"idle\">Idle</af-status-badge>\n                </div>\n              </div>\n            </section>\n\n            <!-- Avatar -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Avatar</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-avatar · Image, initials, fallback · 5 sizes\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-end gap-4\">\n                  <div class=\"flex flex-col items-center gap-1\">\n                    <af-avatar size=\"xs\" initials=\"XS\" />\n                    <span class=\"text-[10px] text-neutral-400\">xs</span>\n                  </div>\n                  <div class=\"flex flex-col items-center gap-1\">\n                    <af-avatar size=\"sm\" initials=\"SM\" />\n                    <span class=\"text-[10px] text-neutral-400\">sm</span>\n                  </div>\n                  <div class=\"flex flex-col items-center gap-1\">\n                    <af-avatar size=\"md\" initials=\"MD\" />\n                    <span class=\"text-[10px] text-neutral-400\">md</span>\n                  </div>\n                  <div class=\"flex flex-col items-center gap-1\">\n                    <af-avatar size=\"lg\" initials=\"LG\" />\n                    <span class=\"text-[10px] text-neutral-400\">lg</span>\n                  </div>\n                  <div class=\"flex flex-col items-center gap-1\">\n                    <af-avatar size=\"xl\" initials=\"XL\" />\n                    <span class=\"text-[10px] text-neutral-400\">xl</span>\n                  </div>\n                </div>\n              </div>\n            </section>\n\n            <!-- Divider -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Divider</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-divider · horizontal · optional label\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-4\"\n              >\n                <af-divider />\n                <af-divider label=\"OR\" />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 📦 LAYOUT & FEEDBACK                         -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Layout & Feedback\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Spinner · Skeleton · Empty State</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Spinner -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Spinner</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-spinner · 4 sizes · 2 colors\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-center gap-6\">\n                  <af-spinner size=\"sm\" />\n                  <af-spinner size=\"md\" />\n                  <af-spinner size=\"lg\" />\n                  <af-spinner size=\"lg\" />\n                  <af-spinner size=\"md\" color=\"white\" />\n                </div>\n              </div>\n            </section>\n\n            <!-- Skeleton -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Skeleton</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-skeleton · pulse animation · 3 variants\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-3\"\n              >\n                <af-skeleton variant=\"text\" class=\"w-3/4\" />\n                <af-skeleton variant=\"text\" class=\"w-1/2\" />\n                <div class=\"flex items-center gap-3 mt-4\">\n                  <af-skeleton variant=\"circular\" />\n                  <div class=\"flex-1 space-y-2\">\n                    <af-skeleton variant=\"text\" class=\"w-1/3\" />\n                    <af-skeleton variant=\"text\" class=\"w-2/3\" />\n                  </div>\n                </div>\n                <af-skeleton variant=\"rectangular\" class=\"w-full h-20 mt-4\" />\n              </div>\n            </section>\n\n            <!-- Tooltip -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Tooltip</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-tooltip · top/bottom/left/right\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-center gap-6\">\n                  <af-tooltip text=\"Tooltip acima\" position=\"top\"\n                    ><af-button variant=\"outline\" size=\"sm\">Top</af-button></af-tooltip\n                  >\n                  <af-tooltip text=\"Tooltip abaixo\" position=\"bottom\"\n                    ><af-button variant=\"outline\" size=\"sm\">Bottom</af-button></af-tooltip\n                  >\n                  <af-tooltip text=\"Tooltip à esquerda\" position=\"left\"\n                    ><af-button variant=\"outline\" size=\"sm\">Left</af-button></af-tooltip\n                  >\n                  <af-tooltip text=\"Tooltip à direita\" position=\"right\"\n                    ><af-button variant=\"outline\" size=\"sm\">Right</af-button></af-tooltip\n                  >\n                </div>\n              </div>\n            </section>\n\n            <!-- Page Title & Empty State -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Page Title & Empty State\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-page-title · af-empty-state\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6 space-y-6\"\n              >\n                <af-page-title title=\"Contatos\" subtitle=\"Gerencie sua lista de contatos\">\n                  <af-button variant=\"primary\" size=\"sm\">+ Novo</af-button>\n                </af-page-title>\n                <af-divider />\n                <af-empty-state\n                  title=\"Nenhum registro encontrado\"\n                  description=\"Crie seu primeiro registro para começar.\"\n                />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 📝 FORM INPUTS                               -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Form Inputs\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Text · Search · Select · Tags · Masks · Password</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Text Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Text Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-text-input · label, error, sizes\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-text-input\n                    [control]=\"nameControl\"\n                    label=\"Nome completo\"\n                    placeholder=\"João da Silva\"\n                    [required]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-text-input\n                    [control]=\"emailControl\"\n                    label=\"Email\"\n                    placeholder=\"joao&#64;email.com\"\n                    type=\"email\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-text-input\n                    [control]=\"readOnlyControl\"\n                    label=\"Somente leitura\"\n                    [readOnly]=\"true\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-text-input\n                    [control]=\"nameControl\"\n                    label=\"Small\"\n                    size=\"sm\"\n                    placeholder=\"Tamanho sm\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Search Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Search Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-search-input · magnifying glass + clear button\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-search-input [control]=\"searchControl\" placeholder=\"Buscar contatos...\" />\n                  <af-search-input\n                    [control]=\"searchControl2\"\n                    placeholder=\"Filtrar resultados...\"\n                    size=\"sm\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Addon Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Addon Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-addon-input · left button with icon and text\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-addon-input\n                    [control]=\"tagControl\"\n                    label=\"Tag\"\n                    addonIcon=\"plus\"\n                    addonLabel=\"Add\"\n                    placeholder=\"Nova tag...\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-addon-input\n                    [control]=\"urlControl\"\n                    label=\"URL do site\"\n                    addonLabel=\"https://\"\n                    placeholder=\"meusite.com.br\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Copy Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Copy Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-copy-input · clipboard copy with visual feedback\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-copy-input [control]=\"apiKeyControl\" label=\"API Key\" classContainer=\"mb-0\" />\n                  <af-copy-input\n                    [control]=\"webhookUrlControl\"\n                    label=\"Webhook URL\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Color Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Color Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-color-input · swatch + hex picker\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-color-input\n                    [control]=\"colorControl\"\n                    label=\"Cor primária\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-color-input\n                    [control]=\"colorControl2\"\n                    label=\"Cor secundária\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Phone Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Phone Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-phone-input · country selector + phone mask\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <af-phone-input\n                  [control]=\"phoneControl\"\n                  label=\"Telefone (WhatsApp)\"\n                  [required]=\"true\"\n                  classContainer=\"mb-0 max-w-md\"\n                />\n              </div>\n            </section>\n\n            <!-- Masked Inputs -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Masked Inputs\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-masked-input · CPF, CNPJ, CEP, Currency (afMask directive)\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n                  <af-masked-input\n                    [control]=\"cpfControl\"\n                    label=\"CPF\"\n                    mask=\"cpf\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-masked-input\n                    [control]=\"cnpjControl\"\n                    label=\"CNPJ\"\n                    mask=\"cnpj\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-masked-input\n                    [control]=\"docControl\"\n                    label=\"CPF/CNPJ\"\n                    mask=\"cpf-cnpj\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-masked-input\n                    [control]=\"cepControl\"\n                    label=\"CEP\"\n                    mask=\"cep\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-masked-input\n                    [control]=\"currencyControl\"\n                    label=\"Valor (R$)\"\n                    mask=\"currency\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Password Inputs -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Password Inputs\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-password-input · show/hide · af-password-strength · meter + checklist\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                  <div>\n                    <p\n                      class=\"text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-3 uppercase tracking-wider\"\n                    >\n                      Show / Hide\n                    </p>\n                    <af-password-input\n                      [control]=\"pwLoginControl\"\n                      label=\"Senha\"\n                      [required]=\"true\"\n                      classContainer=\"mb-0\"\n                    />\n                  </div>\n                  <div>\n                    <p\n                      class=\"text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-3 uppercase tracking-wider\"\n                    >\n                      Com Força da Senha\n                    </p>\n                    <af-password-strength\n                      [control]=\"pwNewControl\"\n                      label=\"Nova Senha\"\n                      [required]=\"true\"\n                      classContainer=\"mb-0\"\n                    />\n                  </div>\n                </div>\n              </div>\n            </section>\n\n            <!-- Select Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Select Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-select-input · searchable dropdown · single select\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-select-input\n                    [control]=\"selectControl\"\n                    [options]=\"statusOptions\"\n                    label=\"Status\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-select-input\n                    [control]=\"selectControl2\"\n                    [options]=\"countryOptions\"\n                    label=\"País\"\n                    placeholder=\"Escolha um país...\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Tag Input -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Tag Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-tag-input · chips · Enter to add · × to remove\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-tag-input\n                    [control]=\"tagsControl\"\n                    label=\"Tags\"\n                    placeholder=\"Digite e pressione Enter...\"\n                    [maxTags]=\"5\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-tag-input\n                    [control]=\"tagsControl2\"\n                    label=\"Habilidades\"\n                    placeholder=\"Ex: Angular, TypeScript...\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <!-- Checkbox & Switch -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Checkbox & Switch\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-checkbox-input · af-switch-input · FormControl + standalone\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                  <div class=\"space-y-3\">\n                    <p\n                      class=\"text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\"\n                    >\n                      Checkboxes\n                    </p>\n                    <af-checkbox-input\n                      [control]=\"checkboxControl\"\n                      label=\"Aceito os termos de uso\"\n                    />\n                    <af-checkbox-input\n                      [control]=\"checkboxControl2\"\n                      label=\"Receber notificações por email\"\n                    />\n                    <af-checkbox-input [control]=\"checkboxDisabled\" label=\"Desabilitado\" />\n                  </div>\n                  <div class=\"space-y-3\">\n                    <p\n                      class=\"text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\"\n                    >\n                      Switches\n                    </p>\n                    <div class=\"space-y-3\">\n                      <af-switch-input [control]=\"switchControl\" label=\"Notificações ativas\" />\n                      <af-switch-input\n                        [checked]=\"switchStandalone()\"\n                        label=\"Modo standalone\"\n                        labelPosition=\"left\"\n                        (toggled)=\"onSwitchToggle($event)\"\n                      />\n                      <af-switch-input\n                        [control]=\"switchDisabledControl\"\n                        label=\"Desabilitado (ligado)\"\n                        [disabled]=\"true\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 📁 FILE UPLOAD                                -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              File Upload\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Drag & drop · Progress · Cancel</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Single File Upload\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-file-upload · single file · progress bar\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <af-file-upload\n                  label=\"Avatar\"\n                  accept=\".jpg,.jpeg,.png,.webp\"\n                  classContainer=\"mb-0\"\n                />\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Multi File Upload\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-file-upload · multiple · cancel + remove\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <af-file-upload\n                  label=\"Documentos\"\n                  [multiple]=\"true\"\n                  accept=\".pdf,.doc,.docx,.xls,.xlsx\"\n                  classContainer=\"mb-0\"\n                />\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- 🪟 MODALS                                     -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">Modals</h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Dialogs · Confirm</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <!-- Modal -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">Modal</h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-modal · header, body, footer slots · 4 sizes\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-button variant=\"primary\" size=\"sm\" (click)=\"showModal.set(true)\"\n                    >Abrir Modal</af-button\n                  >\n                  <af-button variant=\"outline\" size=\"sm\" (click)=\"showLargeModal.set(true)\"\n                    >Modal Grande</af-button\n                  >\n                </div>\n              </div>\n            </section>\n\n            <!-- Confirm Modal -->\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Confirm Modal\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-confirm-modal · danger, warning, default variants\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-wrap items-center gap-3\">\n                  <af-button variant=\"danger\" size=\"sm\" (click)=\"showConfirmDanger.set(true)\"\n                    >Excluir (Danger)</af-button\n                  >\n                  <af-button variant=\"outline\" size=\"sm\" (click)=\"showConfirmWarning.set(true)\"\n                    >Aviso (Warning)</af-button\n                  >\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- DATA & CRUD                                   -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Data & CRUD\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Pagination · Skeleton Table · CRUD Page</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Pagination\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-pagination · prev/next · page numbers · ellipsis\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <af-pagination\n                  [currentPage]=\"paginationPage()\"\n                  [lastPage]=\"12\"\n                  [perPage]=\"15\"\n                  [total]=\"178\"\n                  (pageChange)=\"paginationPage.set($event)\"\n                />\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Skeleton Table Row\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-skeleton-table-row · loading placeholder · configurable cols/rows\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden\"\n              >\n                <af-skeleton-table-row [columns]=\"5\" [rows]=\"4\" />\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                CRUD Page\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-crud-page · orchestrates title, search, content, pagination, empty state\n              </p>\n              <div class=\"bg-neutral-100 dark:bg-neutral-900 rounded-xl p-4\">\n                <af-crud-page\n                  title=\"Contatos\"\n                  subtitle=\"Gerencie sua lista de contatos\"\n                  createLabel=\"Novo Contato\"\n                  [loading]=\"false\"\n                  [empty]=\"false\"\n                  [currentPage]=\"1\"\n                  [lastPage]=\"5\"\n                  [perPage]=\"10\"\n                  [total]=\"48\"\n                >\n                  <!-- Sample table content -->\n                  <table class=\"w-full text-sm\">\n                    <thead>\n                      <tr\n                        class=\"border-b border-neutral-200 dark:border-neutral-700 text-left text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider\"\n                      >\n                        <th class=\"px-4 py-3\">Nome</th>\n                        <th class=\"px-4 py-3\">Email</th>\n                        <th class=\"px-4 py-3\">Telefone</th>\n                        <th class=\"px-4 py-3\">Status</th>\n                      </tr>\n                    </thead>\n                    <tbody class=\"text-neutral-700 dark:text-neutral-300\">\n                      <tr class=\"border-b border-neutral-100 dark:border-neutral-800\">\n                        <td class=\"px-4 py-3 font-medium\">Maria Silva</td>\n                        <td class=\"px-4 py-3\">maria&#64;email.com</td>\n                        <td class=\"px-4 py-3\">(11) 98765-4321</td>\n                        <td class=\"px-4 py-3\">\n                          <af-status-badge status=\"online\">Ativo</af-status-badge>\n                        </td>\n                      </tr>\n                      <tr class=\"border-b border-neutral-100 dark:border-neutral-800\">\n                        <td class=\"px-4 py-3 font-medium\">João Santos</td>\n                        <td class=\"px-4 py-3\">joao&#64;email.com</td>\n                        <td class=\"px-4 py-3\">(21) 91234-5678</td>\n                        <td class=\"px-4 py-3\">\n                          <af-status-badge status=\"idle\">Pendente</af-status-badge>\n                        </td>\n                      </tr>\n                    </tbody>\n                  </table>\n                </af-crud-page>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- COMPLEMENTARY INPUTS                          -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Complementary Inputs\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Radio · Textarea</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Radio Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-radio-input · horizontal/vertical · custom styled circles\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                  <af-radio-input\n                    [control]=\"radioControl\"\n                    [options]=\"radioOptions\"\n                    name=\"status-radio\"\n                    label=\"Status\"\n                    orientation=\"vertical\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-radio-input\n                    [control]=\"radioControl2\"\n                    [options]=\"priorityOptions\"\n                    name=\"priority-radio\"\n                    label=\"Prioridade\"\n                    orientation=\"horizontal\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Textarea Input\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-textarea-input · auto-resize · char counter · resize modes\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <af-textarea-input\n                    [control]=\"textareaControl\"\n                    label=\"Descrição\"\n                    placeholder=\"Digite a descrição do contato...\"\n                    [maxLength]=\"500\"\n                    resize=\"auto\"\n                    classContainer=\"mb-0\"\n                  />\n                  <af-textarea-input\n                    [control]=\"notesControl\"\n                    label=\"Observações\"\n                    placeholder=\"Notas internas...\"\n                    [rows]=\"4\"\n                    resize=\"vertical\"\n                    classContainer=\"mb-0\"\n                  />\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- DASHBOARD & REPORTS                           -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">\n              Dashboard & Reports\n            </h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >KPI · Chart · Filters · Export</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                KPI Cards\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-kpi-card · value · trend indicator · loading state\n              </p>\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <af-kpi-card\n                  title=\"Receita\"\n                  value=\"R$ 48.250\"\n                  [change]=\"12.5\"\n                  changeLabel=\"vs mês anterior\"\n                  icon=\"dollar-sign\"\n                />\n                <af-kpi-card\n                  title=\"Novos Contatos\"\n                  value=\"1.284\"\n                  [change]=\"-3.2\"\n                  changeLabel=\"vs mês anterior\"\n                  icon=\"users\"\n                />\n                <af-kpi-card\n                  title=\"Taxa de Conversão\"\n                  value=\"24.8%\"\n                  [change]=\"5.1\"\n                  changeLabel=\"vs semana anterior\"\n                  icon=\"trending-up\"\n                />\n                <af-kpi-card\n                  title=\"Mensagens\"\n                  value=\"8.492\"\n                  [change]=\"0\"\n                  changeLabel=\"estável\"\n                  icon=\"message-square\"\n                  [loading]=\"false\"\n                />\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Report Filters & Export\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-report-filters · af-report-export · date range + status\n              </p>\n              <div\n                class=\"flex flex-col md:flex-row md:items-end gap-6 p-4 bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 w-full overflow-hidden\"\n              >\n                <div class=\"flex-1 w-full max-w-full overflow-x-auto pb-1\">\n                  <af-report-filters [statusOptions]=\"reportStatusOptions\" />\n                </div>\n                <div class=\"shrink-0 pb-1 flex items-end\">\n                  <af-report-export />\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n\n        <!-- ══════════════════════════════════════════════ -->\n        <!-- CHAT                                          -->\n        <!-- ══════════════════════════════════════════════ -->\n        <div>\n          <div class=\"flex items-center gap-2 mb-6\">\n            <h2 class=\"text-xl font-extrabold text-neutral-900 dark:text-neutral-50\">Chat</h2>\n            <span\n              class=\"ml-2 text-xs font-mono text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded\"\n              >Bubble · List Item · Composer</span\n            >\n          </div>\n\n          <div class=\"space-y-10\">\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Chat Bubble\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-chat-bubble · in/out direction · read receipts · timestamp\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 p-6\"\n              >\n                <div class=\"flex flex-col gap-3 max-w-lg mx-auto\">\n                  <af-chat-bubble\n                    message=\"Olá! Gostaria de saber sobre o plano Enterprise.\"\n                    timestamp=\"14:30\"\n                    senderName=\"Maria\"\n                    direction=\"in\"\n                  />\n                  <af-chat-bubble\n                    message=\"Claro, Maria! O plano Enterprise inclui atendentes ilimitados, API dedicada e suporte prioritário 24/7.\"\n                    timestamp=\"14:31\"\n                    direction=\"out\"\n                    status=\"delivered\"\n                  />\n                  <af-chat-bubble\n                    message=\"Perfeito! Pode me enviar uma proposta?\"\n                    timestamp=\"14:32\"\n                    senderName=\"Maria\"\n                    direction=\"in\"\n                  />\n                  <af-chat-bubble\n                    message=\"Já enviei por email! Confira sua caixa de entrada 📩\"\n                    timestamp=\"14:33\"\n                    direction=\"out\"\n                    status=\"read\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Chat List Item\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-chat-list-item · avatar · online dot · unread count · active state\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden max-w-sm\"\n              >\n                <af-chat-list-item\n                  name=\"Maria Silva\"\n                  lastMessage=\"Perfeito! Pode me enviar uma proposta?\"\n                  timestamp=\"14:32\"\n                  [unreadCount]=\"3\"\n                  [online]=\"true\"\n                  [active]=\"true\"\n                />\n                <af-chat-list-item\n                  name=\"João Santos\"\n                  lastMessage=\"Ok, obrigado pela informação\"\n                  timestamp=\"13:15\"\n                  [unreadCount]=\"0\"\n                  [online]=\"true\"\n                />\n                <af-chat-list-item\n                  name=\"Ana Oliveira\"\n                  lastMessage=\"Vou verificar e retorno\"\n                  timestamp=\"ontem\"\n                  [unreadCount]=\"1\"\n                  [online]=\"false\"\n                />\n                <af-chat-list-item\n                  name=\"Carlos Pereira\"\n                  lastMessage=\"Bom dia!\"\n                  timestamp=\"seg\"\n                  [unreadCount]=\"0\"\n                  [online]=\"false\"\n                />\n              </div>\n            </section>\n\n            <section>\n              <h3 class=\"text-lg font-bold text-neutral-900 dark:text-neutral-50 mb-1\">\n                Chat Composer\n              </h3>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4 font-mono\">\n                af-chat-composer · auto-resize · Enter to send · attach button\n              </p>\n              <div\n                class=\"bg-white dark:bg-neutral-800/50 rounded-xl border border-neutral-200 dark:border-neutral-700/50 overflow-hidden max-w-lg\"\n              >\n                <af-chat-composer placeholder=\"Digite sua mensagem...\" [maxLength]=\"1000\" />\n              </div>\n            </section>\n          </div>\n        </div>\n      </div>\n\n      <!-- Footer -->\n      <div\n        class=\"max-w-7xl mx-auto px-6 py-8 text-center text-xs text-neutral-400 dark:text-neutral-500\"\n      >\n        AgentFlix UI Kit · Phases 1–7 · {{ componentCount }} primitives\n      </div>\n\n      <!-- Modal instances -->\n      <af-modal [open]=\"showModal()\" title=\"Exemplo de Modal\" (closed)=\"showModal.set(false)\">\n        <p class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n          Este é o corpo do modal. Pode conter qualquer conteúdo Angular.\n        </p>\n        <div\n          footer\n          class=\"flex justify-end gap-3 px-6 py-4 border-t border-neutral-200 dark:border-neutral-700\"\n        >\n          <af-button variant=\"ghost\" size=\"sm\" (click)=\"showModal.set(false)\">Cancelar</af-button>\n          <af-button variant=\"primary\" size=\"sm\" (click)=\"showModal.set(false)\">Salvar</af-button>\n        </div>\n      </af-modal>\n\n      <af-modal\n        [open]=\"showLargeModal()\"\n        title=\"Modal Grande\"\n        size=\"lg\"\n        (closed)=\"showLargeModal.set(false)\"\n      >\n        <div class=\"space-y-4\">\n          <p class=\"text-sm text-neutral-600 dark:text-neutral-400\">\n            Modal com tamanho lg para formulários complexos.\n          </p>\n          <div class=\"grid grid-cols-2 gap-4\">\n            <af-text-input [control]=\"nameControl\" label=\"Nome\" placeholder=\"João\" />\n            <af-text-input\n              [control]=\"emailControl\"\n              label=\"Email\"\n              placeholder=\"joao&#64;email.com\"\n            />\n          </div>\n        </div>\n        <div\n          footer\n          class=\"flex justify-end gap-3 px-6 py-4 border-t border-neutral-200 dark:border-neutral-700\"\n        >\n          <af-button variant=\"ghost\" size=\"sm\" (click)=\"showLargeModal.set(false)\"\n            >Cancelar</af-button\n          >\n          <af-button variant=\"primary\" size=\"sm\" (click)=\"showLargeModal.set(false)\"\n            >Salvar</af-button\n          >\n        </div>\n      </af-modal>\n\n      <af-confirm-modal\n        [open]=\"showConfirmDanger()\"\n        title=\"Excluir Contato\"\n        message=\"Tem certeza que deseja excluir este contato? Esta ação não pode ser desfeita.\"\n        confirmLabel=\"Excluir\"\n        variant=\"danger\"\n        (confirmed)=\"showConfirmDanger.set(false)\"\n        (cancelled)=\"showConfirmDanger.set(false)\"\n      />\n\n      <af-confirm-modal\n        [open]=\"showConfirmWarning()\"\n        title=\"Atenção\"\n        message=\"Você está prestes a alterar as configurações do sistema. Deseja continuar?\"\n        confirmLabel=\"Continuar\"\n        variant=\"warning\"\n        (confirmed)=\"showConfirmWarning.set(false)\"\n        (cancelled)=\"showConfirmWarning.set(false)\"\n      />\n\n      <af-fab icon=\"plus\" ariaLabel=\"Novo item\" position=\"bottom-left\" />\n\n      <af-command-palette\n        [open]=\"previewPaletteOpen()\"\n        [items]=\"previewCommandItems\"\n        (closed)=\"previewPaletteOpen.set(false)\"\n        (itemSelected)=\"onPreviewCommand($event)\"\n      />\n    </div>\n  `,\n})\nexport default class UiKitComponent {\n  protected readonly theme = inject(ThemeService);\n  protected readonly componentCount = 112;\n  protected readonly isLoading = signal(true);\n  protected readonly previewPaletteOpen = signal(false);\n  protected readonly previewThemeMode = signal<'light' | 'dark' | 'system'>('system');\n  protected readonly selectedPreviewColor = signal('#6366f1');\n  protected readonly lastPreviewAction = signal('');\n  protected readonly lastPreviewCommand = signal('');\n  protected readonly previewDrawerOpen = signal(false);\n  protected readonly previewSheetOpen = signal(false);\n  protected readonly previewActiveTab = signal('overview');\n  protected readonly previewCountdownTarget = new Date(\n    Date.now() + 1000 * 60 * 60 * 24,\n  ).toISOString();\n\n  protected readonly previewAvatars: AfAvatarGroupItem[] = [\n    { name: 'Rafael Silva' },\n    { name: 'Ana Costa' },\n    { name: 'Lucas Lima' },\n    { name: 'Maya Santos' },\n    { name: 'Pedro Rocha' },\n  ];\n\n  protected readonly previewColors: AfColorOption[] = [\n    { label: 'Indigo', value: '#6366f1' },\n    { label: 'Emerald', value: '#10b981' },\n    { label: 'Amber', value: '#f59e0b' },\n    { label: 'Rose', value: '#f43f5e' },\n  ];\n\n  protected readonly previewMenuItems: AfDropdownMenuItem[] = [\n    { label: 'Editar', value: 'edit', icon: 'pencil' },\n    { label: 'Duplicar', value: 'duplicate', icon: 'copy' },\n    { divider: true, label: 'divider', value: 'divider' },\n    { label: 'Excluir', value: 'delete', icon: 'trash-2', destructive: true },\n  ];\n\n  protected readonly previewCommandItems: AfCommandItem[] = [\n    {\n      id: 'new-contact',\n      label: 'Novo contato',\n      description: 'Criar contato no CRM',\n      icon: 'user-plus',\n    },\n    {\n      id: 'open-settings',\n      label: 'Abrir configurações',\n      description: 'Ir para configurações',\n      icon: 'settings',\n    },\n    {\n      id: 'start-chat',\n      label: 'Iniciar chat',\n      description: 'Abrir conversa',\n      icon: 'message-circle',\n    },\n  ];\n\n  // Text inputs\n  protected readonly nameControl = new FormControl('', { nonNullable: true });\n  protected readonly emailControl = new FormControl('', { nonNullable: true });\n  protected readonly readOnlyControl = new FormControl('Valor fixo', { nonNullable: true });\n  protected readonly passwordControl = new FormControl('', { nonNullable: true });\n\n  // Search & Addon\n  protected readonly searchControl = new FormControl('', { nonNullable: true });\n  protected readonly searchControl2 = new FormControl('', { nonNullable: true });\n  protected readonly tagControl = new FormControl('', { nonNullable: true });\n  protected readonly urlControl = new FormControl('', { nonNullable: true });\n\n  // Copy Input\n  protecte