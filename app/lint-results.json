egotiationCompanySummary;\n  company?: NegotiationCompanySummary;\n  step?: FunnelStep;\n  funnel?: Funnel;\n  user?: NegotiationUserSummary;\n  created_at?: string;\n  updated_at?: string;\n}\n\nexport interface NegotiationPayload {\n  title: string;\n  funnel_id: string | number;\n  step_id: string | number;\n  contact_id: string | number;\n  crm_company_id: string | number;\n  user_id?: string | number;\n  value?: number;\n  expected_close_date?: string;\n  notes?: string;\n  status?: NegotiationStatus;\n}\n\nexport interface NegotiationFilters {\n  search?: string;\n  status?: NegotiationStatus | string;\n  funnel_id?: string | number;\n  step_id?: string | number;\n  company_id?: string | number;\n  contact_id?: string | number;\n  user_id?: string | number;\n  date_from?: string;\n  date_to?: string;\n  expected_close_from?: string;\n  expected_close_to?: string;\n  amount_min?: number;\n  amount_max?: number;\n  lead_score_min?: number;\n  lead_score_max?: number;\n  tag_ids?: (string | number)[];\n  reason_loss_id?: string | number;\n  has_pending_tasks?: boolean;\n  product_id?: string | number;\n  per_page?: number;\n  page?: number;\n}\n\ninterface NegotiationUpdateRequestBody {\n  title?: string;\n  amount?: number;\n  crm_negotiation_funnel_id?: string | number;\n  crm_negotiation_funnel_step_id?: string | number;\n  crm_contact_id?: string | number;\n  crm_company_id?: string | number;\n  auth_user_id?: string | number;\n  expected_close?: string;\n  notes?: string;\n  status?: NegotiationStatus;\n}\n\nexport interface NegotiationKanbanFilters {\n  status?: NegotiationStatus | string;\n  search?: string;\n  funnel_id?: string | number;\n  step_id?: string | number;\n  company_id?: string | number;\n  contact_id?: string | number;\n  user_id?: string | number;\n  date_from?: string;\n  date_to?: string;\n  expected_close_from?: string;\n  expected_close_to?: string;\n  amount_min?: number;\n  amount_max?: number;\n  lead_score_min?: number;\n  lead_score_max?: number;\n  tag_ids?: (string | number)[];\n  reason_loss_id?: string | number;\n  has_pending_tasks?: boolean;\n  product_id?: string | number;\n}\n\nexport interface NegotiationKanbanStep extends FunnelStep {\n  negotiations?: Negotiation[];\n}\n\nexport interface PaginatedResponse<T> {\n  data: T[];\n  meta: {\n    current_page: number;\n    last_page: number;\n    per_page: number;\n    total: number;\n  };\n}\n\n@Injectable({ providedIn: 'root' })\nexport class NegotiationService {\n  private readonly http = inject(HttpClient);\n  private readonly baseUrl = `${environment.apiUrl}/crm/negotiations`;\n\n  list(filters: NegotiationFilters = {}): Observable<PaginatedResponse<Negotiation>> {\n    let params = new HttpParams();\n\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.status) params = params.set('status', String(filters.status));\n    if (filters.funnel_id) params = params.set('funnel_id', String(filters.funnel_id));\n    if (filters.step_id) params = params.set('step_id', String(filters.step_id));\n    if (filters.company_id) params = params.set('company_id', String(filters.company_id));\n    if (filters.contact_id) params = params.set('contact_id', String(filters.contact_id));\n    if (filters.user_id) params = params.set('user_id', String(filters.user_id));\n    if (filters.date_from) params = params.set('date_from', filters.date_from);\n    if (filters.date_to) params = params.set('date_to', filters.date_to);\n    if (filters.expected_close_from)\n      params = params.set('expected_close_from', filters.expected_close_from);\n    if (filters.expected_close_to)\n      params = params.set('expected_close_to', filters.expected_close_to);\n    if (filters.amount_min !== undefined)\n      params = params.set('amount_min', String(filters.amount_min));\n    if (filters.amount_max !== undefined)\n      params = params.set('amount_max', String(filters.amount_max));\n    if (filters.lead_score_min !== undefined)\n      params = params.set('lead_score_min', String(filters.lead_score_min));\n    if (filters.lead_score_max !== undefined)\n      params = params.set('lead_score_max', String(filters.lead_score_max));\n    if (filters.reason_loss_id)\n      params = params.set('reason_loss_id', String(filters.reason_loss_id));\n    if (filters.has_pending_tasks !== undefined) {\n      params = params.set('has_pending_tasks', filters.has_pending_tasks ? 'true' : 'false');\n    }\n    if (filters.product_id) params = params.set('product_id', String(filters.product_id));\n    if (filters.tag_ids && filters.tag_ids.length > 0) {\n      filters.tag_ids.forEach((tagId) => {\n        params = params.append('tag_ids[]', String(tagId));\n      });\n    }\n    if (filters.per_page) params = params.set('per_page', String(filters.per_page));\n    if (filters.page) params = params.set('page', String(filters.page));\n\n    return this.http.get<PaginatedResponse<Negotiation>>(this.baseUrl, {\n      params,\n    });\n  }\n\n  get(id: string | number): Observable<{ data: { negotiation: Negotiation } }> {\n    return this.http.get<{ data: { negotiation: Negotiation } }>(`${this.baseUrl}/${id}`);\n  }\n\n  create(payload: NegotiationPayload): Observable<{ data: { negotiation: Negotiation } }> {\n    const body = {\n      title: payload.title,\n      amount: payload.value,\n      crm_negotiation_funnel_id: payload.funnel_id,\n      crm_negotiation_funnel_step_id: payload.step_id,\n      crm_contact_id: payload.contact_id,\n      crm_company_id: payload.crm_company_id,\n      auth_user_id: payload.user_id,\n      expected_close: payload.expected_close_date,\n      notes: payload.notes,\n      status: payload.status,\n    };\n    // user_id is handled by backend auth context or ignored if not in rules\n    return this.http.post<{ data: { negotiation: Negotiation } }>(this.baseUrl, body);\n  }\n\n  update(\n    id: string | number,\n    payload: Partial<NegotiationPayload>,\n  ): Observable<{ data: { negotiation: Negotiation } }> {\n    const body: NegotiationUpdateRequestBody = {};\n    if (payload.title !== undefined) body['title'] = payload.title;\n    if (payload.value !== undefined) body['amount'] = payload.value;\n    if (payload.funnel_id !== undefined) body['crm_negotiation_funnel_id'] = payload.funnel_id;\n    if (payload.step_id !== undefined) body['crm_negotiation_funnel_step_id'] = payload.step_id;\n    if (payload.contact_id !== undefined) body['crm_contact_id'] = payload.contact_id;\n    if (payload.crm_company_id !== undefined) body['crm_company_id'] = payload.crm_company_id;\n    if (payload.user_id !== undefined) body['auth_user_id'] = payload.user_id;\n    if (payload.expected_close_date !== undefined)\n      body['expected_close'] = payload.expected_close_date;\n    if (payload.notes !== undefined) body['notes'] = payload.notes;\n    if (payload.status !== undefined) body['status'] = payload.status;\n\n    return this.http.put<{ data: { negotiation: Negotiation } }>(`${this.baseUrl}/${id}`, body);\n  }\n\n  delete(id: string | number): Observable<void> {\n    return this.http.delete<void>(`${this.baseUrl}/${id}`);\n  }\n\n  kanban(\n    funnelId: string | number,\n    filters: NegotiationKanbanFilters = {},\n  ): Observable<{ data: { funnel: Funnel; steps: NegotiationKanbanStep[] } }> {\n    let params = new HttpParams();\n\n    params = params.set('funnel_id', String(funnelId));\n\n    if (filters.status) params = params.set('status', String(filters.status));\n    if (filters.search) params = params.set('search', filters.search);\n    if (filters.step_id) params = params.set('step_id', String(filters.step_id));\n    if (filters.company_id) params = params.set('company_id', String(filters.company_id));\n    if (filters.contact_id) params = params.set('contact_id', String(filters.contact_id));\n    if (filters.user_id) params = params.set('user_id', String(filters.user_id));\n    if (filters.date_from) params = params.set('date_from', filters.date_from);\n    if (filters.date_to) params = params.set('date_to', filters.date_to);\n    if (filters.expected_close_from)\n      params = params.set('expected_close_from', filters.expected_close_from);\n    if (filters.expected_close_to)\n      params = params.set('expected_close_to', filters.expected_close_to);\n    if (filters.amount_min !== undefined)\n      params = params.set('amount_min', String(filters.amount_min));\n    if (filters.amount_max !== undefined)\n      params = params.set('amount_max', String(filters.amount_max));\n    if (filters.lead_score_min !== undefined)\n      params = params.set('lead_score_min', String(filters.lead_score_min));\n    if (filters.lead_score_max !== undefined)\n      params = params.set('lead_score_max', String(filters.lead_score_max));\n    if (filters.reason_loss_id)\n      params = params.set('reason_loss_id', String(filters.reason_loss_id));\n    if (filters.has_pending_tasks !== undefined) {\n      params = params.set('has_pending_tasks', filters.has_pending_tasks ? 'true' : 'false');\n    }\n    if (filters.product_id) params = params.set('product_id', String(filters.product_id));\n    if (filters.tag_ids && filters.tag_ids.length > 0) {\n      filters.tag_ids.forEach((tagId) => {\n        params = params.append('tag_ids[]', String(tagId));\n      });\n    }\n\n    return this.http.get<{\n      data: { funnel: Funnel; steps: NegotiationKanbanStep[] };\n    }>(`${environment.apiUrl}/crm/negotiations-kanban`, {\n      params,\n    });\n  }\n\n  move(\n    id: string | number,\n    stepId: string | number,\n    position: number,\n  ): Observable<{ data: { negotiation: Negotiation } }> {\n    return this.http.post<{ data: { negotiation: Negotiation } }>(`${this.baseUrl}/${id}/move`, {\n      crm_negotiation_funnel_step_id: stepId,\n      position,\n    });\n  }\n\n  markAsWon(id: string | number): Observable<{ data: { negotiation: Negotiation } }> {\n    return this.http.post<{ data: { negotiation: Negotiation } }>(`${this.baseUrl}/${id}/won`, {});\n  }\n\n  markAsLost(\n    id: string | number,\n    reasonLossId?: string | number,\n    lossComment?: string,\n  ): Observable<{ data: { negotiation: Negotiation } }> {\n    return this.http.post<{ data: { negotiation: Negotiation } }>(`${this.baseUrl}/${id}/lost`, {\n      crm_reason_loss_id: reasonLossId,\n      loss_comment: lossComment,\n    });\n  }\n\n  reopen(id: string | number): Observable<{ data: { negotiation: Negotiation } }> {\n    return this.http.post<{ data: { negotiation: Negotiation } }>(\n      `${this.baseUrl}/${id}/reopen`,\n      {},\n    );\n  }\n\n  summary(filters: NegotiationFilters = {}): Observable<{ data: Record<string, unknown> }> {\n    let params = new HttpParams();\n\n    if (filters.status) params = params.set('status', String(filters.status));\n    if (filters.funnel_id) params = params.set('funnel_id', String(filters.funnel_id));\n    if (filters.step_id) params = params.set('step_id', String(filters.step_id));\n    if (filters.user_id) params = params.set('user_id', String(filters.user_id));\n    if (filters.date_from) params = params.set('date_from', filters.date_from);\n    if (filters.date_to) params = params.set('date_to', filters.date_to);\n\n    return this.http.get<{ data: Record<string, unknown> }>(`${this.baseUrl}/summary`, { params });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/core/services/opening-hour.service.ts","messages":[{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":63,"column":29,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":63,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Injectable, inject } from '@angular/core';\nimport { HttpClient } from '@angular/common/http';\nimport type { O