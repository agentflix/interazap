      placeholder=\"Opcional\"\n        dataTest=\"uazapi-form-admin-2\"\n      />\n    </form>\n  `,\n})\nexport class UazapiInstanceFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly service = inject(UazapiInstancesService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  readonly instance = input<UazapiInstance | null>(null);\n  readonly saved = output<UazapiInstance>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n  readonly isEditing = computed(() => this.instance() !== null);\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', { nonNullable: true, validators: [Validators.required] }),\n    system_name: this.fb.control('', { nonNullable: true, validators: [Validators.required] }),\n    admin_field_01: this.fb.control(''),\n    admin_field_02: this.fb.control(''),\n  });\n\n  constructor() {\n    effect(() => {\n      const current = this.instance();\n      if (current) {\n        if (this.lastLoadedId() === current.id) return;\n        this.lastLoadedId.set(current.id);\n\n        this.form.reset({\n          name: current.name ?? '',\n          system_name: current.system_name ?? '',\n          admin_field_01: current.admin_field_01 ?? '',\n          admin_field_02: current.admin_field_02 ?? '',\n        });\n        this.form.controls.system_name.disable({ emitEvent: false });\n      } else {\n        this.lastLoadedId.set(null);\n        this.form.enable({ emitEvent: false });\n        this.resetForm();\n      }\n    });\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const value = this.form.getRawValue();\n    const payload: CreateUazapiInstancePayload = {\n      name: value.name.trim(),\n      system_name: value.system_name.trim(),\n      admin_field_01: this.normalizeOptional(value.admin_field_01),\n      admin_field_02: this.normalizeOptional(value.admin_field_02),\n    };\n\n    const editing = this.instance();\n    this.isSaving.set(true);\n\n    if (!editing) {\n      this.service\n        .create(payload)\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe({\n          next: (response) => {\n            this.isSaving.set(false);\n            this.saved.emit(response);\n          },\n          error: () => {\n            this.isSaving.set(false);\n          },\n        });\n      return;\n    }\n\n    const updates = [] as ReturnType<UazapiInstancesService['updateName']>[];\n\n    if ((editing.name ?? '') !== payload.name) {\n      updates.push(this.service.updateName(editing.id, payload.name));\n    }\n\n    if (\n      (editing.admin_field_01 ?? null) !== payload.admin_field_01 ||\n      (editing.admin_field_02 ?? null) !== payload.admin_field_02\n    ) {\n      updates.push(\n        this.service.updateAdminFields(editing.id, {\n          admin_field_01: payload.admin_field_01,\n          admin_field_02: payload.admin_field_02,\n        }),\n      );\n    }\n\n    if (updates.length === 0) {\n      this.isSaving.set(false);\n      this.saved.emit({\n        ...editing,\n        name: payload.name,\n        admin_field_01: payload.admin_field_01,\n        admin_field_02: payload.admin_field_02,\n      });\n      return;\n    }\n\n    forkJoin(updates)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isSaving.set(false);\n          this.saved.emit({\n            ...editing,\n            name: payload.name,\n            admin_field_01: payload.admin_field_01,\n            admin_field_02: payload.admin_field_02,\n          });\n        },\n        error: () => {\n          this.isSaving.set(false);\n        },\n      });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  private resetForm(): void {\n    this.form.reset({\n      name: '',\n      system_name: '',\n      admin_