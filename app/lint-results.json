parison or type conversion is required.","line":133,"column":9,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":133,"endColumn":30,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[3772,3793],"text":"Boolean((errors?.['minlength']))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":166,"column":7,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":166,"endColumn":44,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[4562,4562],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[4562,4562],"text":"await "},"desc":"Add await operator."}]},{"ruleId":"complexity","severity":1,"message":"Method 'next' has a complexity of 11. Maximum allowed is 10.","line":187,"column":9,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":187,"endColumn":15},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":188,"column":15,"nodeType":"ChainExpression","messageId":"conditionErrorNullableBoolean","endLine":188,"endColumn":42,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[5096,5123],"text":"(response.data?.requires_2fa) ?? false"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareTrue","fix":{"range":[5096,5123],"text":"(response.data?.requires_2fa) === true"},"desc":"Change condition to check if true (`value === true`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish