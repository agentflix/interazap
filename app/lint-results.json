label()\" [required]=\"required()\" />\n      }\n      <div [class]=\"dropzoneClasses()\" (click)=\"openFileDialog()\">\n        <lucide-icon name=\"upload\" [size]=\"16\" class=\"text-neutral-400 shrink-0\" />\n        <span class=\"text-sm text-neutral-500 dark:text-neutral-400 truncate flex-1\">\n          {{ fileName() || 'Selecionar arquivo...' }}\n        </span>\n        <input\n          #fileRef\n          type=\"file\"\n          class=\"hidden\"\n          [accept]=\"accept()\"\n          [multiple]=\"multiple()\"\n          (change)=\"onFileChange($event)\"\n        />\n      </div>\n      <af-form-error [show]=\"showError()\" [message]=\"errorMessage()\" />\n    </div>\n  `,\n})\nexport class AfFileInputComponent {\n  /** FormControl for FileList binding */\n  readonly control = input<FormControl<FileList | null>>();\n\n  /** Field label */\n  readonly label = input('');\n\n  /** Accepted file types */\n  readonly accept = input('');\n\n  /** Allow multiple files */\n  readonly multiple = input(false);\n\n  /** Required field */\n  readonly required = input(false);\n\n  /** Error message */\n  readonly errorMessage = input('Arquivo obrigatório.');\n\n  protected readonly fileName = signal('');\n  protected readonly fileRef = viewChild<ElementRef<HTMLInputElement>>('fileRef');\n\n  protected readonly showError = computed(\n    () => !!this.control()?.invalid && !!this.control()?.touched,\n  );\n\n  protected readonly dropzoneClasses = computed(() => {\n    const border = this.showError()\n      ? 'border-red-500 dark:border-red-400'\n      : 'border-neutral-300 dark:border-neutral-600';\n    return [\n      'flex items-center gap-2 rounded-md border border-dashed',\n      'bg-white dark:bg-neutral-900 px-3 py-2.5',\n      'hover:border-accent-500 transition-colors cursor-pointer',\n      border,\n    ].join(' ');\n  });\n\n  protected openFileDialog(): void {\n    this.fileRef()?.nativeElement?.click();\n  }\n\n  protected onFileChange(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    const files = input.files;\n    if (files && files.length > 0) {\n      this.fileName.set(files.length === 1 ? files[0].name : `${files.length} arquivos`);\n      this.control()?.setValue(files);\n    } else {\n      this.fileName.set('');\n      this.control()?.setValue(null);\n    }\n    this.control()?.markAsTouched();\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/file-upload/file-upload.ts","messages":[{"ruleId":"@angular-eslint/template/label-has-associated-control","severity":1,"message":"A label component must be associated with a form element","line":44,"column":9,"nodeType":null,"messageId":"labelHasAssociatedControl","endLine":46,"endColumn":17},{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":50,"column":7,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":79,"endColumn":13},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":50,"column":7,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":79,"endColumn":13}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, signal, computed } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/** Represents a file being uploaded */\nexport interface AfUploadFile {\n  /** Original File object */\n  file: File;\n  /** Display name */\n  name: string;\n  /** File size in bytes */\n  size: number;\n  /** Upload progress 0-100 */\n  progress: number;\n  /** Upload state */\n  status: 'pending' | 'uploading' | 'done' | 'cancelled' | 'error';\n  /** Internal id */\n  id: string;\n}\n\n/**\n * File upload component for AgentFlix UI Kit.\n *\n * @description Drag & drop zone with file list, progress bars,\n * and cancel buttons. Supports single and multi-file upload.\n *\n * @example\n * ```html\n * <af-file-upload\n *   label=\"Documentos\"\n *   [multiple]=\"true\"\n *   accept=\".pdf,.doc,.docx\"\n *   (filesSelected)=\"onFiles($event)\"\n * />\n * ```\n */\n@Component({\n  selector: 'af-file-upload',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div [class]=\"classContainer()\">\n      @if (label()) {\n        <label class=\"block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1.5\">\n          {{ label() }}\n        </label>\n      }\n\n      <!-- Drop zone -->\n      <div\n        class=\"relative flex flex-col items-center justify-center px-6 py-8 border-2 border-dashed rounded-lg transition-colors cursor-pointer\"\n        [class]=\"dropzoneClasses()\"\n        (dragover)=\"onDragOver($event)\"\n        (dragleave)=\"onDragLeave($event)\"\n        (drop)=\"onDrop($event)\"\n        (click)=\"fileInput.click()\"\n      >\n        <lucide-icon\n          name=\"upload-cloud\"\n          [size]=\"40\"\n          class=\"text-neutral-400 dark:text-neutral-500 mb-3\"\n        />\n        <p class=\"text-sm text-neutral-600 dark:text-neutral-400 mb-1\">\n          <span class=\"font-semibold text-accent-600 dark:text-accent-400\">Clique para enviar</span>\n          ou arraste arquivos aqui\n        </p>\n        <p class=\"text-xs text-neutral-400 dark:text-neutral-500\">\n          {{ acceptHint() }}\n        </p>\n\n        <input\n          #fileInput\n          type=\"file\"\n          class=\"sr-only\"\n          [accept]=\"accept()\"\n          [multiple]=\"multiple()\"\n          (change)=\"onFileSelect($event)\"\n        />\n      </div>\n\n      <!-- File list -->\n      @if (files().length > 0) {\n        <ul class=\"mt-3 space-y-2\">\n          @for (f of files(); track f.id) {\n            <li\n              class=\"flex items-center gap-3 px-3 py-2 rounded-md bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700\"\n            >\n              <!-- File icon -->\n              <lucide-icon name=\"file\" [size]=\"18\" class=\"text-neutral-400 shrink-0\" />\n\n              <!-- Info -->\n              <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm text-neutral-800 dark:text-neutral-200 truncate\">{{ f.name }}</p>\n                <div class=\"flex items-center gap-2 mt-1\">\n                  <span class=\"text-xs text-neutral-400\">{{ formatSize(f.size) }}</span>\n\n                  @if (f.status === 'uploading') {\n                    <!-- Progress bar -->\n                    <div\n                      class=\"flex-1 h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-full overflow-hidden\"\n                    >\n                      <div\n                        class=\"h-full bg-accent-500 rounded-full transition-all duration-300\"\n                        [style.width.%]=\"f.progress\"\n                      ></div>\n                    </div>\n                    <span class=\"text-xs font-medium text-accent-600 dark:text-accent-400\"\n                      >{{ f.progress }}%</span\n                    >\n                  }\n\n                  @if (f.status === 'done') {\n                    <lucide-icon name=\"check-circle\" [size]=\"14\" class=\"text-green-500\" />\n                    <span class=\"text-xs text-green-600 dark:text-green-400\">Concluído</span>\n                  }\n\n                  @if (f.status === 'cancelled') {\n                    <span class=\"text-xs text-neutral-400\">Cancelado</span>\n                  }\n\n                  @if (f.status === 'error') {\n                    <span class=\"text-xs text-red-500\">Erro no envio</span>\n                  }\n                </div>\n              </div>\n\n              <!-- Actions -->\n              @if (f.status === 'uploading' || f.status === 'pending') {\n                <button\n                  type=\"button\"\n                  class=\"p-1 rounded hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-400 hover:text-red-500 transition-colors cursor-pointer\"\n                  (click)=\"cancelFile(f.id, $event)\"\n                  aria-label=\"Cancelar envio\"\n                >\n                  <lucide-icon name=\"x\" [size]=\"16\" />\n                </button>\n              }\n\n              @if (f.status === 'done' || f.status === 'cancelled' || f.status === 'error') {\n                <button\n                  type=\"button\"\n                  class=\"p-1 rounded hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-400 hover:text-red-500 transition-colors cursor-pointer\"\n                  (click)=\"removeFile(f.id, $event)\"\n                  aria-label=\"Remover arquivo\"\n                >\n                  <lucide-icon name=\"trash-2\" [size]=\"16\" />\n                </button>\n              }\n            </li>\n          }\n        </ul>\n      }\n    </div>\n  `,\n})\nexport class AfFileUploadComponent {\n  /** Label text */\n  readonly label = input<string>();\n\n  /** Container CSS class */\n  readonly classContainer = input<string>('mb-4');\n\n  /** Accept file types */\n  readonly accept = input<string>('');\n\n  /** Allow multiple files */\n  readonly multiple = input(false);\n\n  /** Emitted when files are selected */\n  readonly filesSelected = output<File[]>();\n\n  /** Internal file list */\n  protected readonly files = signal<AfUploadFile[]>([]);\n\n  /** Whether drag is active */\n  private readonly isDragging = signal(false);\n\n  /** Dynamic dropzone classes */\n  protected readonly dropzoneClasses = computed(() => {\n    if (this.isDragging()) {\n      return 'border-accent-500 bg-accent-50/50 dark:bg-accent-950/20';\n    }\n    return 'border-neutral-300 dark:border-neutral-600 hover:border-accent-400 dark:hover:border-accent-500 bg-white dark:bg-neutral-900';\n  });\n\n  /** Hint text from accept attribute */\n  protected readonly acceptHint = computed(() => {\n    const a = this.accept();\n    if (!a) return this.multiple() ? 'Envie múltiplos arquivos' : 'Qualquer tipo de arquivo';\n    return `Formatos aceitos: ${a}`;\n  });\n\n  /** Handle drag over */\n  protected onDragOver(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(true);\n  }\n\n  /** Handle drag leave */\n  protected onDragLeave(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(false);\n  }\n\n  /** Handle drop */\n  protected onDrop(event: DragEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.isDragging.set(false);\n\n    const droppedFiles = event.dataTransfer?.files;\n    if (droppedFiles) {\n      this.addFiles(Array.from(droppedFiles));\n    }\n  }\n\n  /** Handle native file input change */\n  protected onFileSelect(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    if (input.files) {\n      this.addFiles(Array.from(input.files));\n      input.value = ''; // Reset for re-selecting same file\n    }\n  }\n\n  /** Cancel a file upload */\n  protected cancelFile(id: string, event: Event): void {\n    event.stopPropagation();\n    this.files.update((files) =>\n      files.map((f) => (f.id === id ? { ...f, status: 'cancelled' as const, progress: 0 } : f)),\n    );\n  }\n\n  /** Remove a file from the list */\n  protected removeFile(id: string, event: Event): void {\n    event.stopPropagation();\n    this.files.update((files) => files.filter((f) => f.id !== id));\n  }\n\n  /** Format file size to human readable */\n  protected formatSize(bytes: number): string {\n    if (bytes < 1024) return `${bytes} B`;\n    if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`;\n    return `${(bytes / 1048576).toFixed(1)} MB`;\n  }\n\n  /** Add files to the list and simulate upload */\n  private addFiles(fileList: File[]): void {\n    const filesToAdd = this.multiple() ? fileList : [fileList[0]];\n    const newFiles: AfUploadFile[] = filesToAdd.map((file) => ({\n      file,\n      name: file.name,\n      size: file.size,\n      progress: 0,\n      status: 'pending' as const,\n      id: `file-${Math.random().toString(36).slice(2, 9)}`,\n    }));\n\n    if (!this.multiple()) {\n      this.files.set(newFiles);\n    } else {\n      this.files.update((existing) => [...existing, ...newFiles]);\n    }\n\n    this.filesSelected.emit(filesToAdd);\n\n    // Simulate upload progress for each file\n    for (const f of newFiles) {\n      this.simulateUpload(f.id);\n    }\n  }\n\n  /** Simulate file upload progress */\n  private simulateUpload(id: string): void {\n    let progress = 0;\n    const interval = setInterval(() => {\n      const current = this.files().find((f) => f.id === id);\n      if (!current || current.status === 'cancelled') {\n        clearInterval(interval);\n        return;\n      }\n\n      progress += Math.floor(Math.random() * 15) + 5;\n      if (progress >= 100) {\n        progress = 100;\n        clearInterval(interval);\n        this.files.update((files) =>\n          files.map((f) => (f.id === id ? { ...f, progress: 100, status: 'done' as const } : f)),\n        );\n      } else {\n        this.files.update((files) =>\n          files.map((f) => (f.id === id ? { ...f, progress, status: 'uploading' as const } : f)),\n        );\n      }\n    }, 300);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/form-error/form-error.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/form-label/form-label.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/grid/grid.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/icon-button/icon-button.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/image-cropper/image-cropper.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/infinite-scroll/infinite-scroll.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":24},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'signal' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":9},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":50,"column":30,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":50,"endColumn":34}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ElementRef, OnInit, OnDestroy } from '@angular/core';\nimport {\n  Component,\n  ChangeDetectionStrategy,\n  input,\n  output,\n  signal,\n  viewChild,\n} from '@angular/core';\n\n/**\n * AfInfiniteScrollComponent — Triggers load-more when scrolling near bottom.\n *\n * @example\n * ```html\n * <af-infinite-scroll (loadMore)=\"fetchNextPage()\" [loading]=\"loading()\">\n *   @for (item of items(); track item.id) {\n *     <app-item-card [item]=\"item\" />\n *   }\n * </af-infinite-scroll>\n * ```\n */\n@Component({\n  selector: 'af-infinite-scroll',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div>\n      <ng-content />\n      <div #sentinel class=\"h-1\"></div>\n      @if (loading()) {\n        <div class=\"flex justify-center py-4\">\n          <div\n            class=\"w-6 h-6 border-2 border-accent-600 border-t-transparent rounded-full animate-spin\"\n          ></div>\n        </div>\n      }\n    </div>\n  `,\n  host: { class: 'block' },\n})\nexport class AfInfiniteScrollComponent implements OnInit, OnDestroy {\n  /** Whether currently loading */\n  readonly loading = input(false);\n\n  /** Threshold in pixels before bottom to trigger */\n  readonly threshold = input(100);\n\n  /** Emitted when more content should be loaded */\n  readonly loadMore = output<void>();\n\n  private readonly sentinelRef = viewChild<ElementRef<HTMLElement>>('sentinel');\n  private observer: IntersectionObserver | null = null;\n\n  ngOnInit(): void {\n    // Defer to allow template to render\n    queueMicrotask(() => this.setupObserver());\n  }\n\n  ngOnDestroy(): void {\n    this.observer?.disconnect();\n  }\n\n  private setupObserver(): void {\n    const sentinel = this.sentinelRef()?.nativeElement;\n    if (!sentinel) return;\n\n    this.observer = new IntersectionObserver(\n      (entries) => {\n        if (entries[0]?.isIntersecting && !this.loading()) {\n          this.loadMore.emit();\n        }\n      },\n      { rootMargin: `0px 0px ${this.threshold()}px 0px` },\n    );\n    this.observer.observe(sentinel);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/inputs.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/kanban-column/kanban-column.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'signal' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":61,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":67},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'computed' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":69,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":77},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":100,"column":32,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":100,"endColumn":36},{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":55,"column":11,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":75,"endColumn":17},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":55,"column":11,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":75,"endColumn":17}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Component, ChangeDetectionStrategy, input, output, signal, computed } from '@angular/core';\nimport { LucideAngularModule } from 'lucide-angular';\n\n/** Kanban card */\nexport interface AfKanbanCard {\n  id: string;\n  title: string;\n  description?: string;\n  tag?: string;\n  tagColor?: string;\n}\n\n/**\n * AfKanbanColumnComponent — Single kanban board column.\n *\n * @example\n * ```html\n * <af-kanban-column title=\"Em progresso\" [cards]=\"inProgressCards\" color=\"#f59e0b\"\n *   (cardClicked)=\"onCard($event)\" (addClicked)=\"addCard('in-progress')\" />\n * ```\n */\n@Component({\n  selector: 'af-kanban-column',\n  standalone: true,\n  imports: [LucideAngularModule],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div\n      class=\"bg-neutral-50 dark:bg-neutral-800/50 rounded-xl p-3 min-w-[280px] max-w-[320px] flex flex-col h-full\"\n    >\n      <!-- Header -->\n      <div class=\"flex items-center justify-between mb-3\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-2.5 h-2.5 rounded-full\" [style.background-color]=\"color()\"></div>\n          <span class=\"text-sm font-semibold text-neutral-900 dark:text-neutral-50\">{{\n            title()\n          }}</span>\n          <span\n            class=\"text-xs text-neutral-400 bg-neutral-200 dark:bg-neutral-700 rounded-full px-2 py-0.5\"\n          >\n            {{ cards().length }}\n          </span>\n        </div>\n        <button\n          type=\"button\"\n          class=\"p-1 hover:bg-neutral-200 dark:hover:bg-neutral-700 rounded cursor-pointer\"\n          (click)=\"addClicked.emit()\"\n        >\n          <lucide-icon name=\"plus\" [size]=\"16\" class=\"text-neutral-500\" />\n        </button>\n      </div>\n      <!-- Cards -->\n      <div class=\"flex-1 space-y-2 overflow-y-auto\">\n        @for (card of cards(); track card.id) {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200\n              dark:border-neutral-700 p-3 cursor-pointer hover:shadow-md transition-shadow\"\n            (click)=\"cardClicked.emit(card.id)\"\n          >\n            @if (card.tag) {\n              <span\n                class=\"inline-block text-[10px] font-medium px-2 py-0.5 rounded-full mb-2\"\n                [style.background-color]=\"(card.tagColor ?? '#6366f1') + '20'\"\n                [style.color]=\"card.tagColor ?? '#6366f1'\"\n              >\n                {{ card.tag }}\n              </span>\n            }\n            <p class=\"text-sm font-medium text-neutral-900 dark:text-neutral-50\">\n              {{ card.title }}\n            </p>\n            @if (card.description) {\n              <p class=\"text-xs text-neutral-500 mt-1 line-clamp-2\">{{ card.description }}</p>\n            }\n          </div>\n        }\n        @if (cards().length === 0) {\n          <div class=\"flex items-center justify-center py-8 text-neutral-400\">\n            <p class=\"text-xs\">Nenhum card</p>\n          </div>\n        }\n      </div>\n    </div>\n  `,\n})\nexport class AfKanbanColumnComponent {\n  /** Column title */\n  readonly title = input('');\n\n  /** Column accent color */\n  readonly color = input('#6366f1');\n\n  /** Cards in this column */\n  readonly cards = input<AfKanbanCard[]>([]);\n\n  /** Card clicked */\n  readonly cardClicked = output<string>();\n\n  /** Add new card */\n  readonly addClicked = output<void>();\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/shared/components/kbd/kbd.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'input' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":46,"nodeType":null,"messageId":"unusedVar","endLine":1,"endC