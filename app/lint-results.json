axlength']))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected object value in conditional. The condition is always true.","line":735,"column":15,"nodeType":"MemberExpression","messageId":"conditionErrorObject","endLine":735,"endColumn":47}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { encode } from 'uqr';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfCopyInputComponent,\n  AfEmptyStateComponent,\n  AfLoadingButtonComponent,\n  AfModalComponent,\n  AfPageTitleComponent,\n  AfPasswordInputComponent,\n  AfStatusBadgeComponent,\n  AfTextInputComponent,\n} from '@shared/components';\nimport type {\n  TwoFactorSetupResponse,\n  TwoFactorStatusResponse,\n} from '../../../core/services/two-factor.service';\nimport { TwoFactorService } from '../../../core/services/two-factor.service';\nimport { AuthStoreService } from '../../../core/services/auth-store.service';\n\n/** Multi-step Two-Factor Authentication setup flow. */\ntype Step = 'status' | 'setup' | 'verify' | 'recovery' | 'complete';\n\n/**\n * Two-Factor Authentication page.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-two-factor',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfButtonComponent,\n    AfLoadingButtonComponent,\n    AfModalComponent,\n    AfPageTitleComponent,\n    AfPasswordInputComponent,\n    AfTextInputComponent,\n    AfCopyInputComponent,\n    AfAlertComponent,\n    AfEmptyStateComponent,\n    AfStatusBadgeComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <div class=\"flex flex-col gap-4\">\n      <af-page-title title=\"Segurança\" subtitle=\"Configurações\" />\n\n      @if (isLoading()) {\n        <div\n          class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-8 flex justify-center\"\n        >\n          <lucide-icon name=\"loader-2\" [size]=\"28\" class=\"text-neutral-400 animate-spin\" />\n        </div>\n      } @else if (loadError()) {\n        <div\n          class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4\"\n        >\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar 2FA\"\n            message=\"Não foi possível consultar o status da autenticação em dois fatores.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"loadStatus()\">Tentar novamente</af-button>\n        </div>\n      } @else if (!status()) {\n        <div\n          class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6\"\n        >\n          <af-empty-state\n            title=\"Status indisponível\"\n            description=\"Não foi possível carregar dados de autenticação em dois fatores.\"\n          />\n        </div>\n      } @else {\n        <!-- ── STATUS step ────────────────────────────────────────────────── -->\n        @if (step() === 'status') {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4\"\n          >\n            @if (errorMessage()) {\n              <af-alert variant=\"danger\" [message]=\"errorMessage()\" />\n            }\n\n            <div class=\"flex items-center justify-between\">\n              <div>\n                <p class=\"font-medium text-neutral-800 dark:text-neutral-200\">Status do 2FA</p>\n                <p class=\"text-sm text-neutral-500 dark:text-neutral-400 mt-0.5\">\n                  {{\n                    twoFactorEnabled()\n                      ? 'Autenticação em dois fatores ativada.'\n                      : 'Autenticação em dois fatores desativada.'\n                  }}\n                </p>\n              </div>\n              <af-status-badge [status]=\"twoFactorEnabled() ? 'online' : 'offline'\">\n                {{ twoFactorEnabled() ? 'Ativo' : 'Inativo' }}\n              </af-status-badge>\n            </div>\n\n            @if (!twoFactorEnabled()) {\n              <af-loading-button\n                variant=\"primary\"\n                size=\"sm\"\n                [loading]=\"isProcessing()\"\n                (click)=\"startSetup()\"\n                dataTest=\"2fa-enable-btn\"\n              >\n                <lucide-icon name=\"shield-check\" [size]=\"16\" class=\"inline-block align-middle\" />\n                Ativar autenticação em dois fatores\n              </af-loading-button>\n            } @else {\n              <div class=\"flex flex-col sm:flex-row gap-3\">\n                <af-loading-button\n                  variant=\"secondary\"\n                  size=\"sm\"\n                  [loading]=\"false\"\n                  (click)=\"openRegenerateModal()\"\n                  dataTest=\"2fa-regenerate-btn\"\n                >\n                  <lucide-icon name=\"refresh-cw\" [size]=\"16\" class=\"inline-block align-middle\" />\n                  Regenerar códigos de recuperação\n                </af-loading-button>\n                <af-loading-button\n                  variant=\"danger\"\n                  size=\"sm\"\n                  [loading]=\"false\"\n                  (click)=\"openDisableModal()\"\n                  dataTest=\"2fa-disable-btn\"\n                >\n                  <lucide-icon name=\"shield-off\" [size]=\"16\" class=\"inline-block align-middle\" />\n                  Desativar 2FA\n                </af-loading-button>\n              </div>\n            }\n          </div>\n        }\n\n        <!-- ── SETUP step ─────────────────────────────────────────────────── -->\n        @if (step() === 'setup') {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4\"\n          >\n            <div>\n              <p class=\"font-medium text-neutral-800 dark:text-neutral-200 mb-1\">\n                1. Escaneie o QR Code\n              </p>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n                Use um aplicativo autenticador (Google Authenticator, Authy, etc.) para escanear o\n                código abaixo.\n              </p>\n            </div>\n\n            <!-- QR Code -->\n            <div class=\"flex flex-col items-center gap-3\">\n              @if (qrCodeDataUrl()) {\n                <div\n                  class=\"rounded-md border border-neutral-200 dark:border-neutral-700 bg-white p-3\"\n                >\n                  <img\n                    [src]=\"qrCodeDataUrl()\"\n                    alt=\"QR Code 2FA\"\n                    class=\"size-44 object-contain\"\n                    (error)=\"onQrImageError()\"\n                    data-test=\"2fa-qr-code\"\n                  />\n                </div>\n                <p class=\"text-xs text-neutral-500 dark:text-neutral-400\">\n                  Escaneie o QR Code para configurar rapidamente.\n                </p>\n              } @else {\n                <div\n                  class=\"flex h-44 w-44 items-center justify-center rounded-md border border-dashed border-neutral-300 dark:border-neutral-700 text-xs text-neutral-500 dark:text-neutral-400\"\n                >\n                  QR Code indisponível\n                </div>\n              }\n            </div>\n\n            <!-- Secret key copy -->\n            @if (setupData()) {\n              <div class=\"space-y-4\">\n                <div>\n                  <p class=\"text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1\">\n                    2. Ou insira a chave manualmente\n                  </p>\n                  <af-copy-input\n                    [control]=\"secretControl\"\n                    label=\"Chave secreta\"\n                    classContainer=\"mb-0\"\n                    dataTest=\"2fa-secret-key\"\n                  />\n                </div>\n\n                <div class=\"flex justify-between items-center pt-2\">\n                  <af-button\n                    variant=\"ghost\"\n                    size=\"sm\"\n                    (click)=\"step.set('status')\"\n                    dataTest=\"2fa-setup-back-btn\"\n                  >\n                    Cancelar\n                  </af-button>\n                  <af-button\n                    variant=\"primary\"\n                    size=\"sm\"\n                    (click)=\"goToVerify()\"\n                    dataTest=\"2fa-setup-next-btn\"\n                  >\n                    Continuar\n                    <lucide-icon name=\"arrow-right\" [size]=\"16\" class=\"block\" />\n                  </af-button>\n                </div>\n              </div>\n            }\n          </div>\n        }\n\n        <!-- ── VERIFY step ────────────────────────────────────────────────── -->\n        @if (step() === 'verify') {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4\"\n          >\n            <div>\n              <p class=\"font-medium text-neutral-800 dark:text-neutral-200 mb-1\">\n                3. Verifique o código\n              </p>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n                Insira o código de 6 dígitos gerado pelo seu aplicativo autenticador.\n              </p>\n            </div>\n\n            @if (errorMessage()) {\n              <af-alert variant=\"danger\" [message]=\"errorMessage()\" />\n            }\n\n            <form [formGroup]=\"verifyForm\" (submit)=\"validateCode()\">\n              <af-text-input\n                [control]=\"codeControl\"\n                label=\"Código de verificação\"\n                placeholder=\"000000\"\n                type=\"text\"\n                [required]=\"true\"\n                dataTest=\"2fa-code-input\"\n                [errorMessage]=\"codeError()\"\n              />\n            </form>\n\n            <div class=\"flex justify-between items-center\">\n              <af-button\n                variant=\"ghost\"\n                size=\"sm\"\n                (click)=\"step.set('setup')\"\n                dataTest=\"2fa-verify-back-btn\"\n              >\n                Voltar\n              </af-button>\n              <af-loading-button\n                variant=\"primary\"\n                size=\"sm\"\n                [loading]=\"isProcessing()\"\n                (click)=\"validateCode()\"\n                dataTest=\"2fa-verify-btn\"\n              >\n                Verificar e ativar\n              </af-loading-button>\n            </div>\n          </div>\n        }\n\n        <!-- ── RECOVERY step ──────────────────────────────────────────────── -->\n        @if (step() === 'recovery') {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4\"\n          >\n            <div>\n              <p class=\"font-medium text-neutral-800 dark:text-neutral-200 mb-1\">\n                Códigos de recuperação\n              </p>\n              <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n                Guarde estes códigos em um local seguro. Cada código só pode ser usado uma vez.\n              </p>\n            </div>\n\n            <div class=\"bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4\">\n              <div class=\"grid grid-cols-2 gap-2\">\n                @for (code of recoveryCodes(); track code) {\n                  <span\n                    class=\"font-mono text-sm text-neutral-700 dark:text-neutral-300 tracking-widest\"\n                  >\n                    {{ code }}\n                  </span>\n                }\n              </div>\n            </div>\n\n            <div class=\"flex flex-col sm:flex-row gap-3\">\n              <af-button\n                variant=\"outline\"\n                size=\"sm\"\n                (click)=\"copyCodes()\"\n                dataTest=\"2fa-copy-codes-btn\"\n              >\n                <lucide-icon name=\"copy\" [size]=\"14\" class=\"block\" />\n                Copiar códigos\n              </af-button>\n              <af-button\n                variant=\"outline\"\n                size=\"sm\"\n                (click)=\"downloadCodes()\"\n                dataTest=\"2fa-download-codes-btn\"\n              >\n                <lucide-icon name=\"download\" [size]=\"14\" class=\"block\" />\n                Baixar códigos\n              </af-button>\n            </div>\n\n            <div class=\"flex justify-end\">\n              <af-button\n                variant=\"primary\"\n                size=\"sm\"\n                (click)=\"completeSetup()\"\n                dataTest=\"2fa-complete-btn\"\n              >\n                Concluir configuração\n              </af-button>\n            </div>\n          </div>\n        }\n\n        <!-- ── COMPLETE step ──────────────────────────────────────────────── -->\n        @if (step() === 'complete') {\n          <div\n            class=\"bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 p-6 space-y-4 text-center\"\n          >\n            <div class=\"flex justify-center\">\n              <div class=\"w-14 h-14 rounded-full bg-success/10 flex items-center justify-center\">\n                <lucide-icon name=\"shield-check\" [size]=\"28\" class=\"text-success\" />\n              </div>\n            </div>\n            <p class=\"text-lg font-semibold text-neutral-900 dark:text-neutral-100\">\n              2FA ativado com sucesso!\n            </p>\n            <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n              Sua conta agora tem uma camada extra de segurança.\n            </p>\n            <af-button\n              variant=\"primary\"\n              size=\"sm\"\n              (click)=\"step.set('status'); loadStatus()\"\n              dataTest=\"2fa-finish-btn\"\n            >\n              Concluir\n            </af-button>\n          </div>\n        }\n      }\n    </div>\n\n    <!-- ── Disable 2FA modal ─────────────────────────────────────────────── -->\n    <af-modal\n      [open]=\"disableModalOpen()\"\n      title=\"Desativar autenticação em dois fatores\"\n      size=\"sm\"\n      (closed)=\"disableModalOpen.set(false)\"\n    >\n      <div class=\"px-6 py-4 space-y-4\">\n        <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n          Insira sua senha para confirmar a desativação do 2FA.\n        </p>\n\n        @if (disableError()) {\n          <af-alert variant=\"danger\" [message]=\"disableError()\" />\n        }\n\n        <af-password-input\n          [control]=\"disablePasswordControl\"\n          label=\"Senha\"\n          placeholder=\"••••••••\"\n          [required]=\"true\"\n          dataTest=\"2fa-disable-password\"\n          [errorMessage]=\"\n            disablePasswordControl.touched && disablePasswordControl.errors?.['required']\n              ? 'Senha é obrigatória.'\n              : ''\n          \"\n        />\n      </div>\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button variant=\"ghost\" size=\"sm\" (click)=\"disableModalOpen.set(false)\">\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"danger\"\n          size=\"sm\"\n          [loading]=\"isProcessing()\"\n          (click)=\"disableTwoFactor()\"\n          dataTest=\"2fa-disable-confirm-btn\"\n        >\n          Desativar\n        </af-loading-button>\n      </div>\n    </af-modal>\n\n    <!-- ── Regenerate codes modal ────────────────────────────────────────── -->\n    <af-modal\n      [open]=\"regenerateModalOpen()\"\n      title=\"Regenerar códigos de recuperação\"\n      size=\"sm\"\n      (closed)=\"regenerateModalOpen.set(false)\"\n    >\n      <div class=\"px-6 py-4 space-y-4\">\n        <p class=\"text-sm text-neutral-500 dark:text-neutral-400\">\n          Os códigos anteriores serão invalidados. Insira sua senha para confirmar.\n        </p>\n\n        @if (regenerateError()) {\n          <af-alert variant=\"danger\" [message]=\"regenerateError()\" />\n        }\n\n        <af-password-input\n          [control]=\"regeneratePasswordControl\"\n          label=\"Senha\"\n          placeholder=\"••••••••\"\n          [required]=\"true\"\n          dataTest=\"2fa-regenerate-password\"\n          [errorMessage]=\"\n            regeneratePasswordControl.touched && regeneratePasswordControl.errors?.['required']\n              ? 'Senha é obrigatória.'\n              : ''\n          \"\n        />\n      </div>\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button variant=\"ghost\" size=\"sm\" (click)=\"regenerateModalOpen.set(false)\">\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"primary\"\n          size=\"sm\"\n          [loading]=\"isProcessing()\"\n          (click)=\"regenerateCodes()\"\n          dataTest=\"2fa-regenerate-confirm-btn\"\n        >\n          Regenerar\n        </af-loading-button>\n      </div>\n    </af-modal>\n  `,\n})\nexport class TwoFactor implements OnInit {\n  private readonly fb = inject(FormBuilder);\n  private readonly service = inject(TwoFactorService);\n  private readonly authStore = inject(AuthStoreService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  // ── Step / loading ────────────────────────────────────────────────────────────\n  readonly step = signal<Step>('status');\n  readonly isLoading = signal(false);\n  readonly loadError = signal(false);\n  readonly isProcessing = signal(false);\n\n  // ── 2FA state ────────────────────────────────────────────────────────────────\n  readonly status = signal<TwoFactorStatusResponse['data'] | null>(null);\n  readonly twoFactorEnabled = computed(() => this.status()?.enabled ?? false);\n  readonly setupData = signal<TwoFactorSetupResponse['data'] | null>(null);\n  readonly recoveryCodes = signal<string[]>([]);\n  readonly qrCodeDataUrl = signal<string | null>(null);\n\n  // ── Error messages ────────────────────────────────────────────────────────────\n  readonly errorMessage = signal('');\n  readonly disableError = signal('');\n  readonly regenerateError = signal('');\n\n  // ── Modal flags ───────────────────────────────────────────────────────────────\n  readonly disableModalOpen = signal(false);\n  readonly regenerateModalOpen = signal(false);\n\n  // ── Form controls ─────────────────────────────────────────────────────────────\n  readonly codeControl = this.fb.nonNullable.control('', [\n    Validators.required,\n    Validators.minLength(6),\n    Validators.maxLength(6),\n  ]);\n\n  readonly disablePasswordControl = this.fb.nonNullable.control('', Validators.required);\n  readonly regeneratePasswordControl = this.fb.nonNullable.control('', Validators.required);\n\n  readonly verifyForm = this.fb.group({ code: this.codeControl });\n\n  readonly secretControl = this.fb.nonNullable.control({ value: '', disabled: true });\n\n  ngOnInit(): void {\n    this.loadStatus();\n  }\n\n  // ── Data loading ─────────────────────────────────────────────────────────────\n\n  loadStatus(): void {\n    this.isLoading.set(true);\n    this.loadError.set(false);\n    this.service\n      .getStatus()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.status.set(response.data);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.loadError.set(true);\n          this.isLoading.set(false);\n        },\n      });\n  }\n\n  // ── Setup flow ────────────────────────────────────────────────────────────────\n\n  startSetup(): void {\n    if (this.isProcessing()) return;\n    this.isProcessing.set(true);\n    this.errorMessage.set('');\n\n    this.service\n      .setup()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.setupData.set(response.data);\n          this.secretControl.setValue(response.data.secret);\n          this.generateQrCode(response.data.qr_code_url);\n          this.isProcessing.set(false);\n          this.step.set('setup');\n        },\n        error: (error) => {\n          this.isProcessing.set(false);\n          this.errorMessage.set(error.error?.message || 'Não foi possível iniciar a configuração.');\n        },\n      });\n  }\n\n  goToVerify(): void {\n    this.errorMessage.set('');\n    this.codeControl.reset('');\n    this.step.set('verify');\n  }\n\n  validateCode(): void {\n    if (this.verifyForm.invalid || this.isProcessing()) {\n      this.verifyForm.markAllAsTouched();\n      return;\n    }\n\n    const code = this.codeControl.value.trim();\n    const setup = this.setupData();\n    if (!setup?.secret) return;\n\n    this.isProcessing.set(true);\n    this.errorMessage.set('');\n\n    this.service\n      .validate(code)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.isProcessing.set(false);\n          this.recoveryCodes.set(response.data.recovery_codes ?? []);\n          this.authStore.updateUser({ two_factor_enabled: true });\n          this.step.set('recovery');\n        },\n        error: (error) => {\n          this.isProcessing.set(false);\n          this.errorMessage.set(\n            error.error?.message || 'Código inválido. Verifique e tente novamente.',\n          );\n        },\n      });\n  }\n\n  completeSetup(): void {\n    this.step.set('complete');\n  }\n\n  // ── Utility actions ───────────────────────────────────────────────────────────\n\n  copySecret(): void {\n    const secret = this.setupData()?.secret;\n    if (secret) navigator.clipboard.writeText(secret).catch(() => null);\n  }\n\n  copyCodes(): void {\n    const text = this.recoveryCodes().join('\\n');\n    navigator.clipboard.writeText(text).catch(() => null);\n  }\n\n  downloadCodes(): void {\n    const text = this.recoveryCodes().join('\\n');\n    const blob = new Blob([text], { type: 'text/plain' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = 'recovery-codes.txt';\n    a.click();\n    URL.revokeObjectURL(url);\n  }\n\n  // ── Disable 2FA ───────────────────────────────────────────────────────────────\n\n  openDisableModal(): void {\n    this.disablePasswordControl.reset('');\n    this.disableError.set('');\n    this.disableModalOpen.set(true);\n  }\n\n  disableTwoFactor(): void {\n    if (this.disablePasswordControl.invalid || this.isProcessing()) {\n      this.disablePasswordControl.markAsTouched();\n      return;\n    }\n\n    this.isProcessing.set(true);\n    this.disableError.set('');\n\n    this.service\n      .disable(this.disablePasswordControl.value)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isProcessing.set(false);\n          this.disableModalOpen.set(false);\n          this.authStore.updateUser({ two_factor_enabled: false });\n          this.loadStatus();\n        },\n        error: (error) => {\n          this.isProcessing.set(false);\n          this.disableError.set(error.error?.message || 'Não foi possível desativar o 2FA.');\n        },\n      });\n  }\n\n  // ── Regenerate codes ──────────────────────────────────────────────────────────\n\n  openRegenerateModal(): void {\n    this.regeneratePasswordControl.reset('');\n    this.regenerateError.set('');\n    this.regenerateModalOpen.set(true);\n  }\n\n  regenerateCodes(): void {\n    if (this.regeneratePasswordControl.invalid || this.isProcessing()) {\n      this.regeneratePasswordControl.markAsTouched();\n      return;\n    }\n\n    this.isProcessing.set(true);\n    this.regenerateError.set('');\n\n    this.service\n      .regenerateRecoveryCodes(this.regeneratePasswordControl.value)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.isProcessing.set(false);\n          this.regenerateModalOpen.set(false);\n          this.recoveryCodes.set(response.data.recovery_codes ?? []);\n          this.step.set('recovery');\n        },\n        error: (error) => {\n          this.isProcessing.set(false);\n          this.regenerateError.set(\n            error.error?.message || 'Não foi possível regenerar os códigos.',\n          );\n        },\n      });\n  }\n\n  // ── Error getter ──────────────────────────────────────────────────────────────\n\n  codeError(): string {\n    const c = this.codeControl;\n    if (!c.touched || !c.errors) return '';\n    if (c.errors['required']) return 'Código é obrigatório.';\n    if (c.errors['minlength'] || c.errors['maxlength'])\n      return 'O código deve ter exatamente 6 dígitos.';\n    return '';\n  }\n\n  // ── QR Code generation ────────────────────────────────────────────────────────\n\n  private generateQrCode(value: string): void {\n    if (!value) {\n      this.qrCodeDataUrl.set(null);\n      return;\n    }\n\n    if (value.startsWith('data:image/')) {\n      this.qrCodeDataUrl.set(value);\n      return;\n    }\n\n    try {\n      const result = encode(value, { ecc: 'M' });\n      const moduleSize = Math.max(1, Math.floor(220 / result.size));\n      const actualSize = moduleSize * result.size;\n      const canvas = document.createElement('canvas');\n      canvas.width = actualSize;\n      canvas.height = actualSize;\n      const ctx = canvas.getContext('2d');\n      if (!ctx) {\n        this.qrCodeDataUrl.set(null);\n        return;\n      }\n\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(0, 0, actualSize, actualSize);\n\n      ctx.fillStyle = '#000000';\n      for (let y = 0; y < result.size; y++) {\n        for (let x = 0; x < result.size; x++) {\n          if (result.data[y * result.size + x]) {\n            ctx.fillRect(x * moduleSize, y * moduleSize, moduleSize, moduleSize);\n          }\n        }\n      }\n\n      this.qrCodeDataUrl.set(canvas.toDataURL('image/png'));\n    } catch {\n      this.qrCodeDataUrl.set(null);\n    }\n  }\n\n  onQrImageError(): void {\n    this.qrCodeDataUrl.set(null);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/auth/users/components/settings-user-form/settings-user-form.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../../../core/services/settings-users.service' import is duplicated.","line":28,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":28,"endColumn":92},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":201,"column":31,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":201,"endColumn":35},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected value in conditional. A boolean expression is required.","line":279,"column":10,"nodeType":"ChainExpression","messageId":"conditionErrorOther","endLine":279,"endColumn":32},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":299,"column":12,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":299,"endColumn":20,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[9704,9713],"text":"password == null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[9705,9713],"text":"(password ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[9704,9713],"text":"!Boolean(password)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":316,"column":35,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":316,"endColumn":55,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[10260,10280],"text":"(Boolean((error.error?.message)))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":324,"column":9,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":324,"endColumn":17,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[10498,10506],"text":"password != null"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[10498,10506],"text":"password ?? \"\""},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[10498,10506],"text":"Boolean(password)"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":336,"column":33,"nodeType":"ChainExpression","messageId":"conditionErrorAny","endLine":336,"endColumn":53,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[10890,10910],"text":"(Boolean((error.error?.message)))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":350,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":350,"endColumn":29,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[11233,11253],"text":"Boolean(c.errors['required'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":357,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":357,"endColumn":29,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[11422,11442],"text":"Boolean(c.errors['required'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":358,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":358,"endColumn":26,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[11484,11501],"text":"Boolean(c.errors['email'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":365,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":365,"endColumn":29,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[11673,11693],"text":"Boolean(c.errors['required'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected any value in conditional. An explicit comparison or type conversion is required.","line":366,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorAny","endLine":366,"endColumn":30,"suggestions":[{"messageId":"conditionFixCastBoolean","fix":{"range":[11734,11755],"text":"Boolean(c.errors['minlength'])"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@angular-eslint/template/label-has-associated-control","severity":1,"message":"A label component must be associated with a form element","line":87,"column":11,"nodeType":null,"messageId":"labelHasAssociatedControl","endLine":89,"endColumn":19}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  effect,\n  inject,\n  input,\n  output,\n  signal,\n} from '@angular/core';\nimport { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfButtonComponent,\n  AfIconButtonComponent,\n  AfPasswordInputComponent,\n  AfSwitchInputComponent,\n  AfTextInputComponent,\n} from '@shared/components';\nimport type {\n  CreateSettingsUserPayload,\n  SettingsUser,\n  UpdateSettingsUserPayload,\n} from '../../../../../core/services/settings-users.service';\nimport { SettingsUsersService } from '../../../../../core/services/settings-users.service';\nimport { AuthStoreService } from '../../../../../core/services/auth-store.service';\nimport { RoleService } from '../../../../../core/services/role.service';\nimport type { Role } from '../../../../../core/models/role.model';\n\n/**\n * Settings user form — create/edit a tenant user inside a modal.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-settings-user-form',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfTextInputComponent,\n    AfPasswordInputComponent,\n    AfSwitchInputComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfAlertComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    @if (errorMessage()) {\n      <div class=\"mb-4\">\n        <af-alert variant=\"danger\" [message]=\"errorMessage()\" />\n      </div>\n    }\n\n    <form [formGroup]=\"form\" (submit)=\"$event.preventDefault()\">\n      <!-- Row 1: Name + Email -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <af-text-input\n          [control]=\"form.controls.name\"\n          label=\"Nome\"\n          placeholder=\"Nome completo\"\n          [required]=\"true\"\n          classContainer=\"\"\n          dataTest=\"user-form-name\"\n          [errorMessage]=\"nameError()\"\n        />\n        <af-text-input\n          [control]=\"form.controls.email\"\n          label=\"E-mail\"\n          type=\"email\"\n          placeholder=\"email@exemplo.com\"\n          [required]=\"true\"\n          [readOnly]=\"isEditing()\"\n          classContainer=\"\"\n          dataTest=\"user-form-email\"\n          [errorMessage]=\"emailError()\"\n        />\n      </div>\n\n      <!-- Row 2: Role + Status -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <!-- Role selector -->\n        <div>\n          <label class=\"block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1\">\n            Perfil de acesso\n          </label>\n          <div class=\"relative\">\n            <af-button\n              variant=\"outline\"\n              size=\"sm\"\n              [block]=\"true\"\n              (click)=\"toggleDropdown()\"\n              dataTest=\"user-form-role-trigger\"\n            >\n              <span class=\"text-neutral-500 dark:text-neutral-400 truncate\">\n                {{ selectedRolesLabel() }}\n              </span>\n              <lucide-icon\n                name=\"chevron-down\"\n                [size]=\"16\"\n                class=\"text-neutral-400 shrink-0 transition-transform\"\n                [class.rotate-180]=\"isRoleDropdownOpen()\"\n              />\n            </af-button>\n\n            @if (isRoleDropdownOpen()) {\n              <div\n                class=\"absolute z-50 top-full left-0 right-0 mt-1 rounded-md border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 shadow-lg overflow-hidden\"\n              >\n                <div class=\"max-h-40 overflow-y-auto py-1\">\n                  @if (availableRoles().length === 0) {\n                    <p class=\"px-3 py-2 text-xs text-neutral-400 text-center\">\n                      Nenhum perfil disponível\n                    </p>\n                  }\n                  @for (role of availableRoles(); track role.id) {\n                    <af-button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      [block]=\"true\"\n                      (click)=\"toggleRole(role.name); $event.stopPropagation()\"\n                    >\n                      <lucide-icon\n                        [name]=\"selectedRoles().includes(role.name) ? 'check-square' : 'square'\"\n                        [size]=\"16\"\n                        [class]=\"\n                          selectedRoles().includes(role.name)\n                            ? 'text-accent-500'\n                            : 'text-neutral-400'\n                        \"\n                      />\n                      {{ role.name }}\n                    </af-button>\n                  }\n                </div>\n              </div>\n            }\n          </div>\n          <!-- Selected roles chips -->\n          @if (selectedRoles().length > 0) {\n            <div class=\"mt-2 flex flex-wrap gap-1\">\n              @for (roleName of selectedRoles(); track roleName) {\n                <span\n                  class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-accent-100 dark:bg-accent-900 text-accent-700 dark:text-accent-300\"\n                >\n                  {{ roleName }}\n                  <af-icon-button\n                    label=\"Remover perfil\"\n                    variant=\"ghost\"\n                    size=\"xs\"\n                    (click)=\"removeRole(roleName)\"\n                  >\n                    <lucide-icon name=\"x\" [size]=\"12\" />\n                  </af-icon-button>\n                </span>\n              }\n            </div>\n          }\n        </div>\n\n        <!-- Status -->\n        <div class=\"flex items-start pt-6\">\n          <af-switch-input\n            [control]=\"form.controls.is_active\"\n            label=\"Usuário ativo\"\n            dataTest=\"user-form-is-active\"\n            classContainer=\"\"\n          />\n        </div>\n      </div>\n\n      <!-- Password -->\n      <af-password-input\n        [control]=\"form.controls.password\"\n        [label]=\"isEditing() ? 'Nova senha (opcional)' : 'Senha'\"\n        [placeholder]=\"isEditing() ? 'Deixe em branco para não alterar' : '••••••••'\"\n        [required]=\"!isEditing()\"\n        dataTest=\"user-form-password\"\n        [errorMessage]=\"passwordError()\"\n      />\n    </form>\n  `,\n  host: {\n    '(document:click)': 'onDocumentClick()',\n  },\n})\nexport class SettingsUserFormComponent {\n  private readonly fb = inject(FormBuilder);\n  private readonly service = inject(SettingsUsersService);\n  private readonly authStore = inject(AuthStoreService);\n  private readonly roleService = inject(RoleService);\n  private readonly destroyRef = inject(DestroyRef);\n  private readonly lastLoadedId = signal<string | null>(null);\n\n  /** @input User to edit; null for create mode */\n  readonly user = input<SettingsUser | null>(null);\n  readonly saved = output<SettingsUser>();\n  readonly cancelled = output<void>();\n\n  readonly isSaving = signal(false);\n  readonly isEditing = computed(() => !!this.user());\n  readonly errorMessage = signal('');\n  readonly availableRoles = signal<Role[]>([]);\n  readonly selectedRoles = signal<string[]>([]);\n  readonly isRoleDropdownOpen = signal(false);\n\n  readonly form = this.fb.group({\n    name: this.fb.control('', Validators.required),\n    email: this.fb.control('', [Validators.required, Validators.email]),\n    password: this.fb.control(''),\n    is_active: this.fb.nonNullable.control(true),\n  });\n\n  readonly selectedRolesLabel = computed(() => {\n    const roles = this.selectedRoles();\n    if (roles.length === 0) return 'Selecione perfis...';\n    if (roles.length === 1) return roles[0];\n    return `${roles.length} perfis selecionados`;\n  });\n\n  constructor() {\n    this.loadRoles();\n\n    effect(() => {\n      const item = this.user();\n      if (!item) {\n        this.lastLoadedId.set(null);\n        this.resetForm();\n        this.form.controls.email.enable();\n        this.setPasswordValidators(true);\n        return;\n      }\n\n      if (this.lastLoadedId() === item.id) return;\n      this.lastLoadedId.set(item.id);\n      this.form.reset({\n        name: item.name,\n        email: item.email,\n        password: '',\n        is_active: item.is_active,\n      });\n      this.selectedRoles.set(item.roles ?? []);\n      this.form.controls.email.disable();\n      this.setPasswordValidators(false);\n    });\n  }\n\n  toggleRole(roleName: string): void {\n    const current = this.selectedRoles();\n    if (current.includes(roleName)) {\n      this.selectedRoles.set(current.filter((r) => r !== roleName));\n    } else {\n      this.selectedRoles.set([...current, roleName]);\n    }\n  }\n\n  removeRole(roleName: string): void {\n    this.selectedRoles.set(this.selectedRoles().filter((r) => r !== roleName));\n  }\n\n  toggleDropdown(): void {\n    this.isRoleDropdownOpen.update((v) => !v);\n  }\n\n  protected onDocumentClick(): void {\n    if (this.isRoleDropdownOpen()) this.isRoleDropdownOpen.set(false);\n  }\n\n  submit(): void {\n    if (this.form.invalid || this.isSaving()) {\n      this.form.markAllAsTouched();\n      return;\n    }\n\n    const currentUser = this.authStore.user();\n    if (!currentUser?.tenant_id) {\n      this.errorMessage.set('Não foi possível identificar o tenant do usuário logado.');\n      return;\n    }\n\n    const formValue = this.form.getRawValue();\n    const basePayload = {\n      name: formValue.name.trim(),\n      email: formValue.email.trim(),\n      roles: this.selectedRoles(),\n      is_active: formValue.is_active,\n      tenant_id: String(currentUser.tenant_id),\n    };\n\n    const editing = this.user();\n    this.isSaving.set(true);\n    this.errorMessage.set('');\n\n    if (!editing) {\n      const password = formValue.password?.trim();\n      if (!password) {\n        this.isSaving.set(false);\n        this.errorMessage.set('Senha é obrigatória.');\n        return;\n      }\n\n      const payload: CreateSettingsUserPayload = { ...basePayload, password };\n      this.service\n        .create(payload)\n        .pipe(takeUntilDestroyed(this.destroyRef))\n        .subscribe({\n          next: (response) => {\n            this.isSaving.set(false);\n            this.saved.emit(response.data.user);\n          },\n          error: (error) => {\n            this.isSaving.set(false);\n            this.errorMessage.set(error.error?.message || 'Não foi possível criar o usuário.');\n          },\n        });\n      return;\n    }\n\n    const updatePayload: UpdateSettingsUserPayload = { ...basePayload };\n    const password = formValue.password?.trim();\n    if (password) updatePayload.password = password;\n\n    this.service\n      .update(editing.id, updatePayload)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          this.isSaving.set(false);\n          this.saved.emit(response.data.user);\n        },\n        error: (error) => {\n          this.isSaving.set(false);\n          this.errorMessage.set(error.error?.message || 'Não foi possível atualizar o usuário.');\n        },\n      });\n  }\n\n  cancel(): void {\n    this.cancelled.emit();\n  }\n\n  // ── Error getters ─────────────────────────────────────────────────────────────\n\n  nameError(): string {\n    const c = this.form.controls.name;\n    if (!c.touched || !c.errors) return '';\n    if (c.errors['required']) return 'Nome é obrigatório.';\n    return '';\n  }\n\n  emailError(): string {\n    const c = this.form.controls.email;\n    if (!c.touched || !c.errors) return '';\n    if (c.errors['required']) return 'E-mail é obrigatório.';\n    if (c.errors['email']) return 'E-mail inválido.';\n    return '';\n  }\n\n  passwordError(): string {\n    const c = this.form.controls.password;\n    if (!c.touched || !c.errors) return '';\n    if (c.errors['required']) return 'Senha é obrigatória.';\n    if (c.errors['minlength']) return 'Senha deve ter no mínimo 6 caracteres.';\n    return '';\n  }\n\n  private resetForm(): void {\n    this.form.reset({ name: '', email: '', password: '', is_active: true });\n    this.selectedRoles.set([]);\n    this.errorMessage.set('');\n  }\n\n  private setPasswordValidators(isCreate: boolean): void {\n    const control = this.form.controls.password;\n    const validators = isCreate\n      ? [Validators.required, Validators.minLength(6)]\n      : [Validators.minLength(6)];\n    control.setValidators(validators);\n    control.updateValueAndValidity({ emitEvent: false });\n  }\n\n  private loadRoles(): void {\n    this.roleService\n      .listAll()\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => this.availableRoles.set(response.data),\n        error: () => this.errorMessage.set('Não foi possível carregar os perfis.'),\n      });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/auth/users/users.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'@angular/core' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":10,"endColumn":24},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'debounceTime' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":13,"endColumn":22},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'distinctUntilChanged' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":24,"nodeType":null,"messageId":"unusedVar","endLine":13,"endColumn":44},{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../core/services/settings-users.service' import is duplicated.","line":36,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":36,"endColumn":86},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":300,"column":56,"nodeType":"MemberExpression","messageId":"conditionErrorNullableBoolean","endLine":300,"endColumn":80,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[10549,10573],"text":"(u.is_primary_tenant_user ?? false)"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareFalse","fix":{"range":[10548,10573],"text":"u.is_primary_tenant_user === false"},"desc":"Change condition to check if false (`value === false`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":427,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableBoolean","endLine":427,"endColumn":36,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[13875,13902],"text":"user.is_primary_tenant_user ?? false"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareTrue","fix":{"range":[13875,13902],"text":"user.is_primary_tenant_user === true"},"desc":"Change condition to check if true (`value === true`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":441,"column":9,"nodeType":"MemberExpression","messageId":"conditionErrorNullableBoolean","endLine":441,"endColumn":36,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[14294,14321],"text":"user.is_primary_tenant_user ?? false"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareTrue","fix":{"range":[14294,14321],"text":"user.is_primary_tenant_user === true"},"desc":"Change condition to check if true (`value === true`)"}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":455,"column":51,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":455,"endColumn":85},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable boolean value in conditional. Please handle the nullish case explicitly.","line":465,"column":54,"nodeType":"MemberExpression","messageId":"conditionErrorNullableBoolean","endLine":465,"endColumn":78,"suggestions":[{"messageId":"conditionFixDefaultFalse","fix":{"range":[15212,15236],"text":"(u.is_primary_tenant_user ?? false)"},"desc":"Explicitly treat nullish value the same as false (`value ?? false`)"},{"messageId":"conditionFixCompareFalse","fix":{"range":[15211,15236],"text":"u.is_primary_tenant_user === false"},"desc":"Change condition to check if false (`value === false`)"}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { OnInit } from '@angular/core';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  computed,\n  inject,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { FormControl, ReactiveFormsModule } from '@angular/forms';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { debounceTime, distinctUntilChanged, forkJoin } from 'rxjs';\nimport { LucideAngularModule } from 'lucide-angular';\nimport {\n  AfAlertComponent,\n  AfAvatarComponent,\n  AfButtonComponent,\n  AfCheckboxInputComponent,\n  AfConfirmModalComponent,\n  AfCrudPageComponent,\n  AfDataTableComponent,\n  AfLoadingButtonComponent,\n  AfModalComponent,\n  AfIconButtonComponent,\n  AfSelectInputComponent,\n  AfStatusBadgeComponent,\n  AfTableActionsComponent,\n  type AfSelectOption,\n} from '@shared/components';\nimport { ToastService } from '../../../core/services/toast.service';\nimport type {\n  SettingsUser,\n  SettingsUserStatus,\n} from '../../../core/services/settings-users.service';\nimport { SettingsUsersService } from '../../../core/services/settings-users.service';\nimport { SettingsUserFormComponent } from './components/settings-user-form/settings-user-form';\n\n/**\n * Users settings page — CRUD + status toggle for tenant users.\n * Business logic preserved verbatim from source. Visual layer migrated to UI Kit.\n */\n@Component({\n  selector: 'app-settings-users',\n  standalone: true,\n  imports: [\n    ReactiveFormsModule,\n    LucideAngularModule,\n    AfCrudPageComponent,\n    AfModalComponent,\n    AfConfirmModalComponent,\n    AfButtonComponent,\n    AfIconButtonComponent,\n    AfCheckboxInputComponent,\n    AfLoadingButtonComponent,\n    AfSelectInputComponent,\n    AfDataTableComponent,\n    AfAvatarComponent,\n    AfStatusBadgeComponent,\n    AfTableActionsComponent,\n    AfAlertComponent,\n    SettingsUserFormComponent,\n  ],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <af-crud-page\n      title=\"Usuários\"\n      subtitle=\"Configurações\"\n      createLabel=\"Novo usuário\"\n      searchPlaceholder=\"Buscar usuários...\"\n      [loading]=\"isLoading()\"\n      [empty]=\"isEmpty()\"\n      emptyTitle=\"Nenhum usuário encontrado\"\n      emptyDescription=\"Adicione membros da sua equipe para conceder acesso à plataforma.\"\n      [skeletonColumns]=\"5\"\n      [skeletonRows]=\"6\"\n      [currentPage]=\"meta().current_page\"\n      [lastPage]=\"meta().last_page\"\n      [perPage]=\"meta().per_page\"\n      [total]=\"meta().total\"\n      (create)=\"openCreate()\"\n      (search)=\"onSearch($event)\"\n      (pageChange)=\"loadPage($event)\"\n    >\n      <!-- Filter slot -->\n      <div filters class=\"flex items-center gap-2\">\n        <div class=\"min-w-40\">\n          <af-select-input\n            [control]=\"filterStatusControl\"\n            [options]=\"filterStatusOptions\"\n            size=\"sm\"\n            classContainer=\"\"\n            dataTest=\"users-filter-status\"\n          />\n        </div>\n        @if (hasSelection()) {\n          <af-button variant=\"danger\" size=\"sm\" (click)=\"openBulkDelete()\">\n            Excluir selecionados ({{ selectedCount() }})\n          </af-button>\n        }\n      </div>\n\n      <!-- Error state -->\n      @if (hasError()) {\n        <div class=\"p-6 space-y-3\">\n          <af-alert\n            variant=\"danger\"\n            title=\"Erro ao carregar usuários\"\n            message=\"Não foi possível carregar os usuários. Verifique sua conexão e tente novamente.\"\n          />\n          <af-button variant=\"outline\" size=\"sm\" (click)=\"retry()\">\n            <lucide-icon name=\"refresh-cw\" [size]=\"14\" class=\"block\" />\n            Tentar novamente\n          </af-button>\n        </div>\n      } @else {\n        <af-data-table [hoverable]=\"true\">\n          <thead>\n            <tr>\n              <th class=\"w-10\">\n                <af-checkbox-input\n                  [control]=\"selectAllControl\"\n                  ariaLabel=\"Selecionar todos os usuários\"\n                  dataTest=\"users-select-all\"\n                />\n              </th>\n              <th>Usuário</th>\n              <th>E-mail</th>\n              <th>Perfil</th>\n              <th>Status</th>\n              <th class=\"text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (user of users(); track user.id) {\n              <tr>\n                <td>\n                  @if (!user.is_primary_tenant_user) {\n                    <af-checkbox-input\n                      [control]=\"getRowSelectionControl(user.id)\"\n                      [ariaLabel]=\"'Selecionar usuário ' + user.name\"\n                      [dataTest]=\"'user-select-' + user.id\"\n                    />\n                  }\n                </td>\n                <td>\n                  <div class=\"flex items-center gap-3\">\n                    <af-avatar [initials]=\"getInitials(user.name)\" size=\"sm\" />\n                    <span class=\"font-medium\">{{ user.name }}</span>\n                  </div>\n                </td>\n                <td class=\"text-neutral-500 dark:text-neutral-400\">{{ user.email }}</td>\n                <td>{{ user.role || '—' }}</td>\n                <td>\n                  <af-status-badge [status]=\"user.is_active ? 'online' : 'offline'\">\n                    {{ user.is_active ? 'Ativo' : 'Inativo' }}\n                  </af-status-badge>\n                </td>\n                <td>\n                  <div class=\"flex justify-end items-center gap-1\">\n                    @if (!user.is_primary_tenant_user) {\n                      <af-icon-button\n                        [label]=\"user.is_active ? 'Inativar usuário' : 'Ativar usuário'\"\n                        variant=\"ghost\"\n                        size=\"sm\"\n                        (click)=\"toggleStatus(user)\"\n                      >\n                        <lucide-icon name=\"power\" [size]=\"15\" class=\"block\" />\n                      </af-icon-button>\n                    }\n                    <af-table-actions\n                      [showDelete]=\"!user.is_primary_tenant_user\"\n                      (edit)=\"openEdit(user)\"\n                      (delete)=\"openDelete(user)\"\n                    />\n                  </div>\n                </td>\n              </tr>\n            }\n          </tbody>\n        </af-data-table>\n      }\n    </af-crud-page>\n\n    <!-- Create / Edit modal -->\n    <af-modal\n      [open]=\"showFormModal()\"\n      [title]=\"formModalTitle()\"\n      size=\"md\"\n      (closed)=\"handleFormCancelled()\"\n    >\n      <app-settings-user-form\n        #userForm\n        [user]=\"selectedUser()\"\n        (saved)=\"handleFormSaved($event)\"\n        (cancelled)=\"handleFormCancelled()\"\n      />\n\n      <div footer class=\"flex justify-end gap-2 px-6 py-4\">\n        <af-button\n          variant=\"ghost\"\n          size=\"sm\"\n          dataTest=\"user-form-cancel-btn\"\n          (click)=\"userFormRef()?.cancel()\"\n        >\n          Cancelar\n        </af-button>\n        <af-loading-button\n          variant=\"primary\"\n          size=\"sm\"\n          [loading]=\"isFormSaving()\"\n          [disabled]=\"(userFormRef()?.form?.invalid ?? true) || isFormSaving()\"\n          dataTest=\"user-form-save-btn\"\n          (click)=\"userFormRef()?.submit()\"\n        >\n          Salvar\n        </af-loading-button>\n      </div>\n    </af-modal>\n\n    <!-- Delete confirmation modal -->\n    <af-confirm-modal\n      [open]=\"showDeleteModal()\"\n      [title]=\"deleteModalTitle()\"\n      [message]=\"deleteMessage()\"\n      [confirmLabel]=\"deleteConfirmLabel()\"\n      cancelLabel=\"Cancelar\"\n      variant=\"danger\"\n      iconName=\"trash-2\"\n      (confirmed)=\"handleDeleteConfirmed()\"\n      (cancelled)=\"showDeleteModal.set(false)\"\n    />\n  `,\n})\nexport class SettingsUsers implements OnInit {\n  private readonly service = inject(SettingsUsersService);\n  private readonly toast = inject(ToastService);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly userFormRef = viewChild<SettingsUserFormComponent>('userForm');\n\n  // ── List state ───────────────────────────────────────────────────────────────\n  readonly users = signal<SettingsUser[]>([]);\n  readonly meta = signal({ current_page: 1, last_page: 1, per_page: 15, total: 0 });\n  readonly isLoading = signal(false);\n  readonly hasError = signal(false);\n  readonly isEmpty = computed(\n    () => !this.isLoading() && !this.hasError() && this.users().length === 0,\n  );\n\n  private currentPage = 1;\n  private searchTerm = '';\n  private filterStatus = signal<SettingsUserStatus>('all');\n\n  readonly searchControl = new FormControl<string>('', { nonNullable: true });\n  readonly filterStatusControl = new FormControl<string>('all', { nonNullable: true });\n  readonly filterStatusOptions: AfSelectOption[] = [\n    { label: 'Todos', value: 'all' },\n    { label: 'Ativo', value: 'active' },\n    { label: 'Inativo', value: 'inactive' },\n  ];\n\n  // ── Bulk selection ───────────────────────────────────────────────────────────\n  readonly selectAllControl = new FormControl<boolean>(false, { nonNullable: true });\n  private readonly rowSelectionControls = new Map<string, FormControl<boolean>>();\n  readonly selectedUserIds = signal<string[]>([]);\n  readonly selectedCount = computed(() => this.selectedUserIds().length);\n  readonly hasSelection = computed(() => this.selectedCount() > 0);\n\n  // ── Form modal ───────────────────────────────────────────────────────────────\n  readonly showFormModal = signal(false);\n  readonly selectedUser = signal<SettingsUser | null>(null);\n  readonly isFormSaving = computed(() => this.userFormRef()?.isSaving() ?? false);\n  readonly formModalTitle = computed(() =>\n    this.selectedUser() ? 'Editar usuário' : 'Novo usuário',\n  );\n\n  // ── Delete modal ─────────────────────────────────────────────────────────────\n  readonly showDeleteModal = signal(false);\n  readonly userToDelete = signal<SettingsUser | null>(null);\n  readonly isDeleting = signal(false);\n  readonly deleteModalTitle = computed(() =>\n    this.userToDelete() ? 'Excluir usuário' : 'Excluir usuários',\n  );\n  readonly deleteMessage = computed(() => {\n    const single = this.userToDelete();\n    if (single) {\n      return `Tem certeza que deseja excluir o usuário \"${single.name}\"? Esta ação não pode ser desfeita.`;\n    }\n    return `Tem certeza que deseja excluir os ${this.selectedCount()} usuários selecionados? Esta ação não pode ser desfeita.`;\n  });\n  readonly deleteConfirmLabel = computed(() =>\n    this.userToDelete() ? 'Excluir' : 'Excluir selecionados',\n  );\n\n  constructor() {\n    this.selectAllControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((checked) => {\n        const selectable = this.users().filter((u) => !u.is_primary_tenant_user);\n        const ids = checked ? selectable.map((u) => u.id) : [];\n        this.selectedUserIds.set(ids);\n        selectable.forEach((u) => {\n          const ctrl = this.rowSelectionControls.get(u.id);\n          ctrl?.setValue(checked, { emitEvent: false });\n        });\n      });\n  }\n\n  ngOnInit(): void {\n    this.filterStatusControl.valueChanges\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe((value) => {\n        this.filterStatus.set(value as SettingsUserStatus);\n        this.currentPage = 1;\n        this.loadUsers();\n      });\n\n    this.loadUsers();\n  }\n\n  // ── Data loading ─────────────────────────────────────────────────────────────\n\n  loadUsers(): void {\n    this.isLoading.set(true);\n    this.hasError.set(false);\n    this.service\n      .list({\n        search: this.searchTerm || undefined,\n        status: this.filterStatus(),\n        page: this.currentPage,\n        per_page: 15,\n      })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: (response) => {\n          const users = response.data.map((u) => this.withDerivedRole(u));\n          this.users.set(users);\n          this.meta.set(response.meta);\n          this.syncSelectionControls(users);\n          this.isLoading.set(false);\n        },\n        error: () => {\n          this.hasError.set(true);\n          this.isLoading.set(false);\n        },\n      });\n  }\n\n  onSearch(term: string): void {\n    this.searchTerm = term;\n    this.currentPage = 1;\n    this.loadUsers();\n  }\n\n  loadPage(page: number): void {\n    this.currentPage = page;\n    this.loadUsers();\n  }\n\n  retry(): void {\n    this.loadUsers();\n  }\n\n  // ── CRUD actions ─────────────────────────────────────────────────────────────\n\n  openCreate(): void {\n    this.selectedUser.set(null);\n    this.showFormModal.set(true);\n  }\n\n  openEdit(user: SettingsUser): void {\n    this.selectedUser.set(user);\n    this.showFormModal.set(true);\n  }\n\n  openDelete(user: SettingsUser): void {\n    this.userToDelete.set(user);\n    this.showDeleteModal.set(true);\n  }\n\n  openBulkDelete(): void {\n    this.userToDelete.set(null);\n    this.showDeleteModal.set(true);\n  }\n\n  handleFormSaved(user: SettingsUser): void {\n    this.showFormModal.set(false);\n    this.toast.success('Usuário salvo com sucesso.');\n    this.loadUsers();\n    void user;\n  }\n\n  handleFormCancelled(): void {\n    this.showFormModal.set(false);\n  }\n\n  handleDeleteConfirmed(): void {\n    if (this.isDeleting()) return;\n    const single = this.userToDelete();\n    const idsToDelete = single ? [single.id] : this.selectedUserIds();\n    if (idsToDelete.length === 0) return;\n\n    this.isDeleting.set(true);\n    forkJoin(idsToDelete.map((id) => this.service.delete(id)))\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => {\n          this.isDeleting.set(false);\n          this.showDeleteModal.set(false);\n          this.userToDelete.set(null);\n          this.clearSelection();\n          this.toast.success(\n            idsToDelete.length > 1\n              ? 'Usuários excluídos com sucesso.'\n              : 'Usuário excluído com sucesso.',\n          );\n          this.loadUsers();\n        },\n        error: () => {\n          this.isDeleting.set(false);\n        },\n      });\n  }\n\n  toggleStatus(user: SettingsUser): void {\n    if (user.is_primary_tenant_user) return;\n    this.service\n      .toggleStatus(user.id)\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: () => this.loadUsers(),\n      });\n  }\n\n  // ── Extra table actions ───────────────────────────────────────────────────────\n\n  getExtraActions(\n    user: SettingsUser,\n  ): { label: string; icon: string; action: () => void; variant?: string }[] {\n    if (user.is_primary_tenant_user) return [];\n    return [\n      {\n        label: user.is_active ? 'Inativar' : 'Ativar',\n        icon: 'power',\n        variant: user.is_active ? 'danger' : 'primary',\n        action: () => this.toggleStatus(user),\n      },\n    ];\n  }\n\n  // ── Selection helpers ─────────────────────────────────────────────────────────\n\n  getRowSelectionControl(id: string): FormControl<boolean> {\n    if (this.rowSelectionControls.has(id)) return this.rowSelectionControls.get(id)!;\n    const control = new FormControl<boolean>(false, { nonNullable: true });\n    control.valueChanges.pipe(takeUntilDestroyed(this.destroyRef)).subscribe((checked) => {\n      const selected = new Set(this.selectedUserIds());\n      if (checked) {\n        selected.add(id);\n      } else {\n        selected.delete(id);\n      }\n      this.selectedUserIds.set([...selected]);\n      const selectable = this.users().filter((u) => !u.is_primary_tenant_user);\n      this.selectAllControl.setValue(\n        selectable.length > 0 && selectable.every((u) => selected.has(u.id)),\n        { emitEvent: false },\n      );\n    });\n    this.rowSelectionControls.set(id, control);\n    return control;\n  }\n\n  // ── Helpers ───────────────────────────────────────────────────────────────────\n\n  getInitials(name: string): string {\n    return (\n      name\n        .split(' ')\n        .filter(Boolean)\n        .map((p) => p[0]?.toUpperCase())\n        .join('')\n        .slice(0, 2) || 'US'\n    );\n  }\n\n  private withDerivedRole(user: SettingsUser): SettingsUser {\n    const role = user.roles?.[0] ?? user.role ?? null;\n    return { ...user, role };\n  }\n\n  private syncSelectionControls(users: SettingsUser[]): void {\n    const validIds = new Set(users.map((u) => u.id));\n    for (const id of this.rowSelectionControls.keys()) {\n      if (!validIds.has(id)) this.rowSelectionControls.delete(id);\n    }\n    const remaining = this.selectedUserIds().filter((id) => validIds.has(id));\n    if (remaining.length !== this.selectedUserIds().length) {\n      this.selectedUserIds.set(remaining);\n    }\n  }\n\n  private clearSelection(): void {\n    this.selectedUserIds.set([]);\n    this.rowSelectionControls.forEach((c) => c.setValue(false, { emitEvent: false }));\n    this.selectAllControl.setValue(false, { emitEvent: false });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/rafael.silva/Documents/agentflix/app-new/src/app/pages/billing/invoices/components/invoice-payment-modal/invoice-payment-modal.ts","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'../../../../../core/services/billing-invoice.service' import is duplicated.","line":31,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":31,"endColumn":94},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":247,"column":28,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":247,"endColumn":32},{"ruleId":"@typescript-eslint/no-invalid-void-type","severity":2,"message":"void is only valid as a return type or generic type argument.","line":248,"column":36,"nodeType":"TSVoidKeyword","messageId":"invalidVoidNotReturnOrGeneric","endLine":248,"endColumn":40},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":282,"column":12,"nodeType":"Identifier","messageId":"conditionErrorNullableString","endLine":282,"endColumn":14,"suggestions":[{"messageId":"conditionFixCompareNullish","fix":{"range":[9357,9359],"text":"(qr != null)"},"desc":"Change condition to check for null/undefined (`value != null`)"},{"messageId":"conditionFixDefaultEmptyString","fix":{"range":[9357,9359],"text":"(qr ?? \"\")"},"desc":"Explicitly treat nullish value the same as an empty string (`value ?? \"\"`)"},{"messageId":"conditionFixCastBoolean","fix":{"range":[9357,9359],"text":"(Boolean(qr))"},"desc":"Explicitly convert value to a boolean (`Boolean(value)`)"}]},{"ruleId":"@typescript-eslint/strict-boolean-expressions","severity":2,"message":"Unexpected nullable string value in conditional. Please handle the nullish/empty cases explicitly.","line":332,"column":28,"nodeType":"ChainExpression","messageId":"conditionErrorNullableString","endLine":332,"endColumn":49,"suggestions":[{"message