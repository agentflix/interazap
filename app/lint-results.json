orm.value.priority).toBe(0);\n  });\n\n  it('should fill form when guardrail input changes', () => {\n    const guardrail: AutopilotGuardrail = {\n      id: '1',\n      name: 'Guard',\n      rule_type: 'BLOCK',\n      priority: 10,\n      is_active: false,\n      conditions: { tool: 'SEARCH' },\n    };\n\n    fixture.componentRef.setInput('guardrail', guardrail);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('Guard');\n    expect(component.form.value.conditions).toContain('\"SEARCH\"');\n  });\n\n  it('should reset form when guardrail input is null', () => {\n    const guardrail: AutopilotGuardrail = {\n      id: '1',\n      name: 'Guard',\n      rule_type: 'BLOCK',\n      priority: 0,\n      is_active: true,\n      conditions: null,\n    };\n    fixture.componentRef.setInput('guardrail', guardrail);\n    fixture.detectChanges();\n\n    fixture.componentRef.setInput('guardrail', null);\n    fixture.detectChanges();\n\n    expect(component.form.value.name).toBe('');\n  });\n\n  it('should submit creation', () => {\n    const createSpy = vi.spyOn(autopilotService, 'createGuardrail');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n\n    component.form.patchValue({ name: 'New Guard', conditions: '{}' });\n    component.submit();\n\n    expect(createSpy).toHaveBeenCalledWith(expect.objectContaining({ name: 'New Guard' }));\n    expect(savedSpy).toHaveBeenCalled();\n  });\n\n  it('should submit update', () => {\n    const updateSpy = vi.spyOn(autopilotService, 'updateGuardrail');\n    const savedSpy = vi.spyOn(component.saved, 'emit');\n    const guardrail: AutopilotGuardrail = {\n      id: '1',\n      name: 'Old',\n      description: 'Desc',\n      rule_type: 'BLOCK',\n      priority: 1,\n      conditions: { tool: 'SEARCH' },\n      is_active: true,\n    };\n\n    fixture.componentRef.setInput('guardrail', guardrail);\n    fixture.detectChanges();\n\n    component.form.patchValue({ name: 'Updated' });\n    component.submit();\n\n 