{
  "name": "app-new",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\"",
    "gate:lint": "ng lint && echo '✅ ESLint passou!'",
    "gate:test": "ng test --watch=false && echo '✅ Testes passaram!'",
    "gate:build": "ng build --configuration production && echo '✅ Build passou!'",
    "gate:all": "npm run gate:lint && npm run gate:test && npm run gate:build && echo '🎉 TODOS OS GATES PASSARAM!'",
    "quality": "npm run gate:all"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@ng-icons/core": "32.5.0",
    "@ng-icons/lucide": "32.5.0",
    "apexcharts": "^5.6.0",
    "canvas-confetti": "^1.9.4",
    "lucide-angular": "^0.575.0",
    "ngx-mask": "^20.0.3",
    "ngx-sonner": "^3.1.0",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "simplebar-angular": "^3.3.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "uqr": "^0.1.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.0",
    "@analogjs/vitest-angular": "^2.3.0",
    "@angular-eslint/builder": "21.2.0",
    "@angular/build": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.15",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.50.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
