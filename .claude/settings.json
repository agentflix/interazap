{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Read(.claude/commands/**)",
            "Read(.claude/skills/**)",
            "Read(.claude/hooks/**)",
            "Read(.context/**)",
            "Read(AGENTS.md)",
            "Read(CLAUDE.md)",
            "Read(api/AGENTS.md)",
            "Read(gateway/AGENTS.md)",
            "Bash(node .claude/hooks/router.js)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push *)",
            "Bash(git checkout main)",
            "Bash(npm publish)",
            "Bash(composer global *)"
        ]
    }
}
