APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# ⚠️ Generate with: php artisan key:generate
# Segredo JWT para tokens do chat público (deve ser IGUAL ao WEBCHAT_JWT_SECRET do gateway)
# Gerar com: openssl rand -hex 32
WEBCHAT_JWT_SECRET=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Additional CORS origins (comma-separated). Production/staging hosts and
# mobile origins (capacitor://localhost, http://localhost) are already
# included by default in config/cors.php — use this var only for staging
# previews or custom client hosts.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:8000,http://localhost:3000

#LOG 
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gateway
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# CACHE
CACHE_STORE=redis
CACHE_PREFIX=INTERAZAP_LOCAL

#REDIS / MEMCACHED
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# BROADCAST
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

# REVERB
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_APP_MAX_MESSAGE_SIZE=20000

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# VITE
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# CHAT CONFIG
CHAT_AUTO_CLOSE_MINUTES=20
CHAT_EVALUATION_PUBLIC_URL=http://localhost:4200

# GATEWAY
GATEWAY_URL=http://gateway:3000
GATEWAY_INTERNAL_API_KEY=
GATEWAY_E2E=0

# AUTOPILOT
AI_AUTOPILOT_MAX_TOKENS=800
AI_MAX_TOOL_ITERATIONS=10
AI_AUTOPILOT_QUEUE_CONNECTION=redis
AI_AUTOPILOT_QUEUE_NAME=ai
AI_EMBEDDING_DIMENSIONS=512
AI_EMBEDDING_BATCH_SIZE=100
AI_CHUNKING_CHARS_PER_TOKEN=3.5

# ASAAS (Billing)
# Get from: https://www.asaas.com/
ASAAS_API_KEY=

# CONFIGS
# ⚠️ Set your default tenant ID
DEFAULT_TENANT_ID=your-default-tenant-uuid

# SANCTUM
# Token expiration in minutes (default: 24 hours)
SANCTUM_EXPIRATION=1440

# =============================================================================
# OBSERVABILITY (OBS-CRIT-001)
# =============================================================================

# Sentry - Error tracking
# Get DSN from https://sentry.io
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Horizon notifications - Set in production!
HORIZON_NOTIFICATION_EMAIL=
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=#alerts
HORIZON_ADMIN_EMAIL=

# =============================================================================
# QUEUE CONFIGURATION (006-async-resilience)
# =============================================================================

# Queue Connection
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# Queue Timeouts per Priority (seconds)
QUEUE_CRITICAL_TIMEOUT=30
QUEUE_CRITICAL_TRIES=5
QUEUE_HIGH_TIMEOUT=60
QUEUE_HIGH_TRIES=3
QUEUE_DEFAULT_TIMEOUT=120
QUEUE_DEFAULT_TRIES=3
QUEUE_LOW_TIMEOUT=300
QUEUE_LOW_TRIES=2
QUEUE_AI_TIMEOUT=180
QUEUE_AI_TRIES=3
QUEUE_MEDIA_TIMEOUT=300
QUEUE_MEDIA_TRIES=3

# Queue Health Thresholds
QUEUE_HEALTH_MAX_SIZE=1000
QUEUE_HEALTH_MAX_STUCK=10
QUEUE_HEALTH_STUCK_THRESHOLD=600

# Horizon Workers
HORIZON_MAX_PROCESSES=10
HORIZON_MIN_PROCESSES=1

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================

# WhatsApp Provider Circuit Breaker
WHATSAPP_USE_REAL_PROVIDER=false
WHATSAPP_CB_FAILURE_THRESHOLD=5
WHATSAPP_CB_SUCCESS_THRESHOLD=2
WHATSAPP_CB_OPEN_TIMEOUT=60

# Gateway Circuit Breaker
GATEWAY_TIMEOUT=3
GATEWAY_RETRY_ATTEMPTS=3
GATEWAY_RETRY_DELAY_MS=150

# HTTP Retry Configuration
HTTP_RETRY_DELAY_MS=1000

# =============================================================================
# REDIS BACKOFF CONFIGURATION
# =============================================================================

# Backoff algorithm: decorrelated_jitter, exponential, linear
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# =============================================================================
# PUSH NOTIFICATIONS (TASK-047.10 - Fatia A)
# =============================================================================

# APNs (iOS)
APN_KEY_ID=
APN_TEAM_ID=
APN_PRIVATE_KEY=
APN_BUNDLE_ID=
APN_PRIVATE_SECRET=
APN_PRODUCTION=false

# FCM (Android)
FCM_CREDENTIALS_JSON=
