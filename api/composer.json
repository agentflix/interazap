{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "brick/money": "^0.10",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.43",
        "laravel-notification-channels/apn": "^6.0",
        "laravel-notification-channels/fcm": "^6.0",
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.10.1",
        "league/csv": "^9.28",
        "maatwebsite/excel": "^3.1",
        "owen-it/laravel-auditing": "^14.0",
        "predis/predis": "^3.3",
        "promphp/prometheus_client_php": "^2.14",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.5",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.19",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "src/Domain/",
            "Infrastructure\\": "src/Infrastructure/",
            "Shared\\": "src/Shared/",
            "Support\\": "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": "vendor/bin/pest --parallel",
        "test:no-parallel": "vendor/bin/pest",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "analyse": "@php ./bin/larastan analyse --memory-limit=2G",
        "test:coverage": "XDEBUG_MODE=coverage php -d memory_limit=512M vendor/bin/pest --coverage",
        "test:coverage:min": "XDEBUG_MODE=coverage php -d memory_limit=512M vendor/bin/pest --coverage --min=80",
        "refactor": "vendor/bin/rector process",
        "refactor:dry": "vendor/bin/rector process --dry-run",
        "gate:format": [
            "sh -c \"vendor/bin/pint --test || (echo '\\n❌ Formatação falhou! Execute: composer format\\n' && exit 1)\"",
            "echo '✅ Gate 1/4: Formatação OK'"
        ],
        "gate:analyse": [
            "sh -c \"composer analyse || (echo '\\n❌ Análise estática falhou!\\n' && exit 1)\"",
            "echo '✅ Gate 2/4: Análise estática OK'"
        ],
        "gate:test": [
            "sh -c \"php -d pcov.enabled=0 -d memory_limit=2G vendor/bin/pest --parallel || (echo '\\n❌ Testes falharam!\\n' && exit 1)\"",
            "echo '✅ Gate 3/4: Testes OK'"
        ],
        "gate:refactor": [
            "sh -c \"vendor/bin/rector process --dry-run || (echo '\\n⚠️  Rector sugere melhorias. Revise: composer refactor\\n' && exit 1)\"",
            "echo '✅ Gate 4/4: Refatoração OK'"
        ],
        "gate:all": [
            "echo '\n🚀 Executando todos os gates...\n'",
            "@gate:format",
            "@gate:analyse",
            "@gate:test",
            "@gate:refactor",
            "echo '\n🎉 TODOS OS GATES PASSARAM!\n'"
        ],
        "ci": "@gate:all"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
